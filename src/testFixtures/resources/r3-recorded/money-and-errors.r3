[$1e127 % $3]
[$1 % $1e-128]
[$1e-128 < $2e-128]
[$0 = -$0]
[same? $0 -$0]
[-$1 + $1]
[$1 - $1]
[mold to money! -0.0]
[$1 * $0]
[-$1 * $0]
[to decimal! $0.1]
[to decimal! $1e-128]
[to money! "1'000.5"]
[to money! "1,5"]
[to money! "1e"]
[to money! "."]
[to money! "$"]
[$0.1 + $0.2 = $0.3]
[max 3 $1]
[min -$3 2]
[min -$3 1.0]
[max $1 $1.0]
[min $1 1]
[max 1 1.0]
[min 1 1.0]
[max "a" "b"]
[min 2.5 $2.5]
[max 1:00 2:00]
[max 1x2 3x0]
[e: try [max 1 "a"] e/id]
[max #"a" #"b"]
[max 1.2.3 1.3]
[e: try [1 < "a"] reduce [e/id e/arg1 e/arg2]]
[e: try [object [] < object []] reduce [e/id e/arg1 e/arg2]]
[e: try [true < false] reduce [e/id e/arg1 e/arg2]]
[e: try [#[] < #[]] reduce [e/id e/arg1 e/arg2]]
] [set/any 'e try code print either unset? get/any 'e [{#unset}] [mold/flat either error? e [reduce [e/id e/arg1 e/arg2]] [e]]]
