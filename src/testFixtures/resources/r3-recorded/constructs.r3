REBOL []
foreach code [
[transcode {#(true 1)}]
[transcode {#(false x y)}]
[transcode {#(unset 2)}]
[transcode {#(none [a])}]
[transcode {#(NONE 1)}]
[transcode {#(True)}]
[transcode {#(k: 1)}]
[transcode {#(k:)}]
[transcode {#(1 2)}]
[transcode {#(1.5)}]
[transcode {#("a" b)}]
[transcode {#([a] 1)}]
[transcode {#(:g 1)}]
[transcode {#('l 1)}]
[transcode {#(a/b 1)}]
[transcode {#(#a 1)}]
[transcode {#(%f 1)}]
[transcode {#(foo 1)}]
[transcode {#(char! 65)}]
[transcode {#(string! "ab" x)}]
[transcode {#()}]
[load {#(1 2)}]
[first transcode/error {#(1 2) x}]
] [set/any 'e try code print either unset? get/any 'e [{#unset}] [mold/flat/all either error? e [reduce [e/id e/arg1 e/arg2 e/arg3]] [e]]]
