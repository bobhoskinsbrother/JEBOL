-- allium: 3
--
-- JEBOL: the built-in function set for milestone 1.
--
-- The standard function set is two layers, and this module covers both.
-- Natives are written in the host language because they reach something
-- the language cannot: arithmetic on machine integers, the reader, the
-- evaluator itself. The prelude is written in REBOL and evaluated at
-- startup into the same context, and holds everything that can be said in
-- REBOL. Nothing tells a caller which layer a function came from.
--
-- This is not an optimisation, it is what the language is. REBOL is
-- extended in REBOL: a dialect is a block interpreted by a function, and
-- a library is words bound in a context. An implementation that can only
-- be extended in its host language is a program that parses REBOL rather
-- than a REBOL. It also cannot borrow: REBOL's own library is some
-- twenty-five thousand lines of REBOL, and none of it is reachable to an
-- implementation with nowhere to put it.
--
-- The rule for which layer a function belongs in is whether it needs
-- something REBOL cannot say. MAX compares two values and belongs in the
-- prelude; ADD touches machine arithmetic and does not.
--
-- The rule has a test, and JEBOL fails it in sixteen places. R3 defines
-- these in REBOL and JEBOL defines them in Java:
--
--   body-of exists? func function join keys-of load quote split
--   to-block to-decimal to-integer to-string to-word use values-of
--
-- Each is a native that did not have to be one. FUNC and FUNCTION are
-- the striking pair: R3 builds them in REBOL on top of MAKE FUNCTION!,
-- and JEBOL builds them in Java, which means JEBOL cannot be extended
-- with a new way of making functions without changing JEBOL.
--
-- This matters more than tidiness. Loading Rebol's own file for one of
-- these replaces the native outright -- the REBOL definition wins,
-- because it is assigned into the same context afterwards. So every one
-- of the sixteen is either dead code waiting to be shadowed, or a
-- deliberate divergence that has to be defended. Left alone it is
-- neither, and nobody can tell which by reading it.
--
-- This module says what the natives are and what the non-obvious ones do.
-- It does not restate the evaluator: how a native gets its arguments,
-- what happens when one is the wrong type, and how an error travels back
-- out are all in eval.allium and apply to natives exactly as they apply
-- to anything else.
--
-- What earns a rule here is behaviour a caller can get wrong. IF
-- returning NONE rather than UNSET, ANY returning a value rather than a
-- logic, and zero being true are all things people trip over, and each of
-- them has corpus entries behind it.

use "./values.allium" as values

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum NativeCategory {
    control         -- if, either, any, all, loop, while, until, foreach
    | arithmetic    -- add, subtract, multiply, divide, remainder, negate
    | comparison    -- equal, lesser, greater and their operator spellings
    | logic_op      -- and, or, not, xor
    | series        -- first, last, length, pick, select, find, append, copy
    | conversion    -- to-integer, to-string, to-block, form, mold
    | reflection    -- type, value, native, function, get, set, unset, protect
    | failure       -- try, error, throw, catch
}

-- How closely two values have to agree before a comparison calls them
-- equal, and how far it will go to compare two different datatypes. The
-- ten comparison natives ask one of these six questions between them.
--
-- Four questions are about sameness and two are about order. Reading down
-- the list, each sameness question is stricter than the one above it.
enum ComparisonStrictness {
    -- = and EQUAL?, and NOT-EQUAL? and <> negated. Folds the case of a
    -- character or a string, coerces across the datatypes named in the
    -- rules below, and allows two decimals to differ in the last few bits.
    equal

    -- EQUIV?, and NOT-EQUIV? negated. Coerces and folds exactly as
    -- `equal` does, and then insists on the bits of a decimal.
    | equiv

    -- == and STRICT-EQUAL?, and !== and STRICT-NOT-EQUAL? negated. Minds
    -- the case and refuses two different datatypes rather than coercing.
    | strict_equal

    -- =? and SAME?. Asks whether the two are one value.
    | same

    -- GREATER-OR-EQUAL? and >=, and LESSER? and < negated.
    | greater_or_equal

    -- GREATER? and >, and LESSER-OR-EQUAL? and <= negated.
    | greater
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

-- One entry in the built-in catalogue. The catalogue is data: what a
-- native is called, how many arguments it takes and what it accepts. What
-- it does is either obvious or has a rule below.
entity NativeDefinition {
    name: String                    -- the word it is bound to, lowercased
    category: NativeCategory
    parameters: List<values/Parameter>
    arity: parameters.count

    -- True for the ones reached infix. An operator is always binary and
    -- always has a prefix twin, so `1 + 2` and `add 1 2` are the same
    -- call reached two ways.
    is_operator: Boolean
    prefix_twin: String when is_operator = true

    invariant OperatorsAreBinary {
        is_operator implies arity = 2
    }

    @guidance
        -- Two of the pairings are not what the spelling suggests, and
        -- guessing them wrong gives an operator that works on the easy
        -- cases and lies on the rest.
        --
        -- `=?` is SAME?, not EQUAL?. It asks whether two references are
        -- one value, so `1 =? 1` is true and `"a" =? "a"` is false --
        -- two strings that are equal but not the same one.
        --
        -- `%%` is MOD, not MODULO. Both divide, and they differ on
        -- negatives: `-7 %% 3` is 2, never negative, because it uses
        -- Euclidean division. Reading `%%` as REMAINDER gives -1.
        --
        -- The other seven are the obvious twins: != is NOT-EQUAL?,
        -- !== is STRICT-NOT-EQUAL?, ** is POWER, & is AND~, | is OR~,
        -- << is SHIFT-LEFT and >> is SHIFT-RIGHT.
}

-- One comparison, as all ten comparison natives reach it. The strictness
-- is the whole of the difference between them: nothing else about the call
-- changes from EQUAL? to LESSER?.
entity ComparisonRequest {
    left: values/Value
    right: values/Value
    strictness: ComparisonStrictness

    -- Whether the two values can be brought to a common datatype at this
    -- strictness. True when they share one already; true across the four
    -- number datatypes, between a time and the three non-money numbers,
    -- between a character and an integer, among the word datatypes and
    -- among the string ones; false for the two strictest strictnesses
    -- whenever the datatypes differ at all.
    coerces: Boolean

    -- True where a series function asked -- FIND, SELECT, SWITCH, SORT,
    -- UNIQUE, or the object field walk. Those cross fewer datatype
    -- boundaries than the comparison natives do, so who asked changes the
    -- answer.
    asked_by_a_series_function: Boolean

    -- A comparison that cannot bring the two together either answers false
    -- or refuses to answer, and which one it does depends only on whether
    -- the question was about order.
    refuses_to_answer: not coerces
        and strictness in {greater_or_equal, greater}

    invariant SamenessQuestionsAlwaysAnswer {
        strictness in {equal, equiv, strict_equal, same}
            implies refuses_to_answer = false
    }
}

-- One write to a file, holding everything the caller asked for.
--
-- WRITE takes nine refinements and four of them change what happens. The
-- other three are accepted and change nothing, and they are carried here
-- rather than left out, because "accepted and without effect" is a fact a
-- caller can rely on and an implementation can get wrong in two directions:
-- by refusing them, and by making one of them do something.
entity FileWriteRequest {
    destination: values/Value       -- the file! being written to
    data: values/Value

    -- /part length. How much of the data to write, counted in the units of
    -- the data's own series: characters of a string, bytes of a binary.
    -- Absent when the caller did not bound the write.
    units_permitted: Integer?

    -- /seek index. Where in the file the write starts, counted from its
    -- beginning. Absent when the caller named no position.
    position_asked_for: Integer?

    -- /append. Write at the end of what is already there.
    writes_at_the_end: Boolean

    -- /lines. One value per line.
    one_value_per_line: Boolean

    -- /binary. Nothing to switch on: the branch that would have re-encoded
    -- a string on the way out is commented out in the C, so both answers
    -- take the same path and write the same bytes.
    asked_for_binary: Boolean

    -- /allow access. The protection attributes the caller named, as mode
    -- words. Nothing on the write path reads them.
    access_modes: List<String>

    -- /all. Never tested on this path.
    asked_for_all: Boolean

    -- Whether the file is replaced rather than written into.
    --
    -- Truncating is not something a caller asks for. It is what is left
    -- when nobody asked to write anywhere in particular, which is why this
    -- reads as the absence of the other two rather than as a flag.
    replaces_the_file: position_asked_for = null and not writes_at_the_end

    -- Whether a bound the caller gave has any effect.
    --
    -- Two kinds of data ignore it and both for the same reason: the length
    -- is worked out again, from the encoding or from the molded text, after
    -- the bound has already been applied. A char is one, and a block
    -- written one value per line is the other.
    --
    -- A bound that does not apply is still checked. A negative one is
    -- refused whatever the data is, because the refusal happens where the
    -- number is read rather than where it is used.
    the_bound_applies: units_permitted != null
        and not is_char(data)
        and not (is_block(data) and one_value_per_line)
}

-- One read of a file, with everything the caller asked for.
--
-- READ's seven refinements sort into three jobs: two say how much to read
-- and from where, three say what shape the answer takes, and the last two
-- are a duplicate and a vestige. Getting the shape wrong is the one that
-- costs, because a read that answers text where it should answer bytes
-- corrupts anything that is not text and says nothing about it.
entity FileReadRequest {
    source: values/Value            -- the file! being read

    -- /part length. How many bytes to read, and negative is meaningful
    -- rather than refused: it reads backwards. Absent when the caller did
    -- not bound the read.
    bytes_permitted: Integer?

    -- /seek index. Where in the file the read starts. Absent when the caller
    -- named no position, and then it starts at the beginning.
    position_asked_for: Integer?

    answers_text: Boolean           -- /string
    answers_bytes_outright: Boolean -- /binary
    answers_lines: Boolean          -- /lines

    -- /all. Accepted and without effect on a file. Its meaning belongs to
    -- the schemes that have response metadata to include, and a file has
    -- none, so there is nothing for it to add.
    asked_for_all: Boolean

    -- Whether the bytes are decoded to text before the answer is made.
    -- /lines asks for it without naming it, because a block of lines is a
    -- block of strings and there is no way to split bytes into those without
    -- first deciding what the bytes say.
    decodes_the_bytes: answers_text or answers_lines

    -- Whether the bound reaches back before where the read would have
    -- started rather than forward from it.
    reads_backwards: bytes_permitted != null and bytes_permitted < 0
}

-- One call to another program, holding everything the caller asked for.
--
-- CALL takes seven refinements and three of them carry a value. Those three
-- are the substance: each says where one of the child's streams comes from
-- or goes to, and each is optional twice over. The refinement may be absent,
-- and it may be present holding none, and the two mean opposite things.
entity ProgramCall {
    -- The command as written: a string for the shell to read, a file naming
    -- the executable, or a block of the program and its arguments already
    -- separated.
    command: values/Value

    waits_for_it_to_finish: Boolean     -- /wait
    attaches_to_the_console: Boolean    -- /console
    reads_through_the_shell: Boolean    -- /shell
    answers_an_object: Boolean          -- /info

    -- /input in, /output out and /error err. Absent means the refinement was
    -- not used and the child inherits the host's stream. Present holding
    -- none means the stream is closed or thrown away, which is the opposite
    -- thing, and a model that had one way of saying "nothing" could not tell
    -- a script which it had asked for.
    input_redirection: values/Value?
    output_redirection: values/Value?
    error_redirection: values/Value?

    -- Whether any of the three has a string or a binary at its end. One
    -- condition across all three, because the C tests all six possibilities
    -- in one place and takes the same decision from any of them.
    a_series_is_at_one_end:
        is_a_series(input_redirection)
        or is_a_series(output_redirection)
        or is_a_series(error_redirection)

    -- Whether the call waits for the child to exit.
    --
    -- Not the same question as whether /wait was named. A caller who asked
    -- for a capture has asked to wait without saying so, because a capture
    -- cannot be answered while the child is still writing.
    waits: waits_for_it_to_finish or a_series_is_at_one_end
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    -- Above this many characters a plain string molds braced rather than
    -- quoted, because a long single line reads more easily between braces.
    longest_quoted_string: Integer = 50

    -- At this many newlines or more a plain string molds braced, so the
    -- lines stay real line breaks rather than becoming a run of `^/`.
    newlines_forcing_braces: Integer = 3
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- === Conditionals ==========================================
--
-- Every conditional native asks the same question of its condition: is
-- this value true? The answer is in values.allium, and it is that only
-- NONE and logic FALSE are false. Zero is true, an empty string is true,
-- an empty block is true. This is the single most surprising thing about
-- the language for anyone arriving from elsewhere, and it is one rule
-- rather than a special case per native.

rule ConditionalTakesBranchOnTruth {
    when: EvaluateIf(condition, branch)
    requires: condition.is_truthy
    ensures: BranchTaken(branch: branch)
}

-- IF with a false condition produces NONE, not UNSET. The distinction
-- matters because UNSET cannot be assigned or passed on, and `flag: if
-- false [...]` has to leave something behind.
rule ConditionalProducesNoneOnFalsehood {
    when: EvaluateIf(condition, branch)
    requires: not condition.is_truthy
    ensures: ConditionalResult(value: none_value())
}

-- The condition is not reduced. A block is a value and values are true,
-- so `if [false] [...]` takes the branch. What is inside the block is
-- never looked at.
rule ConditionalDoesNotReduceItsCondition {
    when: EvaluateIf(condition, branch)
    requires: condition.datatype = block
    ensures: BranchTaken(branch: branch)
}

-- SWITCH compares its cases as values and never evaluates them. A case is
-- whatever was written, matched against the subject by the same comparison
-- everything else uses.
--
-- Which means a paren case matches an equal paren rather than being run:
-- `switch first [(2)] [(1) [...] (2) [...]]` takes the second branch,
-- because the subject is the paren `(2)` and the case `(2)` equals it.
-- Rebol's own conditional-test.r3 asserts this twice, with parens
-- specifically, because parens are where the wrong reading shows.
--
-- The wrong reading is natural and worth naming: SWITCH looks like it
-- evaluates a list of expressions and picks the one that matches, and it
-- does not. Nothing between the cases runs. A case that is a paren of code
-- is compared as code rather than as its result, so a caller wanting the
-- result has to compute it before SWITCH sees it.
--
-- The blocks are the exception, and they have to be: a block in a case
-- position is a branch body rather than a case, which is how the two are
-- told apart without a separator.
rule SwitchComparesItsCasesAsValues {
    when: EvaluateSwitch(subject, cases)

    ensures: BranchTaken(branch: the_body_after_the_first_case_equal_to(subject))
}

-- An untaken branch is never evaluated, so an error inside it cannot
-- fire. This is what makes a conditional a conditional rather than a
-- function of two already-computed values.
rule UntakenBranchIsNotEvaluated {
    when: EvaluateEither(condition, true_branch, false_branch)
    requires: not condition.is_truthy
    ensures: BranchTaken(branch: false_branch)
}

-- === Any and all ===========================================
--
-- These return values, not logics. That is what makes `any [supplied 100]`
-- the way a default is written in REBOL, and it is why they are worth a
-- rule each rather than being filed under boolean logic.

rule AnyProducesFirstTruthyValue {
    when: EvaluateAny(candidates)
    requires: candidates.any(candidate => candidate.is_truthy)
    ensures: AnyResult(value: first_truthy(candidates))
}

rule AnyProducesNoneWhenNothingIsTruthy {
    when: EvaluateAny(candidates)
    requires: not candidates.any(candidate => candidate.is_truthy)
    ensures: AnyResult(value: none_value())
}

rule AllProducesLastValueWhenNothingIsFalse {
    when: EvaluateAll(candidates)
    requires: candidates.all(candidate => candidate.is_truthy)
    ensures: AllResult(value: last_value(candidates))
}

rule AllProducesNoneOnFirstFalsehood {
    when: EvaluateAll(candidates)
    requires: not candidates.all(candidate => candidate.is_truthy)
    ensures: AllResult(value: none_value())
}

-- Both stop at the point the answer is known. An expression after the
-- deciding one is never evaluated, which is what lets
-- `all [string? a string? b append a b]` guard the append.
rule AnyAndAllStopWhenDecided {
    when: EvaluateAny(candidates)
    ensures: EvaluatedCandidates(count: decisive_position(candidates))
}

-- === Arithmetic ============================================

rule ArithmeticRaisesOnOverflow {
    when: EvaluateArithmetic(operation, left, right)
    requires: overflows(operation, left, right)
    ensures: ArithmeticFailed(failure: overflow)

    @guidance
        -- The JVM wraps silently, which is the worst available behaviour
        -- because a wrong answer looks like a right one. Every integer
        -- operation is checked.
}

-- Arithmetic on a pair is arithmetic on each half. Where the other side
-- is a single number rather than a pair, that number applies to both
-- halves, so 1x2 + 1 is 2x3 and 1x2 * 2 is 2x4. This is the only place
-- where an operand is spread across a value rather than widened to meet
-- it, and it is why a pair is not simply a two-item block.
rule PairArithmeticAppliesToEachHalf {
    when: EvaluateArithmetic(operation, left, right)
    requires: is_pair(left) or is_pair(right)
    ensures: ArithmeticResult(
        x: apply(operation, x_of(left), x_of(right)),
        y: apply(operation, y_of(left), y_of(right)))
}

-- The other side must be a pair or a plain number. Anything else is a
-- math-args failure rather than being read as one somehow, so
-- `1x1 + "a"` and `1x1 + 0:0:1` both raise.
rule PairArithmeticTakesAPairOrANumber {
    when: EvaluateArithmetic(operation, left, right)
    requires: is_pair(left)
    requires: not (is_pair(right) or is_integer(right)
        or is_decimal(right) or is_percent(right))
    ensures: ArithmeticFailed(failure: cannot_use)
}

-- Dividing or taking a remainder by a zero half raises, and the guard is
-- on either half rather than on both, so `1x1 / 1x0` raises although the
-- x half would have divided cleanly.
rule PairDivisionByAZeroHalfRaises {
    when: EvaluateArithmetic(operation, left, right)
    requires: operation in {divide, remainder}
    requires: is_pair(left)
    requires: x_of(right) = 0 or y_of(right) = 0
    ensures: ArithmeticFailed(failure: zero_divide)
}

-- AND, OR and XOR are bit operations, so each half is rounded to a whole
-- number first and the answer is a pair of whole numbers. The rounding is
-- to the nearest, halves going up, which is why `16x15.6 or 16x4` is
-- 16x20: the 15.6 becomes 16, and 16 or 4 is 20.
--
-- Rounding rather than truncating is the whole of it. Truncating gives
-- 15 for that half, and 15 or 4 is 15, so the answer would be 16x15 and
-- look near enough right to survive review.
rule PairBitOperationsRoundEachHalfFirst {
    when: EvaluateLogicOperation(operation, left, right)
    requires: operation in {bitwise_and, bitwise_or, bitwise_xor}
    requires: is_pair(left)
    ensures: LogicResult(
        x: apply(operation, round_half_up(x_of(left)), round_half_up(x_of(right))),
        y: apply(operation, round_half_up(y_of(left)), round_half_up(y_of(right))))
}

-- EVEN? and ODD? round each half the same way before asking, so
-- `odd? 1.1x2.9` is true -- the 2.9 rounds to 3. A pair is odd when both
-- halves are odd and even when both are even, so one of each is neither.
rule PairParityRoundsEachHalfFirst {
    when: EvaluatePredicate(predicate, subject)
    requires: predicate in {is_odd, is_even}
    requires: is_pair(subject)
    ensures: PredicateHolds(
        holds: holds(predicate, round_half_up(x_of(subject)))
            and holds(predicate, round_half_up(y_of(subject))))
}

-- A path may write a half, and the pair the word holds changes. Rebol
-- writes through the value in place; a language with immutable pairs has
-- to put a new pair back in the word, and either way `p: 1x1  p/x: 0`
-- leaves p as 0x1.
rule WritingAPairHalfChangesThePairTheWordHolds {
    when: EvaluateSetPath(target, segment, written)
    requires: is_pair(value_of(target))
    requires: segment in {x, y, 1, 2}
    requires: is_integer(written) or is_decimal(written)
    ensures: SetPathResult(
        target_holds: pair_with_half_replaced(value_of(target), segment, written))
}

-- Writing anything but a number into a half is refused, and so is writing
-- to the derived area, which has nothing to write to. Both are
-- bad-path-set rather than bad-path-type: the path is fine and the write
-- is not.
rule WritingANonNumberIntoAPairHalfIsRefused {
    when: EvaluateSetPath(target, segment, written)
    requires: is_pair(value_of(target))
    requires: segment = area or not (is_integer(written) or is_decimal(written))
    ensures: SetPathFailed(failure: bad_path_set)
}

-- A pair answers to three word spellings and two positions, and nothing
-- else. `p/z` and `p/3` are refused, and the failure names the path
-- rather than the write.
rule APairHasThreeNamedSegments {
    when: EvaluatePath(target, segment)
    requires: is_pair(value_of(target))
    requires: not (segment in {x, y, area, 1, 2})
    ensures: PathFailed(failure: invalid_path)
}

-- p/area is the size of the rectangle the pair describes, so it is never
-- negative: the two halves are multiplied and the sign is dropped.
-- `(-10x20)/area` is 200.0 and so is `10x20`'s.
rule PairAreaIsAbsolute {
    when: EvaluatePath(target, area)
    requires: is_pair(value_of(target))
    ensures: PathResult(value: absolute(x_of(target) * y_of(target)))
}

-- RANDOM of a pair randomises each half between one and that half read as
-- a whole number, so the answer is always a pair of whole numbers. An
-- infinite half is still randomised rather than refused, and the answer is
-- finite, which is the only way `random as-pair 1e300 -1e300` can be a
-- pair at all.
rule RandomOfAPairRandomisesEachHalf {
    when: EvaluateRandom(subject)
    requires: is_pair(subject)
    ensures: RandomResult(is_pair: true, x_is_finite: true, y_is_finite: true)
}

-- Two pairs are equal when both halves are. They are ordered on the first
-- half alone, and the second half is looked at only to break a tie, so
-- 1x2 < 2x1 is true: the x halves settle it before the y halves are
-- reached. That makes < a total order over pairs.
--
-- Both-halves-must-agree was what JEBOL did until Cmp_Pair was read. It is
-- the rule the equality gets and not the one the ordering gets, and it
-- answers false for 1x2 < 2x1 where Rebol answers true.
rule PairEqualityNeedsBothHalves {
    when: EvaluateComparison(request)
    requires: request.strictness in {equal, equiv, strict_equal}
    requires: is_pair(request.left) and is_pair(request.right)
    ensures: ComparisonHolds(
        holds: x_of(request.left) = x_of(request.right)
            and y_of(request.left) = y_of(request.right))
}

rule PairOrderingBreaksTheTieOnTheSecondHalf {
    when: EvaluateComparison(request)
    requires: request.strictness in {greater_or_equal, greater}
    requires: is_pair(request.left) and is_pair(request.right)
    ensures: ComparisonHolds(
        holds: if x_of(request.left) != x_of(request.right):
                holds(request.strictness, x_of(request.left), x_of(request.right))
            else: holds(request.strictness, y_of(request.left), y_of(request.right)))
}

-- === CASE walks a block two values at a time ===============

-- CASE reads its block as condition, branch, condition, branch, and the
-- interesting rules are all about what happens when that pattern runs out
-- or is not followed.
--
-- A condition that is false skips the next value without evaluating it. A
-- condition that is truthy has the next value evaluated, and then that
-- value is run only if it turned out to be a block. So `case [true 1]` is
-- 1: a branch that is not a block is its own answer rather than a mistake.
--
-- And a truthy condition with nothing after it at all answers logic true.
-- That is the rule worth writing down, because it is what makes a trailing
-- expression a default clause whose side effect is the point. Rebol's own
-- CLEAN-PATH ends with
--
--     case [ ... test [branch] ... file: append what-dir file ]
--
-- where the last entry is a condition, has no block, and is there to be
-- evaluated for its assignment. An implementation that refuses it stops
-- CLEAN-PATH from loading, and CLEAN-PATH is in the file every other file
-- function comes from.
rule ATruthyConditionWithNoBranchAnswersTrue {
    when: EvaluateCase(entries)
    requires: first_truthy_condition_is_last(entries)
    ensures: CaseResult(value: true)
}

rule AFalseConditionSkipsItsBranchWithoutEvaluatingIt {
    when: EvaluateCase(entries)
    requires: entries.any(entry => not entry.condition.is_truthy)
    ensures: CaseResult(branches_evaluated: 0)
}

-- A branch is evaluated once as a value, and run a second time only if it
-- turned out to be a block. So a bare value branch answers itself.
rule ABranchThatIsNotABlockIsItsOwnAnswer {
    when: EvaluateCase(entries)
    requires: taken_branch_of(entries) != null
    requires: not is_block(taken_branch_of(entries))
    ensures: CaseResult(value: taken_branch_of(entries))
}

-- === Asking an object for a word it may not have ==========

-- IN answers none for a word the object does not hold, rather than refusing.
-- That is what makes `any [get in obj 'field  default]` the ordinary way to
-- read an optional field, and Rebol's own MAKE-PORT* reads its awake handler
-- exactly that way.
--
-- Refusing instead breaks the idiom at the first missing field, and the
-- refusal reads as a bad path rather than as an absent field.
rule AskingForAWordAnObjectHasNotGotAnswersNone {
    when: EvaluateCall(in_context, object, word)
    requires: not object.holds(word)
    ensures: CallResult(value: none)
}

-- An error, a port and a module answer IN as an object does, because each is
-- an object underneath. `in err 'id` gives the word bound to the error, and a
-- module answers for the words it defines.
--
-- The module case is what makes IN usable on Rebol's own library, where a
-- codec is a module and asking it whether it has a word is how the registry
-- finds out.
rule EveryKindOfObjectAnswersInTheSameWay {
    when: EvaluateCall(in_context, subject, word)
    requires: is_any_object(subject)
    ensures: CallResult(value: word_bound_to(subject, word))
}

-- A paren is refused. R3's declaration takes any-object! and block!, and a
-- paren is neither, so it raises rather than being searched the way a block
-- is.
--
-- Worth pinning because a paren is a block family series and the block arm
-- sits right beside it, so accepting one is the natural mistake. It would
-- give `in (obj1 obj2) 'field` a meaning R3 does not give it.
rule AParenIsNotSomethingInReachesInto {
    when: EvaluateCall(in_context, subject, word)
    requires: is_paren(subject)
    ensures: CallFails(error: expect_arg, about: subject)
}

-- IN with a block for its first argument searches the block. It reads each
-- item, looks a word up as it goes, and answers the first item that is an
-- object holding the wanted word. No such item answers none, and a second
-- argument that is not a word raises.
--
-- This is how code asks a list of objects which of them owns a field.
rule InSearchesABlockOfObjects {
    when: EvaluateCall(in_context, subject, word)
    requires: is_block(subject) and is_word(word)
    ensures: CallResult(
        value: first_object_in(subject, that_holds: word).word_bound_to(word))
}

-- IN with a block for its SECOND argument is a different function under the
-- same name. It binds that block into the object, deeply, and answers the
-- block. Nothing is read and nothing is searched for.
--
-- The two forms are told apart by which argument is the block, which is why
-- reading the specification as "IN takes an object and a word" gets one of
-- them wrong. Rebol's C calls this one "Special form: IN object block".
rule InWithABlockBindsThatBlockAndAnswersIt {
    when: EvaluateCall(in_context, subject, block)
    requires: is_object(subject) and is_block(block)
    ensures: CallResult(value: block, block_is_bound_to: subject)
}

-- GET of anything that is not a word, a path or an object answers that thing.
-- `get 5` is 5 and `get "a"` is "a". The C's last branch is one line:
-- `else val = word;`
--
-- That is the general rule, and GET of none answering none is one case of it
-- rather than a rule of its own. Writing only the none case leaves `get 5`
-- refusing a number for no reason a caller can see.
rule GettingAnythingElseAnswersItself {
    when: EvaluateCall(get, subject)
    requires: not (is_any_word(subject) or is_path(subject) or is_object(subject))
    ensures: CallResult(value: subject)
}

-- GET of a path evaluates the path.
rule GettingAPathEvaluatesIt {
    when: EvaluateCall(get, subject)
    requires: is_path(subject)
    ensures: CallResult(value: result_of(subject))
}

-- GET of an object answers a block of its values, and SELF is not among them.
-- Every object holds SELF and it points back at the object, thus a block that
-- carried it could not be printed.
rule GettingAnObjectAnswersItsValues {
    when: EvaluateCall(get, subject)
    requires: is_object(subject)
    ensures: CallResult(value: field_values_of(subject, excluding: self))
}

-- === Defining a function ====================================

-- A function's spec is checked when the function is made, not when it is
-- called. So a malformed spec raises at the definition and never becomes a
-- function that fails later, which is where a script wants the complaint:
-- beside the definition that is wrong rather than at the first call site,
-- which may be a different file.
--
-- FUNC, FUNCTION and MAKE FUNCTION! all reach one check, because R3 builds
-- the first two on the third. So everything here holds however the function
-- was written.

-- A `return:` annotation must be followed by a block, which is the return
-- type it declares. With nothing after it, or a non-block after it, it is no
-- definition and the whole spec is refused with bad-func-def.
--
-- `return:` says what the function answers, and its block is the declared
-- type of that answer. `func [return:]` names an answer and never says what
-- it is, and `func [return: ""]` puts a string where the type block belongs;
-- neither is a spec a function can be built from.
--
-- The error carries the whole spec block as its first argument, not the
-- offending word alone. A caller reading it gets the definition it wrote
-- back, which is what a person needs to see to find the mistake in it.
rule AReturnAnnotationWithoutATypeBlockIsRefused {
    when: EvaluateCall(verb, spec, body)
    requires: verb in {func, function}
    requires: spec_has_a_return_not_followed_by_a_block(spec)

    ensures: CallFails(error: bad_func_def, about: spec)
}

-- No name in a spec's interface may appear twice, and a repeat raises
-- dup-vars naming the word that was repeated.
--
-- The interface, and only the interface: a parameter, a refinement and the
-- `return:` annotation all count, so `func [return: [] a return: []]` raises
-- dup-vars with arg1 `return`. The two `return:` annotations are the
-- collision even though each is well formed on its own.
--
-- A /local word is deliberately not covered, and the exemption is load-
-- bearing rather than a nicety. FUNCTION collects a body's set-words into
-- /local, and a body that assigns the same name in two branches hands the
-- builder that name twice through no fault of the author. A real R3
-- tolerates a repeat among the collected locals for exactly this reason, so
-- the check is on what the caller wrote as the interface and not on what was
-- gathered from the body. Applying it to locals stopped the borrowed
-- prot-http.reb from loading until they were exempted.
--
-- Named rather than counted, so the caller is pointed at the word to rename
-- rather than told a count is wrong. A spec with a dozen parameters and one
-- accidental repeat is a needle the error hands over rather than one the
-- caller has to hunt for.
rule ASpecThatNamesAnInterfaceWordTwiceIsRefused {
    when: EvaluateCall(verb, spec, body)
    requires: verb in {func, function}
    requires: an_interface_name_appears_twice_in(spec)

    ensures: CallFails(error: dup_vars, about: the_repeated_interface_name(spec))
}

-- A well-formed `return:` builds and survives a round trip through SPEC-OF
-- unchanged. It is kept in the spec rather than stripped, so the function
-- remembers it was written with one and hands the same block back.
--
-- Kept and not acted on. The annotation is for a reader -- a person, or a
-- tool documenting the interface -- rather than for the evaluator, which
-- ignores it while running the function. So `spec-of :fun` gives back the
-- block that was written, `return:` and its type and all, and a function
-- defined with one is indistinguishable by its spec from how it was
-- written.
rule AWellFormedReturnAnnotationRoundTripsThroughSpecOf {
    when: EvaluateCall(spec_of, subject)
    requires: is_function(subject)

    ensures: CallResult(value: the_spec_the_function_was_defined_with(subject))
}

-- BODY-OF answers a copy of the function's body, deep enough that changing
-- the answer never reaches the function. So `clear second body-of :f` clears
-- the copy's string and the function still holds `[append "xx" s]`, and a
-- later `body-of :f` answers that block again.
--
-- A copy rather than the body itself, and deep rather than shallow, are two
-- claims and both matter. A shallow copy hands back a fresh block whose
-- elements still point into the function's own series, so clearing a string
-- inside it would reach through and empty the function's string -- which is
-- the case the suite tests, and the reason `Clone_Block` rather than
-- `Copy_Block`.
--
-- The equality still holds. A copy is equal to what it was copied from, so
-- `body-of :f` compares equal to the source body; what a caller must not
-- assume is that the two are the same series, and a mutation is where that
-- assumption shows.
rule BodyOfAnswersADeepCopyOfTheBody {
    when: EvaluateCall(body_of, subject)
    requires: is_function(subject)

    ensures: CallResult(value: a_deep_copy_of_the_body_of(subject))
    ensures: the_function_body_is_unchanged_by_mutating(the_answer)
}

-- MAKE from a native or an action prototype refuses a body. A native's
-- behaviour is C, so there is no REBOL body a MAKE could put in place of it,
-- and handing one over asks for something the datatype cannot hold:
-- `make :read [[][]]` raises.
--
-- The refusal is the second block, not the making. A native prototype with a
-- single spec block is derivation, and it works: it builds a new function
-- keeping the native's behaviour under a wider interface, which is exactly
-- how the mezzanine builds EMPTY? from TAIL? -- `make :tail? [[...spec...]]`
-- with none! added to the accepted set. What is refused is the shape with
-- two blocks, a spec and a body, because the body is the part a native has
-- nowhere to put.
--
-- So the two calls are one block apart and mean opposite things. A caller
-- reaching for the derivation and writing a body by habit gets a refusal
-- saying the value cannot be used that way, rather than a function that
-- silently ignored the body it was given.
--
-- Cannot-use rather than bad-make-arg, because the failure is the copy
-- routine rejecting a body for a value that has none, which the C reports
-- against the prototype. The two are worth keeping apart: bad-make-arg is
-- what the datatype form of the same mistake gives, and that difference is
-- recorded as an open question below.
rule MakingFromANativePrototypeWithABodyIsRefused {
    when: EvaluateCall(make, prototype, definition)
    requires: is_native(prototype) or is_action(prototype)
    requires: definition_supplies_a_body(definition)

    ensures: CallFails(error: cannot_use, about: definition)
}

-- === Making a module ========================================

-- MAKE MODULE! does not build the module. It hands the work to REBOL.
--
-- This is the second place JEBOL calls out of the host layer and back into
-- the loaded library, and R3 does the same thing in the same place. Its
-- Make_Module is four lines of C and one of them is
-- `Do_Sys_Func(SYS_CTX_MAKE_MODULE_P, spec, 0)`, which reaches MAKE-MODULE*
-- in sys-base.reb. MAKE PORT! is arranged the same way, through MAKE-PORT*
-- in sys-ports.reb.
--
-- Writing MAKE-MODULE* in the host language instead would be a fork of
-- ninety lines of Rebol's own code, and those ninety lines are where the
-- EXPORT and HIDDEN keywords in a module body are handled, where the header
-- is checked, and where the choice between a shared and an isolated
-- namespace is made. Every one of those is behaviour a script can observe,
-- so a second copy of it is a second set of answers.
rule MakingAModuleAsksTheLibraryToDoIt {
    when: EvaluateCall(make, module_datatype, spec)
    requires: is_block(spec)
    ensures: CallResult(value: result_of_calling(make_module_star, spec))
}

-- A spec the library cannot make a module from raises invalid-spec, and says
-- so about the spec rather than about the datatype.
--
-- MAKE-MODULE* answers none when the header will not do, and none is not a
-- module. Answering it would give the caller a value whose datatype is wrong
-- and no reason why.
rule ASpecThatMakesNoModuleRaisesInvalidSpec {
    when: EvaluateCall(make, module_datatype, spec)
    requires: result_of_calling(make_module_star, spec) = none
    ensures: CallFails(error: invalid_spec, about: spec)
}

-- TO MODULE! joins a header and a context that already exist.
--
-- MAKE-MODULE* finishes with `to module! reduce [spec context]`, so this is
-- not a convenience for scripts: it is the step that turns the object the
-- library has been filling in into a module. Both arguments must be objects,
-- and a block of any other shape is refused.
rule ToModuleJoinsAHeaderAndAContext {
    when: EvaluateCall(to, module_datatype, pair_of_objects)
    requires: is_block(pair_of_objects)
    requires: is_object(first_of(pair_of_objects))
    requires: is_object(second_of(pair_of_objects))
    ensures: CallResult(value: module_with(
        header: first_of(pair_of_objects),
        context: second_of(pair_of_objects)))
}

-- === Reading and writing the bits of a set =================

-- A path reads one bit of a bitset and answers a logic. A character the set
-- does not hold answers false and never none, which matters because the two
-- look alike in a condition and part company under NONE?.
rule ReadingABitOfASetAnswersALogic {
    when: EvaluatePath(target, selector)
    requires: is_bitset(target) and is_char(selector)
    ensures: PathResult(value: target.holds(selector))
}

-- Writing a bit minds the complement flag, and the flag inverts what true
-- means. A complemented set holds every character its octets do not name,
-- thus to put a character into one the octet for it must be cleared.
--
-- The inversion changes nothing for an ordinary set, which is why it is easy
-- to leave out and hard to notice.
rule WritingABitOfAComplementedSetInvertsIt {
    when: EvaluateSetPath(target, selector, written)
    requires: is_bitset(value_of(target)) and is_char(selector)
    ensures: SetPathResult(
        octet_set: if value_of(target).is_complemented:
                not written.is_truthy
            else: written.is_truthy)
}

-- APPEND and INSERT both put characters into a set, and they are one
-- operation under two names. A set has no front, so there is nowhere for
-- INSERT to put anything that APPEND would not have put it.
--
-- The C is explicit about it -- `case A_APPEND: case A_INSERT: diff = TRUE;
-- goto set_bits;` -- one arm and one label for the pair. What the argument
-- may be is what a bitset can be made from: a character, text whose
-- characters all become members, or a range written as a block.
--
-- The answer is the set itself rather than a position, for the same reason
-- INSERT means nothing here: there is no position in a set to answer with.
rule AppendingOrInsertingIntoASetAddsItsCharacters {
    when: EvaluateCall(verb, target, added)
    requires: is_bitset(target)
    requires: verb in {append, insert}

    ensures: CallResult(value: target)
    ensures: for character in the_characters_named_by(added):
        target.holds(character) = true
}

-- Adding to a complemented set inverts the sense, because holding is
-- inverted there. A complemented set holds every character its octets do not
-- name, so putting a character in means clearing the octet for it.
--
-- One line does it -- `if (BITS_NOT(VAL_SERIES(value))) diff = !diff;` -- and
-- it is the same inversion a write through a path goes through, reached from
-- the same label. Leaving it out gives a set that is right for every
-- ordinary case and exactly backwards for a complemented one.
rule AddingToAComplementedSetInvertsTheSense {
    when: EvaluateCall(verb, target, added)
    requires: is_bitset(target)
    requires: verb in {append, insert}
    requires: target.is_complemented

    ensures: for character in the_characters_named_by(added):
        the_octet_for(target, character) = cleared
}

-- Making a set from a block spreads a string member's characters, the same
-- as it spreads a char or an integer. So `charset ["abc"]` holds a, b and c,
-- and `find "abc" charset ["c"]` lands on the "c" rather than answering none.
--
-- Every any-string member spreads this way, not only a plain string: a file,
-- a url, an email, a tag and a ref each put their characters into the set,
-- because the C reads all of them through the same Set_Bit_Str. A char and
-- an integer name one code point each, and a `[a - b]` range names the run
-- between them.
--
-- Spreading is the point that was missed. A string member used to be dropped
-- and the set came out empty, so `charset ["c"]` held nothing and every
-- search through it answered none -- a set that silently matched nothing,
-- which reads as "not found" rather than as the malformed set it was.
rule MakingASetFromABlockSpreadsEachStringMembersCharacters {
    when: EvaluateCall(make, bitset_datatype, block)
    requires: is_block(block)

    ensures:
        for member in block:
            for character in the_characters_named_by(member):
                the_set_holds(character) = true
}

-- An argument that names no bits at all is refused, and the complaint is
-- about the argument. `if (Set_Bits(...)) break; Trap_Arg(arg);` -- the
-- refusal is what is left when the set could not read the request.
rule AddingSomethingThatNamesNoBitsIsRefused {
    when: EvaluateCall(verb, target, added)
    requires: is_bitset(target)
    requires: verb in {append, insert}
    requires: not names_any_bits(added)

    ensures: CallFails(error: invalid_arg, about: added)
}

-- REMOVE on a set clears members, and it must be told which ones. There are
-- two ways to say, and asking neither way is a failure rather than a
-- clearing of everything.
--
-- /key takes any value at all and clears the bits it names. /part takes a
-- range. Either says which members go, and the answer is the set.
--
-- Of an ordinary set. What removing from a complemented one does is an open
-- question below, because the C does not put REMOVE through the inversion
-- that APPEND, INSERT and a path write all go through.
rule RemovingFromASetClearsWhatItIsTold {
    when: EvaluateCall(remove, target)
    requires: is_bitset(target)
    requires: not target.is_complemented
    requires: refinement_asked(key) or refinement_asked(part)

    ensures: CallResult(value: target)
    ensures: for character in the_characters_the_refinement_names(target):
        target.holds(character) = false
}

-- Naming neither raises missing-arg, and the C's own comment says why:
-- "/key or /part is required".
--
-- Which is the right refusal rather than an obvious one. `remove some-set`
-- reads as "empty it", and a set that quietly emptied itself on a call that
-- said nothing about what to remove would be a hard mistake to find: the
-- call succeeds, the answer is the set, and everything after it looks at an
-- empty set without knowing when it emptied.
rule RemovingFromASetWithoutSayingWhatRaises {
    when: EvaluateCall(remove, target)
    requires: is_bitset(target)
    requires: not refinement_asked(key)
    requires: not refinement_asked(part)

    ensures: CallFails(error: missing_arg)
}

-- Naming both raises bad-refines. They are two ways of answering one
-- question and a caller that used both has not said which it meant.
rule RemovingFromASetBothWaysAtOnceIsRefused {
    when: EvaluateCall(remove, target)
    requires: is_bitset(target)
    requires: refinement_asked(key)
    requires: refinement_asked(part)

    ensures: CallFails(error: bad_refines)
}

-- The range /part is given must be a block, a string, a binary or a
-- character, and anything else is refused before any bit is touched.
--
-- Four kinds and no more, which is narrower than /key: that one takes any
-- value and reads what it can from it. So the two refinements differ in what
-- they accept as well as in nothing else, and a caller handed a value of
-- unknown shape should reach for /key.
rule TheRangeRemovedByPartMustBeOneOfFourKinds {
    when: EvaluateCall(remove, target, range)
    requires: is_bitset(target)
    requires: refinement_asked(part)
    requires: not is_block(range)
    requires: not is_string(range)
    requires: not is_binary(range)
    requires: not is_char(range)

    ensures: CallFails(error: invalid_arg, about: range)
}

-- /key on an ordinary series is not a feature any build offers. It means
-- something for a map and for a set, and for a block family series it walks
-- two at a time looking for a key; on a string or a binary there are no keys
-- to look for and the call raises feature-na.
--
-- Rebol's own series-test.r3 asserts the id directly on line 1607:
-- `remove/key "abcd" #"a"` gives an error whose id is feature-na. Not
-- invalid-arg, which is what a reading where the argument was at fault would
-- give: the argument is fine and the combination does not exist.
rule RemoveKeyOnAnOrdinarySeriesIsNotAFeature {
    when: EvaluateCall(remove, target)
    requires: is_series(target)
    requires: not is_bitset(target)
    requires: not is_map(target)
    requires: not is_block(target)
    requires: refinement_asked(key)

    ensures: CallFails(error: feature_na)
}

-- COMPLEMENT on a binary answers a new binary with every byte flipped, and
-- leaves the one it was given alone.
--
-- `Make_Binary` and then `*out++ = ~ *str++`, so the bytes are built rather
-- than changed in place. It reads from where the binary stands, not from its
-- head, so `complement next #{0102}` is `#{FD}` -- one byte, because only one
-- was in front of it.
--
-- The same verb on a set answers a new set too, by copying the series and
-- flipping the complement flag on the copy. So both leave their argument
-- alone, and what differs is what flipping means: a binary gets new bytes and
-- a set gets a flag saying to read the same octets the other way round.
rule ComplementingABinaryAnswersNewBytes {
    when: EvaluateCall(complement, subject)
    requires: is_binary(subject)

    ensures: CallResult(value: every_byte_flipped_from_here(subject))
    ensures: subject_is_unchanged(subject)
}

-- COMPLEMENT on an image answers a new image with every channel of every
-- pixel flipped, and leaves the original alone. The same shape the binary
-- arm has, over a different unit.
--
-- Alpha included, which is the half worth stating. Flipping the three colour
-- channels and leaving the transparency is the reading that produces a
-- picture a person would call inverted, and it is not what happens: an
-- opaque image complements to a transparent one. Anything relying on the
-- inverse being an inverse depends on it, since flipping every channel twice
-- is what gets the original back.
rule ComplementingAnImageFlipsEveryChannelIncludingAlpha {
    when: EvaluateCall(complement, subject)
    requires: is_image(subject)

    ensures: CallResult(value: every_channel_of_every_pixel_flipped(subject))
    ensures: subject_is_unchanged(subject)
}

-- === Asking about a file, a date or a handle ===============

-- QUERY asks the host what it knows about a file, and the shape of its
-- second argument decides the shape of the answer. Three shapes, three
-- answers, and the third is the one nobody guesses.
--
-- A word asks for one fact and answers it bare: `query %a 'size` is a
-- number.
--
-- None asks for everything and answers an object, whose fields are the six
-- facts plus `date` as a second name for `modified`.
--
-- A block asks for several and answers a block -- and whether each fact is
-- labelled depends on how the word was written. A plain word puts itself
-- in the answer as a set-word before its value; a get-word contributes the
-- value alone. So `query %a [type size]` is `[type: file size: 1234]` and
-- `query %a [:type :size]` is `[file 1234]`, and the two may be mixed:
-- `query %a [type: :size]` is `[type: file 1234]`.
--
-- That last rule is what makes QUERY worth specifying rather than
-- guessing. Reading the block as a plain list of fields gives the
-- get-word form for every call, and the labelled form is the one a caller
-- reading the answer by name depends on.
enum QueryShape {
    one_field       -- a word: the fact alone
    | several       -- a block: a block, labelled or not, word by word
    | everything    -- none: an object of all six facts
}

rule QueryingWithAWordAnswersTheFactAlone {
    when: EvaluateQuery(target, field)
    requires: is_word(field)
    ensures: QueryResult(shape: one_field, value: fact_of(target, field))
}

rule QueryingWithNoneAnswersAnObject {
    when: EvaluateQuery(target, field)
    requires: field = none
    ensures: QueryResult(shape: everything, is_object: true)
}

rule QueryingWithABlockLabelsAPlainWordAndNotAGetWord {
    when: EvaluateQuery(target, field)
    requires: is_block(field)
    ensures: QueryResult(
        shape: several,
        items: field.flat_map(word =>
            if is_get_word(word): [fact_of(target, word)]
            else: [as_set_word(word), fact_of(target, word)]))
}

-- A field the host does not report is refused rather than answered none,
-- because a misspelled field name is a mistake in the script and a script
-- that got none for it would read the mistake as a missing file.
--
-- The six names are size, type, date, modified, accessed and created, plus
-- name. DATE and MODIFIED are the same fact under two names, which is why
-- there are seven names for six facts.
rule QueryingAnUnknownFieldRaises {
    when: EvaluateQuery(target, field)
    requires: is_word(field) or is_block(field)
    requires: not every_named_field_is_known(field)
    ensures: QueryFailed(failure: invalid_arg)
}

-- Anything in the block that is not a word at all raises the same way. A
-- block of fields is a block of names, and a number in it is not a name
-- that happens to be unknown.
rule QueryingWithANonWordInTheBlockRaises {
    when: EvaluateQuery(target, field)
    requires: is_block(field)
    requires: field.any(item => not is_word(item))
    ensures: QueryFailed(failure: invalid_arg)
}

-- SIZE? and MODIFIED? are QUERY with the field already chosen, which is how
-- Rebol writes them: one line each. Writing them as their own host calls
-- would give two more places for the boundary to be crossed and two more
-- chances for them to disagree with QUERY.
rule SizeAndModifiedAreQueryWithTheFieldChosen {
    when: EvaluateCall(function, target)
    requires: function in {size_of, modified_of}
    ensures: CallResult(value: fact_of(target,
        if function = size_of: size else: modified))
}

-- The type field is a word rather than a logic, and it is `dir` or `file`.
-- EXISTS? answers the same two words rather than true, which is the trap:
-- `if exists? %a [...]` takes the branch for a directory as readily as for
-- a file, because both words are truthy, and code that wanted to know
-- which has to compare.
-- A datatype as the field asks for everything, exactly as none does. So
-- `query %a file!` answers the whole information object.
--
-- Four kinds of field argument and no more: a word, a block, none and a
-- datatype. The get-word and lit-word JEBOL used to declare are gone, and
-- their absence is the point rather than a narrowing. A get-word at a call
-- site is evaluated before QUERY is reached, so QUERY never sees one and
-- declaring it accepted a value no real call could deliver. The get-words
-- that do reach QUERY arrive inside a block, where they are read as written
-- rather than evaluated, and the block arm above is what handles them.
rule QueryingWithADatatypeAnswersEverything {
    when: EvaluateQuery(target, field)
    requires: is_datatype(field)
    ensures: QueryResult(shape: everything, is_object: true)
}

-- QUERY takes more than a file. A date, a handle, a port, a url, a block and
-- a word are all accepted targets, and the four field shapes above work the
-- same way for each: a word asks one part, a block asks several, none and a
-- datatype ask for everything.
--
-- The shapes are QUERY's and the parts belong to the target, which is what
-- makes one function serve six datatypes. What differs between them is only
-- which names there are to ask for.
--
-- The scheme targets are the exception, and they do not answer at all: a url
-- or a word naming a scheme routes to a scheme this host does not serve, and
-- refuses as READ and WRITE do.
rule QueryAsksTheSameFourShapesOfEveryTargetItTakes {
    when: EvaluateQuery(target, field)
    requires: is_date(target) or is_handle(target)

    ensures: QueryResult(shape: the_shape_asked_for(field))
}

-- A date answers its fourteen parts, the same ones a path reads off it:
-- year, month, day, time, date, zone, hour, minute, second, weekday,
-- yearday, timezone, utc and julian.
--
-- With one difference from a file worth pinning. None asks a file for
-- everything and gets an object; none asks a date for everything and gets
-- the part NAMES, as a block of words. So the same call shape answers a
-- record for one target and an index of what could be asked for the other,
-- and a caller that reads the answer as an object finds words instead.
--
-- The word `words` asks for the names too, which gives a caller a way to say
-- what it means rather than relying on the none form doing something
-- unobvious.
rule QueryingADateWithNoneOrWordsAnswersThePartNames {
    when: EvaluateQuery(target, field)
    requires: is_date(target)
    requires: field = none or field = words

    ensures: QueryResult(value: block_of(the_part_names_of(target)))
}

-- A part no date has raises cannot-use, where a path reading the same part
-- answers none.
--
-- The two are asking different questions and it is right that they differ. A
-- path walks into a value and finding nothing there is an answer; QUERY is
-- handed a name and told to fetch it, so a name that is not a part is a
-- mistake in the call rather than an absence in the date.
rule QueryingADateForAPartItHasNotGotRaises {
    when: EvaluateQuery(target, field)
    requires: is_date(target)
    requires: not names_a_part_of(target, field)

    ensures: QueryFailed(failure: cannot_use)
}

-- A handle answers one part, `type`, in the same four shapes. One part is
-- still a set worth asking about by name, because the shapes are the same
-- and code that walks a target's parts does not have to special-case it.
rule QueryingAHandleAnswersItsTypeAlone {
    when: EvaluateQuery(target, field)
    requires: is_handle(target)

    ensures: QueryResult(value: the_type_of_the_handle(target))
}

rule TheTypeFieldIsAWord {
    when: EvaluateQuery(target, type)
    ensures: QueryResult(value: if is_directory(target): dir else: file)
}

-- === Reading a file ========================================

-- READ answers a file's bytes. Not its text: a binary, holding exactly what
-- was stored, and /string is how a caller asks for text instead.
--
-- JEBOL answers a string today, which is drift from the C rather than a
-- decision, and the code will be corrected to match what follows. It is the
-- expensive direction to be wrong in. A read that decodes without being
-- asked corrupts every file that is not text, and it corrupts it silently:
-- an image read as text comes back as a string of replacement characters
-- that compares, molds and writes back as if it were fine.
--
-- Reading needs the files service, as every host call needs its own.
-- embed.allium says what a host grants and what a refusal looks like.

rule APlainReadAnswersTheBytes {
    when: EvaluateFileRead(request)
    requires: not request.decodes_the_bytes

    ensures: CallResult(value: the_bytes_read(request))
}

-- /binary is that same answer asked for outright, and its stated purpose in
-- Rebol's own declaration is "preserves contents exactly".
--
-- Worth having even though it changes nothing, because it says what the
-- caller meant. A read that must not be decoded reads the same either way,
-- and the refinement is how the next person to touch the code learns that
-- the bytes were the point.
rule TheBinaryRefinementIsThePlainAnswerAskedForOutright {
    when: EvaluateFileRead(request)
    requires: request.answers_bytes_outright
    requires: not request.decodes_the_bytes

    ensures: CallResult(value: the_bytes_read(request))
}

-- /string decodes the bytes as UTF text and standardises the line endings on
-- the way: a carriage return and line feed together become one line feed.
--
-- So a file written on one system reads the same on another, which is what
-- "standard text string" means in the declaration. Rebol's own port-test.r3
-- has it both ways on lines 270 to 276: the same file read plainly is
-- "a^M^/b^/c" and read with /string is "a^/b^/c", and the plain read passed
-- through DELINE gives the second, which is the same conversion done later.
rule TheStringRefinementDecodesAndStandardisesLineEndings {
    when: EvaluateFileRead(request)
    requires: request.decodes_the_bytes
    requires: the_bytes_decode(request)

    ensures: the_text_read(request) =
        with_line_endings_standardised(decoded_as_utf_text(the_bytes_read(request)))
}

-- Which encoding is decided by the marks in the bytes. A UTF-8 byte order
-- mark is taken off and the rest read as UTF-8; UTF-16 with a mark of either
-- endianness is decoded by it.
--
-- The mark is a statement about the bytes rather than part of the text, so
-- leaving it in gives a first character nothing a script writes can match,
-- and it survives every comparison looking like an ordinary string.
rule TheByteOrderMarkDecidesTheEncodingAndIsNotPartOfTheText {
    when: EvaluateFileRead(request)
    requires: request.decodes_the_bytes
    requires: the_bytes_decode(request)

    ensures: the_text_read(request) =
        decoded_by_the_mark_and_without_it(the_bytes_read(request))
}

-- Bytes that do not decode come back as bytes. The answer is the binary a
-- plain read would have given, exactly as stored, rather than a failure and
-- rather than text with the bad bytes replaced.
--
-- The C returns from the decoder with nothing and leaves the binary standing:
-- `ser = Decode_UTF_String(...); if (!ser) return;`. So /string is a request
-- that may not be honoured, and a caller has to look at what came back rather
-- than assume it asked for text and got text.
--
-- This settles the awkward case the bound creates as well. /part counts bytes
-- and the decoding happens afterwards, so a bound that cuts a character in
-- half leaves bytes that do not decode, and the answer is those bytes. No
-- special rule is needed for it: it is this rule reached by a different
-- route, and a reading where a cut character is a failure would refuse a call
-- that a real Rebol answers.
rule BytesThatDoNotDecodeComeBackAsBytes {
    when: EvaluateFileRead(request)
    requires: request.decodes_the_bytes
    requires: not the_bytes_decode(request)

    ensures: CallResult(value: the_bytes_read(request))
}

-- /lines asks for /string without naming it, and then splits the text into a
-- block of its lines. The terminator belongs to no line: it ends the one
-- before it and does not appear in it.
rule LinesImpliesStringAndSplitsTheTextIntoABlock {
    when: EvaluateFileRead(request)
    requires: request.answers_lines

    ensures: CallResult(value: block_of(the_lines_of(the_text_read(request))))
}

-- A terminator ends the line before it and does not begin a new one. So a
-- file ending in a single line feed has no empty line after its last, and a
-- file ending in two has exactly one.
--
-- Rebol's own port-test.r3 pins the awkward case on lines 259 and 260:
-- `write/lines %tmp.txt {a^/}` puts "a^/^/" in the file and `read/lines` of
-- it is ["a" ""]. Two terminators, two lines, and the second is empty. A
-- reading where every terminator starts a fresh line gives three, with a
-- second empty one nobody wrote.
--
-- So the count is one line per terminator, and one more only when text
-- follows the last of them. Stated the other way round -- one more unless
-- the text ends with a terminator -- it gives an empty file one empty line
-- instead of none, which is the boundary the C settles with `if (idx >
-- start)` and worth its own test.
rule ATerminatorEndsALineAndDoesNotBeginANewOne {
    when: EvaluateFileRead(request)
    requires: request.answers_lines

    ensures: the_lines_of(the_text_read(request)).count =
        the_number_of_terminators_in(the_text_read(request))
            + if any_text_follows_the_last_terminator(request): 1 else: 0

    @guidance
        -- A carriage return ends a line as readily as a line feed does, and
        -- the two together end one line rather than two. Usually moot,
        -- because /string has already turned every pair into a single feed,
        -- but a file holding a lone carriage return still splits there.
}

-- /seek skips that many bytes before reading, counted from the start of the
-- file.
rule ASeekOnAReadSkipsThatManyBytes {
    when: EvaluateFileRead(request)
    requires: request.position_asked_for != null

    ensures: where_the_read_starts(request) =
        the_smaller_of(request.position_asked_for, size_of_the_file(request.source))
}

-- A seek past the end of the file is clipped back to the size, so the read
-- answers nothing rather than failing.
--
-- `if (cnt > file->file.size) cnt = file->file.size` in Set_Seek, the same
-- one line a write goes through. Which makes the two ends of a seek behave
-- differently on purpose: past the end is an empty answer, and before the
-- beginning is a failure.
rule ASeekPastTheEndAnswersNothing {
    when: EvaluateFileRead(request)
    requires: request.position_asked_for != null
    requires: request.position_asked_for > size_of_the_file(request.source)

    ensures: the_bytes_read(request).count = 0
}

-- A negative seek position is refused. `Int64s(arg, 0)` takes a floor of
-- zero and raises out-of-range below it, exactly as it does for a write.
rule ANegativeSeekPositionOnAReadIsRefused {
    when: EvaluateFileRead(request)
    requires: request.position_asked_for != null
    requires: request.position_asked_for < 0

    ensures: CallFails(error: out_of_range, about: request.position_asked_for)
}

-- /part bounds the read in bytes, counted forward from where the read
-- starts. Bytes and not characters, whatever shape the answer takes: the
-- bound is applied to what is read and the decoding happens afterwards, so a
-- bound of three on text that is not ASCII may cut a character in half. What
-- comes back then is the bytes, by the rule above about bytes that do not
-- decode; the bound needs no case of its own for it.
rule TheReadBoundIsInBytes {
    when: EvaluateFileRead(request)
    requires: request.bytes_permitted != null
    requires: not request.reads_backwards

    ensures: the_bytes_read(request).count =
        the_smaller_of(request.bytes_permitted, what_remains_from(request))
}

-- A bound larger than what remains reads what remains, rather than failing
-- or padding. So a caller who does not know a file's size can ask for more
-- than it can possibly hold and get all of it.
rule AReadBoundLargerThanWhatRemainsReadsWhatRemains {
    when: EvaluateFileRead(request)
    requires: request.bytes_permitted != null
    requires: not request.reads_backwards
    requires: request.bytes_permitted > what_remains_from(request)

    ensures: the_bytes_read(request).count = what_remains_from(request)
}

-- A negative bound reads backwards from the seek position. It is not a
-- refusal and not a bound of zero: the read moves back by that many bytes
-- and lengthens by the same amount, so `read/seek/part %f 5 -2` answers the
-- two bytes before position five.
--
-- The C does it in three lines, and reading them as a validation rather than
-- as a movement is the mistake to avoid:
--
--     cnt = -cnt;
--     if (cnt > file->file.index) Trap1(RE_OUT_OF_RANGE, ...);
--     file->file.index -= cnt; len += cnt;
--
-- It reads as arithmetic on the position, which is what it is. A negative
-- /part is how a caller reads what it has just gone past, and the whole
-- reason /seek and /part have to be described together.
rule ANegativeBoundReadsBackwardsFromTheSeekPosition {
    when: EvaluateFileRead(request)
    requires: request.reads_backwards
    requires: how_far_back(request) <= where_the_read_starts(request)

    ensures: the_bytes_read(request) = the_bytes_before(
        where_the_read_starts(request), how_far_back(request))
}

-- Reading backwards past the start of the file is refused.
--
-- Which makes any negative bound without a /seek a refusal, because the read
-- starts at zero and there is nothing behind it. So `read/part %f -1` always
-- raises and `read/seek/part %f 5 -6` does too, and both for the same
-- reason: there are not that many bytes behind where the read stands.
rule ReadingBackwardsPastTheStartIsRefused {
    when: EvaluateFileRead(request)
    requires: request.reads_backwards
    requires: how_far_back(request) > where_the_read_starts(request)

    ensures: CallFails(error: out_of_range, about: request.bytes_permitted)
}

-- /all is accepted and changes nothing for a file. A file has no response
-- metadata to include, so there is nothing extra for it to ask for.
--
-- Accepted rather than refused, because the refinement belongs to READ
-- rather than to any one scheme, and a script that names it for a URL and
-- then runs the same code over a file should not stop.
rule TheAllRefinementChangesNothingForAFile {
    when: EvaluateFileRead(request)
    requires: request.asked_for_all

    ensures: CallResult(value: what_the_same_read_without_all_answers(request))
}

-- Reading a directory answers a block of the names in it, rather than bytes.
-- What decides it is what is actually there, not how the path was spelled,
-- so `read %somewhere` lists a directory as readily as `read %somewhere/`
-- does.
--
-- The trailing slash is a hint and not the test. R3 asks the operating
-- system, and its own comment in MAKE-PORT* says so of the `dir?/check` it
-- uses: the path does not have to end with a slash. A reading where the
-- slash is the whole distinction answers bytes for `read %somewhere` and
-- fails on a directory, which is the wrong answer for the spelling most
-- people write.
--
-- The consequence a caller has to live with is that the datatype of the
-- answer depends on the filesystem rather than on the call. The same
-- expression gives a binary today and a block tomorrow if a file is replaced
-- by a directory of the same name.
rule ReadingADirectoryAnswersItsNames {
    when: EvaluateFileRead(request)
    requires: host_has_a_directory_at(request.source)

    ensures: CallResult(value: block_of(the_names_within(request.source)))
}

-- === Writing a file ========================================

-- WRITE has nine refinements and four of them change what happens: /part
-- bounds how much of the data is written, /seek says where in the file to
-- put it, /append puts it at the end, and /lines puts one value on each
-- line. Sorting the nine into those four and the other five is most of
-- what there is to get right here.
--
-- Three of the remaining five are accepted and do nothing. /binary has
-- nothing to switch on, because the branch that would have re-encoded a
-- string on the way out is commented out. /allow's access modes never
-- reach the write. /all is never tested. All three are still accepted, so
-- a script written against a port that does use them still runs against a
-- file.
--
-- The other two of the nine are the two arguments, which belong to /part
-- and /seek rather than being refinements in their own right.
--
-- This section covers a file destination, which is the only kind JEBOL
-- serves. WRITE also takes a url!, a port! and a block of them, and each
-- of those is a different handler with answers of its own.
--
-- Writing needs the files service, exactly as every other host call does.
-- embed.allium says what a host grants and what a refusal looks like, and
-- none of it is different here.

-- A plain write replaces the file. It is created new and whatever was in
-- it is gone, which makes this the only form that truncates.
--
-- One line of the C decides it, where the file is opened for the write:
--
--     if (args & AM_WRITE_SEEK || args & AM_WRITE_APPEND) nargs |= AM_OPEN_SEEK;
--     else nargs |= AM_OPEN_NEW;
--
-- So there is no truncating refinement to look for. Truncation is what is
-- left when nobody said where to write.
rule APlainWriteReplacesTheFile {
    when: EvaluateFileWrite(request)
    requires: request.replaces_the_file

    ensures: FileReplaced(
        destination: request.destination,
        bytes: bytes_written_for(request))
}

-- /seek and /append open the file without truncating it, and still create
-- it when it is not there.
--
-- Both halves of that matter. Writing two bytes at the start of a longer
-- file leaves everything past them exactly as it was, so a caller can
-- patch a file rather than rewrite it. And a caller building a file a
-- piece at a time does not have to create it first, because the first
-- seek or append makes it.
rule SeekingOrAppendingLeavesTheRestOfTheFile {
    when: EvaluateFileWrite(request)
    requires: not request.replaces_the_file

    ensures: FileWrittenAt(
        destination: request.destination,
        bytes: bytes_written_for(request),
        at: first_byte_written_at(request))
}

-- /append writes at the file's end, which for a file that is not there yet
-- is its beginning.
rule AppendingWritesAtTheEnd {
    when: EvaluateFileWrite(request)
    requires: request.writes_at_the_end
    requires: request.position_asked_for = null

    ensures: first_byte_written_at(request) = size_of_the_file(request.destination)
}

-- Asked for both, the seek position wins. The C sets the append position
-- and then lets /seek overwrite it, and the order is the whole answer:
--
--     if (args & AM_WRITE_APPEND || action == A_APPEND) file->file.index = -1;
--     if (args & AM_WRITE_SEEK) Set_Seek(file, D_ARG(ARG_WRITE_INDEX));
--
-- Reading it the other way round, so that /append wins because it is the
-- coarser instruction, is the natural guess and puts every byte of such a
-- call in the wrong place.
rule ASeekPositionBeatsAnAppend {
    when: EvaluateFileWrite(request)
    requires: request.writes_at_the_end
    requires: request.position_asked_for != null

    ensures: first_byte_written_at(request) = clipped_to_the_size_of(request)
}

-- A seek position past the end of the file is clipped back to the size, so
-- it appends rather than leaving a hole.
--
-- `if (cnt > file->file.size) cnt = file->file.size` in Set_Seek, and it is
-- one line because the alternative is a file with a run of bytes in it
-- that nobody chose. Answering a failure instead would be defensible and
-- is not what happens: seeking past the end is a way of appending.
rule ASeekPastTheEndIsClippedToTheSize {
    when: EvaluateFileWrite(request)
    requires: request.position_asked_for != null
    requires: request.position_asked_for > size_of_the_file(request.destination)

    ensures: first_byte_written_at(request) = size_of_the_file(request.destination)
}

-- A string or a binary is written from where its series stands, not from
-- its head. `VAL_BIN_DATA(data)` takes the bytes at the index, so
-- `write %tmp next "ab"` writes "b".
--
-- Rebol's own port-test.r3 leans on this from line 283, where all eight
-- line-ending assertions write `next "a^/"` and read back the one byte
-- that follows the character.
rule WritingStartsFromWhereTheDataStands {
    when: EvaluateFileWrite(request)
    requires: is_string(request.data) or is_binary(request.data)

    ensures: bytes_written_for(request) =
        the_data_from_where_it_stands(request.data, request.units_permitted)
}

-- A char writes its UTF-8 bytes, and a bound does not apply to it.
--
-- The C sets the length to zero for a char before /part gets a look at it,
-- and then recomputes it from the encoding: `len = Encode_UTF8_Char(buf,
-- VAL_CHAR(data))`. So a bound of one on a two-byte character writes both
-- bytes rather than the first of them, which is the only sane answer for a
-- character and a surprising one for a bound.
rule ACharWritesItsBytesWholeWhateverTheBound {
    when: EvaluateFileWrite(request)
    requires: is_char(request.data)

    ensures: bytes_written_for(request) = utf8_of(request.data)
}

-- A block written one value per line ignores the bound too, by the same
-- mechanism. The length is measured, clipped by /part, and then thrown
-- away: the block is molded and `len = SERIES_TAIL(mo.series)` replaces it
-- with the length of the text that came out. So
-- `write/lines/part %f ["a" "b"] 1` still writes both lines.
--
-- The contrast is the part worth having, because it is one line of C apart.
-- Any other value that gets molded is molded in the actor, *before* the
-- length is taken, so the bound lands on the molded text and does apply:
-- `write/part %f [1 2] 3` writes "[1 ", the first three characters of
-- "[1 2]". The rules above about molding and about the bound already
-- compose to say that, and a bound counted against the block's two items
-- rather than its five characters is the wrong answer they compose to rule
-- out.
--
-- So the same block, the same bound, and two different answers depending
-- on whether /lines was named.
rule ABlockWrittenAsLinesIgnoresTheBoundToo {
    when: EvaluateFileWrite(request)
    requires: is_block(request.data)
    requires: request.one_value_per_line
    requires: request.units_permitted != null

    ensures: bytes_written_for(request) = bytes_written_ignoring_any_bound(request)
}

-- A block with /lines writes each value formed, with a line feed after
-- each one. `write/lines %f ["a" "b"]` writes "a^/b^/", so there is a break
-- after the last value and not only between them.
--
-- Rebol's own port-test.r3 asserts it on line 262:
-- `"a^/b^/" = read/string write/lines %tmp.txt ["a" "b"]`.
rule ABlockWithLinesWritesAValueAndABreakEachTime {
    when: EvaluateFileWrite(request)
    requires: is_block(request.data)
    requires: request.one_value_per_line

    ensures: bytes_written_for(request) =
        utf8_of(each_value_formed_then_a_line_feed(request.data))
}

-- Anything that became text gains one line feed with /lines, whatever it
-- already ends with. `write/lines %tmp.txt "a^/"` writes "a^/^/", which
-- Rebol's own suite reads back on line 260 as the two lines ["a" ""].
--
-- Anything that became text, not only a string that arrived as one. Molding
-- happens first, before /lines is looked at, so a value that was molded into
-- text is text by the time the terminator is added: `write/lines %f 12`
-- writes "12" and a line feed, not "12" alone.
--
-- Appended and not ensured, and that is the distinction worth keeping. A
-- string already ending in a break gets a second one. Reading /lines as
-- "make sure it ends with a break" gives "a^/" for that call and fails the
-- assertion.
rule AnythingThatBecameTextGainsOneLineFeed {
    when: EvaluateFileWrite(request)
    requires: request.one_value_per_line
    requires: not is_block(request.data)
    requires: not is_binary(request.data)
    requires: not is_char(request.data)

    ensures: bytes_written_for(request) =
        utf8_of(the_text_then_one_line_feed(request))
}

-- A binary with /lines gains the line feed as a byte. The same branch runs
-- for it as for text, so `write/lines %f #{41}` puts two bytes in the file:
-- 41 and 0A.
--
-- Worth stating because /lines reads as a text refinement and a binary is
-- the one kind of data it touches that is not text. A reading where /lines
-- is ignored for bytes writes one byte where a real Rebol writes two.
rule ABinaryWithLinesGainsTheLineFeedByte {
    when: EvaluateFileWrite(request)
    requires: is_binary(request.data)
    requires: request.one_value_per_line

    ensures: bytes_written_for(request) =
        the_data_from_where_it_stands(request.data, request.units_permitted)
            + one_line_feed_byte()
}

-- A char with /lines writes the character's bytes and nothing else.
--
-- A decision rather than a reading, because the C has no answer here. Its
-- terminator branch appends to the data's series, and a char has no series,
-- so what it appends to is not the character and not anything the write then
-- sends: the char branch afterwards rebuilds the length from the encoding
-- and writes from its own buffer. So the appended byte goes nowhere in some
-- builds and somewhere unfortunate in others.
--
-- The character's bytes alone is the answer that matches the rest of the
-- rules for a char, which already ignore the bound for the same reason: the
-- length is worked out again from the encoding after everything else has had
-- its say. Adding a terminator would be inventing behaviour no Rebol
-- reliably has.
rule ACharWithLinesWritesItsBytesAlone {
    when: EvaluateFileWrite(request)
    requires: is_char(request.data)
    requires: request.one_value_per_line

    ensures: bytes_written_for(request) = utf8_of(request.data)
}

-- Anything else is molded and the text written. A block without /lines, an
-- integer, none: each is molded rather than formed, so a block arrives with
-- its brackets and `write %f [1 2]` puts "[1 2]" in the file.
--
-- Molded rather than formed is the part to state. FORM gives "1 2" and
-- throws away the fact that it was a block, and the C asks for the other
-- one: `Mold_Value(&mo, spec, TRUE)`, where the TRUE means molded.
--
-- Without /lines here, because molding runs first and the terminator is
-- added to what it produced. The rule above covers the pair.
rule AnyOtherValueIsMoldedAndTheTextWritten {
    when: EvaluateFileWrite(request)
    requires: not request.one_value_per_line
    requires: not is_string(request.data)
    requires: not is_binary(request.data)
    requires: not is_char(request.data)

    ensures: bytes_written_for(request) = utf8_of(mold(request.data))
}

-- Text crosses to the host as UTF-8 bytes. A file holds bytes and a string
-- holds characters, so an encoding has to be chosen, and every form above
-- chooses the same one.
--
-- Nothing a caller can ask for changes it. /binary is the refinement that
-- would have been the switch, and its branch is commented out.
rule TextCrossesTheHostBoundaryAsUtf8 {
    when: EvaluateFileWrite(request)
    requires: not is_binary(request.data)

    ensures: bytes_written_for(request) = utf8_of(the_text_to_be_written(request))
}

-- /part bounds the write in the units of the data's own series: characters
-- of a string, bytes of a binary. It is not a count of bytes for both,
-- which is what makes the two datatypes answer differently to the same
-- number when the text is not all ASCII.
--
-- Where it applies at all. A char and a block written as lines are the two
-- exceptions, each stated with its own rule above.
rule TheBoundIsInTheUnitsOfTheData {
    when: EvaluateFileWrite(request)
    requires: request.the_bound_applies

    ensures: units_written_for(request) =
        the_smaller_of(request.units_permitted, units_available_in(request.data))
}

-- A bound larger than the data writes the whole data rather than padding
-- out to the bound. `if (n <= len) len = n;` -- the bound only ever
-- narrows, and never lengthens.
rule ABoundLargerThanTheDataWritesItAll {
    when: EvaluateFileWrite(request)
    requires: request.the_bound_applies
    requires: request.units_permitted > units_available_in(request.data)

    ensures: units_written_for(request) = units_available_in(request.data)
}

-- A bound of zero writes nothing, and the file is made all the same.
--
-- Which means `write/part %f "x" 0` empties an existing file rather than
-- leaving it alone: the bound decides how much is written and the plain
-- form still replaces what was there, so the two together give an empty
-- file. Nothing about a bound of zero turns the write into no write.
--
-- A char and a block written as lines are the exceptions again, and this is
-- where they are most visible: `write/lines/part %f ["a" "b"] 0` writes
-- both lines rather than emptying the file.
rule ABoundOfZeroWritesNothingAndStillMakesTheFile {
    when: EvaluateFileWrite(request)
    requires: request.the_bound_applies
    requires: request.units_permitted = 0

    ensures: units_written_for(request) = 0
    ensures: the_file_exists_afterwards(request.destination)
}

-- A negative bound is refused rather than counted backwards.
-- `Int32s(D_ARG(ARG_WRITE_LENGTH), 0)` takes a floor of zero and raises
-- out-of-range below it, so there is no reading of /part where a negative
-- number means anything.
--
-- Refused whatever the data is, including the two kinds that go on to
-- ignore the bound. The number is read where /part is handled and used
-- somewhere else, so a char and a lines-block are refused a negative bound
-- they would then have taken no notice of.
rule ANegativeBoundIsRefused {
    when: EvaluateFileWrite(request)
    requires: request.units_permitted != null
    requires: request.units_permitted < 0

    ensures: CallFails(error: out_of_range, about: request.units_permitted)
}

-- A negative seek position is refused the same way, and it is the same
-- shape of check: Set_Seek opens with `cnt = Int64s(arg, 0)`, which takes a
-- floor of zero and raises out-of-range below it.
--
-- So the two ends of a seek are refused for different reasons and both are
-- worth a test. Past the end is clipped back to the size and writes; before
-- the beginning raises. Reading the clip as "a seek is always brought into
-- range" would make a negative one write at the start, which is a byte in
-- the wrong place rather than a failure.
rule ANegativeSeekPositionIsRefused {
    when: EvaluateFileWrite(request)
    requires: request.position_asked_for != null
    requires: request.position_asked_for < 0

    ensures: CallFails(error: out_of_range, about: request.position_asked_for)
}

-- /binary, /all and /allow's access modes are accepted and change nothing.
-- The same call with and without any of them puts the same bytes in the
-- same place.
--
-- Worth a rule rather than a note, because it is testable in exactly that
-- form and because both ways of getting it wrong are easy. Refusing them
-- breaks a script that named one out of habit; honouring /binary breaks
-- the eight assertions on port-test.r3 line 283, which write with it and
-- expect what a write without it would have given.
rule TheThreeAcceptedRefinementsChangeNothing {
    when: EvaluateFileWrite(request)
    requires: request.asked_for_binary
        or request.asked_for_all
        or request.access_modes.count > 0

    ensures: bytes_written_for(request) = bytes_written_ignoring_those_three(request)
    ensures: first_byte_written_at(request) =
        first_byte_written_at_ignoring_those_three(request)
}

-- The answer is the destination, which is what lets a caller chain a read
-- onto a write. `*D_RET = *path`, after the file is closed.
--
-- Rebol's own suite depends on it in every write assertion it has:
-- `read write/binary %tmp next "a^/"` writes the file, gets the path back
-- and reads it, all in one expression. Answering the byte count instead
-- would read a number as a filename.
rule TheAnswerIsTheDestination {
    when: EvaluateFileWrite(request)

    ensures: CallResult(value: request.destination)
}

-- === Routing to a scheme this host does not serve ==========

-- READ, WRITE and RENAME take more than a file. Each also accepts a url, a
-- block naming a specification, and a word naming a scheme; WRITE takes a
-- port as well. Every one of those routes to a scheme rather than to the
-- filesystem, and JEBOL serves no scheme, so the routing finds nothing.
--
-- Routing that finds nothing is the honest shape here rather than a
-- pretence. A real R3 hands the call to the scheme's actor, and the actor is
-- what knows how to read an http url or write to a clipboard. JEBOL routes
-- the same way and there is no actor at the end of it, so the answer is a
-- no-service error naming the scheme that was wanted: nothing here reads the
-- http scheme.
--
-- Naming the scheme matters. A script told only that a read failed cannot
-- tell a missing file from a protocol nobody implemented, and the two ask
-- for entirely different things from whoever reads the error.
--
-- Declaring the argument and refusing it beats not declaring it. A script
-- that writes `read http://example.com` gets a refusal saying what is
-- missing rather than a type error saying a url is not a file, and the day a
-- scheme arrives nothing about the call site changes.
rule ReadingOrWritingThroughASchemeFindsNoScheme {
    when: EvaluateCall(verb, target)
    requires: verb in {read, write, rename}
    requires: names_a_scheme(target)
    requires: not the_host_serves(the_scheme_named_by(target))

    ensures: CallFails(error: no_service, about: the_scheme_named_by(target))
}

-- The console port is the one that works. WRITE to it forms the data and
-- puts it through the console, which is what makes the console reachable as
-- a port rather than only through PRINT.
--
-- Formed rather than molded, so a string arrives as its text and a block as
-- its values run together, exactly as PRINT would have shown them.
--
-- And it needs the console grant, like every other way of reaching the
-- operator. embed.allium says what a host grants and what a refusal looks
-- like; a port is not a way around a grant that was not given.
rule WritingToTheConsolePortGoesThroughTheConsole {
    when: EvaluateCall(write, target, data)
    requires: names_the_console_port(target)
    requires: console in granted_services()

    ensures: CallResult(value: target)
    ensures: the_console_shows(formed(data))
}

-- === Starting another program ==============================

-- CALL starts another program. Three questions decide what it does: how the
-- command is spelled, what happens to the child's three streams, and whether
-- the call waits.
--
-- Starting a program needs the processes service, exactly as every other
-- host call needs its own. embed.allium says what a host grants, what a
-- refusal looks like, and what shape the request and its answer take when
-- they cross. Nothing about that is different here.
--
-- JEBOL's own CALL takes /wait, /shell and an /output that carries no buffer
-- and answers the text instead. That shape is JEBOL's invention rather than
-- anything Rebol does, and the rules below describe the C. The difference
-- worth naming is that /output here is not a way of getting the text back:
-- it is a series the caller already holds, and the child's output is added
-- to it.

-- A string command is a shell-style command line: one piece of text holding
-- the program and its arguments, to be split by whatever reads it.
rule AStringCommandIsAShellStyleCommandLine {
    when: EvaluateProgramCall(request)
    requires: is_string(request.command)

    ensures: ProgramStarted(
        command: as_one_command_line(request.command),
        read_by_the_shell: request.reads_through_the_shell)
}

-- A file command is the executable itself, with nothing reading it first.
-- So a program whose path holds a space starts, where the same path written
-- as a string would have been split at the space and not found.
rule AFileCommandIsTheExecutableItself {
    when: EvaluateProgramCall(request)
    requires: is_file(request.command)

    ensures: ProgramStarted(
        command: as_the_only_argument(request.command),
        read_by_the_shell: request.reads_through_the_shell)
}

-- A block command is the program and its arguments already separated, one
-- item each. Nothing splits it and nothing needs quoting, which is what
-- makes it the form to reach for when an argument holds a space.
rule ABlockCommandIsTheProgramAndItsArgumentsAlreadySplit {
    when: EvaluateProgramCall(request)
    requires: is_block(request.command)

    ensures: ProgramStarted(
        command: each_item_as_one_argument(request.command),
        read_by_the_shell: request.reads_through_the_shell)
}

-- A get-word or a get-path inside the block is resolved to what it holds
-- before anything else looks at it. So a block may name a value without the
-- caller reducing it first, and `[:system/options/boot %script.r3 :url foo]`
-- is four arguments rather than a get-path and three others.
--
-- The C says why in its own comment: "to avoid call to reduce, resolve
-- get-word! or get-path! values if used". REDUCE would have evaluated
-- everything in the block, including the words meant to stay words.
rule AGetWordOrGetPathInTheBlockIsResolvedFirst {
    when: EvaluateProgramCall(request)
    requires: is_block(request.command)

    ensures:
        for item in request.command:
            if is_get_word(item) or is_get_path(item):
                the_argument_from(item) = the_argument_from(value_of(item))
}

-- Each item of the block then becomes text its own way. A file crosses as
-- its path, any of the string datatypes passes as it stands, and a word is
-- formed to its spelling. Anything else raises.
--
-- Any of the string datatypes, not only a string: the C tests ANY_STR, so a
-- url, an email, a tag and a file-like text all pass the same way. Which is
-- what makes the suite's `:url` case work, since what the get-word resolves
-- to is a url rather than a string.
--
-- Rebol's own call-test.r3 drives all four on line 102:
-- `call/wait/output [:system/options/boot %probe-args.r3 :url foo] tmp`
-- answers the arguments as `["http://example.org" "foo"]`, so the get-path
-- resolved to the executable, the file crossed as its path, the get-word's
-- url passed as text and the bare word became "foo".
--
-- Formed rather than molded, which is the difference between `foo` and
-- `'foo` reaching the child. A molded word carries the tick that says it is
-- a word, and no program wants one.
--
-- A file crosses in REBOL's own spelling, with forward slashes, rather than
-- being rewritten into whatever the host writes paths in. Two reasons and
-- both are about keeping one rule rather than two. The JVM's process and
-- file interfaces accept forward slashes on every host JEBOL runs on, so
-- nothing is gained by rewriting. And JEBOL keeps path conversion in exactly
-- one place, TO-LOCAL-FILE, which a script calls when it wants the host's
-- spelling; scattering the same conversion through the callers is how the
-- two spellings start disagreeing about edge cases nobody tests.
rule EachBlockItemBecomesTextItsOwnWay {
    when: EvaluateProgramCall(request)
    requires: is_block(request.command)

    ensures:
        for item in request.command:
            if is_file(resolved(item)): the_argument_from(item) = the_path_of(resolved(item))
            else if is_any_string(resolved(item)): the_argument_from(item) = resolved(item)
            else if is_word(resolved(item)): the_argument_from(item) = formed(resolved(item))
            else: CallFails(error: invalid_arg, about: item)
}

-- An empty block raises too-short rather than starting nothing. There is no
-- program named in it, and the failure says the content was too short rather
-- than that an argument was invalid, because nothing in it was wrong.
rule AnEmptyBlockCommandRaisesTooShort {
    when: EvaluateProgramCall(request)
    requires: is_block(request.command)
    requires: request.command.count = 0

    ensures: CallFails(error: too_short)
}

-- A command that is none of the three raises expect-arg. An integer is not a
-- program.
--
-- Expect-arg rather than invalid-arg, because nothing inside CALL ever sees
-- it. The declared parameter says which datatypes the argument may be, and
-- an argument outside that set is refused where arguments are gathered,
-- before any arm of the native runs. The C carries a Trap_Arg for this case
-- and it is unreachable for the same reason, sitting behind its own
-- type check.
rule AnythingElseAsACommandRaises {
    when: EvaluateProgramCall(request)
    requires: not is_any_string(request.command)
    requires: not is_file(request.command)
    requires: not is_block(request.command)

    ensures: CallFails(error: expect_arg, about: request.command)
}

-- A string or a binary on /input is piped to the child, and then its input
-- ends. The string's text goes as bytes and the binary's bytes go as they
-- are, so a script may feed a child anything at all, including bytes no text
-- could hold.
--
-- Rebol's own call-test.r3 drives both on lines 208 and 217: a binary of
-- four bytes including a null, and a string holding a null between two
-- words, each read back by the child and counted.
rule AStringOrBinaryOnInputIsPipedToTheChild {
    when: EvaluateProgramCall(request)
    requires: is_a_series(request.input_redirection)

    ensures: ProgramStarted(standard_input: supplied_bytes)
}

-- A file on /input feeds the child that file's contents.
rule AFileOnInputFeedsItsContents {
    when: EvaluateProgramCall(request)
    requires: is_file(request.input_redirection)

    ensures: ProgramStarted(standard_input: a_files_contents)
}

-- None on /input closes the child's input, so it reads end of input at once.
--
-- This is the difference the refinement exists for. A child left on the
-- host's own input waits for whoever is at the other end of it, and on a
-- server that is nobody, so the child never finishes and neither does the
-- script. Closing it is how a caller says "you are getting nothing" in a way
-- the child can act on.
rule NoneOnInputClosesTheChildsInput {
    when: EvaluateProgramCall(request)
    requires: request.input_redirection = none

    ensures: ProgramStarted(standard_input: nothing_at_all)
}

-- A string or a binary on /output captures what the child printed by
-- appending it to the very series the caller passed.
--
-- Appending to the caller's own series, not answering a new one, and that is
-- the whole shape of the refinement. Rebol's own call-test.r3 is built on
-- it: `call/shell/output/error cmd out-buffer err-buffer` on line 18, with
-- `clear out-buffer` before each call on line 15, because a second call
-- without the clear would find the first call's output still there.
--
-- A caller may pass the same series twice and get both streams interleaved
-- into it, which is a thing worth being able to ask for and impossible if
-- the native answered a fresh string.
rule AStringOrBinaryOnOutputGrowsTheCallersSeries {
    when: EvaluateProgramCall(request)
    requires: is_a_series(request.output_redirection)

    ensures: ProgramStarted(standard_output: captured)
    ensures: what_the_series_holds_afterwards(request.output_redirection) =
        what_it_held_before(request.output_redirection)
            + what_the_child_wrote_to(standard_output)
}

-- A file on /output writes the child's output to that file, and none throws
-- it away. Discarding is a real request rather than an omission: a program
-- that chatters is quieted without its output going anywhere a script has to
-- read.
rule AFileOnOutputWritesToItAndNoneDiscards {
    when: EvaluateProgramCall(request)
    requires: is_file(request.output_redirection)
        or request.output_redirection = none

    ensures: ProgramStarted(
        standard_output: if is_file(request.output_redirection): into_a_file
            else: discarded)
}

-- A stream nobody redirected is inherited from the host, so a child prints
-- where the host prints. That is the default because it is what a person
-- running a command expects to see, and it is the reason a capture has to be
-- asked for rather than being the ordinary case.
rule AStreamNobodyRedirectedIsInheritedFromTheHost {
    when: EvaluateProgramCall(request)
    requires: request.input_redirection = null
        or request.output_redirection = null
        or request.error_redirection = null

    ensures: each_stream_nobody_named(request) = the_hosts_own
}

-- /console puts the child on the host's own console, which is inheritance
-- asked for rather than fallen into.
--
-- The C passes a flag and leaves the host to act on it, so what it means is
-- as much a property of the host as of the call. On a host with a console
-- the request and the default arrive at the same place, and the refinement
-- is a way of saying it was meant. Whether it should differ on a host with
-- no console at all is an open question below, and JEBOL's common case is
-- exactly that host.
rule TheConsoleRefinementAsksForInheritanceOutright {
    when: EvaluateProgramCall(request)
    requires: request.attaches_to_the_console

    ensures: ProgramStarted(attached_to_the_hosts_console: true)
}

-- The error stream is redirected the same four ways as the output, and
-- separately from it. Which is what lets a script capture what a program
-- produced while letting its complaints reach the operator, or capture the
-- complaints into a second series and read them after.
rule TheErrorStreamIsRedirectedTheSameFourWays {
    when: EvaluateProgramCall(request)
    requires: request.error_redirection != null

    ensures: ProgramStarted(
        standard_error: the_same_choice_as_for_output(request.error_redirection))
}

-- A redirection that is not a string, a binary, a file or none raises
-- expect-arg, and the complaint names the redirection that was wrong rather
-- than the command.
--
-- Expect-arg for the same reason the command is: each of the three
-- refinements declares which datatypes its argument may be, so an argument
-- outside that set never reaches the arm that would have looked at it. The
-- C's Trap_Arg for this case is unreachable behind its own type check.
--
-- Naming the offending redirection matters more here than for the command,
-- because there are three of them. A caller told only that something was
-- wrong has three places to look.
rule AnythingElseAsARedirectionRaises {
    when: EvaluateProgramCall(request)
    requires: some_redirection_is_of_no_usable_kind(request)

    ensures: CallFails(error: expect_arg,
        about: the_redirection_of_no_usable_kind(request))
}

-- A relative file named by any of the three redirections is resolved against
-- the interpreter's own directory, so `call/input [x] %in.txt` reads the file
-- `read %in.txt` reads. An absolute path passes as it stands.
--
-- The same rule every other relative path in JEBOL follows, and it has to be:
-- the working directory belongs to the interpreter rather than to the process
-- holding it, as embed.allium says, so a host running several interpreters
-- has several current directories. A redirection resolved against the
-- process's directory instead would read one file where the script reads
-- another, with nothing in either answer saying so.
rule ARelativeRedirectionFileResolvesAgainstTheInterpretersDirectory {
    when: EvaluateProgramCall(request)
    requires: some_redirection_names_a_relative_file(request)

    ensures: the_file_reached_by(request) =
        made_absolute_against_the_interpreters_directory(request)
}

-- Piping into a string or a binary, at any of the three ends, makes the call
-- wait whether or not /wait was named.
--
-- It cannot do otherwise. A capture is only complete when the child has
-- stopped writing, so answering before then would answer with part of the
-- output and no way of saying it was part. The C decides it in one test over
-- all six possibilities rather than three tests of one each, and that is the
-- right reading: it is a property of there being a series at one end, not of
-- which end it is at.
rule ASeriesAtEitherEndMakesTheCallWait {
    when: EvaluateProgramCall(request)
    requires: request.a_series_is_at_one_end

    ensures: request.waits = true
}

-- With /info the answer is an object rather than a number, and it carries
-- the process number under `id`.
rule WithInfoTheAnswerIsAnObject {
    when: EvaluateProgramCall(request)
    requires: request.answers_an_object

    ensures: CallResult(value: an_object_holding(id: the_process_number(request)))
}

-- The object carries an exit code only when the call waited and the program
-- actually ran. A child still running has not got one yet, and a program the
-- system refused to start never will.
--
-- The second half is a deliberate divergence from the C, which publishes a
-- fabricated zero in that field when the start failed. Zero is the code a
-- program returns when everything went perfectly, so a caller reading the
-- field sees success where nothing ran at all, and the object carries an
-- error field beside it that most callers will not think to check. The
-- section's own reasoning applies: a failure to start is not an exit code and
-- must not arrive as one. Absent is the honest answer, and it is the answer
-- the same object gives for a child still running.
rule TheObjectCarriesTheExitCodeOnlyWhenWaitedAndTheProgramRan {
    when: EvaluateProgramCall(request)
    requires: request.answers_an_object

    ensures: object_field_is_present(exit_code) =
        request.waits and not the_system_refused_to_start_it(request)
}

-- The object carries an error only when the system would not start the
-- program, and it holds what the system said.
--
-- Which is the asymmetry worth stating. With /info such a refusal is a field
-- on an object the caller reads; without it the same refusal raises. So the
-- refinement changes whether a failure to start is a value or an error, and
-- a caller wanting to look at it rather than catch it asks for /info.
rule TheObjectCarriesTheErrorOnlyWhenTheSystemRefused {
    when: EvaluateProgramCall(request)
    requires: request.answers_an_object

    ensures: object_field_is_present(error) =
        the_system_refused_to_start_it(request)
}

-- Without /info the answer is a number, and which number depends on whether
-- the call waited: the exit code when it did, the process number when it did
-- not.
--
-- The two are told apart by the call rather than by the value, and nothing
-- in the number itself says which it is. A caller that waited and got 4321
-- has a program that exited with 4321, and a caller that did not has a
-- program still running as process 4321.
rule WithoutInfoTheAnswerIsTheExitCodeOrTheProcessNumber {
    when: EvaluateProgramCall(request)
    requires: not request.answers_an_object
    requires: not the_system_refused_to_start_it(request)

    ensures: CallResult(value: if request.waits: the_exit_code(request)
        else: the_process_number(request))
}

-- Without /info, a system that would not start the program raises call-fail
-- carrying what the system said.
--
-- A failure to start is not an exit code and must not arrive as one. A
-- program that could not be found never ran, and answering some number for
-- it would let a script test the number and conclude the program had failed
-- on its own terms.
rule WithoutInfoARefusalToStartRaises {
    when: EvaluateProgramCall(request)
    requires: not request.answers_an_object
    requires: the_system_refused_to_start_it(request)

    ensures: CallFails(error: call_fail, about: what_the_system_said(request))
}

-- A host that waited and then answers neither an exit code nor a refusal has
-- broken its side of the boundary, and CALL says so as call-fail.
--
-- There is no third outcome for a call that waited. Either the program ran
-- and finished, which gives a code, or it never started, which gives a
-- reason. A host answering neither has told the interpreter nothing usable,
-- and the interpreter has nothing to hand the script.
--
-- Call-fail rather than anything escaping, which is what embed.allium
-- promises for every way a script can stop: no failure arrives as a host
-- exception. A defect on the host's side of the boundary is still a REBOL
-- error on this side, catchable like any other, and the alternative is a
-- script that cannot be timed out by a host whose own port misbehaved.
rule AHostThatWaitedAndAnsweredNeitherIsBroken {
    when: EvaluateProgramCall(request)
    requires: request.waits
    requires: no_exit_code_came_back(request)
    requires: not the_system_refused_to_start_it(request)

    ensures: CallFails(error: call_fail)
}

-- Text crosses in both directions as UTF-8. A string piped to a child goes
-- as its UTF-8 bytes, and bytes captured back into a string are read as
-- UTF-8 text.
--
-- The C appends the child's raw bytes and then marks the string as UTF-8 if
-- what arrived was not plain ASCII, so a child that printed accented text
-- comes back as the characters rather than as the bytes that spelled them.
-- A binary captures the bytes untouched, which is the reason to capture into
-- one: a child producing anything that is not text has to have somewhere to
-- put it.
rule TextCrossesToAndFromTheChildAsUtf8 {
    when: EvaluateProgramCall(request)
    requires: is_string(request.input_redirection)
        or is_string(request.output_redirection)
        or is_string(request.error_redirection)

    ensures: the_bytes_at_that_end(request) = utf8_of(the_text_at_that_end(request))
}

-- === Integers and the bit operations =======================

-- SHIFT keeps the sign and refuses to lose a bit off the top, which makes
-- it the fussiest of the three shifting natives. `shift 1 63` raises
-- overflow, because the answer would be the most negative whole number and
-- a positive one was shifted. Four cases, and each has its own boundary:
--
--   a count of 64 or more, shifting left: overflow unless the value is
--     already zero, in which case the answer is zero
--   a count below 64, shifting left: overflow when the magnitude would not
--     fit, and the one exception is the most negative number itself, which
--     is reachable and is not an overflow
--   a count of 64 or more, shifting right: the sign bit repeated, so -1 for
--     a negative value and 0 for anything else
--   a count below 64, shifting right: an ordinary signed shift
--
-- /LOGICAL drops all of that and shifts the bits, so
-- `shift/logical 1 63` is the most negative whole number rather than an
-- overflow, and `shift/logical -9223372036854775808 -64` is 0.
rule ShiftingLeftPastTheWidthRaises {
    when: EvaluateShift(value, count)
    requires: count >= 64
    requires: value != 0
    ensures: ShiftFailed(failure: overflow)
}

rule ShiftingLeftOutOfRangeRaises {
    when: EvaluateShift(value, count)
    requires: count > 0 and count < 64
    requires: not fits_in_a_signed_word(value * power(2, count))
    ensures: ShiftFailed(failure: overflow)
}

rule ShiftingRightPastTheWidthRepeatsTheSignBit {
    when: EvaluateShift(value, count)
    requires: count <= -64
    ensures: ShiftResult(value: if value < 0: -1 else: 0)
}

-- `//` is INTEGER-DIVIDE and not REMAINDER, which is the operator pairing
-- most likely to be got wrong: every other language that spells a
-- remainder with two characters spells it this way. `23 // 10` is 2, the
-- whole part of the quotient, and `23 % 10` is 3, what is left over.
--
-- Both operands are truncated to whole numbers before dividing, so
-- `23.5 // 10` and `23 // 10.5` are both 2, and the answer is always an
-- integer.
rule IntegerDivideTruncatesBothSidesAndTheAnswer {
    when: EvaluateArithmetic(integer_divide, left, right)
    ensures: ArithmeticResult(
        datatype: integer,
        value: truncated(left) / truncated(right))
}

-- Reading an integer out of text that names a number too large for a
-- machine word raises rather than saturating at the largest one. Saturating
-- is the dangerous answer: it is a number, it is in range, and it is not
-- the number the text said.
rule ReadingAnOversizedIntegerRaises {
    when: EvaluateConversion(integer, source)
    requires: is_string(source)
    requires: not fits_in_a_signed_word(number_named_by(source))
    ensures: ConversionFailed(failure: bad_make_arg)
}

-- SET takes a word, a lit-word, a path, a block or an object, and the
-- refusal is at the door: `set 1 1` is expect-arg, from the argument check,
-- rather than a failure raised inside the native.
rule SetTakesANameShapedArgument {
    when: EvaluateCall(set, target, value)
    requires: not (is_word(target) or is_path(target)
        or is_block(target) or is_object(target))
    ensures: CallFailed(failure: expect_arg)
}

-- PRIME? is trial division by six-and-one-either-side up to the square
-- root, which reaches a fourteen digit number in about a million and a half
-- steps. So the largest prime it will be asked about is a real answer and
-- not a timeout, and a bound on the input would be wrong.
rule PrimeIsAnsweredForEveryWholeNumber {
    when: EvaluatePredicate(is_prime, subject)
    requires: is_integer(subject)
    ensures: PredicateHolds(holds: has_no_divisor_below_its_square_root(subject))
}

-- === Decimals and the maths natives ========================

-- Three remainders, three definitions of division, and the names do not
-- line up with the definitions in the way anyone would guess. Each is a
-- separate function with its own rule.
--
-- REMAINDER and MOD are the same thing under two names: truncated
-- division, so the sign follows the dividend and `-7 % 3` is -1. MODULO is
-- Euclidean, so the answer is never negative and `-7 %% 3` is 2. Adding
-- /FLOOR to MODULO switches it to floor division, where the sign follows
-- the divisor, so `modulo/floor -7 -3` is -1 and `modulo/floor -7 3` is 2.
--
-- The three agree on every pair of positive numbers, which is why getting
-- them wrong is quiet.
enum DivisionDefinition {
    truncated       -- REMAINDER, %, MOD. Sign follows the dividend.
    | euclidean     -- MODULO, %%. Never negative.
    | floored       -- MODULO/FLOOR. Sign follows the divisor.
}

rule TruncatedRemainderTakesTheDividendsSign {
    when: EvaluateRemainder(truncated, dividend, divisor)
    ensures: RemainderResult(sign: sign_of(dividend))
}

rule EuclideanModuloIsNeverNegative {
    when: EvaluateRemainder(euclidean, dividend, divisor)
    ensures: RemainderResult(value: value >= 0 and value < absolute(divisor))
}

rule FlooredModuloTakesTheDivisorsSign {
    when: EvaluateRemainder(floored, dividend, divisor)
    ensures: RemainderResult(sign: sign_of(divisor))
}

-- The two that are not truncated round a negligible answer down to nothing.
-- `modulo 0.1 + 0.1 + 0.1 0.3` is 0.0 rather than the 5.55e-17 the
-- arithmetic actually leaves, and `modulo 562949953421311.25 1` is 0.0
-- rather than 0.25.
--
-- Negligible means: the answer makes no difference to the dividend when
-- taken off it, or makes no difference to the divisor when added to it,
-- measured by the same twenty-one step allowance EQUAL? uses. So this is
-- not a fixed epsilon and not a rounding of the answer; it is a question
-- about whether the answer is visible at the scale of its own operands.
--
-- MOD does not do this, which is how the two are told apart:
-- `mod 562949953421311.25 1` is 0.25.
rule NonTruncatedModuloRoundsANegligibleAnswerToZero {
    when: EvaluateRemainder(definition, dividend, divisor)
    requires: definition in {euclidean, floored}
    requires: negligible_against(value, dividend) or negligible_against(value, divisor)
    ensures: RemainderResult(value: 0)
}

-- The answer keeps the dividend's datatype, so an integer dividend gives an
-- integer however the divisor was written.
rule RemainderKeepsTheDividendsDatatype {
    when: EvaluateRemainder(definition, dividend, divisor)
    ensures: RemainderResult(datatype: dividend.datatype)
}

-- SINE and COSINE snap an answer within one step of the representation to
-- an exact zero, so `cosine 90` is 0.0 and not 6.1e-17. Without it every
-- assertion about a right angle fails on a number that prints as though it
-- were zero.
rule SineAndCosineSnapANegligibleAnswerToZero {
    when: EvaluateTrigonometry(function, angle)
    requires: function in {sine, cosine}
    requires: absolute(result) < smallest_representable_step
    ensures: TrigonometryResult(value: 0)
}

-- TANGENT answers an infinity at a right angle rather than the very large
-- number the hardware gives, and "at a right angle" is measured with the
-- same twenty-one step allowance rather than exactly. So
-- `tangent 89.99999999999987` is 1.#INF.
rule TangentAtARightAngleIsInfinite {
    when: EvaluateTrigonometry(tangent, angle)
    requires: nearly_equal(absolute(radians_of(angle)), pi / 2)
    ensures: TrigonometryResult(value: if angle < 0: negative_infinity else: infinity)
}

-- SQRT takes a decimal and nothing else, where SQUARE-ROOT takes any
-- number. Two functions for one curve, and the shorter name is the fussier
-- one, which is the opposite of what the spelling suggests. `sqrt 4` raises
-- expect-arg naming integer!; `square-root 4` is 2.0.
--
-- This is the same trap as SIN against SINE, and it is a trap because the
-- forgiving version exists: code written with SQRT works on every decimal
-- and fails the first time an integer reaches it.
rule SqrtTakesADecimalAndSquareRootTakesAnyNumber {
    when: EvaluateCall(sqrt, argument)
    requires: not is_decimal(argument)
    ensures: CallFailed(failure: expect_arg)
}

-- The whole trigonometric and logarithmic family takes a number and nothing
-- else. SINE, COSINE, TANGENT, ARCSINE, ARCCOSINE, ARCTANGENT, SQUARE-ROOT,
-- LOG-10, LOG-2, LOG-E and EXP each accept an integer, a decimal or a
-- percent, and refuse everything else with expect-arg.
--
-- Refused deliberately, and the list of what is refused is the interesting
-- half: a char, a date, a money, a pair, a time and a tuple. Every one of
-- those has a plausible reading. A char has a code point, a time has a
-- number of seconds, a money has an amount, and a pair has two numbers that
-- could each be taken. Accepting any of them would be inventing a
-- conversion, and REBOL's own declaration in natives.reb says number! and
-- means it, so the refusal is the specified behaviour rather than a gap.
--
-- The conversion a caller wanted is still available by asking for it.
-- `sine to-integer #"a"` is an ordinary call and says what it is doing.
rule TheTrigonometricAndLogarithmicFamilyTakesANumberAlone {
    when: EvaluateCall(function, argument)
    requires: function in {sine, cosine, tangent, arcsine, arccosine,
        arctangent, square_root, log_10, log_2, log_e, exp}
    requires: not is_number(argument)

    ensures: CallFails(error: expect_arg, about: argument)
}

-- AS-PAIR takes a number for each half, on the same terms and for the same
-- reason. Both arguments are checked, so `as-pair 1 #"a"` is refused as
-- readily as `as-pair #"a" 1`.
rule AsPairTakesANumberForEachHalf {
    when: EvaluateCall(as_pair, x, y)
    requires: not is_number(x) or not is_number(y)

    ensures: CallFails(error: expect_arg, about: if is_number(x): y else: x)
}

-- ABSOLUTE takes a number, a pair, a money or a time, and no longer a char.
--
-- Four datatypes rather than one, because each has a signed magnitude that
-- absolute value means something for: a pair has two, a money has an amount
-- and a time runs backwards as readily as forwards. A char has a code point
-- and code points are not signed, so there was nothing for it to do.
rule AbsoluteTakesTheFourDatatypesThatHaveASign {
    when: EvaluateCall(absolute_value, argument)
    requires: not is_number(argument)
    requires: not is_pair(argument)
    requires: not is_money(argument)
    requires: not is_time(argument)

    ensures: CallFails(error: expect_arg, about: argument)
}

-- NUMBER? excludes a NaN, which makes it the one predicate that is not
-- purely a question about the datatype. `number? 1.#NaN` is false although
-- `decimal? 1.#NaN` is true.
--
-- A money counts as a number here, which the typeset does not: values.allium
-- has is_number covering integer, decimal and percent only.
rule NotANumberIsNotANumber {
    when: EvaluatePredicate(is_number, subject)
    requires: is_not_a_number(subject)
    ensures: PredicateHolds(holds: false)
}

rule AMoneyIsANumberToTheNumberPredicate {
    when: EvaluatePredicate(is_number, subject)
    requires: is_money(subject)
    ensures: PredicateHolds(holds: true)
}

-- TAIL? asks a series-like thing whether it is at its end, and takes only
-- the things that have an end: a series, a gob, a port, a bitset, a typeset
-- and a map. None, an object and an issue are refused with expect-arg.
--
-- EMPTY? is wider and takes none as well, so `empty? none` is true where
-- `tail? none` raises. The two look like one question and they are not, and
-- the reason is worth knowing rather than guessing at: Rebol builds EMPTY?
-- out of TAIL? in its own library, with `make :tail?` and none! added to the
-- accepted set. So EMPTY? is TAIL? with one more datatype, deliberately,
-- and code that treats them as interchangeable breaks on exactly that one.
rule TailAsksOnlyTheThingsThatHaveAnEnd {
    when: EvaluatePredicate(is_tail, subject)
    requires: not is_series(subject)
    requires: not is_gob(subject)
    requires: not is_port(subject)
    requires: not is_bitset(subject)
    requires: not is_typeset(subject)
    requires: not is_map(subject)

    ensures: CallFails(error: expect_arg, about: subject)
}

-- UNIQUE takes a block, a string, a bitset, a typeset or a map, and refuses
-- the rest of the string family.
--
-- Narrower than it looks, because a file, a url, an email and a tag are all
-- string-like and none of them is accepted. Rebol declares it that way and
-- the reason is not obvious, so this is a declaration to match rather than a
-- rule to derive: deduplicating the characters of a filename is a question
-- with an answer, and simply not one UNIQUE offers.
rule UniqueTakesFiveKindsOfSet {
    when: EvaluateCall(unique, subject)
    requires: not is_block(subject)
    requires: not is_string(subject)
    requires: not is_bitset(subject)
    requires: not is_typeset(subject)
    requires: not is_map(subject)

    ensures: CallFails(error: expect_arg, about: subject)
}


-- A character in decimal arithmetic is its code point, so `1.0 * #"a"` is
-- 97.0. The character does not survive: the answer is a decimal.
rule ACharacterInDecimalArithmeticIsItsCodePoint {
    when: EvaluateArithmetic(operation, left, right)
    requires: is_decimal(left) and is_char(right)
    ensures: ArithmeticResult(
        datatype: decimal,
        value: apply(operation, value_of(left), codepoint_of(right)))
}

-- A scale of zero means "do not round", not "round to a whole number".
-- `round/to 11.65 0.0` is 11.65 unchanged. A scale so small it underflows
-- to zero, such as 1e-400, is the same case and answers the same way.
--
-- Reading a zero scale as a request for a whole number is the plausible
-- wrong answer: it makes `round/to x 0.0` give 11, which looks like
-- rounding rather than like a bug.
rule AZeroRoundingScaleRoundsNothing {
    when: EvaluateRound(subject, scale)
    requires: value_of(scale) = 0
    ensures: RoundResult(value: value_of(subject), datatype: subject.datatype)
}

-- === Money =================================================

-- Money arithmetic widens the other side to a money and keeps the answer
-- a money, so `$4 * $4` is $16 and `$4 / $4` is $1 rather than the plain 1
-- either of them might have been. An integer, a decimal and a percent all
-- widen; nothing else does.
rule MoneyArithmeticWidensTheOtherSide {
    when: EvaluateArithmetic(operation, left, right)
    requires: is_money(left)
    requires: is_integer(right) or is_decimal(right) or is_percent(right)
        or is_money(right)
    ensures: ArithmeticResult(is_money: true)
}

-- A time is the one exception, and it is an exception in one direction
-- only: multiplying accepts it and reads it as a count of hours, so
-- `$5 * 1:30:0` is $7.5. Adding, subtracting, dividing and taking a
-- remainder all refuse it.
--
-- Hours rather than seconds, which is the part to get wrong. Reading
-- 1:30:0 as 5400 gives $27000 -- a plausible-looking number from a wage
-- calculation that has quietly gone wrong by a factor of 3600.
rule MultiplyingMoneyByATimeReadsItAsHours {
    when: EvaluateArithmetic(multiply, left, right)
    requires: is_money(left) and is_time(right)
    ensures: ArithmeticResult(is_money: true, amount: amount_of(left) * hours_of(right))
}

rule OtherMoneyArithmeticRefusesATime {
    when: EvaluateArithmetic(operation, left, right)
    requires: is_money(left) and is_time(right)
    requires: operation != multiply
    ensures: ArithmeticFailed(failure: cannot_use)
}

-- Anything that is not a number and not a time is refused whichever
-- operation asked. A character and a tuple are the two that look like they
-- might work: both carry numbers, and neither is a number here.
rule MoneyArithmeticRefusesEverythingElse {
    when: EvaluateArithmetic(operation, left, right)
    requires: is_money(left)
    requires: not (is_integer(right) or is_decimal(right) or is_percent(right)
        or is_money(right) or is_time(right))
    ensures: ArithmeticFailed(failure: cannot_use)
}

-- Arithmetic past twenty-six significant digits, or past a power of ten of
-- 127, raises overflow. This is the one place where an implementation on an
-- unbounded decimal silently disagrees: it answers a number Rebol refuses
-- to hold, and every assertion about the values below the bound still
-- passes.
rule MoneyArithmeticRaisesPastTheBound {
    when: EvaluateArithmetic(operation, left, right)
    requires: is_money(left)
    requires: result_significand_of(operation, left, right) >= power(10, 26)
        or result_exponent_of(operation, left, right) > 127
    ensures: ArithmeticFailed(failure: overflow)
}

-- Seven datatypes make a money and everything else is refused. A binary is
-- the ninety-six bit form, right-aligned in twelve bytes, so a shorter
-- binary is padded from the left and `to money! #{0F}` is $15.
rule SevenDatatypesMakeAMoney {
    when: EvaluateMake(money, source)
    requires: is_integer(source) or is_decimal(source) or is_percent(source)
        or is_money(source) or is_string(source) or is_binary(source)
        or is_logic(source)
    ensures: MakeResult(is_money: true)
}

-- An issue is refused on purpose. It looks like the obvious way to write a
-- money in hexadecimal, and Rebol removed the support rather than never
-- having had it, so the refusal is a decision and not a gap.
rule MakingAMoneyFromAnythingElseIsRefused {
    when: EvaluateMake(money, source)
    requires: not (is_integer(source) or is_decimal(source) or is_percent(source)
        or is_money(source) or is_string(source) or is_binary(source)
        or is_logic(source))
    ensures: MakeFailed(failure: bad_make_arg)
}

-- A logic makes a money only through MAKE, not through TO, and true is $1
-- while false is $0.
rule MakingAMoneyFromALogicGivesOneOrNothing {
    when: EvaluateMake(money, source)
    requires: is_logic(source)
    ensures: MakeResult(amount: if source.truth: 1 else: 0)
}

-- A money converts to a binary as the same twelve bytes it was made from,
-- so the round trip through both is exact.
rule AMoneyConvertsToTwelveBytes {
    when: EvaluateConversion(binary, source)
    requires: is_money(source)
    ensures: ConversionResult(byte_count: 12)
}

-- ROUND/TO takes the datatype of the scale rather than keeping the money.
-- `round/to $1.333 $.01` is a money, `round/to $1.333 .01` is a decimal and
-- `round/to $0.5 1` is the integer 1. Plain ROUND with no scale keeps the
-- money.
rule RoundingAMoneyTakesTheDatatypeOfItsScale {
    when: EvaluateRound(subject, scale)
    requires: is_money(subject)
    ensures: RoundResult(datatype: scale.datatype)
}

-- === Tuples ================================================
--
-- A tuple is a row of octets and every operation on one works octet by
-- octet, then forces the answer back into an octet. Nothing about a
-- tuple ever overflows or raises on range: 200 + 100 is 255 and 1 - 2 is
-- 0. This is the opposite of integer arithmetic, where an answer that
-- does not fit raises, and it is deliberate: a tuple is a colour or a
-- version number, and both want the edge rather than a failure.
rule TupleArithmeticClampsEachOctet {
    when: EvaluateArithmetic(operation, left, right)
    requires: is_tuple(left)
    ensures: ArithmeticResult(
        octets: octets_of(left).map(octet =>
            clamp(apply(operation, octet, matching_octet(right)), 0, 255)))
}

-- Where the right side is a single number it applies to every octet, as
-- it does for a pair. Where it is a tuple, the longer of the two lengths
-- wins and the shorter one contributes zeros.
rule TupleArithmeticTakesTheLongerLength {
    when: EvaluateArithmetic(operation, left, right)
    requires: is_tuple(left) and is_tuple(right)
    ensures: ArithmeticResult(
        segment_count: max(left.segment_count, right.segment_count))
}

-- A zero octet stays zero however large the factor, and a factor over
-- 255 saturates without being multiplied out. Both are guards against a
-- multiplication that would leave the range of a machine integer on the
-- way to an answer that was going to be clamped anyway.
rule TupleMultiplicationSaturates {
    when: EvaluateArithmetic(multiply, left, right)
    requires: is_tuple(left) and magnitude_of(right) > 255
    ensures: ArithmeticResult(
        octets: octets_of(left).map(octet => saturated(octet)))
}

-- Dividing by a decimal rounds the octet to the nearest whole number
-- rather than truncating it, so 1 / 0.625 is 2 and not 1.
rule TupleDivisionByADecimalRounds {
    when: EvaluateArithmetic(divide, left, right)
    requires: is_tuple(left) and is_decimal(right)
    ensures: ArithmeticResult(
        octets: octets_of(left).map(octet =>
            clamp(round_half_away(octet / right), 0, 255)))
}

-- Two tuples are equal when their octets agree, and the zeros behind the
-- kept ones count, so 1.2.3 equals 1.2.3.0. Strict equality asks the
-- further question of whether the two were written to the same length,
-- and those two are not.
rule TupleEqualityIgnoresTheLength {
    when: EvaluateComparison(request)
    requires: request.strictness = equal
    requires: is_tuple(request.left) and is_tuple(request.right)
    ensures: ComparisonHolds(
        holds: octets_to_twelve(request.left) = octets_to_twelve(request.right))
}

rule TupleStrictEqualityMindsTheLength {
    when: EvaluateComparison(request)
    requires: request.strictness = strict_equal
    requires: is_tuple(request.left) and is_tuple(request.right)
    ensures: ComparisonHolds(
        holds: octets_to_twelve(request.left) = octets_to_twelve(request.right)
            and request.left.segment_count = request.right.segment_count)
}

-- A path reads any of the shown octets, so a tuple of one octet answers
-- zero for its second and third. Past the shown length it answers none,
-- the way a series does rather than the way an object does.
rule TupleReadsAZeroWithinTheShownLength {
    when: EvaluatePath(target, position)
    requires: is_tuple(target) and position >= 1
        and position <= target.shown_count
    ensures: PathResult(value: octet_at(target, position))
}

rule TupleReadsNonePastTheShownLength {
    when: EvaluatePath(target, position)
    requires: is_tuple(target)
        and (position < 1 or position > target.shown_count)
    ensures: PathResult(value: none_value())
}

-- Writing past the end lengthens the tuple and fills the gap with zeros,
-- so setting the fifth octet of 1.2.3 gives 1.2.3.0.5. A written octet
-- is clamped rather than refused, matching the arithmetic.
rule TupleWriteExtendsAndClamps {
    when: EvaluateSetPath(target, position, written)
    requires: is_tuple(target) and position >= 1 and position <= 12
        and is_number(written)
    ensures: SetPathResult(
        octet_at: clamp(written, 0, 255),
        segment_count: max(target.segment_count, position))
}

-- Writing NONE cuts the tuple short at that position and zeros what
-- followed. It is the only way to shorten one.
rule TupleWriteOfNoneShortens {
    when: EvaluateSetPath(target, position, written)
    requires: is_tuple(target) and position >= 1 and position <= 12
        and is_none(written)
    ensures: SetPathResult(segment_count: position - 1)
}

rule TupleWriteOutsideTheBoundsRaises {
    when: EvaluateSetPath(target, position, written)
    requires: is_tuple(target) and (position < 1 or position > 12)
    ensures: SetPathFailed(failure: bad_path_set)
}

-- POKE is refused where a set-path is allowed. A tuple is not a series
-- and POKE asks for one, so the argument is rejected before the write is
-- considered.
rule PokeOfATupleIsRefused {
    when: EvaluatePoke(target, position, written)
    requires: is_tuple(target)
    ensures: PokeFailed(failure: expect_arg)
}

-- POKE writes a pixel of an image, and it is the same write a set-path
-- makes. `poke img 1 9.8.7.6` sets the first pixel, and four parts set the
-- alpha as well as the three colours.
--
-- One write reached two ways, which is what keeps `img/1: colour` and
-- `poke img 1 colour` from drifting apart. An image is a series of pixels,
-- so it answers the series natives rather than needing verbs of its own.
--
-- The answer is the value written, which is POKE's answer everywhere and
-- not the image.
rule PokingAnImageWritesAPixel {
    when: EvaluatePoke(target, position, written)
    requires: is_image(target)
    requires: is_tuple(written)

    ensures: PokeResult(value: written)
    ensures: the_pixel_at(target, position) = written
}

rule DivisionByZeroRaises {
    when: EvaluateArithmetic(operation, left, right)
    requires: operation in {divide, remainder}
    requires: is_zero(right)
    ensures: ArithmeticFailed(failure: zero_divide)
}

-- POWER refuses a tuple, and so does the ** it is reached by. The failure is
-- cannot-use, naming the verb and the datatype: `1.2.3.4 ** 1` gives an
-- error whose id is cannot-use and whose second argument is tuple!.
--
-- Cannot-use rather than a user error, and the difference is whether a
-- script can act on it. A user error carries a message and nothing to test,
-- so code that wanted to try raising a tuple and fall back has to match on
-- text. Cannot-use is in the catalogue with the verb and the datatype
-- beside it, which is what makes `e/id = 'cannot-use` a test somebody can
-- write. Rebol's own tuple-test.r3 writes exactly that, and checks the
-- datatype too.
--
-- Refused rather than applied to each segment, which is what the other
-- arithmetic on a tuple does. Raising each octet to a power has no meaning
-- anyone wants and would overflow the byte range almost immediately.
rule PowerRefusesATuple {
    when: EvaluateArithmetic(operation, left, right)
    requires: operation = power
    requires: is_tuple(left)

    ensures: ArithmeticFailed(failure: cannot_use, about: tuple_datatype)
}

-- === Comparison ============================================

-- There is one comparison in the language and every comparison native is
-- a call to it with a strictness. That is worth stating plainly, because
-- writing a separate answer per native is how the operators come to
-- disagree with the words they are twins of.
--
-- Only two of the four ordering natives ask a question of their own.
-- GREATER? asks `greater` and LESSER-OR-EQUAL? asks the same thing and
-- negates the answer; GREATER-OR-EQUAL? asks `greater_or_equal` and
-- LESSER? asks the same thing and negates it. So `a < b` is worked out as
-- "not (a >= b)", and everything the rules below say about ordering --
-- including which datatypes refuse to be ordered at all -- holds for < and
-- <= as much as for > and >=.

-- There are two comparisons, not one, and the rules below are the looser
-- one. A comparison native reaches it. A series function -- FIND, SELECT,
-- SWITCH, SORT, UNIQUE, and the walk that compares two objects field by
-- field -- reaches a stricter one that crosses only two datatype
-- boundaries: among the four numbers, and among the six words. It crosses
-- neither the string boundary, nor the time-to-number one, nor the
-- character-to-integer one.
--
-- So the same two values get two answers depending on who asked.
-- `equal? "a" %a` is true and `equal? ["a"] [%a]` is false;
-- `equal? 0:0:1 1` is true and `equal? [0:0:1] [1]` is false. The three
-- pairings where they part company are the string one, the time one and
-- the character one, and each has a Rebol assertion of its own.
--
-- This is not a tidiness problem to be fixed by making them agree. Making
-- the series functions looser makes `select [%a [1] "a" [2]] "a"` answer
-- the file's block, which Rebol's own suite asserts against.
rule SeriesFunctionsCrossFewerDatatypeBoundaries {
    when: EvaluateComparison(request)
    requires: request.asked_by_a_series_function
    requires: request.left.datatype != request.right.datatype
    requires: not (is_number(request.left) and is_number(request.right))
    requires: not (is_word(request.left) and is_word(request.right))
    ensures: ComparisonHolds(holds: false)
}

-- The four number datatypes compare as numbers whichever pair of them
-- meets, so all sixteen combinations of integer, decimal, percent and
-- money answer about the amounts. `97 = 97.0`, `97 = 9700%` and
-- `$1 = 1` are all true.
rule NumbersCompareAcrossTheirDatatypes {
    when: EvaluateComparison(request)
    requires: request.coerces
    requires: is_number(request.left) and is_number(request.right)
    ensures: ComparisonHolds(holds: holds(request.strictness,
        amount_of(request.left), amount_of(request.right)))
}

-- A time compares as its length in seconds, so `0:0:1 = 1` and
-- `0:0:1 < 2.0`. It meets an integer, a decimal and a percent this way and
-- does not meet a money, so `equal? 0:0:1 $1` is false rather than true.
rule TimeComparesAsItsSeconds {
    when: EvaluateComparison(request)
    requires: request.coerces
    requires: is_time(request.left) or is_time(request.right)
    ensures: ComparisonHolds(holds: holds(request.strictness,
        seconds_of(request.left), seconds_of(request.right)))
}

-- A character meets an integer and no other number, so `#"a" = 97` is
-- true while `#"a" = 97.0` is false and `#"a" < 98.0` refuses to answer.
-- The three excluded types are excluded on purpose: comparing a code point
-- against a fraction or an amount of money is a question with no sensible
-- answer, and the loose form of it is a typo that would otherwise pass.
rule CharacterComparesWithAnIntegerAndNothingElseNumeric {
    when: EvaluateComparison(request)
    requires: request.coerces
    requires: is_char(request.left) and is_integer(request.right)
    ensures: ComparisonHolds(holds: holds(request.strictness,
        codepoint_of(request.left), amount_of(request.right)))
}

-- Strict equality and sameness mind the datatype before they look at the
-- value, so two different datatypes are not equal whatever they hold.
-- `97 == 97.0` is false, and so are `1 == 1.0`, `$1 == 1` and
-- `#"a" == 97`. This is the whole difference between == and =.
rule StrictComparisonMindsTheDatatype {
    when: EvaluateComparison(request)
    requires: request.strictness in {strict_equal, same}
    requires: request.left.datatype != request.right.datatype
    ensures: ComparisonHolds(holds: false)
}

-- Two datatypes that do not coerce are simply not equal. Asking whether a
-- character equals a string, or an integer equals a pair, answers false
-- rather than failing, so `#"a" <> "a"` is true and needs no TRY around
-- it.
rule UncomparableDatatypesAreNotEqual {
    when: EvaluateComparison(request)
    requires: not request.coerces
    requires: not request.refuses_to_answer
    ensures: ComparisonHolds(holds: false)
}

-- Ordering the same two values raises instead, because there is no false
-- answer to "is this one below that one" when the question does not apply.
-- `#"a" < "a"`, `90 < 1x1` and `0:0:0 < "a"` all raise invalid-compare.
rule OrderingUncomparableDatatypesRaises {
    when: EvaluateComparison(request)
    requires: request.refuses_to_answer
    ensures: ComparisonFailed(failure: invalid_compare)
}

-- An object is never ordered, whatever it holds, so `>` and `<` on two of
-- them raise invalid-compare rather than comparing field by field.
rule ObjectsRefuseToBeOrdered {
    when: EvaluateComparison(request)
    requires: request.strictness in {greater_or_equal, greater}
    requires: is_object(request.left) and is_object(request.right)
    ensures: ComparisonFailed(failure: invalid_compare)
}

-- Two objects are equal when they declare the same field names in the same
-- order and each pair of values is equal. The values are compared as a
-- block's items are, so a number field coerces across its datatypes and
-- `construct [c: 1]` equals `construct [c: $1]`. Strict equality compares
-- the same fields strictly, so those two are not strictly equal.
rule ObjectEqualityComparesFieldsAsValues {
    when: EvaluateComparison(request)
    requires: request.strictness in {equal, equiv, strict_equal}
    requires: is_object(request.left) and is_object(request.right)
    ensures: ComparisonHolds(
        holds: field_names_of(request.left) = field_names_of(request.right)
            and field_positions_of(request.left).all(at => holds(request.strictness,
                    field_value_at(request.left, at), field_value_at(request.right, at))))
}

-- How far apart two decimals may be and still be equal, counted in steps
-- of the floating point representation rather than as a fixed amount, so
-- the allowance scales with the size of the numbers.
--
-- Twenty-one for `equal` and none at all for `equiv`. The twenty-one is
-- not a round number and not a guess: it is the smallest allowance under
-- which `100% // 3% = 1%` is true, which is the assertion Rebol's own
-- source cites beside the constant.
rule EqualAllowsTwentyOneStepsBetweenDecimals {
    when: EvaluateComparison(request)
    requires: request.strictness = equal
    requires: is_decimal(request.left) or is_decimal(request.right)
    ensures: ComparisonHolds(
        holds: representation_steps_between(request.left, request.right) <= 21)
}

rule EquivAllowsNoStepsBetweenDecimals {
    when: EvaluateComparison(request)
    requires: request.strictness = equiv
    requires: is_decimal(request.left) or is_decimal(request.right)
    ensures: ComparisonHolds(
        holds: representation_steps_between(request.left, request.right) = 0)
}

-- A NaN is a number that is not equal to itself, and the four strictnesses
-- disagree about whether to say so. `equal` and `equiv` allow a step
-- count only between real numbers, so both call two NaNs equal only where
-- the allowance is more than nothing: `1.#NaN = 1.#NaN` is true and
-- `equiv? 1.#NaN 1.#NaN` is false. `strict_equal` compares the bits and
-- excludes a NaN by name, so `1.#NaN == 1.#NaN` is false. `same` compares
-- the bits with no exclusion, so `same? 1.#NaN 1.#NaN` is true.
--
-- No two of the four agree, which is why each is written down rather than
-- derived from another.
rule NotANumberIsEqualAndNotStrictlyEqualToItself {
    when: EvaluateComparison(request)
    requires: is_not_a_number(request.left) and is_not_a_number(request.right)
    ensures: ComparisonHolds(holds: request.strictness in {equal, same})
}

-- === Two names, two different functions ====================

-- SIN is not a short name for SINE. They are different functions that
-- happen to compute the same curve, and they disagree on both of the
-- things that matter:
--
--   sine 90    is 1.0                 -- degrees
--   sin 90.0   is 0.893996663600558   -- radians
--   sin 90     raises expect_arg      -- decimals only
--
-- The long names take degrees and accept a whole number. The short ones
-- take radians and refuse anything but a decimal. The same split runs
-- through COS and COSINE, TAN and TANGENT, ASIN and ARCSINE, ACOS and
-- ARCCOSINE, ATAN and ARCTANGENT, and SQRT and SQUARE-ROOT -- the last
-- of which has no angle at all and still refuses `sqrt 16` while
-- answering `square-root 16`.
--
-- Naming one as an alias of the other is a plausible reading and gives
-- an implementation that is wrong by a factor of fifty-seven for every
-- angle. Neither pair may be defined in terms of the other.
--
-- ATAN2 belongs with the short names: two decimals, whole numbers
-- refused.
-- === Counting from zero ====================================

-- REBOL series are one-based: the first item is at index 1, and INDEX?
-- of a fresh series is 1. There is a second family of natives that
-- counts from zero instead, spelled with a z: ATZ, INDEXZ?, PICKZ and
-- POKEZ. They exist for code talking to something that counts from zero
-- and are otherwise the same operations.
--
-- Both families are present at once, which is the trap. `pick b 1` and
-- `pickz b 1` are different items, and neither spelling is wrong. Code
-- that mixes them is off by one in a way that reads as correct.
--
-- ATZ clamps rather than raising. A position past the tail gives the
-- tail and a negative one gives the head, so `atz [1 2 3] 4` is the
-- empty tail and `atz [1 2 3] -1` is the whole series. That is the same
-- clamping SKIP does, and it is why neither of them has an out-of-range
-- failure.
rule ZeroBasedPositionsClampAtBothEnds {
    when: EvaluateAtz(series, position)
    ensures: SeriesPosition(
        index: clamp(position, 0, series.length))
}

-- AT and SKIP read their offset the way every native that takes a count
-- does: an integer as it stands, and a decimal or a percent truncated
-- towards zero, so `skip s 1.9` moves one.
--
-- And a logic, where true counts one and false counts two. That is not a
-- typo. The C is `n = (VAL_LOGIC(val) ? 1 : 2)`, so `skip [1 2 3] false` is
-- [3] and `at [1 2 3] false` is [2 3], while the same calls with true move
-- one and none respectively. No reading of "false means nothing" or "false
-- means zero" gives that, and nothing in the language explains it; it is
-- behaviour to reproduce rather than to rationalise, and it is the sort of
-- thing an implementation quietly gets wrong because the sensible answer
-- looks obvious.
rule AnOffsetCountsAnIntegerATruncatedNumberOrALogic {
    when: EvaluateCall(verb, series, offset)
    requires: verb in {at, skip}
    requires: is_number(offset) or is_logic(offset)

    ensures: the_offset_counted(verb) =
        if is_logic(offset): (if offset: 1 else: 2)
        else: truncated(offset)
}

-- A pair is an offset only into an image, where two numbers name a column
-- and a row. A flat series has one dimension and nothing to do with the
-- second number, so it raises invalid-arg rather than taking one half.
rule APairIsAnOffsetOnlyIntoAnImage {
    when: EvaluateCall(verb, series, offset)
    requires: verb in {at, skip}
    requires: is_pair(offset)
    requires: not is_image(series)

    ensures: CallFails(error: invalid_arg, about: offset)
}

-- Writing one element by number refuses an index outside the series.
-- Confirmed against a real R3: for a three-element series, POKE at 1 and
-- at 3 both work, and 0, -1 and 4 all raise out-of-range. An empty
-- series refuses every index, including 1.
--
-- Reading does not. `pick [1 2 3] 4` is none, and so are `pick` at 0 and
-- at -1. So POKE and PICK part company on the same index, and the split
-- is reading against writing rather than anything about the number: a
-- question about an element that is not there has an answer, and a
-- demand to change one does not.
--
-- Worth stating beside the clamping rule above, because three natives
-- given the same out-of-range number do three different things. AT
-- clamps, PICK shrugs, POKE raises. Each is right for what it is asked,
-- and none of it is guessable.
rule WritingAnElementOutsideTheSeriesRaises {
    when: EvaluatePoke(series, index)
    requires: index < 1 or index > series.length
    ensures: Raises(id: out_of_range)
}

rule ReadingAnElementOutsideTheSeriesGivesNone {
    when: EvaluatePick(series, index)
    requires: index < 1 or index > series.length
    ensures: PickResult(value: none)
}

-- The same rule covers a record width on a BLOCK, which is an element count
-- and so has the same lower bound. `select/skip [1 2 3 4 5 6] 5 -4` and the
-- same with 0 both raise, rather than being read as "backwards" or "no step".
-- A block reads its width with a floor of one, so anything below one is out
-- of range.
--
-- A string and a binary do not share that floor, and the sub-one case parts
-- company by series type -- specified in the sibling rule below. This is a
-- block rule.
--
-- Searching backwards is the exception, and it is a real one rather than
-- an oversight. FIND/REVERSE is already walking towards the head, so a
-- negative width is not a contradiction there: `find/reverse/skip tail
-- "acde" (a bitset holding #"c") -2` finds "cde", and so does the same
-- call with 2. A width of zero under /REVERSE answers none rather than
-- raising. Confirmed against a real R3, all three.
rule NonPositiveStepSizeOnABlockRaises {
    when: EvaluateSkippingSearch(series, step)
    requires: is_block(series)
    requires: step < 1
    requires: not searching_backwards
    ensures: Raises(id: out_of_range)

    @guidance
        -- Zero is the one that catches an implementation out: a step of
        -- zero reads as "do not move", and a search that does not move
        -- does not end. JEBOL's SELECT looped on it until this rule
        -- existed, and no wall-clock bound stopped it, because nothing
        -- inside a native's own loop asks whether to keep running.
}

-- On a string or a binary, a sub-one forward width is not an error. A width
-- of zero answers none, and a negative forward width walks the index below
-- the head and answers none there too. So `find/skip "acdcde" "cd" 0` and
-- `find/skip "acdcde" "cd" -3` are both none, where the same shapes on a
-- block raise.
--
-- The split is not a decision so much as which function reads the width. A
-- block reads it with a floor of one and traps below; a string and a binary
-- read it plainly, so a zero short-circuits to none and a negative one is a
-- step that carries the search off the front of the series before it can
-- match. Reading the two the same way makes one of them wrong: a raise where
-- R3 answers none, or a hang where R3 refuses.
rule ASubOneForwardWidthOnAStringOrBinaryAnswersNone {
    when: EvaluateSkippingSearch(series, step)
    requires: is_string(series) or is_binary(series)
    requires: step < 1
    requires: not searching_backwards
    ensures: SearchResult(value: none)
}

-- A reverse or last search steps one element at a time, whatever the width.
-- Combining /skip with /reverse or /last forces the step to one and ignores
-- the width entirely, so `find/skip/reverse tail "acd000cde" "cd" -3` finds
-- the "cd" at every position going back, not every third, and answers "cde",
-- and `select/skip/last [a b a c] 'a 2` walks back one at a time to the last
-- 'a and answers the element after it, 'c.
--
-- One line of the C does it -- `if (flags & (AM_FIND_REVERSE | AM_FIND_LAST))
-- skip = -1;` -- overwriting whatever width was given. Reading /skip as the
-- step for a reverse or last search is the natural mistake and it makes both
-- miss: a width of three steps past the very match they were looking for.
rule AReverseOrLastSearchStepsOneAtATime {
    when: EvaluateSkippingSearch(series, step)
    requires: searching_backwards

    ensures: the_step_taken() = one_element
}

-- SELECT answers the value straight after the match, always. The record
-- width decides only WHERE it is allowed to look: at the first element of
-- each record and nowhere else. Without /skip it may look anywhere.
--
-- Confirmed against a real R3, and the two halves are easy to conflate.
-- `select/skip [1 2 3 4 5 6] 4 3` is 5, not 6: the width of three puts a
-- record boundary before the 4, and the answer is still the very next
-- element rather than the end of that record. An implementation that
-- returns the record's last field agrees at a width of two and disagrees
-- everywhere else, which is a hard way to find out.
--
-- A match with nothing after it answers none, and so does a value that
-- sits inside a record rather than at its start.
rule SelectAnswersTheValueAfterTheMatch {
    when: EvaluateSelect(series, wanted, width)

    requires: matched_record_start(series, wanted, width) > 0

    ensures:
        if matched_record_start(series, wanted, width) < series.length:
            SelectResult(value: element_at(
                series, matched_record_start(series, wanted, width) + 1))
        else:
            SelectResult(value: none)

    @guidance
        -- Without /skip the width is one, so every position is a record
        -- start. A default of two would quietly skip half the series and
        -- fail to find anything at an even position.
}

-- A block key matches a run of values, one for one, at a record start. With
-- /skip and a block key and no /only, the key is not a single value compared
-- against the whole record -- it is a sequence of values that each has to
-- equal the element at the same offset from the record's start.
--
-- So `select/skip [a a a b b y] [b b] 3` matches the run `b b` at the second
-- record and answers the element after the run, 'y. The record width of
-- three lines the records up as [a a a] and [b b y], and the key [b b] runs
-- against the second record's first two elements.
--
-- Compared one for one, not as one value. Reading the block key as a single
-- thing to compare against a record element never matches, because a record
-- element is one value and a block of two is not equal to it. /ONLY is what
-- asks for the whole-block reading, and this is the behaviour without it.
rule ABlockKeyMatchesARunInsideARecord {
    when: EvaluateSelect(series, key, width)
    requires: is_block(key)
    requires: not treats_the_key_as_one_value

    ensures:
        if a_record_starts_with_the_run(series, key, width):
            SelectResult(value: element_after_the_run(series, key, width))
        else:
            SelectResult(value: none)
}

-- Taking everything from an empty series gives an empty series of the
-- same kind, not a failure and not none. `take/all` on an empty block is
-- an empty block; on an empty string it is an empty string. Emptiness is
-- the ordinary case for a series, so it must not be an error path.
rule TakingEverythingFromAnEmptySeriesGivesAnEmptyOne {
    when: EvaluateTakeAll(series)
    requires: series.length = 0
    ensures: TakeResult(value: empty_series_like(series))
}

-- === Failure ===============================================

-- TRY turns a raised error into an ordinary value. It is the only thing
-- that stops an error propagating, and it is why the guarantee that no
-- failure escapes as a host exception is keepable.
rule TryProducesTheErrorAsAValue {
    when: EvaluateTry(body)
    requires: raises(body)
    ensures: TryResult(value: raised_error(body))
}

-- MAKE ERROR! from a spec block that leaves out the type or the id raises,
-- and what it raises is an Internal error whose id is invalid-error.
--
-- Either missing, not only both. `make error! []`, `make error! [code: 400]`
-- and `make error! [code: 500 type: 'math]` all reach it, the last of those
-- naming a type and no id. And the code field is ignored entirely: setting
-- it neither supplies the missing pair nor changes what happens.
--
-- Internal rather than User is what makes this findable. A User error is
-- what a script raises on purpose and carries a message rather than
-- anything to test, so an implementation that answers one here has turned a
-- malformed error into an error that looks deliberate. A script asking
-- whether its own error-building worked cannot tell the two apart.
rule MakingAnErrorWithoutATypeAndAnIdRaisesInvalidError {
    when: EvaluateCall(make, error_datatype, spec)
    requires: is_block(spec)
    requires: not names_both_a_type_and_an_id(spec)

    ensures: CallFails(error: invalid_error)
}

-- A type or an id that is a word naming nothing in the catalogue is a
-- different failure: invalid-arg, naming the word that was not found.
--
-- Worth stating beside the rule above, because the two are easy to fold
-- together and they answer different questions. Nothing named at all is the
-- shape of the spec being wrong; a name that does not resolve is the spec
-- being well formed and the name being wrong. `make error! [type: 'math id:
-- 'foo]` gives invalid-arg with arg1 `foo`, and so does a type nobody has.
rule MakingAnErrorWithANameTheCatalogueHasNotGotRaisesInvalidArg {
    when: EvaluateCall(make, error_datatype, spec)
    requires: is_block(spec)
    requires: names_both_a_type_and_an_id(spec)
    requires: not the_catalogue_has(the_type_and_id_named_by(spec))

    ensures: CallFails(error: invalid_arg,
        about: the_name_the_catalogue_has_not_got(spec))
}

-- MAKE from an existing error with a string re-messages it, and the result
-- is a User error carrying the message as its first argument.
--
-- `make e "message"` answers rather than raises, which sets it apart from
-- the two rules above: this is a well formed request. A User error is right
-- here for the same reason it is wrong there, because a message is exactly
-- what a User error is for and the caller supplied one on purpose.
--
-- The original's type and id do not survive. It is a new error that borrowed
-- an error to be made from, not the old one with different words, so code
-- that expected to keep the id has to carry it separately.
rule MakingFromAnErrorWithAStringGivesAUserError {
    when: EvaluateCall(make, subject, message)
    requires: is_error(subject)
    requires: is_string(message)

    ensures: CallResult(value: a_user_error_whose_first_argument_is(message))
}

-- Opening a plain file that is not there raises cannot-open, and the file
-- itself is the error's first argument.
--
-- The file rather than a message, so a script that caught the error can say
-- which file, retry a different one, or create it. Rebol's own error-test.r3
-- leans on that directly: after `read %nonsense` it asserts
-- `%nonsense == select e 'arg1`, and binds the catalogue entry to the error
-- to check the whole message reads "cannot open: %nonsense".
--
-- Cannot-open rather than a missing-scheme failure, and the difference is
-- which door was shut. A plain file path routes to the file scheme, and the
-- file scheme is one this host serves; what is missing is the file. Reaching
-- for the no-scheme failure here answers a question nobody asked and sends
-- whoever reads the error looking for a protocol that was never involved.
--
-- READ reaches it as readily as OPEN does, because reading a path that is
-- not already an open port opens it first.
rule OpeningAFileThatIsNotThereRaisesCannotOpen {
    when: EvaluateCall(verb, target)
    requires: verb in {open, read}
    requires: is_file(target)
    requires: not host_has_anything_at(target)

    ensures: CallFails(error: cannot_open, about: target)
}

rule TryPassesThroughASuccessfulResult {
    when: EvaluateTry(body)
    requires: not raises(body)
    ensures: TryResult(value: body_result(body))
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- Names are unique, because a name is how a native is reached.
invariant NativeNamesAreUnique {
    for first in NativeDefinitions:
        for second in NativeDefinitions:
            first != second implies first.name != second.name
}

invariant NativeNamesAreCanonical {
    for native in NativeDefinitions:
        native.name = lowercase(native.name)
}

-- Every operator has a prefix spelling of the same thing. Without that,
-- code that avoids infix could not be written, and the corpus entries
-- that pair `1 + 2` with `add 1 2` would be comparing different
-- behaviours rather than the same one reached two ways.
invariant OperatorsHaveAPrefixTwin {
    for native in NativeDefinitions:
        native.is_operator implies native.prefix_twin != null
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface BuiltInFunctions {
    exposes:
        NativeCategory
        NativeDefinition
        ComparisonStrictness
        ComparisonRequest
        DivisionDefinition
        QueryShape
        StringMoldForm
        FileWriteRequest
        FileReadRequest
        ProgramCall

    @guarantee AFileReadsAsItsBytesUntilTextIsAskedFor
        -- READ answers a binary holding exactly what was stored. Text is
        -- what /string asks for, and it decodes the bytes as UTF and
        -- standardises the line endings on the way.
        --
        -- Decoding by default is the wrong direction to be wrong in, and
        -- silently so. An image read as text comes back as a string of
        -- replacement characters that compares, molds and writes back as
        -- though nothing had happened, so the corruption survives every
        -- check a script could make and only shows up in the file.

    @guarantee ACaptureIsAnAppendToTheCallersOwnSeries
        -- /output and /error do not answer what a program printed. They take
        -- a series the caller already holds and add the program's output to
        -- the end of it, so the caller's own buffer grows and the caller
        -- clears it between calls.
        --
        -- Reading it as "a way of getting the output back" gives a native
        -- that answers a fresh string, and that shape cannot express what
        -- Rebol's own suite does on its first page: two buffers passed at
        -- once for the two streams, cleared before each call, and read after.
        -- It also loses the ability to point both streams at one series and
        -- get them interleaved.
        --
        -- Because a capture must be complete before it can be handed over,
        -- asking for one at any of the three ends makes the call wait,
        -- whether or not /wait was named.

    @guarantee ARefusalToStartIsNotAnExitCode
        -- A system that would not start the program at all is a different
        -- outcome from a program that started and failed, and CALL keeps
        -- them apart. Without /info a refusal raises; with /info it is a
        -- field on the object, beside the process number.
        --
        -- So /info changes whether a failure to start arrives as a value or
        -- as an error, which is the reason to ask for it. Folding the two
        -- together would let a script test an exit code and conclude a
        -- program had failed on its own terms when it never ran.

    @guarantee AWriteReplacesOnlyWhenNobodySaidWhere
        -- A plain write replaces the file and a write that named a
        -- position does not. So `write/seek` and `write/append` both leave
        -- everything they did not write over, and both still create a file
        -- that is not there.
        --
        -- This is the one that costs data when it is wrong. A seek that
        -- truncates loses the tail of a file the caller was patching, and
        -- nothing in the answer says so: the path comes back either way.

    @guarantee ThreeWriteRefinementsAreAcceptedAndChangeNothing
        -- /binary, /all and /allow are accepted by a file write and change
        -- none of its bytes. A caller may name them and gets what the same
        -- call without them would have given.
        --
        -- Both directions are wrong. Refusing them stops a script that
        -- named one for a port kind that does read it, and honouring one
        -- of them quietly changes what lands in the file.

    @guarantee QueryAnswersInTheShapeItWasAsked
        -- The shape of QUERY's second argument decides the shape of its
        -- answer: a word gives the fact bare, none gives an object of all
        -- six, and a block gives a block. In the block form a plain word
        -- labels its own value with a set-word and a get-word does not, so
        -- `query %a [type size]` and `query %a [:type :size]` are two
        -- different answers to the same question.

    @guarantee ThreeRemaindersUnderFourNames
        -- REMAINDER, MOD, MODULO and MODULO/FLOOR are four spellings of
        -- three different answers, and the names do not sort into the
        -- definitions the way anyone guesses. REMAINDER and MOD are one
        -- answer; MODULO is a second; MODULO/FLOOR is a third. All four
        -- agree on every pair of positive numbers, so a wrong pairing
        -- passes every test written without a negative in it.

    @guarantee ComparisonIsOneAnswerAskedTenWays
        -- All ten comparison natives reach one comparison, and the
        -- strictness is the only thing that differs between them. An
        -- implementation that answers each native separately drifts: the
        -- operator and the word it is a twin of start disagreeing, and the
        -- disagreement shows up first on a cross-datatype call nobody
        -- wrote a test for.

    @guarantee ConditionalTruthIsOneRule
        -- Every native that asks whether a value is true gets the same
        -- answer: only NONE and logic FALSE are false. No native has its
        -- own notion of truth.

    @guarantee ADeclaredTypeMayNameSomethingNothingCanMakeYet
        -- A native's accepted datatypes are its published shape, and they
        -- include datatypes nothing in JEBOL can currently make. COPY accepts
        -- an action, a closure, a command, a rebcode and a struct; IN accepts
        -- a task beside the objects.
        --
        -- A real R3 does the same. Nothing in a stock Rebol makes a rebcode
        -- either, and its COPY still declares one, so a script reflecting on
        -- COPY sees the same accepted set from either.
        --
        -- Narrowing each declaration to what can be made today is the
        -- tempting alternative and it is worse. The published shape would
        -- then drift every time a datatype landed, and a script asking what
        -- COPY accepts would get a different answer here than from Rebol for
        -- no behavioural reason at all.

    @guarantee ANativeDeclaresItsRefinements
        -- A native declares its refinements and is told which of them the
        -- caller asked for, exactly as a user function is. It does not get
        -- a separate entry per refinement, and a refinement it does not
        -- declare raises no_refine.
        --
        -- Registering copy/part as its own native worked while there were
        -- three of them and stopped working at nine: FIND alone takes
        -- /any, /tail, /last, /same, /part, /skip, /case, /reverse and
        -- /only, and a caller may combine them, so one entry per
        -- combination is five hundred entries for one native. Rebol's own
        -- suite reaches roughly six hundred assertions through
        -- refinements that arrangement could not express.
        --
        -- A refinement may carry an argument, and only when it was asked
        -- for: TAKE takes one value and TAKE/PART takes two. Counting
        -- those unconditionally would make every plain call demand values
        -- it has no use for.

    @guarantee ThePreludeIsIndistinguishableFromANative
        -- A prelude function is reached, called, molded and rebound
        -- exactly as a native is. A caller cannot tell which layer a
        -- function came from, and nothing in the language depends on
        -- knowing, so a function may move between the layers without any
        -- script noticing.

    @guarantee ThePreludeIsEvaluatedBeforeAnyScript
        -- It is evaluated once when the interpreter is built, into the
        -- context the natives are in, so its functions see the natives and
        -- each other. A failure while evaluating it is a defect in JEBOL
        -- rather than something a script did, and it is raised as one
        -- rather than leaving an interpreter half-built.

    @guarantee NativesAreOrdinaryFunctions
        -- A native gathers arguments, type-checks them and raises exactly
        -- as a user function does. Nothing about being built in changes
        -- how it is called, which is why :print can be assigned to
        -- another word and called through it.
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

-- Resolved: the list is pinned by the corpus rather than written out
-- here. There are 113 of them, each reached by at least one entry, and a
-- native with no entry is a native that does not exist. The count moved
-- from forty as the milestones landed, which is why naming it here would
-- have gone stale.

-- Resolved against a real R3: TO-STRING runs a block's values together
-- with no separator, so to-string [1 2 3] is "123". Putting spaces
-- between them is FORM's job, and form [1 2 3] is "1 2 3". The two are
-- easy to conflate because they agree on every value that is not a
-- series, and the corpus had them conflated until the binary was asked.

-- Resolved against a real R3: converting a string to an integer fails in
-- three distinguishable ways, and which one you get depends on the text
-- rather than on the call. Leading and trailing whitespace is trimmed
-- first. Nothing left after trimming is too_short. Whitespace still
-- inside what remains is invalid_chars, so "1 2" and "a b" fail alike.
-- Anything else that will not parse is bad_make_arg. A quote is a digit
-- separator, so "1'000" is 1000, and a leading + or - is accepted.
-- A decimal is truncated toward zero rather than rejected.

-- Resolved against a real R3: FORALL leaves the series at its head, not
-- at its tail. It walks the series to the end and then puts the word
-- back where it found it. The guide's habit of writing HEAD after every
-- FORALL is what suggested otherwise, and that habit is a leftover
-- rather than a necessity.

-- Resolved against a real R3: SYSTEM is an object holding what the
-- interpreter knows about itself, reached by path: system/catalog holds
-- the datatypes and the error catalogue, system/options what the host
-- chose, system/version which build this is.
--
-- The catalogue is not decoration. REBOL's own library reads it and
-- builds itself out of what it finds: base-defs.reb walks
-- system/catalog/reflectors and defines SPEC-OF, BODY-OF, WORDS-OF,
-- VALUES-OF, TYPES-OF and TITLE-OF from it, one per entry, rather than
-- writing six functions out. base-series.reb walks
-- system/catalog/bitsets to define the named character sets, and
-- base-constants.reb reads system/contexts to name the two contexts it
-- works in.
--
-- So a missing catalogue field is not a missing field. It is every
-- function that would have been generated from it, and the ones
-- generated from those in turn. Six of eighty-two mezzanine files load
-- today, and the commonest reason the rest do not is a path into SYSTEM
-- that resolves to nothing.
--
-- It is data rather than a function, which is why nothing here had it: a
-- native set is a list of things to call, and this is a thing to read. A
-- script asks it what datatypes exist rather than being told, and
-- Rebol's own library reaches for it in six of its files.

-- Resolved against a real R3: USE makes a context holding the words it
-- is given, binds the block to it, and evaluates it there. A word named
-- in the USE shadows an outer one of the same name and the outer one is
-- untouched afterwards, which is what makes it a scope rather than an
-- assignment.
--
-- It is how REBOL scopes local words outside a function, so a library can
-- keep its working names to itself. Its absence is why several of Rebol's
-- own library files would not load.

-- Resolved: BIND given a single word answers the same question BIND
-- given a block answers, one word at a time. A word it can place comes
-- back naming the context that holds the slot, not the target it was
-- asked through. The two halves of one function disagreeing about where
-- a word lives is the sort of thing that only shows up much later, in
-- code that asks where a word lives and then writes there.

-- Resolved against a real R3: UNBIND takes the binding off its words, and
-- the word comes back loose. So `unbind 'x` no longer reaches the slot x
-- pointed at, and `unset unbind 'x` raises not-defined rather than clearing
-- that slot -- an unbound word has no slot to reach.
--
-- A block has each of its words unbound, and /DEEP reaches the words inside
-- the blocks it holds; without /DEEP only the top level comes loose. So
-- unbinding a block of code detaches its words from wherever they were bound,
-- which is what lets a caller rebind the same block into a fresh context
-- rather than leaving it pointing at the old one.
--
-- It was a no-op stub that answered its argument unchanged, which is the
-- worst kind of wrong for a binding operation: the words looked unbound to a
-- caller reading the block back and were still bound underneath, so a later
-- SET reached a slot the caller thought it had detached.

open question "Refusing a body to a native comes back under two different error ids in the C, depending on how the make was written, and it is not settled that JEBOL should keep them apart. The prototype form `make :read [[][]]` reaches Copy_Function, which returns FALSE for a value that is not a function or closure, and the make arm reports that with Trap_Reflect -- cannot-use, arg1 the definition block. The datatype form `make native! [[][]]` and `make action! [[][]]` never reach Copy_Function: Make_Function refuses REB_NATIVE and REB_ACTION outright and the arm reports that with Trap_Make -- bad-make-arg, arg1 the type. Same mistake, two doors, two ids. MakingFromANativePrototypeWithABodyIsRefused specifies the prototype form as cannot-use, matching the C for the case the suite exercises and the derivation contrast turns on. What is undecided is whether JEBOL should reproduce the datatype form's bad-make-arg as faithfully, or unify the two on one id on the grounds that a script cannot tell which arm it hit and the distinction is an artefact of the C's control flow rather than a fact about the value. It wants measuring against a real R3 on all three spellings before either is built."

open question "What does QUERY with a none field answer -- the information object, or the list of modes the port supports? The spec says the object, resolved earlier against a real R3, and QueryingWithNoneAnswersAnObject states it. The C disagrees: its A_QUERY arm answers the modes list, and actions.reb documents the argument as `NONE will return valid modes`. Two authorities and they cannot both be describing the same call, so one of three things is true: the measurement was of a build that differs, the modes answer belongs to a port that is open where the object answer belongs to a file path, or the C's own declaration is stale against its own code. It wants measuring again on both a file and an open port before either is trusted, because the difference is not a detail: a script reading a size off the answer gets a block of words instead."

open question "A wildcard in a path read as a directory listing in the C, and cannot-open here. `read %*.r3` in a real R3 lists the matching files, because the path goes to the directory scheme and the pattern is handed to the operating system's own matcher. JEBOL takes the path literally, finds no file spelled that way and raises cannot-open. Three things to settle before it is built: whether the matching belongs in JEBOL or in the host, given that the JVM's own path matcher and a Windows shell disagree about several patterns; whether a wildcard should list only where the path names no real file, since a file genuinely called `*.r3` is legal on every system JEBOL runs on; and whether the answer is the plain names a directory listing gives, which is what would make the two forms interchangeable. Backlogged rather than open in the sense of blocking: nothing in Rebol's own library reads a wildcard, so this costs no assertions today."

open question "What should REMOVE do to a complemented bitset? Three of the four ways of writing bits go through one inversion -- APPEND, INSERT and POKE all reach the `set_bits` label, where `if (BITS_NOT(...)) diff = !diff` turns \"hold this\" into \"clear the octet\" for a complemented set -- and REMOVE does not. It jumps straight to `Set_Bits(..., FALSE)`, so it clears the octet whatever the set's sense is, which on a complemented set means the character it was told to remove becomes one the set holds. Two readings and neither is obviously the C's intent: REMOVE is meant to clear octets rather than to remove members, in which case the asymmetry is deliberate and the name is misleading; or it is meant to remove members like every other verb and the missing inversion is an oversight nobody has hit, because complemented sets are made by COMPLEMENT and rarely written to afterwards. Worth measuring against a real R3 before either is built, since the two disagree on every call."

open question "Does /console on CALL differ observably from plain inheritance on a host that has no console? The C passes a flag and leaves the host to decide, so both readings are open. A console-less host could treat the request as ordinary inheritance, which keeps a script portable and gives the operator nothing it would not have had anyway; or it could refuse and say there is no console to attach to, which is honest and stops a script that would otherwise have worked. It matters more for JEBOL than for Rebol, because a server with no console is the ordinary case here and the opposite of the case the refinement was drawn for. The same question decides whether /console on a host that does have one is worth distinguishing from the default at all, or is only a way for a caller to say the inheritance was meant."

open question "BIND given an object and a word the object does not itself have raises in a real R3, because an object there is a flat context and the word is simply not in it. Contexts nest here, so an object reaches its parent and JEBOL places the word in whichever ancestor holds it. Matching R3 means asking an object only for its own fields, which is a change with a wide blast radius and no test pressing on it yet. Which behaviour does JEBOL want, and is the nesting an implementation detail that binding should not be able to see? Note that R3 is not consistent about this itself: given a WORD as the target rather than an object, it returns an unplaceable word unchanged instead of raising."

-- Resolved against a real R3: ROUND/TO rounds to a multiple of what it
-- is given rather than to a number of places, so `round/to 1.234 0.01`
-- is 1.23 and `round/to 17 5` is 15. One rule covers both, which a
-- decimal-places refinement would not.

-- Resolved against a real R3: MAX and MIN compare whatever they are
-- given rather than only numbers, so `max "a" "b"` is "b". They are the
-- same comparison SORT uses, reached two at a time.

-- Resolved against a real R3: SORT folds case and is stable, so
-- ["b" "A" "a" "B"] sorts to ["A" "a" "b" "B"] rather than to
-- ["A" "B" "a" "b"]. Equal keys keep the order they arrived in, which is
-- what makes a second sort on another key a usable way to sort on two.
-- /case compares exactly and puts every capital before every small
-- letter. /compare takes a function of two values and puts the first one
-- first when the answer is true or positive. /skip sorts records of that
-- many items by their first, so a flat block of pairs stays paired.

-- Resolved against a real R3: SORT/COMPARE hands the comparator values of
-- the series' own kind, not raw list items. Without /ALL the comparator sees
-- one element and with /ALL it sees a whole record, and either way the value
-- carries the datatype the series is made of.
--
-- Without /ALL: a byte of a binary arrives as the char of that code point
-- and an element of a string arrives as a char, so `sort/compare #{030201} f`
-- calls f with chars and `char? a` inside f is true. With /ALL: a record of a
-- binary arrives as a binary, a record of a string as a string, and a record
-- of a block as a block, so `sort/all/compare #{030201} f` calls f with
-- binaries and `binary? a` is true.
--
-- The ordering of the bytes is unchanged; what was wrong was only the
-- datatype the comparator saw. It handed the function the raw storage items
-- rather than values of the series' kind, which a comparator that asks
-- `char?` or `binary?` of its argument -- to decide how to compare -- would
-- catch, while one that only subtracts two numbers would not. The C's
-- Compare_Call sets a char for a single element and a string-or-binary
-- sub-series for a whole record.

-- Resolved against a real R3: PROTECT on an object protects its fields,
-- so assigning through a path into it raises locked_word exactly as
-- assigning to a protected word does. Protecting the word that holds the
-- object and protecting the object are different things, and it is the
-- second that stops o/a: 1.

-- Resolved against a real R3: the % operator divides, so dividing by zero
-- through it raises zero_divide with category math, the same as DIVIDE
-- does. It is an operator with a prefix twin like the rest.

-- Resolved against a real R3: there are five names for taking what is
-- left after a division, and they fall into two groups that disagree
-- wherever a negative is involved. Checked at every combination of signs,
-- with -7 and 3:
--
--   %, MOD and REMAINDER  answer -1
--   %% and MODULO         answer 2
--
-- REMAINDER takes its sign from the dividend, so it is what a JVM's own %
-- already does and needs no correction. MODULO is never negative at all:
-- with a divisor of -3 it still answers 2 for -7 and 1 for 7, so the
-- divisor's sign changes nothing either way.
--
-- The grouping is the reverse of what the spellings suggest twice over.
-- % is REMAINDER although the operator is called modulo everywhere else,
-- and MOD is REMAINDER although its name is the first three letters of
-- the other one. Only %% and MODULO go together.
--
-- Nothing about this is inferable, and getting it wrong is silent: the
-- two groups agree on every pair of positive operands, which is most
-- code and nearly every test. JEBOL had all three of the first group
-- answering 2.

-- Resolved against a real R3: AJOIN takes its datatype from the first
-- value, when that is one which can carry a run of text without markers
-- of its own: a file gives a file, a url a url, an email an email.
-- Everything else gives a string.
--
-- A tag is the exception worth writing down, and Rebol's own suite calls
-- it out as by design: `ajoin [<a> "b"]` is the string "<a>b", not a
-- tag, because a tag's text carries its own angle brackets and running
-- two together would produce something that no longer reads as one.
--
-- The first value decides even when it contributes nothing: `ajoin
-- [none %a 3]` is a string, because the none came first.

-- Resolved against a real R3: AJOIN drops an unset as well as a none when
-- /ALL is absent, so both vanish from the joined text. The C forms each
-- value and drops any whose datatype is at or below none, and unset sits
-- just below none, so the two go together.
--
-- A dropped unset is invisible until a separator sits beside it. `ajoin/with
-- ["a" #(unset) 3] #"/"` is "a/3", the two survivors joined by one slash
-- with no sign the unset was ever there. /ALL keeps it instead, forming it
-- as the empty string, so `ajoin/all/with ["a" #(unset) 3] #"/"` is "a//3" --
-- the empty run between the two slashes is where the unset was.
--
-- Worth stating because unset is easy to leave out. None is the obvious
-- thing to drop and a rule written for it alone passes every test without an
-- unset in it, then a PRINT or an unset word inside the block quietly
-- disappears where a real R3 dropped it too but for a reason the code did
-- not know it was matching.

-- Resolved against a real R3: JOIN keeps the datatype of what it is
-- joining onto, so `join %a "b"` is the file %ab rather than a string.
-- Joining onto something that is not a series gives a string, which is
-- why `join 'a 'b` is "ab" and not a word.

-- Resolved against a real R3: FIND on a string searches for a substring
-- rather than for a single character, so `find "abc" "b"` answers "bc".
-- Comparing one item at a time is right for a block and wrong for a
-- string, and the difference was invisible for as long as every corpus
-- entry searched a block.
--
-- Its refinements narrow or turn the search rather than changing what it
-- answers. /reverse walks backwards from the position toward the head and
-- /last walks backwards from the end; /part bounds how far it looks, so a
-- match beyond the bound is not found; /case stops folding case; /tail
-- answers the position after the match instead of at it; /only treats a
-- block needle as one value rather than as a run to match.

-- Resolved against a real R3: FIND/SAME matches by series identity rather
-- than by content, so two strings that are equal but are not the same series
-- do not match. Searching a block for a string with /SAME walks past an
-- equal copy at the head and lands on the value that is literally the one
-- looked for, further along.
--
-- Identity rather than equality is the whole of the refinement. Ordinary
-- FIND compares content, so it stops at the first equal thing; /SAME asks
-- "is this the same value" and the C answers it with Compare_Values in its
-- same-series-node mode, which only two references to one series satisfy.
--
-- It is how a caller finds the position of a value it is holding, rather
-- than of something that merely looks like it. Without /SAME a block holding
-- two equal strings gives no way to say which one, because FIND cannot tell
-- them apart; with it the shared node is found and the copy is skipped.

-- Resolved against a real R3: TO converts to whatever datatype it is
-- given, so `to integer! "12"` and `to-integer "12"` are the same call
-- reached two ways. The to-x spellings are the common conversions given
-- names; TO is the general one, and a script that computes which type it
-- wants can only use TO.
--
-- The to-x spellings are generated rather than written out, one per
-- datatype a value can actually be made of. Forty-five of R3's fifty-eight
-- get one. The thirteen that do not are END, UNSET and NONE, which hold a
-- single value each and so have nothing to convert to, and the ten the
-- interpreter keeps to itself -- NATIVE, ACTION, REBCODE, OP, FRAME, TASK,
-- HANDLE, STRUCT, LIBRARY and UTYPE. Every generated one is exactly
-- `to <type>! :value` and nothing else, so none of them can drift from TO
-- or from each other.
--
-- Eleven further to-x names exist and are not conversions in this sense at
-- all: TO-DEGREES, TO-RADIANS, TO-HEX, TO-IDATE, TO-ITIME, TO-JSON,
-- TO-LOCAL-FILE, TO-REAL-FILE, TO-REBOL-FILE, TO-RELATIVE-FILE and
-- TO-VALUE. Each takes its own arguments and several take refinements, so
-- they are separate work and not part of the family.
--
-- JEBOL's catalogue holds one datatype R3's does not, JAVA-OBJECT!. It
-- gets no to-x while the interop boundary is still unspecified.

-- Resolved against a real R3: QUOTE takes its argument as written and
-- hands it back, so `quote (1 + 1)` is the paren rather than 2. It is
-- how a value is passed on without being evaluated on the way.

-- Resolved against a real R3: SHIFT moves bits left for a positive count
-- and right for a negative one, so `shift 1 2` is 4 and `shift 8 -2` is
-- 2. One native rather than two, with the sign choosing the direction,
-- which is the same arrangement FOR uses for its step.

-- Resolved against a real R3: CONSTRUCT builds an object from a block
-- without evaluating it, so the values arrive as written. MAKE OBJECT!
-- evaluates; CONSTRUCT is for data that happens to be shaped like a
-- spec, where evaluating would be wrong or unsafe.

-- Resolved against a real R3: TAKE from a position the series no longer
-- reaches answers nothing rather than failing.
--
-- `s: next [1 2] clear head s` leaves s pointing at the second item of a
-- series that now has none. TAKE/ALL on it answers an empty series of the
-- same kind, and so does the same walk on a string or a binary.
--
-- Clamping how many to take is not enough on its own: the position it
-- starts from has to be clamped as well, or a count of zero is read from
-- an index past the end and the reading is what fails.

-- Resolved against a real R3: a binary literal may say what base it is
-- written in, and only three bases exist.
--
-- `2#{...}` is bits, `16#{...}` is hexadecimal and is what a plain
-- `#{...}` means, and `64#{...}` is base 64. Any other base raises invalid
-- naming "integer", so `8#{00}` and `10#{00}` are both refused; so is a
-- base written with a sign or with leading zeros, `+2#{}` and `0016#{FF}`.
-- The complaint is about the integer rather than about the binary, which
-- is the clue that the base is read as a number first.
--
-- Inside the braces, whitespace is ignored wherever it falls -- spaces,
-- tabs, newlines and carriage returns alike -- so a long binary can be
-- broken across lines. A semicolon starts a comment that runs to the end
-- of the line, exactly as it does in ordinary source.
--
-- A sign in front of the base is refused, and the C says why in a comment:
-- `if (cp == scan_state->begin) { // no +2 +16 +64 allowed`. The base has to
-- sit at the very start of the token, so a sign makes the whole thing a
-- malformed number.
--
-- Answered by checking both shapes rather than by moving the lexeme
-- boundary, which was the open question here. The reader ends the lexeme in
-- two different places -- it takes the hash in when a sign is present and
-- leaves it ahead when one is not -- so one check could not see both. Two
-- can, and moving the boundary would have disturbed every other reading of
-- a signed number.

-- A body that does not fill its last byte is padded rather than refused:
-- `2#{000}` and `16#{0}` are both one zero byte. An empty body is an
-- empty binary. Base 64 is the exception, and a body it cannot decode
-- raises invalid naming "binary".

-- Resolved against a real R3: COMPOSE/INTO puts the answer into the
-- target whatever the answer is, and hands back the target positioned
-- after what it put there.
--
-- Anything that is not a block composes to itself, which is right, and
-- /INTO must still insert it: `compose/into "a" x` leaves x holding the
-- string and answers x at its tail. Letting the non-block case answer
-- early skips the insertion, so the target is left untouched and the
-- caller gets the source back instead of a position.
--
-- The position matters as much as the insertion. It is what makes a run
-- of COMPOSE/INTO calls build one series, each carrying on where the last
-- stopped.

-- Resolved against a real R3: SET takes a word, a path or a block of
-- them, and refuses an issue or a refinement.
--
-- `set #ab 1` and `set /a 1` raise expect-arg. The same targets inside a
-- block raise invalid-arg instead: `set [#f][6]` and `set [/e][5]` do.
-- Two different ids for the same mistake, because the first is a wrong
-- argument to SET and the second is a wrong item inside a right argument.
--
-- An issue and a refinement both read as words at a glance, which is what
-- makes silently assigning to them plausible and wrong.

-- Resolved against a real R3: TRIM refuses two kinds of contradictory
-- request rather than picking one of them, and both raise bad-refines.
--
-- /HEAD or /TAIL says which end to work on; /ALL and /WITH say to work
-- everywhere. Asking for one of each leaves nothing coherent to do, so
-- `trim/head/all` and `trim/tail/with` are refused. /AUTO is not in that
-- quarrel and `trim/auto/tail` is a perfectly ordinary call.
--
-- /WITH, /AUTO and /LINES are about text, so a binary or a block refuses
-- all three. /HEAD, /TAIL and /ALL still work on both: a binary drops
-- zero bytes and a block drops nones, which is the same idea as dropping
-- spaces.
--
-- Ten of the fourteen TRIM assertions in the suite are these two rules and
-- nothing else, which is what a refinement combination nobody checked
-- looks like from the outside.

-- Resolved against a real R3: seven more refinements, found by comparing
-- the whole library against the binary rather than by reading failures.
--
-- COPY/DEEP copies what the series holds as well as the series, so
-- changing a nested block afterwards leaves the original alone. Without
-- it `copy` gives a new outer block whose items are the very same inner
-- ones, and a change through either is visible through both. It combines
-- with /PART: `copy/part/deep` takes the first few and copies those
-- deeply.
--
-- TAKE/DEEP is the same distinction, and it reaches the /PART take as well
-- as the single-item one. Without /DEEP the taken block holds the very same
-- nested series the source held, so `same? orig (first c)` is true and
-- mutating what was taken mutates the original. With /DEEP the taken block
-- is cloned all the way down: the nested series is a copy, `same?` is false,
-- and the source is untouched. This held for a plain TAKE already; the fix
-- was carrying /DEEP through TAKE/PART, which used to copy shallow whatever
-- the caller asked.
--
-- UPPERCASE/PART and LOWERCASE/PART change only the first few characters
-- from where the series is, counting from the position rather than from
-- the head, so `uppercase/part next "abcd" 2` is "BCd".
--
-- REVERSE/PART turns round only the first few and leaves the rest where
-- they were, so `reverse/part [1 2 3 4] 2` is [2 1 3 4].
--
-- TYPE?/WORD answers the datatype's name as a word rather than the
-- datatype itself, which is what makes it usable in a block being built.
--
-- IF/ONLY, EITHER/ONLY and UNLESS/ONLY hand the branch back without
-- running it, so `if/only true [1]` is the block [1] rather than 1. It is
-- how a caller chooses between two blocks without either being evaluated.
--
-- COPY/PART is a refinement and not a function called "copy/part". A word
-- with a slash in it answers the one call it is named for and leaves
-- every other combination raising no-refine, which is why `copy/part`
-- worked and `copy/deep` did not.

-- Resolved against a real R3: two characters compare equal without regard
-- to case, and compare in order with regard to it.
--
-- `#"a" = #"A"` is true and `#"a" == #"A"` is false, the same split a
-- string gets. But `#"a" < #"B"` is false, so the ordering is by code
-- point and folds nothing: the two questions are answered differently on
-- purpose, and a comparison that folds for both puts the letters in an
-- order nobody asked for.
--
-- The folding is not confined to the operator. Everything built on that
-- comparison inherits it, so `switch #"a" [#"A" [1] #"a" [2]]` takes the
-- first branch, and SELECT and FIND find the capital when asked for the
-- small letter. /CASE turns it off where it is offered.
--
-- A character is not a one-character string, so `#"a" = "A"` is false.

-- Resolved against a real R3: INDEX? and LENGTH? answer none for none
-- rather than refusing, and EMPTY? answers true. Nothing else in that
-- family is so forgiving -- FIRST, LAST, HEAD, TAIL, NEXT and BACK all
-- raise -- so this is three named exceptions rather than a rule about
-- none, and code that leans on it is asking about a series it may not
-- have got.

-- Resolved against a real R3: LOAD reads a string, a binary or a block of
-- either, not only a string.
--
-- A binary is read as UTF-8, and a byte order mark at the front is
-- dropped rather than becoming part of the first value. So
-- `load #{EFBBBF223322}` and `load #{223322}` both answer the string "3".
--
-- A block is a block of sources rather than something to load. Each item
-- is loaded on its own and its answer added as a single item, so
-- `load ["1" "2"]` is `[1 2]` and `load ["print 'a" "print 'b"]` is
-- `[[print 'a] [print 'b]]` -- the second nests because each of those
-- sources holds two values and so loads as a block. An item that is not a
-- source raises expect-arg: `load [1]` does.
--
-- Loading nothing answers an empty block rather than failing, for a
-- string and a binary alike.
--
-- /ALL is a refinement rather than a second function. Source holding
-- exactly one value loads as that value, and /ALL turns that off, so
-- `load "1"` is the integer and `load/all "1"` is a block holding it.

-- Resolved against a real R3: = on two decimals allows the last few bits
-- to differ, and == does not. `0.5 = cosine 60` is true even though
-- `cosine 60` is 0.5000000000000001, and `(0.1 + 0.2) = 0.3` is true even
-- though the sum is 0.30000000000000004.
--
-- The allowance is counted in steps of the floating point representation
-- rather than as a fixed amount, so it scales with the size of the
-- numbers: twenty-one steps apart or fewer is equal, and more is not.
-- At the boundary, 1.0 equals 1.0000000000000047, which is twenty-one
-- steps above it, and does not equal 1.0000000000000049, which is
-- twenty-two.
--
-- Twenty-one was read from Rebol's own source rather than probed. An
-- earlier reading of ten made every assertion here pass and made
-- `100% // 3% = 1%` fail, which is the one Rebol's comment cites beside
-- the constant.
--
-- A fixed tolerance would be wrong in both directions at once, too coarse
-- for small numbers and far too fine for large ones.
--
-- == and SAME? are exact and mind the datatype as well, so
-- `0.5 == 0.5000000000000001` is false and so is `1 == 1.0` while
-- `1 = 1.0` is true. A zero equals a negative zero under both. The two
-- part company over NaN: `1.#NaN == 1.#NaN` is false and
-- `same? 1.#NaN 1.#NaN` is true, because == excludes a NaN by name before
-- it looks at the bits and SAME? does not.
--
-- This is not a detail of the arithmetic natives. Every assertion in a
-- test suite that computes a decimal and compares it to a written-out one
-- depends on it, and an exact comparison fails most of them for reasons
-- that look like arithmetic bugs.

-- Resolved against a real R3: seven refinements JEBOL had not got. Each
-- has to be written down with what the plain call does beside it, because
-- a refinement that is accepted and then changes nothing looks right from
-- every angle but that one.
--
-- CASE/ALL runs every branch whose condition is truthy rather than
-- stopping at the first, and answers the last one it ran. With no
-- condition truthy it answers none, and a branch whose block is empty
-- makes the whole thing answer unset.
--
-- GET/ANY answers unset for a word whose slot holds nothing, where plain
-- GET raises no-value. It is how code asks whether a word has a value
-- without having to catch an error to find out.
--
-- REDUCE/NO-SET leaves a set-word or set-path where it stands and reduces
-- only what follows it, so `reduce/no-set [x: 1 + 2]` is `[x: 3]` and
-- assigns nothing. Plain REDUCE performs the assignment and drops the
-- set-word, leaving `[3]`.
--
-- The trigonometric natives take degrees by default and /RADIANS switches
-- them to radians, both for the six that take an angle and for the three
-- that answer one: SINE, COSINE, TANGENT, ARCSINE, ARCCOSINE and
-- ARCTANGENT.
--
-- SHIFT/LOGICAL shifts without regard to sign, filling with zeros from
-- whichever end, so `shift/logical 1 63` is the most negative integer and
-- `shift/logical -9223372036854775808 -64` is 0. Plain SHIFT keeps the
-- sign, so a right shift of a negative number stays negative.
--
-- PUT/CASE matches its key exactly rather than folding case, so a block
-- holding both "A" and "a" has two separate entries to a PUT/CASE and one
-- to a plain PUT.
--
-- SELECT/SAME compares by identity and by exact datatype rather than by
-- value. 1, 1.0 and 100% are three different keys to it and one key to
-- plain SELECT, and on a string it stops folding case.

-- Resolved against a real R3: DO of an error value raises it.
--
-- Rebol's own CAUSE-ERROR is written as `do make error! [...]` and
-- nothing else, thus every call to it depends on this. Answering the
-- error as a value makes CAUSE-ERROR do nothing at all.
--
-- The failure is hard to see because it looks right. TRY of the call
-- still gives back an error value, so `error? try [...]` still holds. It
-- shows only when something follows the call: the value is dropped and
-- the script carries on as though nothing went wrong.
--
-- Found while porting ENUM, whose ASSERT raises this way. Four other
-- explanations were tried and measured away first -- the function body,
-- FIND, UNLESS and VALUES-OF were each blamed and each cleared -- because
-- the probes were read from a console that interleaves its prompts with
-- what a script prints. A probe must print a label and be run through the
-- same file on both sides, or it proves nothing.

-- Resolved against a real R3: CONTINUE stops the round a loop is in and
-- starts the next, where BREAK stops the loop.
--
-- The two are caught in different places and that is the whole of the
-- difference: a break around the whole walk, a continue around each turn
-- of it. A CONTINUE caught where BREAK is would end the loop, which makes
-- the two words the same.
--
-- A round that was cut short answers none, so a loop whose last round
-- continued answers none rather than whatever the round before it left.
--
-- Either may sit several blocks deep inside the body, which is why both
-- are thrown rather than returned: every step in between would otherwise
-- have to carry the news back.

-- Resolved against a real R3: /ANY reads the needle as a shape rather
-- than as text to find. A question mark stands for one character and a
-- star for any run of them, including none.
--
-- The match may then be longer or shorter than the needle, so what comes
-- after it cannot be worked out by counting characters: `select/any
-- "abcde" "*d"` answers the e, which means the star stopped at the d
-- rather than running to the end. Only those two characters mean
-- anything; everything else in the needle is itself, so a needle holding
-- a dot looks for a dot.
--
-- FIND/SAME minds case for the same reason /CASE does: a capital is not
-- the same character as a small letter. Minding case means minding the
-- datatype as well, so 1, 1.0 and 100% stop being one another.

-- Resolved against a real R3: PROTECT/HIDE conceals a field rather than
-- locking it, and the two are separate: a hidden field is not locked and
-- a locked one is not hidden.
--
-- The object stops listing the field in WORDS-OF and BODY-OF, stops
-- molding it, and a path to it raises invalid-path as though there were
-- no such field. Code written inside the object still reaches it, which
-- is the whole point -- it is how an object keeps something to itself,
-- and without that hiding would be the same as removing.
--
-- Nothing outside may write over it either: EXTEND, APPEND and PUT all
-- raise `hidden` for that name, while any other name is added as usual.
-- Allowing it would let something outside replace what the object was
-- keeping, and the object's own code would then find something else
-- there.

-- Resolved against a real R3: PROTECT given a path protects the field
-- the path names, and nothing else. `protect 'o/a` makes `o/a: 9` raise
-- locked-word while `o/o/a: 9` stays free, and the word `o` in the
-- enclosing scope is still assignable afterwards.
--
-- A path is a block of words, so a PROTECT that reads its target as a
-- list of names finds `o` and `a` and protects whatever those words are
-- bound to where they were written. That protects the outer `o` rather
-- than the field, and every later `o: something` then fails quietly --
-- which reads as though the object is protected when it is the name that
-- is. Six assertions in the suite's UNPROTECT group failed on that one
-- line, all of them several tests later.
--
-- A path that names nothing does nothing and raises no error:
-- `protect 'o/missing` and `protect 'o/a/deeper`, where o/a is a number
-- and cannot be walked into, both answer the path and change no state.

-- Resolved against a real R3: protecting an object gives two different
-- failures depending on how the change was attempted, and both are
-- REBOL errors rather than host exceptions.
--
-- Assigning through a name raises locked-word: `set in p 'a 99` and
-- `p/a: 5` both do. Changing it as a container raises protected:
-- `append p [a: 2]` and `put p to-set-word 'a 2` both do. PUT belongs
-- with APPEND and not with the assignments, and it asks the same single
-- question APPEND asks: is the object open to new names. Whether the
-- word is already there makes no difference, so after UNPROTECT/WORDS,
-- which releases the words but not the object, `o/a: 0` succeeds while
-- `put o to-set-word 'a 0` is still refused. Asking instead whether any
-- slot happened to be protected answers neither question and lets EXTEND
-- through, since EXTEND is written in terms of PUT.
--
-- So the error names the route rather than the
-- object, which is why the value layer cannot choose it -- it knows only
-- that the change is refused, and the layer that knows what was being
-- attempted turns that into one error or the other.
--
-- JEBOL threw a Java IllegalStateException for all three, which
-- spec/embed.allium says cannot happen.

open question "PROTECT/HIDE takes a field out of WORDS-OF and makes the path to it raise invalid-path rather than reading it. Confirmed against a real R3: after hiding `a`, `words-of` gives [test], `o/a` raises invalid-path, and `append o [a: 2]` raises hidden. JEBOL accepts the call and hides nothing. Is hiding a property of the slot, of the context, or of the object, and what should REFLECT do with a hidden field -- omit it as WORDS-OF does, or report it?"

-- Resolved against a real R3: SAME? on two objects asks whether they are
-- one object, not whether they hold the same fields. `make base
-- (an empty object)` gives an object that is EQUAL? to base and not
-- SAME? as it. An implementation that compares fields for both answers
-- true twice and loses the only question SAME? exists to answer.
--
-- The same distinction series already have, where SAME? means shared
-- storage at the same position rather than matching contents.

-- Resolved against a real R3: MAKE given a prototype and a second OBJECT
-- rather than a block merges the two. The result holds the prototype's
-- fields, with the second object's values written over the ones they
-- share and its extra fields added. The prototype is not touched.
--
-- Methods come along and are rebound to the result, so they see the
-- merged values rather than the ones they were written against. That is
-- the part worth stating: with `o1: make object! [a: 1 f: does [a]]` and
-- `o2: make object! [a: 2]`, the `f` in `make o1 o2` answers 2. A method
-- that still closed over its original object would answer 1, and would
-- also write into the prototype when called on the copy.
--
-- Merging in the other direction is a second case rather than the same
-- one: `make a b` where b adds a field that b's own method needs -- b's
-- `show` reads x and y, a has no y -- works because b's fields arrive
-- before its methods are asked anything.

-- Resolved against a real R3: TRANSCODE is reachable as a native and
-- takes a string or a binary, giving back the block of values it read.
-- It is the reader with no binding step, which is what LOAD adds, and it
-- is how a script gets at source text as data. Specified in load.allium
-- from the start and only exposed once Rebol's own suite asked for it in
-- 179 places.

-- Resolved against a real R3: ROUND goes half away from zero rather than
-- to even, so 1.5 rounds to 2 and 2.5 rounds to 3, and -1.5 rounds to
-- -2. Banker's rounding is what a JVM reaches for by default and it is
-- not what REBOL does.

-- Resolved against a real R3: COMPOSE evaluates the parens in a block
-- and leaves everything else alone, so `compose [a (1 + 1)]` is
-- `[a 2]`. It is how a block of code is built from a template without
-- reducing the parts that were meant to stay as written.
--
-- Only the parens at the top level, unless /DEEP. `compose [[(7 - 6)]]`
-- keeps the inner paren as written and `compose/deep [[(7 - 6)]]` is
-- `[[1]]`, to any depth: `compose/deep [[[(1 + 1)]]]` is `[[[2]]]`.
-- Confirmed against a real R3.
--
-- A paren answering a block splices its contents in, so `compose [a
-- (reduce [1 2]) b]` is `[a 1 2 b]`. /ONLY turns that off and puts the
-- block in as one value.
--
-- COMPOSE/INTO fills a series the caller already has, at its position,
-- and answers the position after what it put there -- the same shape
-- REDUCE/INTO has, and for the same reason: a loop that builds one series
-- rather than a new one each time round. Any of the block family will do,
-- not only a block, so a paren or a path is filled as readily. A string is
-- refused, because a composed template is values and there is no sensible
-- text for them.
--
-- A paren that answers nothing contributes nothing, so
-- `compose [x (print "") y]` is [x y]. An unset is not a value a block
-- can hold and go on being usable, and a template full of side effects
-- would otherwise fill with them.
--
-- And COMPOSE given something that is not a block hands it straight
-- back: `compose 1` is 1, not a failure. That is the one an
-- implementation gets wrong by being careful, because refusing a
-- non-block looks like good hygiene and is not what the language does.
-- It matters for generated code, where a template may reduce to a single
-- value and the caller should not have to check first.
--
-- Resolved against a real R3: each paren is evaluated with the bindings the
-- template already carries, which is the caller's context and not the
-- interpreter's system context. So a paren can read a word the caller can
-- read: `f: func [a] [compose [got (a)]]` then `f 42` is `[got 42]`, because
-- the paren `(a)` sees the function's own a.
--
-- The distinction is invisible until a paren names a local. A template
-- written at the top level has its words bound where the top level's are, so
-- running its parens in the system context happens to agree; the same
-- template written inside a function does not, and a paren evaluated in the
-- system context there reads an a the system context has never heard of.
-- Threading the caller's context through is what makes COMPOSE usable inside
-- a function rather than only at the top level.
--
-- The same threading is meant to reach a map template's value parens, so
-- `compose #[k (a)]` would read the caller's a too, but that path has a
-- separate defect still open and is not specified as working yet. A block
-- template is the whole of what this covers today.

-- Resolved against a real R3: FOR does not step a character range.
-- `for c #"a" #"e" 1 [...]` raises expect_arg, so it is not a way to walk
-- the alphabet; FOREACH over a string is. It is the character type
-- specifically that is refused, not everything non-numeric: integers,
-- decimals and series bounds are all accepted, and it is the step that
-- must always be a number.

-- Resolved against a real R3: FOR counts in whole numbers only when the
-- start, the end and the step are all integers. A decimal anywhere among the
-- three switches the whole loop to real-number counting, so `for i 1 3.5 1
-- [...]` runs with i at 1.0, 2.0 and 3.0 -- the decimal end pulls the counter
-- into decimals even though start and step are integers.
--
-- All three, not two, is the point. The earlier reading looked at the start
-- and the step for whole-number counting and ignored the end, which gave an
-- integer counter where a decimal end asked for a decimal one. The end is a
-- bound of the count and shapes its type as much as the start does.
--
-- When it does count in whole numbers, the overflow is checked after the body
-- runs, not before. The step past the maximum is taken after the pass that
-- reached it, so `for i (max integer) (max integer) 1 [...]` runs the body
-- exactly once -- start and end are equal, the pass completes, and only then
-- does adding the step overflow and raise. Checking before the body would
-- lose that last pass, which is the one a caller reaching the maximum most
-- wants to run.

-- Resolved against a real R3: FOR walks a series when the start is one,
-- setting the counter to successive positions of that series rather than to
-- numbers. The end may be a number, read as an index, or another series, read
-- as its position; the step is a whole number of positions.
--
-- So `for x "abcde" 3 1 [append out x]` sets x to "abcde", then "bcde", then
-- "cde" -- the whole series at position one, then at two, then at three --
-- giving "abcdebcdecde", and a series end standing at the same index walks
-- the same way. Reading the string start as a number to count from is the old
-- mistake, which had no series case at all.
--
-- The body may move the counter, and the next position is taken from wherever
-- the counter then sits rather than from where the loop would have put it.
-- That is what lets a body skip ahead or repeat a position, and it is the
-- same re-reading FOR does for an integer counter a body reassigned.

-- Resolved against a real R3: REPEAT over a pair walks a two-dimensional
-- grid. A count of N by M runs the counter across then down: the across half,
-- one to N, runs inside the down half, one to M. So `repeat x 2x2 [...]` sets
-- x to 1x1, 2x1, 1x2, 2x2 in that order -- across the row before moving down.
--
-- Across inside down is the nesting, and the order it gives is the thing to
-- get right. The counter's first half is the inner loop and its second half
-- the outer, so a caller filling a grid row by row gets the cells in reading
-- order. Nesting them the other way would visit the same cells in the wrong
-- sequence, which a test that only counts cells would not catch.
--
-- A plain integer count is the ordinary REPEAT and still counts one to that
-- number. The pair is the added case, and it took REPEAT accepting a pair
-- rather than refusing it at the type check, which is where it stopped
-- before.

open question "REPEAT in the C accepts a series and a decimal count as well as an integer and a pair, and JEBOL takes only the integer and the pair so far. A series count walks the series the way FOR does, one to its tail; a decimal count is floored to an integer and then counts as one. JEBOL still refuses both -- a series or a decimal count raises at the type check. Neither is hard once FOR's series walk is shared, and the decimal-to-integer floor is one conversion; they are left out because nothing in Rebol's own library repeats over a series or a fractional count, so they cost no assertions today. Recorded as an open edge rather than a settled refusal: the refusal is where JEBOL is, not where it means to stay."

-- Resolved: there are three ways out and each stops somewhere different.
-- BREAK leaves the nearest loop. RETURN leaves the nearest function, and no
-- further, so a helper that returns does not also return from its caller.
-- THROW leaves everything up to the nearest CATCH, crossing loops and
-- functions alike.
--
-- None of the three is an error. TRY catches none of them and CATCH catches
-- only THROW, because a throw is a decision and an error is a failure, and
-- letting either mechanism swallow the other would make both unreliable.
-- All three unwind through the evaluator's own control flow rather than
-- through the error mechanism.

-- Resolved against a real R3: a throw may carry a name, and naming
-- changes who is allowed to catch it. The pairing is strict in both
-- directions, which is the whole point -- an unnamed CATCH is not a
-- catch-all, so a throw meant for an outer handler travels past an inner
-- one that was not expecting it.
--
--   catch [throw 5]                        catches, 5
--   catch/name [throw/name 5 'foo] 'foo    catches, 5
--   catch/name [throw/name 5 'foo] 'bar    does not catch
--   catch [throw/name 5 'foo]              does not catch
--   catch/all [throw/name 5 'foo]          catches, 5
--   catch/all [throw 5]                    catches, 5
--
-- /ALL is the deliberate catch-all, and it is a separate refinement
-- rather than the default because catching a throw addressed to somebody
-- else is almost always a bug.
--
-- A CATCH that catches nothing answers what its block answered, so
-- `catch [1 2 3]` is 3. There is no way to tell that apart from a throw
-- of the same value, and REBOL does not try to provide one.
rule CatchTakesOnlyAThrowItWasExpecting {
    when: EvaluateCatch(body, expected_name, catching_everything)

    requires: throws(body)

    ensures:
        if catching_everything or thrown_name(body) = expected_name:
            CatchResult(value: thrown_value(body))
        else:
            Rethrows(value: thrown_value(body), name: thrown_name(body))
}

-- Resolved against a real R3: an error's code is its category's base plus
-- the id's position within that category, so the code depends on the id
-- and not only on the family. `1 / 0` is 400 because zero-divide is the
-- first id under Math, whose base is 400, and a throw caught by TRY/ALL
-- is 2 because throw is the third id under Throw, whose base is 0.
--
-- The catalogue is data: ten categories and a hundred and forty-one ids,
-- taken verbatim from a real R3 and readable as `system/catalog/errors`.
-- A script compares codes against arithmetic on it and compares ids
-- against names it did not choose, so neither half can be invented and
-- neither can be worked out from what JEBOL happens to raise.
--
-- Each category also carries a `type` field naming itself. That is not
-- an error id, and counting it would shift every code in the category by
-- one, which is the mistake this rule exists to prevent.

-- Resolved against a real R3: MAKE ERROR! builds the error the spec asks
-- for. Given a block it takes the type and id written there, so
-- `make error! [type: 'math id: 'positive]` really is a math error whose
-- id is positive. A `code:` field in the spec is ignored: the code
-- follows from the type, and letting a caller set it would let an error
-- claim a category its code contradicts.
--
open question "A real R3 keeps whichever spelling of the type word it was given, so an error it raised itself reports Math while one built from a spec saying 'math reports math. The catalogue spells them capitalised -- Throw, Note, Syntax, Script, Math, Access, Command, User, Internal -- so the raised form is the canonical one and the made form is the caller's. Word equality ignores case, so nothing a script can write depends on it, and JEBOL reports the canonical spelling in both cases. Is the difference deliberate, or an artefact of the spec block being copied verbatim?"

-- Given a string instead, the error is a User one whose id is `message`
-- and whose first argument is the string. That is the shape a script
-- uses to raise something of its own, and it needs no catalogue entry.

-- Resolved against a real R3: a datatype describes itself. REFLECT on one
-- with SPEC gives an object holding a title and a type, and with TITLE or
-- TYPE gives either directly. `reflect integer! 'title` is "64 bit
-- integer" and `reflect integer! 'type` is the word scalar.
--
-- Both are data rather than derivations. The title is a string a script
-- can compare against, so inventing the wording would make every such
-- comparison wrong, and the type names R3's own families -- scalar,
-- string, block, word, function, object, internal, vector, symbol,
-- opt-object -- several of which group datatypes JEBOL has not built.
-- Neither can be worked out from what JEBOL knows, so both are taken
-- verbatim from a real R3 and kept as a table.

-- Resolved against a real R3: a decimal index truncates wherever an index
-- is taken, not only into a series. A pair and a tuple answer their parts
-- the same way, so `1x2` at 1.6 is 1 and `1.2.3` at 2.6 is 2.

-- Resolved against a real R3: INTEGER-DIVIDE takes decimals and throws
-- their fractions away, so `integer-divide 23.5 10` and `integer-divide
-- 23 10.5` are both 2. Refusing a decimal is the tempting reading, since
-- the name says integer, and it is not what the function does.

-- Resolved against a real R3: SELECT and FIND reach an error's fields.
-- `select e 'arg1` answers what that field holds, and FIND answers
-- something truthy when the field exists. An error is an object with a
-- fixed set of fields, so the things that read an object's fields read
-- an error's too.

-- Resolved against a real R3: ROUND has six modes besides its default,
-- and they disagree in more places than the names suggest. Measured at
-- every half and either side of one:
--
--            1.5   2.5  -1.5  -2.5   1.4   1.6  -1.4
--   plain     2     3    -2    -3     1     2    -1
--   /down     1     2    -1    -2     1     1    -1
--   /even     2     2    -2    -2     1     2    -1
--   /half-down 1    2    -1    -2     1     2    -1
--   /floor    1     2    -2    -3     1     1    -2
--   /ceiling  2     3    -1    -2     2     2    -1
--   /half-ceiling 2 3    -1    -2     1     2    -1
--
-- /DOWN and /FLOOR agree on every positive and part company on every
-- negative; /HALF-DOWN and /HALF-CEILING agree everywhere except on an
-- exact half. JEBOL declared an /UP that a real R3 has not got, and had
-- neither /FLOOR nor /CEILING.

-- Resolved against a real R3: ROUND/TO with a scale of zero throws the
-- fraction away and answers an integer, so `round/to 11.65 0` is 11 --
-- not 12, not 11.0, and not a division by zero. It truncates towards
-- zero rather than rounding, which is the opposite of what ROUND does
-- with no /TO at all, and -11.6 is -11 rather than -12.
--
-- It is the one scale that cannot mean "a multiple of this", so it has
-- been given a different job, and the job is not the one the function's
-- name suggests.

-- Resolved against a real R3: REDUCE/INTO puts the results into a series
-- the caller already has, at its position, and answers the position after
-- what it put there. `b: [] reduce/into [1 + 1 2 + 2] b` leaves b holding
-- [2 4]. It is how a loop fills one block without building a new one each
-- time round.
--
-- Any of the block family will do as the target, not only a block, exactly
-- as COMPOSE/INTO takes any of them. A paren, a path or a set-path is filled
-- as readily, so `reduce/into ['a 1 + 1 3 + 3] make path! 3` builds the path
-- a/2/6. The C declares the target any-block! and the two INTO natives share
-- that, which is why filling a path from one and not the other would be a
-- difference no caller asked for.

-- Resolved against a real R3: ++ and -- step a character as readily as a
-- number, so `a: #"a"` then `++ a` answers #"a" and leaves a holding
-- #"b". The same one-operation-covers-everything shape they have for
-- series positions.

-- Resolved against a real R3: `system/state` records what just happened
-- rather than what is configured. `last-error` holds the error the most
-- recent TRY caught, and `last-result` holds the value the most recent
-- CATCH or QUIT carried. Both are readable after the fact, which is what
-- lets a handler that was given no arguments still find out what it is
-- handling: `catch/with [throw 3] [system/state/last-result * 10]` is 30.
--
-- So a /WITH handler has two ways to reach the value, its argument and
-- this, and a block handler has only this one. That is why the pair
-- exists rather than being derivable from the handler's parameters.

-- Resolved against a real R3: TO DECIMAL! of a binary reads the bytes as
-- the double they are, big-endian, rather than as text or as a number to
-- be scaled. `to decimal! #{3FD3333333333333}` is 0.3, and the pattern
-- for an infinity or a NaN gives that. A binary shorter than eight bytes
-- is read right-aligned, so #{01} is the smallest subnormal there is.
--
-- TO BINARY! of a decimal is the same thing backwards: `to binary! 0.3`
-- is #{3FD3333333333333}. The pair is how a test suite pins floating
-- point exactly, without writing decimals whose text form has already
-- rounded.
--
-- Note that -0.0 survives the trip and molds as -0.0, which is the whole
-- reason the sign bit is worth carrying.

-- Resolved against a real R3: EVEN? and ODD? take a decimal, and round it
-- half away from zero before asking. So 1.4 is odd and 1.5 is even, 2.4
-- is even and 2.5 is odd, and -1.5 is even. The same rule ROUND uses,
-- which is the point: they are asking about the whole number the decimal
-- is nearest to, not about the one it truncates to.
--
-- Truncating instead agrees on every whole decimal and disagrees on every
-- half, so refusing decimals outright is the safer wrong answer and
-- guessing at truncation is the dangerous one.

-- Resolved against a real R3: a decimal used as a path index truncates
-- towards zero rather than rounding, so `b/1.6` is the first item and
-- `b/2.6` is the second. The opposite of the rule above, in the same
-- language, and both were checked rather than assumed.

-- Resolved against a real R3: TRY and ATTEMPT take a paren as readily as
-- a block, so `try first [(1 + 1)]` is 2. A paren is a block that
-- evaluates itself when reached; handing one to TRY is asking for the
-- same thing a block would give.

-- Resolved against a real R3: SORT/REVERSE sorts the other way round, and
-- SORT/PART sorts only the first so many items and leaves the rest where
-- they were, answering the whole series either way. `sort/part [3 1 2 9]
-- 3` is [1 2 3 9]: the 9 was outside the part and did not move.

-- Resolved against a real R3: sorting needs a real ordering, and REBOL's
-- comparison does not provide one. `1.#NaN < 1` and `1 < 1.#NaN` are both
-- true, so a comparison answers "less" whichever way round it is asked,
-- and a sort built on it produces whatever the algorithm happens to do.
--
-- So SORT has its own rule for NaN: every NaN goes last and two of them
-- are equal. `sort [1.#inf -1.0 1.#nan 1.0 -1.#inf 0 1.#NAN]` is
-- [-1.#INF -1.0 0 1.0 1.#INF 1.#NaN 1.#NaN].
--
-- The two questions are genuinely different. Comparison is asked whether
-- one value is below another and may answer yes to both; ordering has to
-- put them in a line.

-- Resolved against a real R3: SORT/ALL compares whole records rather than
-- their first elements, so `sort/skip/all [4 3 4 1] 2` is [4 1 4 3] where
-- plain `sort/skip` leaves both records where they were -- their first
-- elements are equal and the sort is stable.
--
-- /ALL and /COMPARE together are refused with bad-refines: /COMPARE says
-- how to compare records, which leaves /ALL nothing to mean.

open question "PROTECT/DEEP/WORDS on a block of words: a real R3 refuses `insert a/b \"x\"` with protected after `protect/deep/words [a]`, so /DEEP plainly reaches what each word holds. Implementing it costs six of Rebol's own UNPROTECT assertions in object-test.r3 and gains two, and three explanations have now been ruled out by measurement: it is not asymmetry between guarding and releasing (restricting it to the protecting direction changes nothing), it is not the object-versus-words distinction below (adding that changed nothing here), and those UNPROTECT assertions do not go through this code path at all -- they protect an object directly, not a block of words. So something else in the run is reaching it. Left unimplemented rather than half-implemented. The probe is `a: make object! [b: \"abc\"] protect/deep/words [a] insert a/b \"x\"`, and the six assertions are object-test.r3 UNPROTECT #174 #175 #179 #182 #183 #187."

-- Resolved against a real R3: protection on an object covers three
-- separate things, and no two of them are the same question:
--
--   the object itself   -- may a new word be added to it
--   the words in it     -- may an existing word be reassigned
--   the values it holds -- may a series a word holds be changed
--
-- PROTECT/DEEP guards all three. The UNPROTECT refinements each release
-- a different subset, which is how the three are told apart:
--
--   unprotect            frees the object and its words, not the values
--   unprotect/words      frees the words only
--   unprotect/deep       frees all three
--   unprotect/words/deep frees the words and the values, not the object
--
-- Rebol's own object-test.r3 spells this out in comments beside each of
-- the four. Without the first as a flag of its own, "may a word be
-- added" and "may a word be reassigned" are one question, and no
-- combination of refinements can separate them -- which is why an
-- attempt to make /DEEP reach the values cost six of those assertions
-- and could not be made to fit.

-- Resolved against a real R3: /DEEP reaches everything inside, including
-- an object inside an object. Protecting an object deeply and then
-- writing `o/b/c: 4` raises locked-word; stopping at the outer object
-- leaves free exactly the case a caller reached for /DEEP to cover.
--

-- Resolved against a real R3: SWITCH/DEFAULT names the branch to run when
-- nothing matched. Without it the answer is none, which a caller cannot
-- tell from a branch that answered none itself -- so the refinement is
-- not sugar for `any [switch ... [...]]`, it is the only way to know
-- which happened.

-- Resolved against a real R3: COLLECT-WORDS/IGNORE leaves out the words
-- it is given, so `collect-words/ignore [a: 1 b: 2] [a]` is [b]. It takes
-- an object as readily as a block, which is how a caller asks what is in
-- here that a context does not already know about.

-- Resolved against a real R3: TRIM has five modes and they are not
-- variations on each other. The plain form takes whitespace off both
-- ends; /HEAD and /TAIL bound it to one. /ALL takes every space out
-- wherever it sits, so "  a b  " is "ab". /LINES folds the whole thing
-- onto one line with single spaces, so "a\nb\n\nc" is "a b c". /WITH
-- takes out the characters it is given rather than whitespace. /AUTO
-- removes the first line's indentation from every line, keeping anything
-- deeper -- so a block of code pasted into a string comes back with its
-- shape intact.
--
-- All four beyond the plain form were declared and unread, so every one
-- of them silently did what the plain form does.

-- Resolved against a real R3: naming both /HEAD and /TAIL trims both ends,
-- which is the same as naming neither. The bare TRIM trims both ends, /HEAD
-- alone trims the head, /TAIL alone trims the tail, and the two together are
-- the bare form again. So `trim/head/tail #{000102030000}` is #{010203}, and
-- the same both-ends logic holds for a string.
--
-- The trap is reading it as "trim the head unless /tail is named". That makes
-- trim/head/tail trim nothing, because the head branch wants /tail absent and
-- the tail branch wants /head absent, and with both named both conditions go
-- false. The C guards each end with "no flags, or this end's flag", so both
-- named lights both ends rather than cancelling them.

-- Resolved against a real R3: TRIM/WITH removes characters by their datatype
-- rather than by molding the argument. An integer is one code point, so
-- `trim/with "a1b2c3" 97` removes the letter a, whose code point is 97, and
-- not the digits 9 and 7 that molding 97 to "97" would have removed.
--
-- /WITH accepts a char, a string, a binary or an integer, and nothing else.
-- Any other type -- a none, a block, a word -- is refused at the argument
-- boundary as a type error, because the declared argument is
-- [char! string! binary! integer!] and a value outside that set never reaches
-- the removal logic.
--
-- The removal set is built from the argument's characters, for those four
-- types: a char is its own code point, a string contributes each of its
-- characters, a binary each of the characters its bytes decode to, and an
-- integer is the single code point it names. Only the integer differed --
-- JEBOL molded it to its decimal text and removed those digits, where a real
-- R3 reads the number as the one character it stands for.
--
-- The integer is the whole of the surprise, because it is the one argument
-- whose molded form and whose code-point form are both plausible removal
-- sets and happen to differ. A char and a string mold to the same characters
-- they name, so molding them would have looked right and hidden the bug.
--
-- The default whitespace set belongs to /ALL, not to /WITH. /ALL strips every
-- whitespace character, and it reaches the same removal routine with no
-- argument: its refinement value defaults to none, and it is that none which
-- selects the whitespace set. So a none is how /ALL asks for whitespace and
-- never something a caller passes to /WITH.
-- `append/dup [1] 2 3` is [1 2 2 2] and `change/dup [1 2 3 4] 9 3` is
-- [9 9 9 4]. A block being spliced repeats as a whole, so
-- `append/dup [1] [2 3] 2` is [1 2 3 2 3], and a count of zero adds
-- nothing, which is what makes the refinement usable with a computed
-- number.
--
-- Its count had no parameter in JEBOL, so the number was never consumed:
-- it leaked out as the expression's own value and the operation happened
-- once.

-- Resolved: a refinement's argument is found by which refinements were
-- asked for, never by a fixed position in the argument list. Only the
-- ones a caller names contribute arguments, so adding /DUP after /PART
-- moves /PART's own argument when both are asked and neither when only
-- one is. Two natives had a fixed index and read one refinement's
-- argument as the other's the moment a second was declared.

-- Resolved against a real R3: a binary is a series like the others, so
-- APPEND, INSERT, SWAP and REMOVE-EACH all take one. Each was written for
-- blocks and strings and left binaries out, which refused ordinary calls
-- and, where the binary was protected, reported a type error in place of
-- the refusal.

-- Resolved against a real R3: a protected series refuses a change before
-- the change is attempted, not when the first element is touched. So
-- `remove-each a bin [a < 3]` raises even when nothing in bin would have
-- been removed. A guard that only fires when something actually changes
-- is not a guard: whether it fires depends on the data rather than on
-- the protection.

-- Resolved against a real R3: RESOLVE into a protected object raises
-- `protected` too. Filling an object from another changes it as a
-- container, which puts it with APPEND and PUT rather than with an
-- assignment through a name.

-- Resolved against a real R3: PUT on a protected object raises
-- `protected` and not `locked-word`. It changes the object as a
-- container, which is the same split APPEND is on: the error names the
-- route, and only an assignment through a name is a locked word.

-- Resolved against a real R3: PROTECT/VALUES and PROTECT/WORDS take a
-- block of words and protect two different things. /VALUES protects what
-- each word holds, so changing the series raises `protected` and
-- reassigning the word is allowed. /WORDS protects the slots, so
-- reassigning raises `locked-word` and changing the series is allowed.
--
-- They are complements, and neither does the other's job. Without them a
-- caller who writes `protect/values [a b]` protects the literal block
-- holding the two words and nothing else -- accepted, plausible, and
-- leaving everything it was meant to guard wide open.

-- Resolved against a real R3: RANDOM shuffles the series it was given and
-- answers it, so another name for the same series sees the new order. It
-- takes a binary as readily as a block or a string.
--
-- Same shape as UPPERCASE below, and the same two consequences when it is
-- got wrong: the caller's own series is left untouched, and a protected
-- one is shuffled instead of refusing.

-- Resolved against a real R3: INSERT puts a binary into a binary byte by
-- byte, the way it puts a block into a block item by item, so
-- `insert #{0102} #{03}` is #{030102}. Only an integer was accepted,
-- which made the one obvious way to join two binaries a type error.

-- Resolved: which natives change a series and which build a new one is a
-- decision per native, not a rule, and getting it wrong is invisible in
-- the answer. UPPERCASE, LOWERCASE, TRIM, DELINE, ENLINE, RANDOM and
-- SORT all change what they were given; MAP-EACH, DIFFERENCE, AJOIN,
-- COLLECT-WORDS and FUNCTION all build something new, confirmed against
-- a real R3.
--
-- The five that were wrong were found one at a time, each through a
-- different failing assertion, before the shape was recognised. Anything
-- that takes a series, hands back a freshly built one and never reaches
-- the storage is the shape to look for.

-- Resolved against a real R3: DELINE and ENLINE change the string they
-- were given, like UPPERCASE below, so a caller holding it sees the
-- change and a protected one refuses. DELINE/LINES answers the lines as
-- a block instead of rewriting anything.
--
-- On a platform whose line ending is a bare newline the two agree on the
-- answer and differ only in intent, which is why building a new string
-- looked harmless: the text was right and everything else about it was
-- not.

-- Resolved against a real R3: UPPERCASE, LOWERCASE and TRIM change the
-- string they were given and answer it, rather than building a new one.
-- `s: "ab" uppercase s` leaves s holding "AB".
--
-- Building a new string agrees on the answer and disagrees on everything
-- else. A caller holding the string never sees the change, which is the
-- whole point on a series someone else is also looking at, and a
-- protected string is quietly rewritten instead of refusing -- because
-- the refusal lives in the storage, and a native that never touches the
-- storage never meets it.

-- Resolved against a real R3: FIND/SAME asks each element of a run to be
-- the same value rather than an equal one, and the two part company on
-- numbers written as different datatypes: 1.0 equals 1 and is not the
-- same as it.
--
-- In [1.0 3 1 3 1.0 2.0 1 2] a loose search for [1 2] finds the decimals
-- at position five and a same search finds the integers at seven. A
-- single-value needle was already asked strictly; only a run was not, so
-- the refinement worked for `find/same blk 1` and lied for
-- `find/same blk [1 2]`.

-- Resolved against a real R3: FIND/ANY matches wildcards, where * stands
-- for any run of characters and ? for one. How much the star takes
-- depends on where it sits: a star at the END of the pattern takes the
-- rest of the series, and a star with anything after it takes as little
-- as it can.
--
--   "c*"  in "abcd"     ends at the tail
--   "a*"  in "abcd"     ends at the tail
--   "*bc" in "abcabc"   ends at the third character, not the sixth
--   "a*c" in "abcabc"   ends at the third
--   "b*d" in "abcdabcd" ends at the fourth
--
-- Neither a wholly greedy star nor a wholly lazy one fits: each is right
-- for one of those groups and wrong for the other. And it only shows in
-- where the match ENDS, which is what /TAIL stands after, so a single
-- rule either way finds every position correctly and reports half the
-- lengths wrongly.
--
-- The pattern search combines with /REVERSE, which looks BEHIND the
-- position rather than ahead of it, so a series standing at its tail has
-- the whole string behind it and nothing in front. Searching only what
-- is ahead answers none for every such call, and measuring the match
-- from the position rather than from the head gives a negative offset.
-- `find/any/reverse tail "abcdabcd" "?c"` is "bcd".

-- Resolved against a real R3: searching a binary for a number no byte
-- could hold raises out_of_range rather than answering "not found".
-- `find #{0063} -1`, the same with 256, and the same with 700 all raise,
-- while 0 and 99 are ordinary searches. SELECT raises on the same input.
--
-- Which is the right split. A byte holds 0 to 255, so asking for anything
-- outside that is a mistake in the caller rather than a search that
-- happened to miss, and answering none would hide it.

open question "Searching a binary for 255 answers none even when the byte is there: `find #{00FF} 255` and `find #{FF00} 255` are both none, while `find #{0063} 99` finds its byte. 255 is inside the legal range and is not refused, so this is neither the out-of-range rule nor an ordinary miss. Is 255 a sentinel inside R3's own search, and is the behaviour intended? JEBOL finds the byte, which is what the rule above implies; if the binary is right then the rule needs an exception nobody has written down."

-- Resolved against a real R3: what TAKE/PART answers is a series of the
-- same kind it was taking from. Two items off a paren give a paren, off a
-- binary give a binary, off a string give a string. Answering a block for
-- everything loses the datatype silently, and the loss only shows up
-- somewhere else entirely, when the result is molded or appended to.
--
-- TAKE/LAST takes from the tail rather than the head, so `take/last
-- [1 2 3]` is 3. Taking one item without /LAST is the head.
--
-- The counts clamp rather than failing. A count of zero or a negative one
-- takes nothing, and a count past the end takes what there is.

-- Resolved against a real R3: PROTECT and UNPROTECT answer the value they
-- were given, not unset, so `b: protect #{0102}` is a way to build a
-- protected value and keep hold of it in one step. Answering unset makes
-- that read as `b: ` with nothing after it, and every later use of b
-- fails on a word with no value rather than on the protection.
--
-- Protecting a series refuses every change to it while leaving reads
-- alone: CLEAR, APPEND, INSERT and POKE all raise `protected` and MOLD
-- still works.

-- Resolved against a real R3: DO/NEXT evaluates one expression and moves
-- a word on to what is left, so `blk: [1 + 1 5]` with `do/next blk 'blk`
-- answers 2 and leaves blk holding [5]. It is how a caller walks a block
-- an expression at a time without counting values itself, and the reason
-- it needs a word rather than answering a pair is that the caller usually
-- wants to keep stepping the same variable.

-- Resolved against a real R3: CONSTRUCT builds an object without
-- evaluating, but it still reads `none`, `true` and `false` as the values
-- they name. /ONLY turns even that off, so `construct/only [b: none]`
-- gives b the WORD none rather than the none value.
--
-- Which is the whole point of the plainer form: data that arrived from
-- somewhere untrusted and happens to be shaped like a spec should not
-- have its words quietly become values.

-- Resolved against a real R3: CONTEXT? answers the object a bound word
-- lives in, which is how code holding a word can reach the rest of what
-- surrounds it.

-- Resolved against a real R3: RESOLVE copies values from one object into
-- another, and by default it only fills in the words the target has not
-- got a value for. /ALL overwrites the ones it has, and /EXTEND adds the
-- words it lacks. Without /EXTEND a word only the source has is skipped
-- rather than added, so `resolve a b` where b has an extra field leaves
-- the target's word list unchanged.

-- Resolved against a real R3: dividing by zero raises only when both
-- sides are whole numbers. `1 / 0` raises zero_divide; `1.0 / 0` and
-- `1 / 0.0` are both 1.#INF, and `0.0 / 0.0` is 1.#NaN. So the decimal
-- side follows the floating-point hardware and the integer side does not,
-- and which one a caller gets depends on how the operands happen to be
-- written.
--
-- 1.#INF, -1.#INF and 1.#NaN are decimals, they read as literals, and
-- they mold back as they were written.

-- Resolved against a real R3: the two equalities disagree about NaN, and
-- in the direction opposite to every other pair of values.
--
--   1.#NaN =  1.#NaN   is true
--   1.#NaN == 1.#NaN   is false
--   same? 1.#NaN 1.#NaN is true
--
-- Everywhere else the loose = is the forgiving one and == the strict one,
-- and here loose means "the same value" while strict means "what the
-- hardware says". A comparison against NaN is also true rather than
-- false: `1.#NaN < 1` holds.
--
-- Nothing about this is inferable from IEEE 754 or from how the two
-- operators behave on anything else.

-- Resolved against a real R3: TO BINARY! reads the value's bytes rather
-- than the text of how it is written. A string gives its UTF-8, so
-- `to binary! "ab"` is #{6162}; a block of numbers gives one byte each,
-- so `[1 2 3]` is #{010203}; and an integer gives all eight bytes of its
-- machine width, so 65 is #{0000000000000041} rather than #{41}.
--
-- That last one is the trap. Reading it as "the smallest binary that
-- holds this number" is more useful and is not what happens, and the two
-- agree for every value under 256 written as a block.
--
-- TO FILE! takes the text of the value, so a word gives its spelling and
-- a block gives its parts run together: `to file! [a b]` is %ab, not
-- %a/b. Nothing inserts separators.

-- Resolved against a real R3: ++ and -- change a word in place and answer
-- what it held BEFORE the change, so `a: 1  reduce [++ a a]` is [1 2].
-- Answering the new value would be the obvious reading and is wrong.
--
-- On a series they step the position rather than the contents: with s
-- holding [1 2 3], `++ s` answers [1 2 3] and leaves s holding [2 3].
-- One operation covers counting and walking, because in REBOL a position
-- is a value like any other.

-- Resolved against a real R3: TRUNCATE throws away everything before the
-- current position, so a series skipped past its first two items keeps
-- only what is left. /PART bounds how much of the rest is kept.

-- Resolved against a real R3: SET given a block of words spreads a block
-- of values across them one for one, and spreads anything else to every
-- word. So `set [d e] 9` puts 9 in both, and `set [b c] [1 2]` puts 1 in
-- one and 2 in the other. A short value block pads with none rather than
-- failing: `set [k l m] [1 2]` leaves m holding none.
--
-- /ONLY turns the spreading off, so every word gets the whole block.
-- /SOME skips the words whose value would be none, leaving what was
-- there: with h and i holding 1 and 2, `set/some [h i] reduce [10 none]`
-- gives 10 and 2, where plain SET gives 10 and none. It is for filling
-- in defaults from a partly populated block.
--
-- SET also takes an object, and then the values go to its fields in
-- order, which is the same spreading rule with the object's own words
-- standing in for the block.

-- Resolved against a real R3: TRY/ALL widens TRY to the control-flow
-- signals as well, turning a throw, a break, a continue, a return or an
-- exit into an ordinary error value. `try/all [throw 5]` gives an error
-- whose id is `throw`.
--
-- Which is the exception that proves the rule above rather than a
-- contradiction of it. Plain TRY still catches only failures, because a
-- throw is a decision; /ALL exists for the caller who is running code
-- they did not write and wants nothing at all to escape. Having to ask
-- for it keeps the default honest.
--
-- TRY/WITH runs a handler instead of answering the error, and only on a
-- failure: `try/with [1 / 0] [42]` is 42 and `try/with [3] [42]` is 3.
-- The same handler-not-finally shape CATCH/WITH has.

-- Resolved against a real R3: BREAK/RETURN gives the loop a value to
-- answer, so `repeat i 3 [break/return 9]` is 9 where a plain `break`
-- leaves the loop answering unset. It is how a search loop reports what
-- it found without a variable outside the loop to put it in.

-- Resolved against a real R3: ATTEMPT answers none on a failure rather
-- than the error, and /SAFER widens it the way TRY/ALL widens TRY. Both
-- forms answer none, so the refinement changes what is caught and never
-- what a caught thing looks like.

-- Resolved against a real R3: /WITH runs a block or a function instead of
-- answering the thrown value, so `catch/with [throw 5] [10]` is 10. It
-- runs only when something was thrown: `catch/with [1] [10]` is 1, not
-- 10, so it is a handler rather than a finally.
--
-- And /QUIT catches what QUIT raised, which nothing else can:
-- `catch/quit [quit/return 7]` is 7 and the run carries on. That makes a
-- host able to run a script that stops itself without the stopping
-- reaching the host, which is the same guest-versus-host line QUIT
-- itself is drawn on.
rule CatchWithRunsItsHandlerOnlyOnAThrow {
    when: EvaluateCatchWith(body, handler)

    ensures:
        if throws(body):
            CatchResult(value: handler_result(handler))
        else:
            CatchResult(value: body_result(body))
}

-- A bare CATCH/QUIT catches a quit or a halt and never a throw. With neither
-- /name nor /all it lets a throw pass straight through to whatever catch is
-- outside it, so `catch [catch/quit [throw 5]]` is 5.
--
-- The throw passing through is not rethrown after the fact -- it is never
-- taken in the first place, so a side effect written after it never runs:
-- `a: 1 catch [catch/quit [throw 'x a: 99] a: 0] a` leaves a at 1. The throw
-- leaves before `a: 99`, and `a: 0` sits after the inner catch, which the
-- escaping throw skips over on its way to the outer one.
--
-- /QUIT is not a wider CATCH; it is a narrower one aimed only at what QUIT
-- and HALT raise, which nothing else can reach. Catching a throw needs /all,
-- or a /name that matches -- either of those lets the ordinary throw handling
-- run beside the quit handling. Reading /QUIT as "catch everything, quit
-- included" swallows throws a script meant for an outer handler.
rule ABareCatchQuitDoesNotCatchAThrow {
    when: EvaluateCatchQuit(body, expected_name, catching_everything)
    requires: throws(body)
    requires: expected_name = null
    requires: not catching_everything

    ensures: Rethrows(value: thrown_value(body), name: thrown_name(body))
}

-- Only a block handler writes its result back into last-result. A block
-- handler reads the caught value from `system/state/last-result` and then
-- overwrites it with what the block produced, so `catch/with [throw 1]
-- [2 * system/state/last-result]` is 2 and leaves last-result at 2. A
-- function handler is given the caught value as its first argument and never
-- touches last-result, so `catch/with [throw 21] func [v n] [2 * v]` is 42
-- and leaves last-result at 21.
--
-- The asymmetry is not a design choice so much as where the C puts one line.
-- The caught value is stored in last-result before either handler runs, which
-- is how a block handler with no argument reaches it at all. Then the block
-- form reassigns last-result to the block's own result, and the function form
-- calls the handler and stops -- the reassignment sits after the block
-- evaluation and not after the function call.
--
-- It matters to a script that reads last-result after the catch to learn what
-- was handled. A block handler has moved it on to its own answer; a function
-- handler has left it at the thrown value. Reading it as always the caught
-- value, or always the handler's result, is wrong for one of the two forms.
rule OnlyABlockHandlerWritesBackToLastResult {
    when: EvaluateCatchWith(body, handler)
    requires: throws(body)

    ensures:
        if is_block(handler):
            the_last_result_afterwards() = handler_result(handler)
        else:
            the_last_result_afterwards() = thrown_value(body)
}

-- A CATCH/WITH function handler is type-checked before it runs, and its first
-- two parameters are the caught value and the throw's name. The first is
-- checked against the caught value and the second against the name, and a
-- parameter whose declared type refuses what it is handed raises expect-arg
-- before the handler body evaluates.
--
-- So `catch/with [throw 1] func [v [word!]] []` raises expect-arg, because the
-- caught 1 is an integer and the parameter wanted a word, and
-- `catch/all/with [throw/name 1 'foo] func [v n [integer!]] []` raises
-- expect-arg on the name, because 'foo is a word and the second parameter
-- wanted an integer. The check happens whether or not the body would ever
-- have touched the argument.
--
-- A handler with more parameters than the two the catch supplies sees the
-- rest as none, so `catch/with [throw 1] func [a b c] [reduce [a b c]]` is
-- [1 none none] -- the value, then the name which was none for an unnamed
-- throw, then the surplus parameter filled with none. This is the same
-- value-as-argument path the last-result rule above describes: the function
-- takes the caught value in rather than reading it from state.
rule ACatchWithFunctionHandlerIsTypeCheckedAndSurplusParametersAreNone {
    when: EvaluateCatchWith(body, handler)
    requires: throws(body)
    requires: is_function(handler)

    ensures:
        if the_first_parameter_refuses(handler, thrown_value(body))
                or the_second_parameter_refuses(handler, thrown_name(body)):
            CallFails(error: expect_arg)
        else:
            the_handler_runs_with(handler,
                first: thrown_value(body),
                second: thrown_name(body),
                every_further_parameter: none)
}

-- Resolved against a real R3: every string-like type, not only string!.
-- %A.txt = %a.txt is true and <A> = <a> is true, and == minds case for
-- all of them.

-- Resolved: arithmetic widens integer to decimal to money. add 1 1.5 is a
-- decimal and add $1.00 1 is money. Integer division that does not divide
-- evenly widens too, so divide 10 3 is a decimal rather than 3.

-- Resolved: a native declares its refinements and is told which of them
-- the caller asked for, exactly as a user function is. It does not get a
-- separate entry per refinement.
--
-- Registering copy/part as its own native worked while there were three
-- of them and stopped working at nine: FIND alone takes /any, /tail,
-- /last, /same, /part, /skip, /case, /reverse and /only, and a caller may
-- combine them. One entry per combination is five hundred entries for one
-- native. Rebol's own suite reaches roughly six hundred assertions
-- through refinements the registration approach could not express, and
-- /one/error was failing purely for being a pair rather than a single.
--
-- The shape already existed on the other side: a user function declares
-- refinements as parameters, and Application already carries
-- requested_refinements. This joins the two up.


-- === Writing a value out so it can be read back ==========

-- MOLD/ALL keeps a series' position where plain MOLD drops it, by writing
-- the positioned construct form.
--
-- `mold/all next "123"` names the datatype, the whole string and the index,
-- so loading it gives a string standing at "23" whose head is still "123".
-- Plain MOLD writes "23" and the position is gone: the text is right and
-- what it means is a different string.
--
-- Which is the point of the refinement rather than a detail of it. A caller
-- writing a value out and reading it back wants the value it had, and for a
-- series that has been walked the position is part of the value. Nothing
-- else in the syntax can say so.
--
-- The reader's half of this is TranscodedSeriesStartAtHead in load.allium,
-- and the two have to agree exactly. A reader that accepts the positioned
-- form and a molder that never writes it leaves the round trip broken in one
-- direction only, which is the harder direction to notice: everything a
-- caller writes reads back, and only what the caller did not write is lost.
rule MoldAllKeepsASeriesPosition {
    when: EvaluateMold(subject)
    requires: refinement_asked(all)
    requires: is_series(subject)
    requires: subject.index > 1

    ensures: MoldResult(text: the_positioned_construct_form_of(subject))
}

-- A series already at its head molds as plain MOLD does, and so does
-- anything that is not a series. There is no position to keep, so the
-- construct form would add ceremony and say nothing.
rule MoldAllIsPlainMoldWhereThereIsNoPositionToKeep {
    when: EvaluateMold(subject)
    requires: refinement_asked(all)
    requires: not is_series(subject) or subject.index = 1

    ensures: MoldResult(text: what_plain_mold_writes(subject))

    @guidance
        -- The positioned series is the whole of what JEBOL's /ALL does
        -- today, and it is the part that round-trips. A real R3 also writes
        -- construct syntax under /ALL for other values that have no literal
        -- spelling of their own, and that is not here yet. So a mold/all of
        -- something outside this rule matches R3 by accident rather than by
        -- construction, and the gap is worth knowing before leaning on it.
}

-- The two spellings a plain string molds as.
enum StringMoldForm {
    quoted      -- "..." with every awkward character caret-escaped
    | braced    -- {...} with newlines and balanced braces left literal
}

-- A plain string molds one of two ways, and which one is a property of the
-- text rather than a choice. The quoted form "..." is used only when the
-- text holds no quote character, fewer than three newlines, and at most
-- fifty characters. Anything outside all three of those uses the braced form
-- {...}.
--
-- The three-newline threshold is the one worth understanding, because it is
-- not about length. In the quoted form a newline is written `^/`, so a
-- string of several lines becomes a wall of carets that no longer looks like
-- the lines it came from. The braced form writes a real newline instead, so
-- past two lines the braces are what keep a multi-line string readable. The
-- quote and the length thresholds are simpler: a quoted form cannot hold a
-- bare quote, and a long single line is easier to read braced.
rule AStringMoldsQuotedOnlyWhenItIsShortAndPlain {
    when: EvaluateMold(subject)
    requires: is_string(subject)

    ensures: MoldResult(string_form:
        if has_no_quote(subject)
                and newline_count(subject) < config.newlines_forcing_braces
                and character_count(subject) <= config.longest_quoted_string:
            quoted
        else: braced)
}

-- In the quoted form every character that could be misread is caret-escaped.
-- A quote is `^"`, a caret is `^^`, a tab is `^-` and a newline is `^/`. A
-- control character below thirty-two, save one, is a caret and the letter
-- thirty-two above it, so a null is `^@` and the rest follow the alphabet up
-- from there. The exception is code point thirty, and it joins the range
-- from one-two-seven to one-five-nine as `^(HH)`, the caret then the code
-- point as two upper-case hex digits.
--
-- A character at one-six-zero and above stands for itself, written as its own
-- UTF-8 bytes rather than escaped. This is the correction: escaping those to
-- hex made a molded accented string a thicket of `^(...)` that still read
-- back, but was unreadable and unlike what a real R3 writes.
rule TheQuotedFormCaretEscapesWhatWouldBeMisread {
    when: EvaluateMold(subject)
    requires: is_string(subject)
    requires: molds_as(subject) = quoted

    ensures:
        for character in subject:
            the_way_it_is_written(character) = caret_escaping_of(character)
}

-- The braced form escapes less, which is the whole reason to reach for it. A
-- quote and a newline stand for themselves, a real quote and a real line
-- break rather than `^"` and `^/`. A caret, a tab and a control character
-- escape exactly as they do in the quoted form.
--
-- A brace is the subtle one. It is escaped as `^{` or `^}` only when the
-- braces in the text do not pair up; a balanced pair is left literal,
-- because balanced braces read back as themselves inside a braced string.
-- So `{a {b} c}` molds with its inner braces bare and `{a {b}` molds with
-- the lone opener escaped, and the decision is made over the whole string
-- rather than brace by brace.
rule TheBracedFormLeavesBalancedBracesAndRealNewlinesAlone {
    when: EvaluateMold(subject)
    requires: is_string(subject)
    requires: molds_as(subject) = braced

    ensures:
        for character in subject:
            the_way_it_is_written(character) =
                if is_brace(character) and the_braces_do_not_pair_up(subject):
                    caret_escaped(character)
                else if is_quote(character) or is_newline(character):
                    literal(character)
                else: caret_escaping_of(character)
}

-- A file molds as a percent sign and then its path, with each character that
-- would not survive the reader written as `%XX` in upper-case hex.
--
-- What gets escaped is the set the file lexer would otherwise stop at or
-- misread: a control character or a space, from zero to thirty-two; a lexer
-- delimiter, which is the semicolon, the double quote, the two parentheses,
-- the two square brackets, the two braces, the two angle brackets, the
-- backslash and the caret; the delete character at one-two-seven; and a
-- percent or a colon. Everything else is written literally.
--
-- The escaping is what makes a molded file read back. Before it, a space
-- ended the path halfway and a control character vanished into the terminal,
-- so mold and load disagreed about what the file was called. The percent and
-- the colon are there because the reader treats them specially -- a percent
-- begins an escape and a colon could start a scheme -- so a file whose name
-- holds one has to hand it over already escaped.
rule AFileMoldsWithEachAwkwardCharacterPercentEscaped {
    when: EvaluateMold(subject)
    requires: is_file(subject)

    ensures: MoldResult(text: a_percent_prefix_then_the_escaped_path(subject))
    ensures:
        for character in subject:
            the_way_it_is_written(character) =
                if needs_file_escaping(character): percent_hex_upper(character)
                else: literal(character)

    @guidance
        -- A comma is a known gap. A real R3 does not escape a comma in a
        -- file and its reader accepts one, so `%a,b` molds and loads back
        -- there. JEBOL's file lexer still ends a name at a comma, so a file
        -- holding one molds correctly and does not read back, and the full
        -- zero-to-two-hundred-and-fifty-five round trip waits on the lexer
        -- fix rather than on anything here. Tracked with the lexer cluster.
}

-- FORM drops a word's sigil where MOLD keeps it. Every word datatype that
-- carries a marker -- a lit-word's tick, a set-word's colon, a get-word's
-- colon, a refinement's slash, an issue's hash -- forms to its bare
-- spelling, so `form ['a 'b 3]` is "a b 3" and `form [/a b: :c #d]` is
-- "a b c d".
--
-- MOLD keeps the marker, because MOLD writes what reads back and the marker
-- is what makes a lit-word a lit-word rather than a plain word: `mold ['a b:]`
-- is "['a b:]". So the two disagree on every word that is not a plain one,
-- and the disagreement is the whole point of having both -- FORM is for a
-- person to read and MOLD is for the reader to read.
--
-- This is a datatype-by-datatype fact rather than a special case: the C's
-- Mold_Value appends the bare symbol when forming and adds the tick, colon,
-- slash or hash only when molding, one branch per word kind.
rule FormDropsAWordsSigilAndMoldKeepsIt {
    when: EvaluateCall(verb, subject)
    requires: verb in {form, mold}
    requires: is_any_word(subject)

    ensures: CallResult(value:
        if verb = form: the_bare_spelling_of(subject)
        else: the_spelling_with_its_sigil(subject))
}

-- === Encoding bytes as text, and back ======================

-- ENHEX and DEHEX are percent encoding, as a URL carries it.
--
-- ENHEX escapes a character the target will not carry literally, writing it
-- as a percent sign and two hexadecimal digits. Which characters need it is
-- not fixed: a file and a url keep more than a query component does, so the
-- default set follows the datatype of the value, and /EXCEPT names a set
-- directly.
--
-- These are here rather than deferred with the rest of the codecs because
-- DECODE-URL cannot run without ENHEX. Rebol's own url-parser opens with
-- `url: to binary! enhex/except url enhex-bits`, so every caller of
-- DECODE-URL raises not-defined until this exists.
rule EnhexEscapesWhatTheTargetWillNotCarry {
    when: EvaluateCall(enhex, value)
    ensures: CallResult(value: percent_encoded(value,
        keeping: default_unescaped_set_for(value.datatype)))
}

-- The default set follows the datatype, which is the part a caller can be
-- surprised by. A file or a url keeps the characters a path needs -- the
-- slashes, the colon -- and anything else keeps only what a query component
-- may hold.
rule TheDefaultUnescapedSetFollowsTheDatatype {
    when: EvaluateCall(enhex, value)
    requires: value.datatype in {file, url}
    ensures: CallResult(value: percent_encoded(value, keeping: uri_set()))
}

-- DEHEX is the inverse, and it reads two hexadecimal digits after the escape
-- character. A percent sign with anything else after it stands for itself,
-- because a URL that was never encoded must survive being decoded.
rule DehexReadsTwoHexDigits {
    when: EvaluateCall(dehex, value)
    ensures: CallResult(value: percent_decoded(value))
}

-- /URI spells a space as a special character rather than as %20, because a
-- form-encoded query writes it as a plus.
--
-- The default character depends on the escape character, which is the
-- awkward part of the C and worth stating: a plus, unless the escape
-- character is an equals sign, in which case an underscore.
rule TheUriFormSpellsASpaceSpecially {
    when: EvaluateCall(enhex, value)
    requires: refinement_asked(uri)
    ensures: CallResult(value: percent_encoded_with_space_as(
        escape_character_is(equals) ? underscore : plus))
}

-- ENBASE and DEBASE move between bytes and a textual representation of them,
-- in one of five bases.
--
-- Five and only five: 85, 64, 36, 16 and 2. Any other base raises rather
-- than being approximated, and the message names the base rather than the
-- data, which is the clue that the base is read first.
rule OnlyFiveBasesExist {
    when: EvaluateCall(enbase, value, base)
    requires: base not in {85, 64, 36, 16, 2}
    ensures: CallFails(error: invalid_arg, about: base)
}

-- Both bound their reading with /part, on the same terms every other /part
-- follows: a whole number of units, or a position into the same series.
--
-- The bound really bounds. It was declared and ignored, which is the worst
-- of the three possible states: a caller asking for the first eight bytes
-- got all of them, and nothing said so, because the call succeeded and the
-- answer was a perfectly well formed encoding of the wrong thing.
rule EnbaseAndDebaseBoundTheirReadingWithPart {
    when: EvaluateCall(verb, value, base)
    requires: verb in {enbase, debase}
    requires: refinement_asked(part)

    ensures: CallResult(value: the_encoding_of_only(the_length_taken(verb)))
}

-- The two are inverses over every base, which is the only property of them
-- worth testing exhaustively.
invariant EnbaseAndDebaseAreInverses {
    for base in {85, 64, 36, 16, 2}:
        for octets in AnyBinary:
            debase(enbase(octets, base), base) = octets
}

-- TO-HEX takes a char and a tuple as well as an integer, and answers an
-- issue in every arm.
--
-- A char becomes its code point in hex, two digits for each byte the code
-- point needs: `#61` for #"a" and `#2603` for the snowman. So the width
-- follows the character rather than being fixed, and /size widens it when a
-- caller wants a column to line up.
--
-- A tuple becomes two hex digits for each of its segments, padded out to at
-- least three: `#010203` for 1.2.3 and `#01020304` for 1.2.3.4. Three is the
-- floor because a colour is three segments and a shorter tuple read as a
-- colour would be a different colour, not a shorter one.
--
-- An issue in every arm, including the integer one, which is the part to
-- hold on to. TO-HEX names what it answers after the sigil rather than after
-- the datatype, so nothing here answers a string and a caller comparing
-- against `"61"` finds nothing.
rule ToHexAnswersAnIssueForAnIntegerACharOrATuple {
    when: EvaluateCall(to_hex, subject)
    requires: is_integer(subject) or is_char(subject) or is_tuple(subject)

    ensures: CallResult(value: an_issue_of(
        if is_tuple(subject): two_digits_per_segment_padded_to_three(subject)
        else: two_digits_per_byte_of(subject)))
}

-- CHECKSUM answers a binary, and the method decides how long it is.
--
-- A word names the method, and it must be one the build offers:
-- `system/catalog/checksums` is the list, filled in by the host rather than
-- written out, because which hashes exist depends on what the host can do.
rule ChecksumNeedsAMethodTheHostHas {
    when: EvaluateCall(checksum, data, method)
    requires: method not in host_checksum_methods()
    ensures: CallFails(error: invalid_arg, about: method)
}

-- A string is encoded as UTF-8 before hashing, which is what makes the
-- answer the same as hashing the bytes a file would hold. Hashing the
-- codepoints instead would make the same text hash differently depending on
-- how it arrived.
rule AStringIsHashedAsItsUtf8Bytes {
    when: EvaluateCall(checksum, data, method)
    requires: is_any_string(data)
    ensures: CallResult(value: checksum_of(utf8_bytes_of(data), method))
}

-- COMPRESS and DECOMPRESS take a method word for the same reason, and the
-- same rule applies: the list is the host's, in
-- `system/catalog/compressions`. Neither belongs in the domain, because both
-- are a library the host happens to carry.
rule CompressNeedsAMethodTheHostHas {
    when: EvaluateCall(compress, data, method)
    requires: method not in host_compression_methods()
    ensures: CallFails(error: invalid_arg, about: method)
}

-- And they are inverses, which is the whole of what a caller needs.
invariant CompressAndDecompressAreInverses {
    for method in host_compression_methods():
        for octets in AnyBinary:
            decompress(compress(octets, method), method) = octets
}

-- === The interpreter's own state ============================

-- Eight functions that ask the interpreter about itself rather than about a
-- value. They are grouped because they share one property: each is a window
-- onto something the host owns, so each needs the host's answer rather than
-- a rule from the C.

-- VERSION answers text, or a tuple when /DATA asks for one it can compare.
--
-- Two forms because two callers want different things. A banner prints the
-- text; a module header compares the tuple against its Needs field, and a
-- string will not compare.
rule VersionAnswersTextOrATuple {
    when: EvaluateCall(version)
    ensures: CallResult(value: the_version_as_text())
}

rule TheDataFormIsATuple {
    when: EvaluateCall(version)
    requires: refinement_asked(data)
    ensures: CallResult(value: the_version_as_a_tuple())
}

-- POKEZ counts from zero, and is POKE underneath.
--
-- The C is three lines and the condition on the first is the whole of it:
-- `if (VAL_INT64(D_ARG(2)) >= 0 && !IS_BITSET(D_ARG(1))) VAL_INT64(D_ARG(2)) += 1;`
-- A negative index is left alone, because counting back from the tail means
-- the same thing in both conventions. A bitset is left alone too: its index
-- is a character code, not a position, so there is nothing to shift.
rule PokezCountsFromZero {
    when: EvaluateCall(pokez, series, index, value)
    requires: index >= 0
    requires: not is_bitset(series)
    ensures: CallResult(value: result_of_poking(series, index + 1, value))
}

rule ANegativeIndexOrABitsetIsNotShifted {
    when: EvaluateCall(pokez, series, index, value)
    requires: index < 0 or is_bitset(series)
    ensures: CallResult(value: result_of_poking(series, index, value))
}

-- TO-REAL-FILE answers the canonical absolute path, and none for a file that
-- is not there.
--
-- None rather than a failure, because the question is "what is this really"
-- and "nothing" is a true answer to it. The C says so in its own summary:
-- "resolves symbolic links and returns NONE if file does not exists!".
rule ToRealFileAnswersNoneForAFileThatIsNotThere {
    when: EvaluateCall(to_real_file, path)
    requires: not exists(path)
    ensures: CallResult(value: none)
}

-- It is a host call, so it needs the files service like every other one.
rule ToRealFileNeedsTheFilesService {
    when: EvaluateCall(to_real_file, path)
    requires: not service_granted(files)
    ensures: CallFails(error: no_service, about: files)
}

-- The datatype catalogue holds every datatype including end!, and the
-- any-type! typeset holds every one except end!. So the two differ by
-- exactly that one entry, and `difference system/catalog/datatypes to-block
-- any-type!` is `[#(end!)]`.
--
-- End! is the marker for the end of a series of values rather than a value
-- anything can hold, which is why the typeset that means "any value at all"
-- leaves it out and the catalogue that means "every datatype there is"
-- keeps it.
--
-- It is the FIRST entry in the order, not the last, and that is worth
-- pinning because the neighbouring assertion depends on it. Rebol's own
-- typeset-test.r3 checks both facts together: the difference is [#(end!)],
-- and `last to-block any-type!` equals `last system/catalog/datatypes`. Both
-- hold only when end! sits at the front and the two lists end on the same
-- entry. A catalogue built with end! appended at the back satisfies the
-- first assertion and fails the second.
rule TheDatatypeCatalogueHoldsEndAndTheAnyTypeSetDoesNot {
    when: EvaluateCall(difference, the_datatype_catalogue, any_type_as_a_block)

    ensures: CallResult(value: block_of_only(end_datatype))
}

invariant TheCatalogueAndAnyTypeEndOnTheSameDatatype {
    last_of(the_datatype_catalogue()) = last_of(any_type_as_a_block())
}

-- TYPES-OF a function answers a block of typesets, one for each entry of its
-- argument list, in the order they were declared.
--
-- Each entry and not each parameter, which is the part to get right.
-- Refinements are entries in their own right, sitting between the parameters
-- they follow and the arguments they introduce, so the block is longer than
-- a count of the named parameters suggests.
--
-- A refinement's typeset is the same for every refinement there is:
-- `[none! logic!]`, because its slot holds none when the caller did not ask
-- and a logic when it did. That is what Rebol's own typeset-test.r3 asserts,
-- and it picked the case that proves the point: `third types-of :insert` is
-- `make typeset! [none! logic!]`, and INSERT's third entry is /part rather
-- than a third parameter.
--
-- A parameter declared with no datatypes carries the any-type! set, so every
-- entry has a typeset and none of them is none.
rule TypesOfAnswersOneTypesetPerArgumentListEntry {
    when: EvaluateCall(types_of, subject)
    requires: is_function(subject)

    ensures: CallResult(value: block_of(
        the_typesets_of_the_argument_list_of(subject)))

    ensures:
        for entry in the_argument_list_of(subject):
            the_typeset_answered_for(entry) =
                if names_a_refinement(entry): the_none_or_logic_typeset()
                else if declares_no_datatypes(entry): the_any_type_typeset()
                else: the_typeset_declared_by(entry)
}

-- RECYCLE answers how many bytes the collection RELEASED, not how many are
-- in use.
--
-- This entry said "in use" and was wrong. The C ends
-- `released_bytes = Recycle(TRUE, D_REF(6)); DS_Ret_Int(released_bytes);`, so
-- the number is what the collection freed. The two readings differ by more
-- than a detail: one grows as a program allocates and the other shrinks.
rule RecycleAnswersTheBytesItReleased {
    when: EvaluateCall(recycle)
    ensures: CallResult(value: bytes_released_by_collecting())
}

-- /OFF answers nothing at all, and turns the collector off.
--
-- `if (D_REF(1)) { GC_Active = FALSE; return R_UNSET; }` -- the first thing
-- the C does, before it collects anything. So /OFF is the one form that does
-- not collect and the one form with no answer.
rule RecycleOffAnswersUnset {
    when: EvaluateCall(recycle)
    requires: refinement_asked(off)
    ensures: CallResult(value: unset)
}

-- STATS answers a number about the interpreter's own storage, and which
-- number depends on the refinement.
--
-- The plain form is `Inspect_Series(flags)`, which measures series rather
-- than the whole heap. /SHOW is the same measurement with printing turned on.
rule StatsAnswersASeriesMeasurement {
    when: EvaluateCall(stats)
    ensures: CallResult(value: storage_used_by_series())
}

-- /TIMER is time since the interpreter started, which is what makes it useful
-- for measuring a stretch of work rather than for telling the time.
rule TheTimerIsSinceStartUp {
    when: EvaluateCall(stats)
    requires: refinement_asked(timer)
    ensures: CallResult(value: time_since_start_up())
}

-- /EVALS is the one with a rule rather than a reading: it counts values the
-- evaluator has walked, and it must never go backwards within one
-- interpreter.
invariant TheEvaluationCountOnlyRises {
    for interpreter in Interpreters:
        stats_evals(interpreter) >= previous(stats_evals(interpreter))
}

-- HALT stops the script and returns to whatever was reading it.
--
-- Not QUIT: quitting ends the host's run and halting does not, so a console
-- that halts is still a console afterwards. It is the same shape as QUIT in
-- every other way, which is why both are signals rather than answers.
rule HaltStopsTheScriptAndKeepsTheHost {
    when: EvaluateCall(halt)
    ensures: ScriptRun.status = halted
}

-- STACK answers what the evaluator is in the middle of.
--
-- Reachable here because evaluation state lives in frames on the heap rather
-- than in host-language stack frames -- see decision 1. An implementation
-- that used the host's own stack could not answer this at all.
rule StackDepthCountsFrames {
    when: EvaluateCall(stack, offset)
    requires: refinement_asked(depth)
    requires: a_frame_exists_at(offset)
    ensures: CallResult(value: frames_currently_open())
}

-- An offset naming no frame answers none, whatever refinement was asked for.
--
-- This entry did not say so and should have. The C tests it before it looks
-- at a single refinement:
--
--     sp = Stack_Frame(index);
--     if (!sp) return R_NONE;
--
-- So `stack/depth 99` is none rather than a depth, and a caller walking
-- outwards can tell where the stack ends. Answering a number regardless would
-- make the walk run for ever.
rule AnOffsetWithNoFrameAnswersNone {
    when: EvaluateCall(stack, offset)
    requires: not a_frame_exists_at(offset)
    ensures: CallResult(value: none)
}

-- With no refinement at all it answers a backtrace: a block, not none.
rule StackWithNoRefinementAnswersABacktrace {
    when: EvaluateCall(stack, offset)
    requires: no_refinement_asked()
    requires: a_frame_exists_at(offset)
    ensures: CallResult(value: a_block_of_frames_from(offset))
}

-- === The four diagnostics, read again ======

-- These were nearly specified as refusals, and reading the C again said
-- otherwise. Three of the four are portable, and the fourth has an error Rebol
-- supplies itself. What follows is what a shipped 3.22.1 does, which is not
-- what its source looks like at a glance: two of the four have bodies that are
-- compiled out of a release build entirely.

-- DS prints the frame stack and answers unset.
--
-- `Dump_Stack(0, 0)` and nothing else, and it is compiled into every build.
-- What it prints is not a C memory structure: it is one line per frame giving
-- the word the call was made through, how many arguments it took and the
-- function's datatype, then one line per argument giving its name and value.
-- The formats are in `boot/strings.reb` -- `^/STACK[%d] %s[%d] %s` and
-- `\t%s: %72r`.
--
-- So this is the same information STACK already answers here, printed instead
-- of returned, and JEBOL can answer it for the same reason STACK can: the
-- frames are on the heap rather than on the host's stack.
--
-- It walks from the innermost frame outwards, because the C recurses into
-- `PRIOR_DSF(dsf)` after printing the frame it is on.
rule DsPrintsTheFrameStackFromTheInnermostOutwards {
    when: EvaluateCall(ds)
    ensures: printed(a_line_per_open_frame_from_the_innermost)
    ensures: CallResult(value: unset)
}

-- At the top level there is nothing open, so it prints one line and no more.
rule DsAtTheTopLevelPrintsOnlyTheTopLine {
    when: EvaluateCall(ds)
    requires: no_frame_is_open()
    ensures: CallResult(value: unset)
}

-- DUMP answers what it was given and prints nothing.
--
-- Its whole body sits inside `#ifdef DEBUG`, so a release build reaches the
-- last line and nothing else: `return R_ARG1;`. A shipped 3.22.1 prints
-- nothing for `dump [1 2]` and answers `[1 2]`, and that is the behaviour to
-- port -- not the debug build's series walk, which no released Rebol performs.
--
-- /FMT is declared and reaches the same nothing.
rule DumpAnswersItsArgumentAndPrintsNothing {
    when: EvaluateCall(dump, value)
    ensures: printed(nothing)
    ensures: CallResult(value: value)
}

-- CHECK answers the series it was given, and cannot fail here.
--
-- It is not a debug-only function: it walks the series looking for a
-- terminator in the wrong place and raises `bad-series` when it finds one.
-- That is a check on the C's own invariant -- every REBSER holds a terminating
-- zero past its tail -- and a JEBOL series has no terminator to be wrong.
--
-- So the check holds for every series, always, and the answer is the value.
-- Raising instead would report a corruption that cannot happen; answering
-- something other than the value would part from the C for no reason.
rule CheckAnswersTheSeriesItWasGiven {
    when: EvaluateCall(check, series)
    ensures: CallResult(value: series)
}

-- And it takes a series and nothing else: `val [series!]`.
rule CheckRefusesWhatIsNotASeries {
    when: EvaluateCall(check, value)
    requires: not is_series(value)
    ensures: CallFails(error: expect_arg)
}

-- EVOKE is a dialect, and most of its chants are unavailable rather than
-- unportable.
--
-- The C's own summary is "Special guru meditations. (Not for beginners.)" Its
-- chant is a word, a block of words or an integer, and what each does depends
-- on how Rebol was built:
--
--   * `crash-dump`, `watch-recycle`, `watch-alloc`, `watch-obj-copy`,
--     `watch-expand` and `crash` are compiled in only under DEBUG. A release
--     build raises `feature-na` for each -- Rebol's own error for a build that
--     cannot do what was asked.
--   * `stack-size n` expands the C's data stack, and is compiled in always.
--   * an integer runs `Check_Memory` and `Check_Bind_Table` in combination.
--   * anything else prints the help text listing the chants.
--
-- `feature-na` is the answer for the debug chants here too, and for the same
-- reason: this build cannot do it. Reusing Rebol's error rather than inventing
-- a refusal keeps a script that handles one handling both.
rule EvokeRaisesFeatureNaForADebugOnlyChant {
    when: EvaluateCall(evoke, chant)
    requires: chant_is_debug_only(chant)
    ensures: CallFails(error: feature_na)
}

-- `stack-size` is accepted and does nothing, because what it asks for is
-- already automatic.
--
-- It is not a permission. `Expand_Stack` grows the interpreter's own
-- value-stack buffer, and the evaluator grows it unasked whenever it runs low:
-- `if ((DSP + 200) > SERIES_REST(DS_Series)) Expand_Stack(STACK_MIN);` at the
-- top of every step. So the chant is a capacity hint about an allocation, not a
-- request for room a script would not otherwise be allowed.
--
-- A JVM grows its own structures the same way and without being asked, so there
-- is nothing here to do and nothing to refuse. This is not the bound
-- LIMIT-USAGE covers below: that one is a security limit SECURE sets, and it is
-- the reason a script may tighten and never loosen.
rule EvokeAcceptsStackSizeAndDoesNothing {
    when: EvaluateCall(evoke, chant)
    requires: chant = stack_size
    ensures: CallResult(value: unset)
}

-- An integer chant asks for memory checks that have nothing to check.
--
-- `Check_Memory` walks Rebol's pools and `Check_Bind_Table` walks its bind
-- table. Neither exists here, and neither can be wrong here. The C answers
-- unset whichever branch it took, so a caller cannot tell a passed check from
-- a skipped one, and that is what makes doing nothing the faithful answer.
rule EvokeAcceptsAnIntegerChantAndAnswersUnset {
    when: EvaluateCall(evoke, chant)
    requires: is_integer(chant)
    ensures: CallResult(value: unset)
}

-- And an unrecognised word prints the list of chants, as the C does.
rule EvokeWithAnUnknownChantPrintsTheHelp {
    when: EvaluateCall(evoke, chant)
    requires: is_word(chant)
    requires: not chant_is_known(chant)
    ensures: printed(the_list_of_chants)
    ensures: CallResult(value: unset)
}

-- A block chant is each of its items in turn, so one call can carry several,
-- and one bad item in the block refuses the whole call.
rule EvokeTakesABlockOfChantsInTurn {
    when: EvaluateCall(evoke, chant)
    requires: is_block(chant)
    requires: any_item_of_is_debug_only(chant)
    ensures: CallFails(error: feature_na)
}

-- === Recording a limit that nothing yet enforces ======

-- LIMIT-USAGE records a number and answers nothing. That is the whole of it,
-- and the second half of that sentence is the part that took reading.
--
-- The native is four lines: `if (Eval_Limit == 0) Eval_Limit = Int64(...)` for
-- eval, the same for memory, and `return R_UNSET`. So it is set-once, it answers
-- unset either way, and a field that is neither of the two falls out of the
-- bottom untouched -- there is an if, an else-if and no else.
--
-- Nothing about that stops a script. The limit is read in one place, inside
-- `Do_Signals`:
--
--     if (Eval_Limit != 0 && Eval_Cycles > Eval_Limit)
--         Check_Security(SYM_EVAL, POL_EXEC, 0);
--
-- and `Check_Security` reads `system/state/policies/eval`, which
-- `boot/sysobj.reb` sets to `0.0.0` -- ALLOW -- along with every other policy. An
-- allowed policy does nothing. So in a Rebol nobody has called SECURE on,
-- exceeding the limit has no effect at all, and SECURE is what changes that:
-- `secure [eval throw]` makes the same overrun raise `security`.
--
-- JEBOL has no SECURE. It is on the porting backlog under the host, because
-- where its boundary sits is a decision nobody has taken. Until it exists, this
-- native records what a script asked for and enforces nothing -- which is what a
-- stock Rebol does, and the alternative would be JEBOL stopping a script where
-- Rebol would not.
--
-- The host can read the request even so. A script asking to be limited is worth
-- an embedder knowing about, and telling the embedder changes nothing the script
-- can see.
rule LimitUsageAnswersNothing {
    when: EvaluateCall(limit_usage, field, limit)
    ensures: CallResult(value: unset)
}

-- The first call for a field records it.
rule LimitUsageRecordsTheFirstLimitForAField {
    when: EvaluateCall(limit_usage, field, limit)
    requires: field = eval or field = memory
    requires: no_limit_recorded_yet_for(field)
    ensures: limit_recorded_for(field) = limit
}

-- And the second does not, because the C tests for zero before it writes.
--
-- Set-once is what makes the first call trustworthy: a script cannot narrow
-- itself and then widen itself again, and it cannot narrow itself twice either.
rule LimitUsageIsSetOnce {
    when: EvaluateCall(limit_usage, field, limit)
    requires: field = eval or field = memory
    requires: a_limit_is_already_recorded_for(field)
    ensures: limit_recorded_for(field) = unchanged
}

-- A field name that is neither is ignored rather than refused.
--
-- SECURE is the only caller in Rebol and it passes one of the two, so the C
-- never needed an else. Refusing would be tidier and would part from the C for
-- nothing.
rule LimitUsageIgnoresAnyOtherField {
    when: EvaluateCall(limit_usage, field, limit)
    requires: not (field = eval or field = memory)
    ensures: CallResult(value: unset)
    ensures: nothing_is_recorded()
}

-- The field is a word and the limit is a number, and nothing else will do.
--
-- `field [word!]` and `limit [number!]`, so a string is refused at the door and
-- so is a decimal-shaped nothing. A number rather than an integer: the C reads
-- it with `Int64`, which takes a decimal and cuts the fraction off.
rule LimitUsageRefusesAnythingElse {
    when: EvaluateCall(limit_usage, field, limit)
    requires: not is_word(field) or not is_number(limit)
    ensures: CallFails(error: expect_arg)
}

open question "Enforcing a recorded limit needs SECURE, and SECURE needs a decision about where its boundary sits: Rebol's policies cover file, net, eval, memory, secure, protect, debug, envr, call, browse and extension, and JEBOL has host grants for some of that ground already. Are policies a second mechanism beside the grants, or does SECURE narrow the grants a host gave? Until that is answered, a limit recorded here is inert -- which is what a stock Rebol does, since every policy defaults to ALLOW."

open question "The six natives that wait on a datatype -- AS-COLOR on image!, MAP-GOB-OFFSET on gob!, MAP-EVENT and WAKE-UP on event!, DO-CODEC and RELEASE on handle! -- have nothing to specify until the datatype they take exists, because each is a small arm over a value JEBOL cannot make. They are recorded in Goal 1 of TODO.md in the order boot/types.reb declares the datatypes, which is the order they will be built. What is not yet decided is whether handle! should carry a Java object directly, since that is what a JVM codec would need to hold, or stay opaque the way the C's does."

-- === Rebol's own scrambler, and changing character set ======

-- ENCLOAK and DECLOAK scramble a binary against a key, in place.
--
-- Rebol's own cipher, written out in fifty-five lines of `Cloak` in s-ops.c.
-- Not a standard one and not presented as strong: the C's own summary is
-- "Simple data scrambler. Quality depends on the key length."
--
-- They are here because they are small, exact and self-contained. Nothing in
-- the library waits on them.
rule EncloakAndDecloakAreInverses {
    when: EvaluateCall(decloak, encloak(data, key), key)
    ensures: CallResult(value: data)
}

-- The key is hashed to twenty bytes first, unless /WITH says to use it as it
-- stands.
--
-- The C builds twenty bytes by cycling the key, takes the SHA-1 of those, and
-- uses the digest as the real key:
--
--     if (!as_is) {
--         for (i = 0; i < 20; i++) src[i] = kp[i % klen];
--         SHA1(src, 20, dst);
--         klen = 20;
--         kp = dst;
--     }
--
-- So a one-byte key and a twenty-byte key are equally long by the time the
-- scrambling starts, which is what "quality depends on the key length" is
-- about: the entropy, not the byte count.
rule TheKeyIsHashedUnlessAskedOtherwise {
    when: EvaluateCall(encloak, data, key)
    requires: not refinement_asked(with)
    ensures: CallResult(value: scrambled_with(data, sha1_of_the_cycled(key)))
}

-- An integer key is spelled out in decimal first, and is always hashed.
--
-- `INT_TO_STR(VAL_INT64(val), dst); ... as_is = FALSE;` -- the C overrides the
-- refinement rather than honouring it, because the digits are not a key a
-- caller chose the bytes of.
rule AnIntegerKeyIsAlwaysHashed {
    when: EvaluateCall(encloak, data, key)
    requires: is_integer(key)
    ensures: CallResult(value: scrambled_with(data, sha1_of_the_cycled(decimal_text_of(key))))
}

-- Empty data is left alone, and answered.
--
-- `if (dlen == 0) return TRUE;` before anything else. Not a failure: there is
-- nothing to scramble and nothing went wrong.
rule EmptyDataIsLeftAlone {
    when: EvaluateCall(encloak, data, key)
    requires: length_of(data) = 0
    ensures: CallResult(value: data)
}

-- A key with no bytes is refused.
--
-- `if (klen == 0) return FALSE;` and the caller turns that into
-- `Trap_Arg(key)`. Scrambling against nothing would answer the data back and
-- look as though it had worked.
rule AnEmptyKeyIsRefused {
    when: EvaluateCall(encloak, data, key)
    requires: length_of(key) = 0
    ensures: CallFails(error: invalid_arg, about: key)
}

-- Both change the binary they were given rather than answering a copy.
--
-- The spec says so -- `data [binary!] "Binary series to scramble (modified)"`
-- -- and the C returns R_ARG1. A protected series is refused before anything
-- is written: `if (IS_PROTECT_SERIES(...)) Trap0(RE_PROTECTED)`.
rule ScramblingChangesTheBinaryInPlace {
    when: EvaluateCall(encloak, data, key)
    ensures: data_is_modified_in_place(data)
}

-- ICONV reads a binary as text in a named character set, or transcodes it to
-- another.
--
-- Two answers from one function, which the refinement chooses: without /TO it
-- answers a string, and with /TO it answers a binary. That is not a
-- convenience -- decoding and transcoding are different operations, and one
-- of them has no text form to answer.
rule IconvAnswersTextOrABinary {
    when: EvaluateCall(iconv, data, codepage)
    ensures: CallResult(value: text_read_from(data, codepage))
}

rule TheToFormAnswersABinary {
    when: EvaluateCall(iconv, data, codepage)
    requires: refinement_asked(to)
    ensures: CallResult(value: bytes_transcoded(data, codepage, target))
}

-- A character set the host does not have is refused rather than guessed at.
rule AnUnknownCharacterSetIsRefused {
    when: EvaluateCall(iconv, data, codepage)
    requires: codepage not in host_character_sets()
    ensures: CallFails(error: invalid_arg, about: codepage)
}

-- === The PNG delta filters ==================================

-- FILTER and UNFILTER are the five per-scanline transforms a PNG applies
-- before compressing, and their inverses.
--
-- Byte arithmetic and nothing else: each output byte is the input byte less a
-- prediction made from its neighbours, and the whole point is that the
-- differences compress better than the values. They are here because they are
-- exact, self-contained and needed by any image codec that follows.
--
-- Five types, numbered as the PNG format numbers them: none, sub, up,
-- average and paeth. A name or a number names one.
enum PngFilter { none | sub | up | average | paeth }

-- SUB predicts from the pixel to the left.
rule SubPredictsFromTheLeft {
    when: EvaluateCall(filter, data, width, sub)
    ensures: CallResult(value: each_byte_less(the_byte_one_pixel_left))
}

-- UP predicts from the same column on the line above. The line above the
-- first is treated as zeros, which is what makes the first line encode as
-- itself.
rule UpPredictsFromTheLineAbove {
    when: EvaluateCall(filter, data, width, up)
    ensures: CallResult(value: each_byte_less(the_byte_on_the_previous_line))
}

-- AVERAGE predicts from the mean of the two, and the mean is floored by a
-- shift rather than rounded: `(scan[c - bpp] + prev[c]) >> 1`.
rule AveragePredictsFromTheMeanOfBoth {
    when: EvaluateCall(filter, data, width, average)
    ensures: CallResult(value: each_byte_less(the_floored_mean_of_both))
}

-- PAETH predicts whichever of the three neighbours is closest to their
-- linear estimate, and the tie-breaks are ordered: left, then above, then
-- above-left.
rule PaethPredictsTheNearestNeighbour {
    when: EvaluateCall(filter, data, width, paeth)
    ensures: CallResult(value: each_byte_less(the_nearest_of_three_neighbours))
}

-- Every filter is reversible, which is the only property that matters to a
-- caller: a codec filters to compress and unfilters to read back.
invariant EveryFilterIsReversible {
    for kind in PngFilter:
        for scanlines in AnyBinary:
            unfilter(filter(scanlines, width, kind), width, kind) = scanlines
}

-- Without /AS, UNFILTER reads each line's filter type from that line's first
-- byte, which is how a PNG actually stores it.
--
-- So the two forms take different widths, and the C adjusts for it before
-- checking: `if (!ref_as) width++;`. A caller passing the same width to both
-- forms is passing two different things, and the type byte is the difference.
rule WithoutTheAsFormEachLineCarriesItsType {
    when: EvaluateCall(unfilter, data, width)
    requires: not refinement_asked(as)
    ensures: CallResult(value: each_line_unfiltered_by_its_own_leading_byte())
}

-- A width of one or less, or wider than the data, is refused. So is a
-- bytes-per-pixel of less than one or wider than a line.
rule AnImpossibleGeometryIsRefused {
    when: EvaluateCall(filter, data, width, kind)
    requires: width <= 1 or width > length_of(data)
    ensures: CallFails(error: invalid_arg, about: width)
}

-- === Adding to a map, and asking an object whether ==========

-- APPEND on a map takes key and value pairs, and answers the map.
--
-- Not the position after the insert, which is what APPEND answers for a
-- series: a map has no position, so there is nothing else it could give back.
-- The C sets the answer before it does the work -- `*D_RET = *val;` -- which
-- is how it can answer the map rather than the result of adding.
rule AppendingToAMapAnswersTheMap {
    when: EvaluateCall(append, target, pairs)
    requires: is_map(target)
    ensures: CallResult(value: target)
}

-- Only a block will do, because a pair needs two values and one value is
-- not half a pair. `if (!IS_BLOCK(arg)) Trap_Arg(val);`
rule AppendingToAMapNeedsABlock {
    when: EvaluateCall(append, target, pairs)
    requires: is_map(target)
    requires: not is_block(pairs)
    ensures: CallFails(error: invalid_arg, about: pairs)
}

-- A key with no value after it is left out rather than stored against none.
--
-- The loop needs both halves of a pair to take a step:
-- `for (...; NOT_END(val) && NOT_END(val+1); val += 2, n++)`. So a block of an
-- odd length adds every whole pair in it and drops the last key.
rule AKeyWithNothingAfterItIsLeftOut {
    when: EvaluateCall(append, target, pairs)
    requires: is_map(target)
    requires: is_block(pairs)
    ensures: CallResult(value: target_with_this_many_pairs_added(length_of(pairs) / 2))
}

-- /DUP is refused rather than ignored.
--
-- `if (DS_REF(AN_DUP)) Trap0(RE_BAD_REFINES);` -- adding the same key twice
-- would set it once and answer as though it had done something twice, so the
-- C refuses the request instead of doing something defensible with it.
rule DuplicatingIntoAMapIsRefused {
    when: EvaluateCall(append, target, pairs)
    requires: is_map(target)
    requires: refinement_asked(dup)
    ensures: CallFails(error: bad_refines, about: dup)
}

-- /PART counts pairs, not values.
--
-- `len >>= 1; // part must be number of key/value pairs`. So a /PART of one
-- adds one entry and consumes two values, and a caller counting values gets
-- twice what it asked for.
rule ThePartOfAMapCountsPairs {
    when: EvaluateCall(append, target, pairs)
    requires: is_map(target)
    requires: refinement_asked(part)
    ensures: CallResult(value: target_with_this_many_pairs_added(part / 2))
}

-- INSERT into a map is APPEND into a map, because a map has no position.
--
-- One arm of the C serves both -- `case A_INSERT: case A_APPEND:` -- so
-- everything above holds for INSERT word for word. There is no front of a map
-- to put anything at.
rule InsertingIntoAMapIsAppending {
    when: EvaluateCall(insert, target, pairs)
    requires: is_map(target)
    ensures: SameOutcomeAs(append, target, pairs)
}

-- An object has no position either, so APPEND and INSERT are one operation
-- there too. `case A_APPEND: case A_INSERT:` and both reach Append_Obj.
--
-- Adding a bare word adds a field holding unset. Not none: `SET_UNSET(val)`
-- where no value was supplied, and the two are different answers to "what is
-- in this field". A field holding none has been given something and a field
-- holding unset has not, and only the second raises when it is read.
rule AppendingAWordToAnObjectAddsAnUnsetField {
    when: EvaluateCall(verb, subject, added)
    requires: is_any_object(subject)
    requires: verb in {append, insert}
    requires: is_any_word(added)

    ensures: CallResult(value: subject)
    ensures: value_of_field(subject, added) = unset
}

-- A block is read as word and value pairs, and each word must be a word or a
-- set-word. Anything else in a word's place is refused and the complaint
-- names it: `if (!IS_WORD(word) && !IS_SET_WORD(word)) ... Trap_Arg(word);`.
--
-- So `append obj [a: 1 b: 2]` adds two fields, and the pairs are read from
-- the block as written rather than evaluated.
rule AppendingABlockToAnObjectReadsItAsPairs {
    when: EvaluateCall(verb, subject, added)
    requires: is_any_object(subject)
    requires: verb in {append, insert}
    requires: is_block(added)

    ensures: CallResult(value: subject)
    ensures:
        for pair in the_pairs_of(added):
            if is_any_word(pair.name): value_of_field(subject, pair.name) = pair.value
            else: CallFails(error: invalid_arg, about: pair.name)
}

-- /dup with a count of zero or less does nothing at all, and the object comes
-- back untouched. `if (n <= 0) break;` happens before anything is added, so a
-- count of zero is not "add it once" and not a refusal.
--
-- Which is what makes the refinement usable with a computed number. A caller
-- that worked out how many times to add something, and got zero, does not
-- have to guard the call.
rule DuplicatingIntoAnObjectZeroTimesDoesNothing {
    when: EvaluateCall(verb, subject, added)
    requires: is_any_object(subject)
    requires: verb in {append, insert}
    requires: refinement_asked(dup)
    requires: duplicate_count <= 0

    ensures: CallResult(value: subject)
    ensures: subject_is_unchanged(subject)
}

-- PUT on an object refuses a key that is not a word, and the complaint is
-- about the argument. `else { Trap_Arg(key); }` closes Extend_Obj, so the
-- failure is invalid-arg.
--
-- Invalid-arg and not cannot-use, which is worth pinning because the two are
-- easy to swap and a script probing the arm can tell them apart. A caller
-- writing `put obj 1 2` has passed a bad argument, not asked an object to do
-- something objects cannot do, and a real R3 complains about the argument.
rule PuttingAKeyThatIsNotAWordIsRefused {
    when: EvaluateCall(put, subject, key, written)
    requires: is_any_object(subject)
    requires: not is_any_word(key)

    ensures: CallFails(error: invalid_arg, about: key)
}

-- FIND on a map answers the key the map holds, not TRUE and not the value.
--
-- The C says so in a comment on the line itself:
-- `*D_RET = *VAL_BLK_SKIP(val, n - ((action == A_FIND)?1:0)); // find returns
-- the key`. The key it answers with need not be the key that was asked for,
-- because a word key is stored as a set-word, and that difference is the only
-- thing FIND on a map can tell a caller that SELECT cannot.
rule FindingAKeyAnswersTheKeyAsStored {
    when: EvaluateCall(find, target, key)
    requires: is_map(target)
    requires: has_key(target, key)
    ensures: CallResult(value: stored_key_of(target, key))
}

-- And a key it has not got answers none, from `if (n == NOT_FOUND) return
-- R_NONE;` -- the same answer a read through a path gives.
rule FindingAKeyTheMapHasNotGotAnswersNone {
    when: EvaluateCall(find, target, key)
    requires: is_map(target)
    requires: not has_key(target, key)
    ensures: CallResult(value: none)
}

-- FIND on an object answers TRUE, where SELECT answers the value.
--
-- One arm in the C serves both, and one line parts them:
-- `if (action == A_FIND) goto is_true;` before the value is read. So FIND is
-- the question "has it got one" and SELECT is the question "what is in it",
-- and a field holding none answers true to the first and none to the second.
rule FindingAFieldAnswersTrue {
    when: EvaluateCall(find, subject, word)
    requires: is_any_object(subject)
    requires: has_field(subject, word)
    ensures: CallResult(value: true)
}

-- A field it has not got answers none, from the same guard SELECT uses:
-- `if (n <= 0 || ...) return R_NONE;`
rule FindingAFieldItHasNotGotAnswersNone {
    when: EvaluateCall(find, subject, word)
    requires: is_any_object(subject)
    requires: not has_field(subject, word)
    ensures: CallResult(value: none)
}

-- And only a word asks the question. `if (IS_WORD(arg))` guards the lookup,
-- so anything else finds nothing rather than being refused.
rule OnlyAWordAsksAnObjectAnything {
    when: EvaluateCall(find, subject, wanted)
    requires: is_any_object(subject)
    requires: not is_word(wanted)
    ensures: CallResult(value: none)
}

-- A hidden field is not found, because it is not there to outside eyes.
--
-- `return (!always && VAL_GET_OPT(word, OPTS_HIDE)) ? 0 : n;` -- the search
-- answers "no such word" for a hidden one, and only an internal caller that
-- asks for the word always sees past that.
rule AHiddenFieldIsNotFound {
    when: EvaluateCall(find, subject, word)
    requires: is_any_object(subject)
    requires: field_is_hidden(subject, word)
    ensures: CallResult(value: none)
}

-- SELF is not found either, although it can be read.
--
-- The search starts one slot in: `word = FRM_WORDS(frame) + 1;` with the loop
-- running from one. Slot zero is the object's own SELF, so the search never
-- compares against it and SELF is the one name an object answers to that FIND
-- says it has not got.
rule SelfIsNotAFieldToFind {
    when: EvaluateCall(find, subject, word)
    requires: is_any_object(subject)
    requires: word = self
    ensures: CallResult(value: none)
}

-- === Reaching into a map through a path ==========

-- A path write stores the key, whether or not the map had it.
--
-- `Find_Entry(VAL_SERIES(data), pvs->select, val, FALSE)` with a value to set
-- creates the entry when it is missing and replaces the value when it is not.
rule WritingAKeyThroughAPathStoresIt {
    when: WriteThroughPath(subject, key, written)
    requires: is_map(subject)
    ensures: select_from(subject, key) = written
}

-- The key may be a value of any type, not only a word.
--
-- The C carried a list of permitted key types and now carries it commented
-- out, beside the issue that removed it: "O: No type limit enymore!". A map is
-- a dictionary of values rather than of names.
rule AKeyOfAnyTypeIsStored {
    when: WriteThroughPath(subject, key, written)
    requires: is_map(subject)
    requires: not is_word(key)
    ensures: select_from(subject, key) = written
}

-- A key the map has not got reads as none rather than failing.
rule ReadingAKeyTheMapHasNotGotAnswersNone {
    when: ReadThroughPath(subject, key)
    requires: is_map(subject)
    requires: not has_key(subject, key)
    ensures: PathResult(value: none)
}

-- Writing against a key of none does nothing at all, and says nothing.
--
-- Two lines make it so. `if (IS_NONE(pvs->select)) return PE_NONE;` in the
-- path handler, and `if (IS_NONE(key)) return NOT_FOUND;` in the lookup
-- underneath it. The path answers none and the value never lands, so the map
-- is the length it was.
--
-- @guidance A caller cannot tell this from a write that worked. Nothing in the
-- C reports it, and adding a failure here would be our invention.
rule AKeyOfNoneIsNeverStored {
    when: WriteThroughPath(subject, key, written)
    requires: is_map(subject)
    requires: key = none
    ensures:
        PathResult(value: none)
        subject unchanged
}

-- A protected map is refused before anything is written.
--
-- `if (pvs->setval) TRAP_PROTECT(VAL_SERIES(data));` is the first line of the
-- handler, so the check happens before the key is even looked at.
rule WritingToAProtectedMapIsRefused {
    when: WriteThroughPath(subject, key, written)
    requires: is_map(subject)
    requires: is_protected(subject)
    ensures: PathFails(error: protected, about: subject)
}

-- === The pairs of a map, read out and walked over ==========

-- A word key is held as a set-word, whichever kind of word was written.
--
-- `if (ANY_WORD(key) && VAL_TYPE(key) != REB_SET_WORD) ... VAL_SET(set,
-- REB_SET_WORD);` -- so a word, a lit-word, a get-word and a refinement of the
-- same spelling are one key rather than four, and everything that reads the
-- pairs back out sees the colon.
rule AWordKeyIsHeldAsASetWord {
    when: StoreInMap(subject, key, written)
    requires: is_any_word(key)
    ensures: stored_key_of(subject, key) = as_set_word(key)
}

-- And a key of any other type is held exactly as it was written, so a map
-- molds with a colon after a word key and nothing after any other.
rule AnyOtherKeyIsHeldAsWritten {
    when: StoreInMap(subject, key, written)
    requires: not is_any_word(key)
    ensures: stored_key_of(subject, key) = key
}

-- KEYS-OF answers plain words, turning the stored set-words back.
--
-- `if (ANY_WORD(val)) VAL_SET(out - 1, REB_WORD);` in `Map_To_Block`, and only
-- for the words-of question: the flag it takes is -1 for the keys, +1 for the
-- values and 0 for the pairs, and only -1 normalises.
rule KeysOfAMapAnswersPlainWords {
    when: EvaluateCall(keys_of, subject)
    requires: is_map(subject)
    ensures: CallResult(value: every_key_of(subject) as plain words)
}

-- The body of a map is its pairs, keys as stored.
--
-- BODY-OF and `to block!` ask the same question and get the same answer, which
-- is the pairs with the set-words in them. A molded map is that block inside
-- `#[...]`, which is why what a map molds to reads back as an equal map.
rule TheBodyOfAMapIsItsPairs {
    when: EvaluateCall(body_of, subject)
    requires: is_map(subject)
    ensures: CallResult(value: pairs_of(subject))
}

-- Walking a map with one word walks the keys, as plain words.
--
-- The key is read from an even slot -- `*vars = *BLK_SKIP(series, index & ~1)`
-- -- and normalised on the way out:
-- `if (IS_SET_WORD(vars)) SET_TYPE(vars, REB_WORD);`. So the walk hands out
-- what KEYS-OF would, and a caller can compare what it gets against a word it
-- wrote.
rule WalkingAMapWithOneWordWalksTheKeys {
    when: WalkOver(subject, names, body)
    requires: is_map(subject)
    requires: count_of(names) = 1
    ensures: EachRound(sets: names.first, to: next_key_of(subject) as a plain word)
}

-- Two words walk the keys and the values together, one pair a round.
rule WalkingAMapWithTwoWordsWalksThePairs {
    when: WalkOver(subject, names, body)
    requires: is_map(subject)
    requires: count_of(names) = 2
    ensures: EachRound(sets: names, to: next_pair_of(subject))
}

-- Three is refused, because a pair has two halves and there is nothing for a
-- third name to be set to: `else Trap_Arg(words);`.
rule WalkingAMapWithThreeWordsIsRefused {
    when: WalkOver(subject, names, body)
    requires: is_map(subject)
    requires: count_of(names) > 2
    ensures: WalkFails(error: invalid_arg, about: names)
}

-- A removed key is not walked, and a key holding none is.
--
-- REMOVE/KEY hides the key and sets the value to none rather than closing the
-- gap: `VAL_SET_OPT(..., OPTS_HIDE); VAL_SET(..., REB_NONE);`. The walk steps
-- over a hidden key by two -- `index += 2; goto skip_hidden;` -- so a removed
-- pair is invisible to it while an ordinary pair holding none is not. Writing
-- none against a key is an ordinary write and takes nothing away.
rule ARemovedKeyIsNotWalked {
    when: WalkOver(subject, names, body)
    requires: is_map(subject)
    ensures: EachRound(skips: every_removed_key_of(subject))
}

-- REMOVE-EACH takes a map, and counts what it took in pairs.
--
-- `SET_INTEGER(DS_RETURN, IS_MAP(value) ? index / 2 : index);` -- the halving
-- is the same reason /PART halves: a caller counting values would be told
-- twice what it removed.
rule RemovingEachPairCountsPairs {
    when: EvaluateCall(remove_each, subject, names, body)
    requires: is_map(subject)
    requires: refinement_asked(count)
    ensures: CallResult(value: how_many_pairs_were_removed)
}

-- MAP-EACH will not take a map at all, where FOREACH and REMOVE-EACH will.
--
-- Not a choice made in the walk but in the spec above it: MAP-EACH declares
-- `data [block! vector!]` while FOREACH declares `data [series! any-object!
-- map! none!]`. So the refusal is the ordinary one for an argument of the
-- wrong type, and it happens before the walk is reached.
rule MappingEachOverAMapIsRefused {
    when: EvaluateCall(map_each, subject, names, body)
    requires: is_map(subject)
    ensures: CallFails(error: expect_arg, about: subject)
}

-- MAP-EACH takes a block of words, as every other walk does.
--
-- One `Loop_Each` serves FOREACH, MAP-EACH, REMOVE-EACH and REMOVE-EACH/COUNT,
-- and the names come from `Init_Loop(D_ARG(1), ...)` before the mode is looked
-- at. So a block of names means to MAP-EACH what it means to FOREACH, and the
-- answer holds one value a round rather than one value a name.
rule MappingEachTakesABlockOfWords {
    when: EvaluateCall(map_each, subject, names, body)
    requires: is_block(names)
    ensures: CallResult(value: one_value_for_each_round)
}

-- A last round with nothing left to take still runs, and the names that have
-- nothing hold none.
--
-- `else SET_NONE(vars);` where the walk has passed the tail. So walking a
-- three-item block two names at a time runs twice and not once, and the second
-- round's second name is none. Dropping the round would be the convenient
-- reading and it is not what the C does.
--
-- A map is exempt without being special-cased: its series always holds whole
-- pairs, so there is never a half round to fill.
rule ALastRoundWithNothingLeftStillRuns {
    when: WalkOver(subject, names, body)
    requires: count_of(names) > 1
    requires: not divides_evenly(count_of(names), length_of(subject))
    ensures: EachRound(sets: the_names_with_nothing_left, to: none)
}

-- MAKE MAP! given a number makes room rather than pairs.
--
-- `else if (IS_NUMBER(arg)) { if (action == A_TO) Trap_Arg(arg); n =
-- Int32s(arg, 0); }` and then `series = Make_Map(n)`. So the answer is an empty
-- map that has somewhere to put n pairs, and a decimal reads the same way a
-- whole number does. Rebol's own MIME type table opens with `make map! 111`.
rule MakingAMapWithARoomCountAnswersAnEmptyMap {
    when: EvaluateCall(make, map_datatype, room)
    requires: is_number(room)
    ensures: CallResult(value: an_empty_map)
}

-- A negative count is refused, because there is no such amount of room.
-- `Int32s(arg, 0)` is the signed read with a floor of zero, and it raises
-- rather than clamping.
rule MakingAMapWithLessThanNoRoomIsRefused {
    when: EvaluateCall(make, map_datatype, room)
    requires: is_number(room)
    requires: room < 0
    ensures: CallFails(error: out_of_range, about: room)
}

-- And TO MAP! refuses a number on the same line that MAKE reads it:
-- `if (action == A_TO) Trap_Arg(arg);`. A conversion answers something made of
-- what it was given, and there are no pairs in a number.
rule ConvertingANumberToAMapIsRefused {
    when: EvaluateCall(to, map_datatype, room)
    requires: is_number(room)
    ensures: CallFails(error: invalid_arg, about: room)
}

-- === NOW, and the ten questions it answers ==========

-- NOW answers the local date and time, with the host's offset attached.
--
-- @guidance The clock is a host service. A script not granted it cannot ask.
rule NowAnswersTheLocalDateAndTime {
    when: EvaluateCall(now)
    ensures: CallResult(value: the_local_date_and_time_with_its_zone)
}

-- The seconds are whole unless /PRECISE is asked for.
--
-- `if (!D_REF(9)) dat.nano = 0; // Not /precise`. So the fraction is dropped
-- rather than rounded, and a caller timing something has to say so.
rule TheSecondsAreWholeWithoutPrecise {
    when: EvaluateCall(now)
    requires: not refinement_asked(precise)
    ensures: CallResult(value: a_time_whose_fraction_is_zero)
}

-- /UTC answers the same instant with no offset, rather than relabelling the
-- local time. `if (D_REF(10)) VAL_ZONE(ret) = 0;`
rule UtcAnswersTheSameInstantWithNoOffset {
    when: EvaluateCall(now)
    requires: refinement_asked(utc)
    ensures: CallResult(value: the_same_instant_at_zone_zero)
}

-- /DATE answers a date with no time and no zone.
--
-- `VAL_TIME(ret) = NO_TIME; VAL_ZONE(ret) = 0;` -- a bare date names a day
-- rather than an instant, so there is nothing for an offset to offset.
rule DateAnswersADayWithNoTime {
    when: EvaluateCall(now)
    requires: refinement_asked(date)
    ensures: CallResult(value: a_date_with_no_time)
}

-- /TIME and /ZONE answer times: the local time of day, and the offset itself.
rule TimeAndZoneAnswerTimes {
    when: EvaluateCall(now)
    requires: refinement_asked(time) or refinement_asked(zone)
    ensures: CallResult(value: a_time)
}

-- /YEAR, /MONTH, /DAY, /WEEKDAY and /YEARDAY answer integers, read from the
-- local date rather than from the underlying instant.
--
-- `if (D_REF(1) || D_REF(2) || D_REF(3) || D_REF(4) || D_REF(6) || D_REF(7) ||
-- D_REF(8)) Adjust_Date_Zone(ret, FALSE);` -- so within an offset of midnight
-- the day these answer is the local day and not the UTC one.
rule ThePartsOfTheDateAnswerIntegers {
    when: EvaluateCall(now)
    requires: refinement_asked(year) or refinement_asked(month)
        or refinement_asked(day) or refinement_asked(weekday)
        or refinement_asked(yearday)
    ensures: CallResult(value: an_integer_read_from_the_local_date)
}

-- Monday is day one, which is not what every calendar says.
rule TheWeekBeginsOnMonday {
    when: EvaluateCall(now)
    requires: refinement_asked(weekday)
    requires: the_local_day_is_monday
    ensures: CallResult(value: 1)
}

-- Two questions at once are refused, unless one of them is /PRECISE.
--
-- `Assert_Max_Refines(ds, D_REF(9) ? 2 : 1); // prevent too many refines like:
-- now/year/month`. The parts are alternatives rather than a set to pick from,
-- and /PRECISE is the one refinement that says how to read the clock rather
-- than which part to answer.
rule OnlyOneQuestionAtATime {
    when: EvaluateCall(now)
    requires: count_of(refinements_asked) > how_many_are_allowed
    ensures: CallFails(error: bad_refines, about: now)
}

-- === A character's two measurements ==========

-- A char answers two fields through a path, and they are different numbers
-- for the same character. `width` is how many columns it takes on a display
-- and `size` is how many bytes it takes in UTF-8.
--
-- Both are needed and neither substitutes for the other. Laying out a table
-- wants the width; sizing a buffer wants the size; and for most characters
-- they happen to agree, which is what makes using the wrong one work until
-- it does not.
--
-- The width comes from the Unicode tables rather than from the encoding. A
-- control character or a combining mark is zero, because it advances the
-- cursor by nothing. An East Asian wide character is two. Everything else is
-- one. So the high-voltage sign is two columns wide and three bytes long,
-- which Rebol's own char-test.r3 asserts as `2 = s/2/width`.
rule ACharAnswersItsWidthAndItsSize {
    when: ReadThroughPath(subject, field)
    requires: is_char(subject)
    requires: field in {width, size}

    ensures: PathResult(value:
        if field = width: the_display_columns_of(subject)
        else: the_utf8_byte_count_of(subject))
}

-- Both are read-only. A write through such a path is refused before the
-- field name is even looked at, so `c/width: 3` fails whatever c is.
--
-- Which is the only sane answer. Neither number is stored: each is worked
-- out from the character, so writing one would be asking for a different
-- character without saying which.
rule WritingThroughACharsPathIsRefused {
    when: WriteThroughPath(subject, field, written)
    requires: is_char(subject)

    ensures: SetPathFailed(failure: bad_path_set)
}

-- Any other field is a bad selection, and so is a selector that is not a
-- word at all. Two fields is the whole of what a char has.
rule AnyOtherFieldOfACharIsABadSelection {
    when: ReadThroughPath(subject, field)
    requires: is_char(subject)
    requires: not (is_word(field) and field in {width, size})

    ensures: PathFails(failure: bad_path)
}

-- === Reading a date's parts ==========

-- A date answers fourteen named parts, and a number names one of them.
--
-- `sym = SYM_YEAR + Int32(arg) - 1` with the range checked against
-- `SYM_YEAR .. SYM_JULIAN`, so the number is a position in the C's own word
-- list: 1 year, 2 month, 3 day, 4 time, 5 date, 6 zone, 7 hour, 8 minute,
-- 9 second, 10 weekday, 11 yearday, 12 timezone, 13 utc, 14 julian.
rule ADateAnswersItsPartsByNameOrByNumber {
    when: ReadThroughPath(subject, part)
    requires: is_date(subject)
    requires: is_word(part) or is_integer(part)
    ensures: PathResult(value: the_named_part_of(subject))
}

-- A part it has not got answers none rather than failing.
--
-- `return (val) ? PE_BAD_SELECT : PE_NONE;` -- so a read answers none and only
-- a write refuses. Asking a date for a part it might not have is an ordinary
-- question; writing one it cannot hold is a mistake.
rule APartADateHasNotGotAnswersNone {
    when: ReadThroughPath(subject, part)
    requires: is_date(subject)
    requires: not is_a_known_part(part)
    ensures: PathResult(value: none)
}

-- A date with no time has no time, no hour, no minute, no second and no zone.
--
-- `if (secs == NO_TIME && (sym == SYM_TIME || (sym >= SYM_HOUR && sym <=
-- SYM_SECOND) || sym == SYM_ZONE)) return PE_NONE;`. A day names no instant, so
-- there is nothing to read the clock parts off. YEAR, MONTH, DAY, WEEKDAY,
-- YEARDAY and JULIAN all still answer.
rule ADayWithNoTimeHasNoClockParts {
    when: ReadThroughPath(subject, part)
    requires: is_date(subject)
    requires: not has_time(subject)
    requires: part in {time, hour, minute, second, zone}
    ensures: PathResult(value: none)
}

-- SECOND answers a whole number, or a decimal where there is a fraction.
--
-- `if (time.n == 0) num = time.s; else { SET_DECIMAL(val, (REBDEC)time.s +
-- (time.n * NANO)); ... }`. So the datatype of the answer depends on the value,
-- which is worth knowing before comparing it against a whole number.
rule TheSecondIsWholeUnlessThereIsAFraction {
    when: ReadThroughPath(subject, second)
    requires: is_date(subject)
    requires: has_a_fraction_of_a_second(subject)
    ensures: PathResult(value: a_decimal)
}

-- TIME, ZONE and TIMEZONE answer times; DATE answers a day; UTC answers the
-- same instant at zone zero.
--
-- DATE drops both the time and the zone -- `VAL_TIME(val) = NO_TIME;
-- VAL_ZONE(val) = 0;` -- so `d/date/time` is none however much time d carried.
rule TheWholeDayAndTheWholeTimeAreParts {
    when: ReadThroughPath(subject, part)
    requires: is_date(subject)
    requires: part in {time, zone, timezone, date, utc}
    ensures: PathResult(value: a_time_or_a_date_as_the_part_names)
}

-- JULIAN answers a decimal, and counts from noon.
--
-- `if (secs == NO_TIME) { time.h = 12; // Julian date is counted from noon }`,
-- and where there is a time it is converted to universal time first. So the
-- answer for a bare day ends in .0 and is not the count a caller reading a
-- calendar would arrive at from midnight.
rule TheJulianDayCountsFromNoon {
    when: ReadThroughPath(subject, julian)
    requires: is_date(subject)
    ensures: PathResult(value: a_decimal_counted_from_noon)
}

-- === Reaching into a block through a path ==========

-- A number selects a position, counting from where the block is.
--
-- `if (i == 0) return PE_NONE; // like in case: path/0` and then
-- `if (i < 0) i++; n = i + VAL_INDEX(pvs->value) - 1;`. So there is no
-- position zero, and a negative one counts back and can reach behind the
-- position the block is at. A decimal is truncated rather than refused.
rule ANumberSelectsAPositionInABlock {
    when: ReadThroughPath(subject, position)
    requires: is_block(subject)
    requires: is_number(position)
    ensures: PathResult(value: the_item_that_many_along(subject, position))
}

-- A word selects the item after the word, which is what makes a block a
-- lookup table.
--
-- `n = Find_Word(VAL_SERIES(...), VAL_INDEX(...), VAL_WORD_CANON(...)); if (n
-- != NOT_FOUND) n++;` -- so `[a 1 b 2]/a` is 1 and not the word. Find_Word
-- takes "word (of any type)", so a set-word or a lit-word in the block matches
-- a plain word in the path: what is compared is the spelling.
--
-- Rebol's own code reads settings out of blocks this way constantly, and a path
-- that refused it stopped `prot-mysql.reb` and the URL parser.
rule AWordSelectsTheItemAfterIt {
    when: ReadThroughPath(subject, name)
    requires: is_block(subject)
    requires: is_word(name)
    ensures: PathResult(value: the_item_after_the_first_word_spelled(subject, name))
}

-- And any other value is looked for by value, again answering the item after
-- it: `Find_Block_Simple(...) + 1`.
rule AnyOtherValueSelectsTheItemAfterIt {
    when: ReadThroughPath(subject, wanted)
    requires: is_block(subject)
    requires: not (is_word(wanted) or is_number(wanted))
    ensures: PathResult(value: the_item_after_the_first_equal_to(subject, wanted))
}

-- Anything a read cannot find answers none.
--
-- A position past the tail, a name the block has not got, and a name sitting at
-- the tail with nothing after it are one case in the C and answer the same way:
-- `if (n < 0 || (REBCNT)n >= VAL_TAIL(pvs->value)) { ... return PE_NONE; }`.
rule APathIntoABlockThatFindsNothingAnswersNone {
    when: ReadThroughPath(subject, selector)
    requires: is_block(subject)
    requires: not is_found_in(subject, selector)
    ensures: PathResult(value: none)
}

-- A write replaces what the read would have answered.
rule WritingThroughAPathIntoABlockReplacesTheItem {
    when: WriteThroughPath(subject, selector, written)
    requires: is_block(subject)
    requires: is_found_in(subject, selector)
    ensures: ReadThroughPath(subject, selector) = written
}

-- And a selector that finds nothing refuses the write rather than adding.
--
-- The same line that answers none for a read: `if (pvs->setval) return
-- PE_BAD_SELECT;`, which is `invalid-path`. The C keeps the question open beside
-- the function -- "a/not-found: 10 error or append?" -- and answers it this way.
rule WritingThroughASelectorThatFindsNothingIsRefused {
    when: WriteThroughPath(subject, selector, written)
    requires: is_block(subject)
    requires: not is_found_in(subject, selector)
    ensures: PathFails(error: invalid_path, about: selector)
}

-- A protected block refuses the write: `if (pvs->setval)
-- TRAP_PROTECT(VAL_SERIES(pvs->value));`.
rule WritingThroughAPathIntoAProtectedBlockIsRefused {
    when: WriteThroughPath(subject, selector, written)
    requires: is_block(subject)
    requires: is_protected(subject)
    ensures: PathFails(error: protected, about: subject)
}

-- Except through position zero, which quietly does nothing.
--
-- `if (i == 0) return PE_NONE;` is tested before the write check, so this one
-- selector is not refused the way a missing name is. Nothing downstream looks
-- at whether the write happened, so the only evidence is that the block is as
-- it was.
--
-- @guidance Raising here instead would be our invention, and it would break the
-- one caller that relies on `path/0` being a way to write nothing.
rule WritingThroughPositionZeroDoesNothing {
    when: WriteThroughPath(subject, position, written)
    requires: is_block(subject)
    requires: position = 0
    ensures:
        PathResult(value: none)
        subject unchanged
}

-- === What DO does with each kind of value ==========

-- DO of a word or a get-word runs what the word holds.
--
-- `*D_RET = *Get_Var(value); if (ANY_FUNC(D_RET)) VAL_SET_OPT(D_RET,
-- OPTS_REVAL);` -- so a word holding a function is called rather than answered,
-- and it takes its arguments from what follows the DO. That is how a script runs
-- a name it was handed.
rule DoingAWordRunsWhatItHolds {
    when: EvaluateCall(do, subject)
    requires: is_word(subject) or is_get_word(subject)
    ensures: CallResult(value: what_the_word_holds_or_the_call_it_makes)
}

-- A path is the same question one segment deeper, and a path into an object it
-- has not got refuses: `Do_Path(&value, 0)` raises invalid-path itself.
rule DoingAPathRunsWhatItReads {
    when: EvaluateCall(do, subject)
    requires: is_path(subject)
    ensures: CallResult(value: what_the_path_reads_or_the_call_it_makes)
}

-- A lit-word answers the plain word, and a lit-path the plain path.
--
-- `*D_RET = *value; SET_TYPE(D_RET, REB_WORD);`. One step of evaluation is what
-- a quote holds back, so DO spends it and stops.
rule DoingAQuotedWordAnswersThePlainWord {
    when: EvaluateCall(do, subject)
    requires: is_lit_word(subject) or is_lit_path(subject)
    ensures: CallResult(value: the_same_name_without_its_quote)
}

-- A set-word or a set-path is refused rather than answered.
--
-- `case REB_SET_WORD: case REB_SET_PATH: Trap_Arg(value);` -- there is nothing
-- after it to assign, so the caller has handed over half an expression.
rule DoingASetWordIsRefused {
    when: EvaluateCall(do, subject)
    requires: is_set_word(subject) or is_set_path(subject)
    ensures: CallFails(error: invalid_arg, about: subject)
}

-- And a block evaluates without any of that. A block that answers a function
-- answers it: OPTS_REVAL is set on the word, path and function arms and on no
-- other, so `do [f]` and `do 'f` are different questions.
rule DoingABlockAnswersWhatItEvaluatesTo {
    when: EvaluateCall(do, subject)
    requires: is_block(subject)
    ensures: CallResult(value: what_the_block_evaluates_to)
}

-- DO/NEXT steps a string exactly as it steps a block, and answers a plain
-- value with the word set to none for anything that is neither.
--
-- The refinement's contract is "take one expression and move this word on to
-- what is left", and a string can honour it: it is loaded and bound the way
-- DO loads it, and then stepped. That is what the C does, routing a string
-- through sys/do*, which loads and then runs `do/next body mark`. So
-- `do/next "1 + 1 5" 'rest` answers 2 and leaves rest holding what is left,
-- exactly as the block form does.
--
-- Anything that is neither a block nor a loadable string answers itself and
-- sets the word to NONE -- `Set_Var(D_ARG(5), NONE_VALUE)`. The none is the
-- signal that stepping is over, and it is what lets a caller loop on the word
-- rather than test the value: a word that came back none says there is
-- nothing further to step, where an empty series would say "step me again".
rule DoNextStepsAStringAndAnswersNoneForAnythingUnsteppable {
    when: EvaluateCall(do, subject, stepping_word)
    requires: refinement_asked(next)

    ensures:
        if is_block(subject) or is_string(subject):
            CallResult(value: what_the_first_expression_answers(subject))
            the_word_holds(stepping_word) = what_is_left_after_that_expression(subject)
        else:
            CallResult(value: subject)
            the_word_holds(stepping_word) = none_value()
}

-- A top-level RETURN inside a DO'd string unwinds to the DO, and DO answers
-- the returned value.
--
-- The reason is structural rather than special-cased. The C runs a string
-- through sys/do*, which is an ordinary REBOL function, so a RETURN written
-- at the top level of the source lands on that function's own frame and its
-- value comes back out as DO's answer. `do "return 5"` is 5.
--
-- Letting the RETURN escape instead is the failure this replaces, and it is
-- the worse kind: the signal unwinds past whatever called DO, so a script
-- that evaluated a fragment of source found its own function returning the
-- fragment's value.
rule ATopLevelReturnInADoneStringIsCaughtByTheDo {
    when: EvaluateCall(do, subject)
    requires: is_string(subject)
    requires: a_top_level_return_runs_in(subject)

    ensures: CallResult(value: what_the_return_was_given)
}

-- DO of a binary runs it as the script it is, header and all.
--
-- The bytes go through the same load-header the loader uses, and three things
-- follow from that rather than from anything DO does itself:
--
--   the header's `length:` bounds the body, so trailing bytes after the
--   declared length are not evaluated;
--   an unmet `needs:` refuses the script with the syntax failure `needs`,
--   rather than running it and failing somewhere inside;
--   a header that cannot be read at all refuses with invalid-arg naming why.
--
-- A top-level RETURN is caught here as it is for a string, for the same
-- reason: the body runs inside sys/do*.
--
-- Why a binary rather than a string: a script arrives from a file or a socket
-- as bytes, and its header is what says how to read the rest of them. Decoding
-- first and then looking for a header inverts that -- the encoding declaration
-- is inside the thing being decoded.
rule DoingABinaryRunsItAsAScript {
    when: EvaluateCall(do, subject)
    requires: is_binary(subject)

    ensures:
        the_header_is_read_by(load_header)
        the_body_evaluated = bounded_by_the_headers_length(subject)
        CallResult(value: what_the_body_answers_or_what_a_top_level_return_gave)
}

rule ABinaryScriptWhoseNeedsAreNotMetIsRefused {
    when: EvaluateCall(do, subject)
    requires: is_binary(subject)
    requires: the_headers_needs_version_is_above(the_interpreters_own_version)

    ensures: CallFails(error: needs, about: subject)
}

-- TO WORD! of a datatype is the word that names it, exclamation mark and all.
--
-- Which makes a datatype comparable against a name a script wrote down, and it
-- is the pair of `to datatype! 'logic!` going the other way.
rule ADatatypeConvertsToTheWordThatNamesIt {
    when: EvaluateCall(to, word_datatype, subject)
    requires: is_datatype(subject)
    ensures: CallResult(value: the_spelling_of(subject))
}

-- === A raw string, and what it does not read ==========

-- A raw string is written between a run of percent signs and a brace, and holds
-- exactly what is between them.
--
-- `Scan_Raw_String`, whose summary says why it exists: "Scan a raw string
-- (without any modifications). Eliminates need of double escaping and allowes
-- unmatched braces." So a caret is a caret, a lone brace is a brace, and a line
-- ending is whatever the source had -- where a braced string reads every one of
-- those as an instruction.
rule ARawStringHoldsWhatIsWrittenInIt {
    when: ReadSource(text)
    requires: opens_with_percents_then_brace(text)
    ensures: ReadResult(value: the_characters_up_to_the_matching_close)
}

-- The length of the run is what closes it.
--
-- Which is what lets a raw string hold the closing sequence of a shorter one:
-- `%%{ %{^}% }%%` is one string holding another. A caller needing to write the
-- terminator writes a longer run rather than escaping anything.
rule TheRunOfPercentsIsWhatCloses {
    when: ReadSource(text)
    requires: opens_with_percents_then_brace(text)
    ensures: ReadResult(ends_at: a_brace_followed_by_the_same_many_percents)
}

-- A closing brace followed by a longer run is refused.
--
-- `if (n > num) return 0;` -- and the caller reads that as an invalid token
-- rather than carrying on to the end of the source looking for a terminator
-- that has already gone past.
rule ALongerRunThanOpenedIsRefused {
    when: ReadSource(text)
    requires: opens_with_percents_then_brace(text)
    requires: a_closing_brace_has_more_percents_than_opened(text)
    ensures: ReadFails(error: invalid)
}

-- === What /part and /dup accept ==========

-- These two refinements belong to no single native. APPEND, INSERT, CHANGE,
-- FIND, SELECT, TAKE and REMOVE all take /part, and each reaches one place to
-- read it, so what it accepts is one answer rather than seven. Writing the
-- rule once is what keeps the seven from drifting apart.
--
-- One subtlety across them: the series a position is measured against is the
-- one the count reads from, and that is not always the first argument. For a
-- read or a removal it is the source; for INSERT and CHANGE it is the value
-- being put in, not the target. The rules below say "the reference series"
-- for that reason.

-- A /part range is either a count or a position, and a position means a
-- position into the reference series.
--
-- As a count it is a whole number, and a decimal is truncated rather than
-- refused, so `append/part a b 1.9` takes one item. As a position it is
-- somewhere in the reference series, and the length is the difference between
-- the two indexes -- which is what lets a caller say "up to here" with a
-- position it already has, rather than working out how far away it is.
--
-- REMOVE reads this way too, and its reference is the series being removed
-- from: `remove/part r next r` removes one item, because next r is one
-- position along, and `remove/part r r` removes none, because the two
-- positions are the same. A position into some other series names no length
-- and is refused, by the rule below. This was a fresh mistake rather than an
-- old one: REMOVE used to hand no reference series in, so a same-series
-- position looked foreign and raised where it should have removed.
rule ThePartRangeIsAWholeNumberOrAPositionInTheSameSeries {
    when: EvaluateCall(verb, subject, argument)
    requires: refinement_asked(part)
    requires: is_number(part_range)
        or names_a_position_in(part_range, the_reference_series(verb, subject, argument))

    ensures: the_length_taken(verb) =
        if is_number(part_range): truncated(part_range)
        else: index_of(part_range)
            - index_of(the_reference_series(verb, subject, argument))
}

-- Anything else raises invalid-part, and the surprise is in the list.
--
-- A percent is not a decimal here. It is a number everywhere else in the
-- language, and `append/part a b 50%` is refused, because the code that
-- reads the range tests for a decimal and an integer by name rather than
-- asking whether the value is a number. A pair is refused for the same
-- reason.
--
-- And a position into a different series is refused rather than being taken
-- as its index. Two series have no common frame of reference, so subtracting
-- one index from the other would give a number that means nothing, and
-- silently taking the wrong count is worse than refusing.
rule AnyOtherPartRangeRaisesInvalidPart {
    when: EvaluateCall(verb, subject, argument)
    requires: refinement_asked(part)
    requires: not is_number(part_range)
    requires: not names_a_position_in(part_range, the_reference_series(verb, subject, argument))

    ensures: CallFails(error: invalid_part, about: part_range)
}

-- INSERT and CHANGE measure the count from the value being put in, and count
-- either way. A positive count takes that many forward from the value's own
-- position, and a negative count takes that many backward from it.
--
-- So `insert/part a [5 6 7 8 9] 2` splices [5 6] -- two forward from the head
-- of the value -- and `insert/part a tail [5 6 7 8 9] -2` splices [8 9] --
-- two backward from the value standing at its tail. The count is always the
-- size of the run, whichever direction it reaches; only the value's position
-- and the sign decide which run.
--
-- The reference being the value rather than the target is the part to hold
-- on to. A caller who reads /part as "how much of the target to affect"
-- would look at the wrong series, and the target is where the run lands, not
-- where the count is measured.
rule InsertPartSplicesTheCountedRunOfTheValueEitherWay {
    when: EvaluateCall(verb, target, value)
    requires: verb in {insert, change}
    requires: refinement_asked(part)

    ensures: the_run_spliced(verb) =
        if part_count >= 0:
            the_run_forward_from(value, part_count)
        else:
            the_run_backward_from(value, part_count)
}

-- A /part count outside the signed 32-bit range is refused as out-of-range,
-- not silently clamped. So `insert/part a b 2147483648` raises rather than
-- taking as much as it can.
--
-- Every /part action shares this, because they all read the count through
-- one function that rejects a number too big for 32 bits before doing
-- anything with it. Clamping instead would let a caller who computed a wrong
-- count get a plausible-looking result from a number that was already a
-- mistake, which is the silent kind of wrong a range check exists to stop.
rule APartCountOutsideThirtyTwoBitsIsRefused {
    when: EvaluateCall(verb, subject, argument)
    requires: refinement_asked(part)
    requires: is_integer(part_count)
    requires: part_count > largest_signed_32_bit or part_count < smallest_signed_32_bit

    ensures: CallFails(error: out_of_range, about: part_count)
}

-- A /dup count is an integer, or a decimal truncated to one. A percent or a
-- pair raises invalid-type, which is a different refusal from /part's and
-- worth knowing: the same wrong value gets a different complaint depending
-- on which refinement it was given to.
rule TheDupCountIsAWholeNumber {
    when: EvaluateCall(verb, subject, argument)
    requires: refinement_asked(dup)
    requires: not is_integer(duplicate_count)
    requires: not is_decimal(duplicate_count)

    ensures: CallFails(error: invalid_type, about: duplicate_count)
}

-- A count of zero or fewer repeats nothing, which is what makes the
-- refinement usable with a number that was worked out rather than written.
rule ADupCountOfZeroOrFewerRepeatsNothing {
    when: EvaluateCall(verb, subject, argument)
    requires: refinement_asked(dup)
    requires: duplicate_count <= 0

    ensures: nothing_is_repeated(verb, subject)
}

-- === Changing a value's type without copying it ==========

-- AS answers the same series under a different type, and the type may be
-- named either way: as a datatype, or as an example value standing for its
-- own type. `as file! {text}` and `as %x {text}` are one call written twice,
-- and both are %text.
--
-- The example form is a convenience with a sharp edge. `as %x s` reads as
-- though %x had something to do with the answer, and it does not: only its
-- datatype is looked at and its own contents are discarded.
rule AsTakesADatatypeOrAnExampleOfOne {
    when: EvaluateCall(as, type, subject)
    requires: is_datatype(type) or is_a_value(type)

    ensures: CallResult(value: subject_seen_as(
        if is_datatype(type): the_datatype_named_by(type)
        else: the_datatype_of(type)))
}

-- The answer shares the storage of what it was given. It is one series seen
-- two ways, not a copy, so a change through either name is visible through
-- the other: after `s: {ab}` and `f: as file! s`, appending "c" to s makes f
-- %abc.
--
-- Sharing rather than copying is the whole point, and it is what separates
-- AS from TO. TO answers a new value and leaves the original to go its own
-- way; AS re-labels the one that is there. A caller who wanted a snapshot
-- has to copy, and a caller who wanted the two to track each other cannot
-- get that from TO at all.
--
-- The trap is that the two names have equal standing. Neither is the
-- original and neither owns the storage, so code holding the file has no
-- way to tell that a string somewhere else can change it.
rule AsSharesTheStorageOfWhatItWasGiven {
    when: EvaluateCall(as, type, subject)

    ensures: shares_storage_with(the_answer, subject)
}

-- Only within a class. A string family value may be seen as another string
-- family value and a block family value as another of those, and crossing
-- between them raises not-same-class.
--
-- Which follows from the sharing. The two names read the same storage, and a
-- block's storage holds values where a string's holds characters, so there
-- is no way to see one as the other without a conversion -- and a conversion
-- is what AS exists not to do.
rule AsRefusesToCrossAClassBoundary {
    when: EvaluateCall(as, type, subject)
    requires: not the_same_class(the_datatype_wanted(type), subject)

    ensures: CallFails(error: not_same_class, about: subject)
}

-- === Building an object, and filling one from another ==========

-- SET with a path for a target writes through the path into an object's
-- field, rather than reading the path's segments as a list of words.
--
-- The order matters and is easy to get wrong. SET's other shapes take a block
-- of words or an object and spread values across them, and a path IS a block
-- underneath, so a reading that checks for a block first turns `set 'a/b 1`
-- into "assign to the words a and b" -- two writes to the wrong places, and
-- no error to say so. The C tests the path shape first: `if (ANY_PATH(word))
-- { Do_Path(&word, val); return R_ARG2; }`.
--
-- A field the object has not got refuses with invalid-path. SET does not
-- create fields; an object's word list is fixed once it is built, and a write
-- to a name it never had is a mistake in the caller rather than a request to
-- extend it.
rule SetThroughAPathWritesTheFieldThePathNames {
    when: EvaluateCall(set, target, written)
    requires: is_any_path(target)

    ensures:
        if the_path_names_a_field_of_an_object(target):
            the_field_holds(target) = written
            CallResult(value: written)
        else:
            CallFails(error: invalid_path, about: last_segment_of(target))
}

-- SET from one object to another copies BY NAME, and every value it copies
-- is cloned and rebound to the target.
--
-- Two rules in one, and both are about not sharing.
--
-- By name rather than by position is the first: each word of the TARGET takes
-- the value the source holds under that same word, and a word the source has
-- not got is left alone. Position plays no part, which is what makes this the
-- one shape of SET that does not spread a list. Two objects with the same
-- fields in different orders copy correctly.
--
-- Cloned and rebound is the second. `Copy_Deep_Values(obj, 1, tail,
-- TS_CLONE)` then `Rebind_Block`: the target shares no series with the source,
-- and a method that came across reads the TARGET's fields rather than the
-- source's. Without the rebind a copied method still closes over the object it
-- was written in, so calling it on the copy reads -- and writes -- the
-- original. That is the defect this exists to prevent, and it is invisible
-- until the copy is mutated.
--
-- Only words bound to the SOURCE frame are rebound. A word bound anywhere
-- else -- the library, an enclosing function -- keeps the binding its author
-- gave it. Rebinding by name instead captures globals whose spelling the
-- object happens to share, so a cloned method reads the object's field where
-- its author wrote the library's function.
rule SettingAnObjectFromAnObjectCopiesByNameAndClones {
    when: EvaluateCall(set, target, source)
    requires: is_object(target) and is_object(source)
    requires: not refinement_asked(only)

    ensures:
        for field in the_own_fields_of(target):
            if holds_field(source, field):
                the_field_holds(target, field) =
                    cloned_and_rebound(
                        the_field_of(source, field),
                        from: the_frame_of(source),
                        into: the_frame_of(target))
}

-- MAKE of an object from a prototype, and a merge of two objects, clone the
-- same way and rebind by the same rule.
--
-- One rule for three callers -- MAKE from a prototype, a merge of a prototype
-- with another object, and SET object-to-object above -- because it is one
-- operation in the C and three places that disagreed about it would be three
-- places to get it wrong. Every value taken from a source object is copied
-- deeply, so the result shares no series with what it was made from; every
-- word inside those values that was bound to a SOURCE frame is rebound to the
-- new one, and every other word is left exactly as written.
--
-- SELF is set before any method is rehomed. A method saying `self` has to
-- reach the copy, and setting SELF afterwards leaves it bound to the
-- prototype -- which made Rebol's own ENUM read the shape it was made from
-- rather than the one it made.
--
-- For a merge, both objects' fields are in place before any method is
-- rehomed, because a method the second object brought may need a field the
-- prototype has never heard of.
rule MakingAnObjectFromAPrototypeClonesAndRebinds {
    when: EvaluateCall(make, prototype, body)
    requires: is_object(prototype)

    ensures:
        for field in the_own_fields_of(prototype):
            the_field_holds(the_new_object, field) =
                cloned_and_rebound(
                    the_field_of(prototype, field),
                    from: the_frame_of(prototype),
                    into: the_frame_of(the_new_object))
        the_new_object_shares_no_series_with(prototype)
        words_bound_outside(the_frame_of(prototype)) = left_as_written
}

-- CONSTRUCT floors an unset to none, and a set-word with nothing after it
-- holds none as well.
--
-- CONSTRUCT evaluates nothing, so it is tempting to say it stores what it
-- finds. It does not: an object's slots begin as none -- `SET_NONE` on every
-- one in Create_Frame -- and a field can never hold unset by construction. So
-- a value below none floors to none on the way in, and a trailing set-word
-- with no value after it holds none rather than nothing at all.
--
-- Which matters because "holds none" and "holds nothing" are different to
-- every caller: a field holding none reads, molds and compares; a field
-- holding unset raises on the first read. A header field a person left blank
-- should read as absent, not blow up whoever reads it.
--
-- /ONLY does NOT change this. /ONLY switches off the reading of the seven
-- named constants -- none, true, on, yes, false, off, no -- so a block that
-- arrived from somewhere untrusted keeps its words as words. It is a rule
-- about words, not about the floor, and a trailing set-word under /ONLY is
-- defined with no value rather than being given none.
rule ConstructFloorsAnUnsetToNoneAndFillsTrailingSetWords {
    when: EvaluateCall(construct, body)

    ensures:
        for field in the_fields_declared_in(body):
            the_field_holds(field) =
                if a_value_followed(field) and value_after(field).datatype != unset:
                    if refinement_asked(only): value_after(field)
                    else: the_named_constant_or_the_value_itself(value_after(field))
                else if refinement_asked(only): defined_with_no_value()
                else: none_value()
}

-- === Reading and writing a series by position ==========

-- PICK counts from one, and answers none for a position that is not there.
--
-- `Pick_Block`: `if (n == 0) return 0; if (n < 0) n++; n += VAL_INDEX(block) -
-- 1; if (n < 0 || n >= VAL_TAIL(block)) return 0;` -- the same three lines a
-- path uses, so the two always agree. There is no position zero, and a negative
-- position counts back from where the series is and may reach behind it.
rule PickCountsFromOneAndHasNoZero {
    when: EvaluateCall(pick, subject, position)
    requires: is_series(subject)
    ensures: CallResult(value: the_item_that_far_along_or_none)
}

-- PICKZ counts from zero forwards and from PICK's own rules backwards.
--
-- `if (VAL_INT64(D_ARG(2)) >= 0 && !IS_BITSET(D_ARG(1))) VAL_INT64(D_ARG(2)) +=
-- 1;` and then the ordinary PICK. So a negative index is passed through
-- untouched: `pickz s -1` and `pick s -1` are one question, and only the
-- forward direction is renumbered.
rule PickzCountsFromZeroForwardsOnly {
    when: EvaluateCall(pickz, subject, position)
    requires: is_series(subject)
    requires: position >= 0
    ensures: SameOutcomeAs(pick, subject, position + 1)
}

-- PUT into a block looks at every position, not every other one.
--
-- `ret = IS_INTEGER(D_ARG(ARG_PUT_SIZE)) ? Int32s(D_ARG(ARG_PUT_SIZE), 1) : 1;`
-- -- the record width is one unless /SKIP says otherwise. So `put [a b b c] 'b
-- 0` writes after the first b, and reading the block as pairs would find the
-- second.
rule PuttingIntoABlockLooksAtEveryPosition {
    when: EvaluateCall(put, subject, key, written)
    requires: is_block(subject)
    ensures: item_after_the_first_key_becomes(subject, key, written)
}

-- A key PUT cannot find is added at the end, and so is its value.
--
-- `Expand_Series(ser, tail, 2)` and both go in. A key that is there with
-- nothing after it grows the block by one instead: "when key is last value in
-- the block".
rule PuttingAKeyThatIsNotThereAddsIt {
    when: EvaluateCall(put, subject, key, written)
    requires: is_block(subject)
    requires: not holds_key(subject, key)
    ensures: subject_ends_with(key, written)
}

-- A number written into a binary has to fit in a byte.
--
-- `if (VAL_INT64(arg) < 0 || VAL_INT64(arg) > 255) Trap_Range(arg);` wherever
-- one reaches a binary -- POKE, a path write, CHANGE, APPEND. Truncating is the
-- silent kind of wrong: `a/1: 400` stored 144 and answered 400, so the caller
-- was told the write had happened as asked.
rule ANumberWrittenIntoABinaryMustFitAByte {
    when: WriteIntoBinary(subject, position, written)
    requires: is_integer(written)
    requires: written < 0 or written > 255
    ensures: WriteFails(error: out_of_range, about: written)
}

-- A character written into a binary goes in as its code point's byte, the
-- same as an integer, and is refused the same way past two-five-five. So
-- `poke s 1 #"z"` writes byte 122 and `poke s 1 #"^(0100)"` raises
-- out-of-range.
--
-- The same as an integer is the point. A binary holds bytes, and both a
-- small integer and a character below two-five-six name one byte, so the
-- reader treats them alike rather than encoding the character as its UTF-8.
-- A caller wanting the multi-byte encoding of a character reaches for a
-- string or APPEND, which do encode; a POKE of one position writes one byte
-- and a character that needs more than one is out of range for it.
rule ACharacterWrittenIntoABinaryMustFitAByte {
    when: WriteIntoBinary(subject, position, written)
    requires: is_char(written)

    ensures:
        if code_point_of(written) > 255:
            WriteFails(error: out_of_range, about: written)
        else:
            the_byte_at(subject, position) = code_point_of(written)
}

-- CHANGE on a binary writes the bytes of whatever it was given, and grows the
-- binary where they run past the end.
--
-- The bytes come from the same rules APPEND uses: a string contributes its
-- UTF-8, a tuple its octets, a number one byte. `change #{} "^(1234)"` writes
-- three bytes into an empty binary.
rule ChangingABinaryWritesBytesAndGrows {
    when: EvaluateCall(change, subject, written)
    requires: is_binary(subject)
    ensures: CallResult(value: the_position_after_what_was_written)
}

-- CHANGE writes the replacement over the target and answers the position just
-- past what it wrote. It removes as many characters as the replacement is
-- long -- or as many as are left, if that is fewer -- then puts the
-- replacement in, growing the string when it runs past the tail.
--
-- So `change c "AB"` on "hello" gives "ABllo", replacing two characters with
-- two. `change/dup mem "x" 5` on an empty string grows it to "xxxxx", writing
-- five into a string that held nothing. And `change at s 1 skip s 1` on
-- "12345" leaves "23455" and answers the position at the final "5", not the
-- head -- the answer is where the next write would carry on from.
--
-- Three things had to change together and each was wrong on its own before.
-- The write overwrote in place without growing, so a replacement past the
-- tail was lost. A change into an empty string was skipped, so /dup could not
-- fill one. And the answer was the head rather than the position past the
-- change, so a caller chaining one change onto another started over each
-- time. The C's Modify_String clamps the write to the tail, expands or shrinks
-- the storage to fit, and returns the position past what it wrote.
rule ChangingAStringWritesOverAndAnswersPastTheChange {
    when: EvaluateCall(change, subject, replacement)
    requires: is_string(subject)

    ensures:
        the_characters_removed(subject) =
            the_smaller_of(length_of(replacement), characters_left_from(subject))
        the_string_holds(subject) = the_replacement_written_over(subject, replacement)
        CallResult(value: the_position_just_past_what_was_written(subject, replacement))
}

-- A series standing past its own tail is brought back to the tail before
-- anything is written, so a CHANGE or an INSERT there appends.
--
-- A position can end up past the tail without anyone asking for it: another
-- value sharing the storage removes items, and a view that was at position
-- four is now beyond a series of two. The C brings every series action back
-- in the setup it shares -- `if (index > tail) VAL_INDEX(value) = index =
-- tail;` -- so the write lands at the end rather than failing or writing into
-- a gap.
--
-- The clamp is the whole reason a stranded position is usable at all rather
-- than an error waiting to happen. Refusing instead would make an ordinary
-- aliasing pattern -- hold a view, shorten the series through another view,
-- keep appending -- into a failure at a distance, and the caller would have
-- no way to tell a genuinely wrong index from one the world moved out from
-- under it.
rule APositionPastTheTailIsBroughtBackToTheTail {
    when: EvaluateCall(verb, subject, written)
    requires: verb in {change, insert}
    requires: is_series(subject)
    requires: subject.index > subject.length + 1

    ensures: SameOutcomeAs(verb, at_the_tail_of(subject), written)
}

-- CHANGE/PART with a negative count replaces the span BEHIND the position
-- rather than the one ahead of it.
--
-- The count is turned round rather than treated as an error or as zero: the
-- position moves back by that many and the count becomes positive, so the
-- span always runs forwards from wherever it ends up. It is clamped to what
-- is behind the position, so at the head a negative count replaces nothing.
--
-- This is `Partial1` in the C, and it is the same rule TAKE/PART already
-- follows, which is the point of stating it here: a negative /part means
-- "backwards from here" everywhere it appears, and a caller who computed a
-- count that came out negative gets the span they meant rather than an empty
-- one.
rule ANegativeChangePartReplacesTheSpanBehind {
    when: EvaluateCall(change, subject, replacement)
    requires: refinement_asked(part)
    requires: the_part_count < 0

    ensures:
        the_span_replaced =
            the_items_between(
                the_later_of(subject.index - absolute(the_part_count), 1),
                subject.index)
}

-- REPLACE copies a replacement that is a view into the same series before it
-- writes anything. When the replacement points into the very series being
-- changed, the destructive removal would otherwise destroy what the view
-- points at, so the source is taken first.
--
-- So `replace r "abcd" (skip r 1)` on "abcde" gives "bcdee": the replacement
-- `skip r 1` is "bcde", a live view into r, and it is copied as it stands
-- before "abcd" is removed. Without the copy, removing "abcd" from the front
-- would pull the ground out from under the view, and the write would land on
-- whatever the freed storage then held.
--
-- The copy happens whenever the source is the same series as the destination,
-- before any expand or remove. It costs a copy on the rare aliased call and
-- nothing on the ordinary one, which is the right trade: the aliased call is
-- the one that is silently wrong without it.
rule ReplaceCopiesAReplacementThatAliasesTheTarget {
    when: EvaluateCall(replace, target, search, replacement)
    requires: replacement_is_a_view_into(replacement, target)

    ensures:
        the_string_holds(target) =
            search_replaced_by(target, search, a_copy_taken_before_writing(replacement))
}
