-- allium: 3
--
-- JEBOL: the console.
--
-- The REPL is an adapter, not part of the language. It reads a line,
-- evaluates it and prints the result, and it is the only place in JEBOL
-- that is allowed to be forgiving. Two conveniences live here that
-- deliberately do not live in the evaluator: a fresh word can be assigned
-- to, and an error ends the expression rather than the session.
--
-- Both of those are why this is a separate module. Putting them in the
-- evaluator would mean a block handed to a function behaved differently
-- depending on who was watching.

use "./values.allium" as values

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum SubmissionOutcome {
    printed             -- a value came back and was shown
    | shown_nothing     -- the expression produced UNSET, so nothing printed
    | reported_error    -- an error came back and was shown as an error
    | still_reading     -- the line was incomplete, so more input is wanted
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity Session {
    user_context: values/Context
    submissions: Submission with session = this

    is_open: Boolean
}

-- The console's other way in, and it is not a conversation. A caller asks for
-- one piece of source to be run and for the process to end with a number that
-- says how it went, which is what makes the console usable from a shell script
-- and from another REBOL.
--
-- It is here rather than in embed.allium because it is the console being
-- driven without a person at it, conveniences and all: a fresh set-word still
-- gets a slot, exactly as it would if the same line had been typed. A caller
-- who wanted the strict evaluator has an interpreter to embed and does not
-- need a process.
--
-- Asking for the mode without giving anything to run is not a batch run of
-- nothing. There is no source, so there is nothing to conclude and no number
-- to leave with, and the console opens as it always does.
entity BatchRun {
    source_text: String
    user_context: values/Context

    status: running | finished

    -- What the process leaves behind for whoever started it.
    exit_status: Integer when status = finished

    transitions status {
        running -> finished
        terminal: finished
    }
}

-- The third way in, and the one a person reaches for first: a path on the
-- command line is a script to run.
--
-- It is a batch run whose source came out of a file, and everything the batch
-- run already says holds -- a fresh set-word gets a slot, and the number the
-- process leaves with is whatever QUIT carried. What it adds is where the
-- script counts from and what it can tell about itself.
entity ScriptRun {
    path: String            -- as it was written on the command line
    arguments: List<String> -- whatever followed it, untouched

    status: running | finished
    exit_status: Integer when status = finished

    transitions status {
        running -> finished
        terminal: finished
    }
}

entity Submission {
    session: Session
    source_text: String

    status: submitted | evaluated | failed | incomplete

    outcome: SubmissionOutcome when status in {evaluated, failed, incomplete}
    result: values/Value when status = evaluated
    error_value: values/Value when status = failed

    -- What was printed back, so that a test can assert on what a user
    -- would have seen rather than on an internal value.
    displayed: String when status in {evaluated, failed}

    transitions status {
        submitted -> evaluated
        submitted -> failed
        submitted -> incomplete
        terminal: evaluated, failed, incomplete
    }
}

config {
    -- RL_Print_TOS in a-lib.c: a value is molded to at most this many
    -- characters before the console cuts it and adds an ellipsis.
    longest_result_shown: Integer = 500
    -- And an error is formed to at most this many.
    longest_error_shown: Integer = 640
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule SubmissionArrives {
    when: Submit(session, source_text)
    requires: session.is_open
    ensures: Submission.created(
        session: session,
        source_text: source_text,
        status: submitted
    )
}

-- Before evaluating, every word in the submission that the user context has
-- no slot of its own for gets one. This is the one place JEBOL creates a
-- binding on assignment, and it is what makes `x: 1` work at a console when
-- `do [x: 1]` inside a function does not.
--
-- A word lib already defines gets a user slot too, holding lib's value, as
-- R3's intern does. That is what keeps lib intact: `add: func [a b][99]` at
-- the prompt sets the user's `add`, and `lib/add 1 2` is still 3. JEBOL gave
-- such a word no user slot until 2026-10-09, so the assignment landed in lib
-- itself and replaced the built-in for everything that used it -- while a
-- script, read through LOAD's intern, already behaved as R3 does.
rule SubmissionExtendsContextForFreshWords {
    when: submission: Submission.created
    requires: submission.status = submitted
    requires: reads_successfully(submission.source_text)

    ensures:
        for word in words_within(submission.source_text):
            if not has_its_own_slot(submission.session.user_context, word.canonical):
                values/ContextSlot.created(
                    context: submission.session.user_context,
                    spelling: word.spelling,
                    canonical: word.canonical,
                    value: lib_value_of_or_unset(word),
                    is_protected: false
                )

    @guidance
        -- A word lib does not define starts UNSET rather than NONE. A word that has been named
        -- but not yet assigned is exactly what UNSET is for, and the
        -- evaluator already reports that differently from an unbound
        -- word.
}

-- The single place a submission's outcome is decided, in precedence
-- order. An unterminated block is not an error; it is a request for the
-- next line, which is what lets a function definition be typed across
-- several of them.
--
-- What the console prints is what R3's own console prints, RL_Print_TOS in
-- a-lib.c: an error -- raised, or merely the value an expression produced --
-- is FORMed and cut at 640 characters; any other value is printed only when
-- its type is in system/options/result-types, molded and cut at 500, after
-- `== ` and before a blank line. A HALT prints nothing.
rule SubmissionResolves {
    when: submission: Submission.created
    requires: submission.status = submitted

    ensures:
        if is_incomplete_source(submission.source_text):
            submission.status = incomplete
            submission.outcome = still_reading
        else if evaluation_halted(submission.source_text):
            submission.status = evaluated
            submission.outcome = shown_nothing
            submission.result = unset_value()
            submission.displayed = ""
        else if evaluation_raised(submission.source_text):
            submission.status = failed
            submission.outcome = reported_error
            submission.error_value = raised_error_of(submission.source_text)
            submission.displayed = formed_error_cut_at(raised_error_of(submission.source_text), config.longest_error_shown)
        else if result_is_unset(submission.source_text):
            submission.status = evaluated
            submission.outcome = shown_nothing
            submission.result = unset_value()
            submission.displayed = ""
        else if result_is_an_error(submission.source_text):
            submission.status = evaluated
            submission.outcome = reported_error
            submission.result = result_of(submission.source_text)
            submission.displayed = formed_error_cut_at(result_of(submission.source_text), config.longest_error_shown)
        else if not result_types_include(type_of(result_of(submission.source_text))):
            submission.status = evaluated
            submission.outcome = shown_nothing
            submission.result = result_of(submission.source_text)
            submission.displayed = ""
        else:
            submission.status = evaluated
            submission.outcome = printed
            submission.result = result_of(submission.source_text)
            submission.displayed = mold_cut_at(result_of(submission.source_text), config.longest_result_shown)
}

-- Whatever came back, printed or not, is what system/state/last-result
-- holds afterwards, as RL_Print_TOS stores it.
rule SubmissionIsRemembered {
    when: submission: Submission.status transitions_to evaluated
    ensures: system_state_last_result() = submission.result
}

-- The console waits for more input the way R3's host does, Host_Repl in
-- host-main.c: by counting the brackets, parens and braces each line opens
-- and closes, skipping those inside strings and comments, and showing the
-- innermost one still open in the prompt. It does not ask the reader. Input
-- that ends while something is open is dropped rather than evaluated.
rule TheConsoleCountsWhatIsOpen {
    when: submission: Submission.created
    requires: openings_left_unclosed(submission.source_text) > 0

    ensures:
        submission.status = incomplete
        submission.outcome = still_reading
        the_continuation_prompt() = innermost_opening_left_unclosed(submission.source_text)
}

rule BatchRunBegins {
    when: RunAndLeave(user_context, source_text)
    ensures: BatchRun.created(
        source_text: source_text,
        user_context: user_context,
        status: running
    )
}

-- Every batch run gets the same convenience an interactive line gets. Without
-- it `--do "x: 1 print x"` fails where typing the same thing works, and the
-- difference has nothing a caller could have predicted behind it.
rule BatchRunExtendsContextForFreshWords {
    when: run: BatchRun.created
    requires: run.status = running
    requires: reads_successfully(run.source_text)

    ensures:
        for word in set_words_within(run.source_text):
            values/ContextSlot.created(
                context: run.user_context,
                spelling: word.spelling,
                canonical: word.canonical,
                value: unset_value(),
                is_protected: false
            )
}

-- What QUIT carried decides the exit status, and that is the whole point of
-- the mode. Rebol's own suite shells out to a second interpreter, has it run
-- `quit/return 100`, and asserts the number 100 comes back -- so the number a
-- script chose has to survive being turned into a process exit code.
--
-- Four cases and only the first is interesting. A quit carrying a whole number
-- leaves with that number. A quit carrying anything else, or nothing, leaves
-- with zero, because REBOL's QUIT without /RETURN means "stop, and nothing
-- went wrong". An error leaves with one, the ordinary shell convention for a
-- failure with no more to say about it. Anything else finished, so zero.
--
-- Zero for a quit carrying a none rather than one is worth being deliberate
-- about: `quit` and `quit/return 0` mean the same thing to the caller, and a
-- script that stops early on purpose has not failed.
--
-- A HALT leaves with fifteen, as R3's host does. An error is reported on the
-- error stream, formed as the console forms it, before the process leaves
-- with one.
rule BatchRunConcludesWithWhatQuitCarried {
    when: run: BatchRun.evaluation_settled
    requires: run.status = running
    requires: not threw_past_every_catch(run)

    ensures:
        run.status = finished
        run.exit_status =
            if quit_carried_a_whole_number(run):
                the_whole_number_quit_carried(run)
            else if quit_was_asked_for(run):
                0
            else if evaluation_halted(run):
                15
            else if evaluation_raised(run):
                1
            else:
                0
        if evaluation_raised(run):
            the_error_stream_receives(formed_error_cut_at(raised_error_of(run.source_text), config.longest_error_shown))
}

-- A throw, BREAK or RETURN that no CATCH or loop took ends the run without
-- reaching the QUIT that R3's start function puts after --do, so the console
-- opens, exactly as it does in R3. Nothing is reported: to R3's host it was
-- not an error.
rule BatchRunThatThrowsOpensTheConsole {
    when: run: BatchRun.evaluation_settled
    requires: run.status = running
    requires: threw_past_every_catch(run)

    ensures:
        Session.created(user_context: run.user_context, is_open: true)
}

-- An error ends the expression, never the session. A console that exited
-- on a typo would be unusable, and the guarantee that errors are values
-- is what makes carrying on safe rather than reckless.
rule SessionSurvivesAnError {
    when: submission: Submission.status transitions_to failed
    ensures: submission.session.is_open = true
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- Nothing is shown for UNSET. Printing something for a value that is not
-- there would make it impossible to tell a function that returned
-- nothing from one that returned NONE.
invariant UnsetShowsNothing {
    for submission in Submissions:
        submission.outcome = shown_nothing implies submission.displayed = ""
}

-- What the console prints is what MOLD prints, so anything shown can be
-- typed back in -- up to the 500 characters R3's console shows, after which
-- it is cut and marked with an ellipsis.
invariant DisplayedValuesAreMolded {
    for submission in Submissions:
        submission.outcome = printed
            implies submission.displayed = mold_cut_at(submission.result, config.longest_result_shown)
}

-- An incomplete line produces no result and no error. It has not been
-- evaluated at all yet.
invariant IncompleteSubmissionsProduceNothing {
    for submission in Submissions:
        submission.status = incomplete implies submission.outcome = still_reading
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface Console {
    facing operator: ConsoleUser
    context session: Session where is_open = true

    provides:
        Submit(session, source_text) when operator.is_open
        RunAndLeave(user_context, source_text)
        RunTheNamedScript(path, arguments)
        Start(words)

    exposes:
        SubmissionOutcome

    @guarantee ErrorsNeverEndTheSession
        -- Every failure is shown and the prompt returns. Nothing a user
        -- can type ends the session except asking it to end.

    @guarantee ConvenienceStopsAtTheConsole
        -- Creating a slot for a fresh set-word happens here and nowhere
        -- else. A block handed to a function behaves the same whether or
        -- not a console is attached.
}

rule AScriptRunBegins {
    when: RunTheNamedScript(path, arguments)
    ensures: ScriptRun.created(
        path: path,
        arguments: arguments,
        status: running
    )
}

-- A script leaves the same number behind a batch run does, and for the same
-- reason: what QUIT carried is the whole of what a caller can act on. A whole
-- number is that number, a HALT is fifteen, an error is one and is reported on
-- the error stream, and anything else finished.
--
-- Unlike a batch run, a script that throws past every catch simply finishes:
-- R3's start function has nothing after the script to skip, so it leaves with
-- nought and says nothing.
rule AScriptRunConcludesWithWhatQuitCarried {
    when: run: ScriptRun.created
    requires: run.status = running
    requires: the_path_names_something_readable(run.path)

    ensures:
        run.status = finished
        run.exit_status =
            if threw_past_every_catch_in(run):
                0
            else:
                the_status_the_batch_rule_gives()
}

-- A script runs in its own directory, not in the one the shell was in.
--
-- Which is what makes a script that ships with data files work wherever it is
-- called from: `%units/files/bug-load-null.r3` reads `%tmp.data` and means the
-- one beside it. The directory the caller was in is not lost -- it stays in
-- `system/options/path` -- so a script that wants the caller's own files can
-- still reach them, and has to say so.
--
-- Getting this backwards is quiet. A script started from its own directory
-- behaves either way, and the difference only shows when somebody runs it
-- from somewhere else.
rule AScriptRunsInItsOwnDirectory {
    when: run: ScriptRun.created
    requires: run.status = running

    ensures:
        the_directory_relative_paths_count_from() = the_directory_holding(run.path)
        system_options_script() = the_full_path_of(run.path)
        system_options_path() = the_directory_the_command_was_given_in()
        system_options_args() = run.arguments
}

-- A script may be confined, and then every path it is given is a path inside
-- what it can see.
--
-- `--root` is what an interpreter starting another one hands over, so the
-- second is bounded the way the first is. A script confined to a directory
-- writes `%/units/files/x.r3` and means a file inside it, so the child has to
-- read the path it is given the same way -- resolving it against the machine
-- instead would name nothing, or something else.
rule ARootedScriptReadsEveryPathInsideItsRoot {
    when: run: ScriptRun.created
    requires: the_command_line_named_a_root()

    ensures:
        the_filesystem_reaches() = only_below(the_root_named())
        the_script_read() = the_path_resolved_inside(the_root_named(), run.path)
}

-- The console grants every host service, and that is a decision rather than
-- an oversight.
--
-- A person typing `jebol script.r3` means what they mean typing `r3
-- script.r3`: the script may read their files, start their programs and open
-- their sockets, because they chose to run it. Confinement is for the other
-- way in -- a host embedding the interpreter and handing it somebody else's
-- script -- and that host builds its own bounds and grants nothing by
-- default.
--
-- So the two defaults are opposite on purpose. Embedding grants nothing
-- because the useful set is the one nobody guessed; the command line grants
-- everything because a shell tool that cannot read a file is not a tool.
rule TheConsoleGrantsEveryService {
    when: run: ScriptRun.created

    ensures: the_granted_services() = every_host_service()
}

-- With `--screen=web` and a script, the script waits for a browser. The page's
-- address is printed, and the script starts once a browser has opened it. A
-- script that opens a window on a page nobody is looking at has its SHOW
-- refused as not present, and the run ends before anyone could have seen it;
-- that is what happened to the first person to try it, on 2026-10-09. At the
-- console, with no script, nothing waits: the prompt says to open the page
-- before VIEW, and a person can do that in either order.
rule AScriptOnTheWebScreenWaitsForABrowser {
    when: run: ScriptRun.created
    requires: the_screen_asked_for_is_the_web()

    ensures:
        the_page_address_is_printed()
        the_script_starts_after(a_browser_has_opened_the_page())
}

-- A script run from the command line has no time limit, as `r3 script.r3`
-- has none, and neither has a line typed at its console. The same reasoning as the grants: the person chose to run it, and
-- a program that opens a window and waits for them is meant to run for as
-- long as they use it. The five seconds `Bounds.standard()` carries is the
-- embedding default and stays there.
--
-- It was not so until 2026-10-09, and a GUI showed why it matters: the window
-- opened, nothing checked the clock while it sat idle, and the first move of
-- the mouse ran a handler, found the five seconds long gone and ended the
-- program with a timeout.
rule AScriptOnTheCommandLineHasNoTimeLimit {
    when: run: ScriptRun.created

    ensures: run.wall_clock_limit = none
}

-- A run its bounds stopped -- out of time, or cancelled by its host -- is
-- reported in the words of the interpreter's own catalogue: `** Access error:
-- port action timed out: ...` for a timeout, as `errors.reb` says. It was
-- reported as "(improperly formatted error)", because the error was built
-- with no catalogue to read.
rule AStoppedRunIsReportedInTheCataloguesWords {
    when: a_run_is_stopped_by_its_bounds(run)

    ensures: the_report_reads(the_catalogue_entry_for(access, the_stopping_id(run)))
}

-- A script is read as bytes and decoded, which is what drops a byte order
-- mark at the front of it. LoadOfABinaryDropsAnyByteOrderMark says the same
-- thing of LOAD, and a script on the command line has to agree: the mark
-- marks the encoding rather than being part of the source.
--
-- Reading the file as text instead keeps the mark, and the first word of the
-- script becomes a word nobody can have defined. A file written by an editor
-- that marks its encoding then fails on its own first line.
rule AScriptIsDecodedRatherThanReadAsText {
    when: run: ScriptRun.created
    requires: the_path_names_something_readable(run.path)

    ensures: the_source_run() =
        text_after_any_byte_order_mark(the_bytes_of(run.path))
}

-- A path that names nothing is a failure with a number, not a console.
--
-- The console opening instead is the worst of the three answers: a script
-- that was meant to run has not, nothing said so, and whoever called it is
-- now looking at a prompt they did not ask for. That is what JEBOL did with
-- any path it was given.
--
-- The report names the script as it was written, on the error stream, with
-- the lower-case "access error" R3's host writes.
rule AScriptThatIsNotThereIsAFailure {
    when: run: ScriptRun.created
    requires: not the_path_names_something_readable(run.path)

    ensures:
        run.status = finished
        run.exit_status = 1
        the_error_stream_receives(script_not_found_naming(run.path))
}

-- The command line is read the way R3's host reads it, OS_Parse_Args in
-- host-args.c, so that the same words given to r3 and to JEBOL ask for the same
-- thing.
--
-- Options come first and the first word that is not one is the script; every
-- word after it is the script's, untouched, even one that looks like an option.
-- `--` ends the options without naming a script. An option that takes a value
-- takes the next word, unless that word's second character is a dash, in which
-- case the option is set and the word is left to be read as what it is. An
-- option that takes a value and has no next word, and any option nobody knows,
-- asks for the usage text instead.
--
-- `--root`, `--data` and `--screen=` are JEBOL's own and are taken off before
-- R3's reading starts, because to R3 they would be unknown options asking for
-- help.
entity CommandLine {
    words: List<String>
    flags: Set<String>         -- spelled as system/catalog/boot-flags spells them
    script: String?            -- as it was written
    arguments: List<String>    -- the --args value first, if given, then the rest
}

rule TheCommandLineIsReadAsRebolsHostReadsIt {
    when: Start(words)
    ensures: CommandLine.created(
        words: words,
        flags: the_flags_os_parse_args_sets(words),
        script: the_script_os_parse_args_finds(words),
        arguments: the_arguments_os_parse_args_leaves(words)
    )
}

-- What was asked is handed to the system object as Init_Main_Args in b-init.c
-- hands it: system/options/flags is a block of the flags given, in boot-flags
-- order, ending in a true so that `flags/verbose` reads as a logic; quiet and
-- no-color are set by their flags; the script is a file as it was written;
-- do-arg, debug, version and import are text; secure and boot-level are words;
-- and path is the directory the command was given in.
rule TheSystemIsToldWhatWasAsked {
    when: line: CommandLine.created
    requires: anything_was_asked(line)

    ensures:
        system_options_flags() = the_flag_words_in_boot_flags_order(line.flags) + [true]
        system_options_script() = file_as_written(line.script)
        system_options_args() = line.arguments
        system_options_path() = the_directory_the_command_was_given_in()
}

-- What R3 does after that is not the host's to do. Its host applies sys/start,
-- Rebol's own function in sys-start.reb, and that is what runs --do, loads the
-- script, works out the data and modules folders, makes the user's context and
-- prints the banner. JEBOL applies the same function the same way, which is why
-- an error raised by a script reports `-apply-` as the outermost call, exactly
-- as r3 does.
--
-- A boot level below mods given with --boot stops short of start altogether, as
-- Init_Mezz does.
rule RebolsOwnStartRunsTheRest {
    when: line: CommandLine.created
    requires: anything_was_asked(line)
    requires: not boot_level_below_mods(line)

    ensures: sys_start_applied_as_the_host_applies_it()
}

-- After start the host decides, as main in host-main.c decides. A QUIT leaves
-- with what it carried. Otherwise start reports a halt as minus fifteen, an
-- error as minus one, having put the error on the error stream, and anything
-- else as nought. Unless --cgi was given, the console opens when there was no
-- script, when start reported trouble, or when --halt asked for it -- except
-- that trouble without --halt leaves with the number negated, saying it is
-- closing first unless system/options/quiet is set. Everything else leaves
-- with nought.
rule TheHostDecidesAfterStart {
    when: line: CommandLine.started
    requires: not quit_was_asked_for_during_start()

    let reported =
        if start_halted(): -15
        else if start_raised_an_error(): -1
        else: 0

    ensures:
        if not (cgi in line.flags)
                and (not names_a_script(line) or reported < 0 or halt in line.flags):
            if reported < 0 and not (halt in line.flags):
                process_leaves_with(-reported)
            else:
                Session.created(user_context: the_user_context_start_made(), is_open: true)
        else:
            process_leaves_with(0)
}

-- The console start leaves open works in the user context start made, and a
-- word new to it takes the value lib gives that word, as intern does. So a
-- word a script set is still set at the prompt that follows it.
rule TheConsoleAfterStartUsesTheContextStartMade {
    when: submission: Submission.created
    requires: submission.session.user_context = the_user_context_start_made()

    ensures:
        for word in words_new_to(submission.session.user_context, submission.source_text):
            word.value = lib_value_of(word)
}

-- `--data` is what one JEBOL tells another it starts, and it reaches start the
-- way R3 is told where its data lives: as REBOL_HOME.
rule TheDataSwitchIsRebolHome {
    when: line: CommandLine.created
    requires: the_command_line_named_a_data_directory()

    ensures: environment_variable("REBOL_HOME") = the_data_directory_named()
}

actor ConsoleUser {
    identified_by: Session where is_open = true
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

-- Resolved, and reversed: the console counts what is open, as R3's host does,
-- rather than asking the reader. It was once decided the other way, on the
-- grounds that counting gets a brace inside a braced string wrong; R3's host
-- counts braces inside a braced string as nesting, so a console that agrees
-- with R3 counts too. See TheConsoleCountsWhatIsOpen.

-- Resolved: the console prints == before a value, as R3-Alpha does.

-- Resolved against a real R3: the console is reachable as
-- system/console, an object! whose words are [history current]. So the
-- history is a REBOL value a script can read rather than something only
-- the adapter knows about.
--
-- JEBOL does not have a system object yet, so this is answered but not
-- built. When it is, history belongs there rather than in the user
-- context, where a script could shadow it by accident.
