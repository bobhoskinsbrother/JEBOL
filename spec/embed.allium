-- allium: 3
--
-- JEBOL: running scripts inside a host application.
--
-- This is what the project is for. Not interoperability, which is a poor
-- reason to build a REBOL: plenty of things call Java already. The reason
-- is running REBOL where production code already runs, with the operational
-- benefits of the JVM, and that means a host has to be able to hand a
-- script to an interpreter under bounds it sets and get a value back.
--
-- Three bounds matter, and none of them is optional in a web application:
-- how long a script may run, how deep it may nest, and what it may reach.
-- A script that cannot be stopped is a request that cannot be timed out.

use "./values.allium" as values

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

-- Why a script stopped. The first is the ordinary case.
enum Conclusion {
    produced_a_value    -- the script finished and its value is available
    | raised            -- the script failed and the error is available
    | timed_out         -- the deadline passed before the script finished
    | cancelled         -- the host asked for it to stop
    | nested_too_deep   -- the script exceeded the nesting the host allowed
    | quit_early        -- the script itself asked to stop, and may say with what
}


-- The kinds of thing outside the interpreter that a script can ask for.
-- Named as kinds rather than as single functions because a host grants or
-- refuses a kind: a host that lets a script read a file almost always
-- lets it read every file it can see, and a host that does not want the
-- file system does not want one corner of it either.
enum HostService {
    files               -- read, write, delete, rename, list, ask about
    | working_directory -- which directory a relative path counts from
    | environment       -- the names and values the host was started with
    | processes         -- start another program and wait for it
    | console           -- read a line from the operator, write one back
    | clock             -- what the time is now
    | network           -- open a connection to another machine
    | windows           -- ask the operator with a window on a screen
    | clipboard         -- read and write what the operator last copied
    | midi              -- list, hear and play the instruments the operator
                        -- has attached
    | web               -- fetch a url through the host's own HTTP machinery
    | certificates      -- judge whether a server's certificates are to be
                        -- trusted, against the authorities the host trusts
}

-- What feeds a started program's standard input.
--
-- The difference between the last two is the one that matters. A child given
-- nothing reads end of input at once and gets on with its work; a child that
-- inherited the host's input waits for whoever is on the other end of it,
-- who may never type anything. A script that meant the first and got the
-- second has hung, and nothing in the answer says why.
enum ProgramInput {
    the_hosts_own       -- the child reads from wherever the host reads
    | supplied_bytes    -- these bytes, and then end of input
    | a_files_contents  -- the named file, from its start to its end
    | nothing_at_all    -- closed, so the child reads end of input at once
}

-- Where a started program's standard output or standard error goes. The two
-- streams are directed separately and by the same four choices.
enum ProgramOutput {
    the_hosts_own       -- the child writes where the host writes
    | captured          -- the bytes come back to the interpreter
    | into_a_file       -- the bytes are written to the named file
    | discarded         -- the bytes are thrown away
}

-- Why a host service is not available. A script that asks for one it
-- cannot have must be able to tell these apart: the first two are the
-- host's decision and the third never changes.
enum ServiceRefusal {
    not_granted         -- the host has this service and did not grant it
    | not_present       -- the host itself has no such service to grant
    | never_portable    -- no host can offer it, so JEBOL never will
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

-- What a host decides before a script runs. Every field is a bound, and
-- every bound has a default, because a host that must configure five
-- things before running anything will configure none of them.
value Bounds {
    time_limit: Duration
    maximum_nesting: Integer
    -- Empty by default. A host that says nothing gets a script that can
    -- compute and cannot reach out, thus a host must name each service it
    -- wants, one at a time. The other bounds have useful defaults because
    -- a host that must set five things sets none of them; this one has no
    -- useful default, because the useful value is the one nobody guessed.
    granted_services: Set<HostService> = empty

    -- The kinds of outside thing this host has no way to offer at all.
    -- Empty by default, because a host on a machine has everything a
    -- machine has until it says otherwise, and a host whose outside is a
    -- page has less.
    --
    -- A different fact from a grant, with a different refusal. A service
    -- the host has and did not grant is the host's decision on the day and
    -- can be changed; a service it has not got never can be, and a script
    -- reading the error needs to tell them apart before asking for the
    -- wrong one.
    unavailable_services: Set<HostService> = empty

    -- What this host calls itself in a refusal: "a browser", "this host".
    -- A refusal names the service and the thing that refused it, so a
    -- script that got one can say what it asked and who said no without
    -- JEBOL knowing a browser from a phone.
    host_name: String = "this host"

    -- The libraries every interpreter built with these bounds gets, in the
    -- order they were added. Carrying them in the bounds rather than
    -- adding them to one interpreter is what makes a task, or any other
    -- interpreter the host builds the same way, get the same ones. Adding
    -- an extension is granting it: one the bounds do not carry is not
    -- there for the script to call.
    extensions: List<Extension> = empty
}

-- A library a host adds: Java behind REBOL words, in the shape R3's own
-- hosted extensions take. R3's `load-boot-exts` takes a REBOL source and a
-- dispatcher for each one, makes a module whose words are `command!`
-- values, and lists it in `system/modules`; an extension here is the same
-- two halves, written by the host.
value Extension {
    name: String                 -- the module's name, as `import` names it
    version: String              -- a tuple, as a REBOL header writes one
    commands: List<ExtensionCommand>
    -- REBOL that runs after the commands are made, in the module: where a
    -- scheme is made with `make-scheme` or a codec registered with
    -- `register-codec`, using the commands. A library's scheme is then
    -- built exactly as `http` is.
    script: String = ""
    -- Kinds of handle the commands hand to scripts, each naming the Java
    -- class it holds.
    handle_kinds: List<HandleKind> = empty
}

-- One word the extension exports, with the spec a script sees: help text,
-- arguments, their datatypes and refinements, written as a REBOL spec
-- block is written.
value ExtensionCommand {
    name: String
    spec: String
}

value HandleKind {
    name: String
    holds: String                -- the Java class of what a handle of this kind carries
}

-- What the host can learn about each extension after building an
-- interpreter: installed, or refused with the error that refused it.
value ExtensionReport {
    name: String
    installed: Boolean
    refusal: String?             -- the error id when it was not installed
}

-- What the host can tell the interpreter about one thing on its filesystem.
--
-- Six facts and no more, because this is the whole of what QUERY answers
-- and a port that offered more would be offering something no script can
-- ask for. Every field is optional except the name and the kind: a host
-- may know a file exists without being able to say when it was last read,
-- and a script asking for a fact the host has not got gets none rather
-- than a refusal. The refusal is for the service, not for the field.
value FileInformation {
    name: String                -- the path, as the interpreter spells it
    is_directory: Boolean       -- what QUERY's `type` field reports
    size: Integer?              -- none for a directory, and for a host that cannot say
    modified: Timestamp?
    accessed: Timestamp?
    created: Timestamp?
}

-- What the host says about the machine an interpreter runs on.
--
-- Told rather than read. An interpreter that looked these up for itself would
-- give every host the JVM's answer, and a host is entitled to another: a
-- browser is not the machine its worker runs on, and a test that wants to see
-- what a script does on Windows should not need Windows to see it.
--
-- Every interpreter has one. A host that supplies none gets the machine the
-- JVM is running on, which is what an embedded interpreter has always reported
-- and is right for any host that has nothing else to say.
value HostMachine {
    -- The operating system, as the word Rebol's own library compares against:
    -- Windows, macOS or Linux, or the name the system gives itself where it is
    -- none of the three. See SystemPlatformNamesTheOperatingSystem in
    -- spec/natives.allium for why "JVM" is never the right answer. Never
    -- blank: a host describing a machine with no name is refused when the
    -- interpreter is built, because a blank word sends every branch in the
    -- borrowed library that tests it down the wrong arm.
    operating_system: String

    -- The character that separates directories in a path this machine writes.
    file_separator: String

    -- Where the operator's home is, as a path on this machine.
    home_directory: String

    -- Where the host process was started, as a path on this machine.
    current_directory: String

    -- The number this machine knows the running process by.
    process_number: Integer

    -- Whether this machine can make a launcher: a program that starts another
    -- interpreter rooted at a given directory and told a given application
    -- data directory. Asked for one, a machine that can answers its path, and
    -- one that cannot answers nothing.
    makes_launchers: Boolean
}

-- What crosses the boundary when a script starts another program.
--
-- The command arrives already separated, one entry for the program and one
-- for each argument, so the host never has to decide where an argument ends.
-- Quoting is the reason: a host handed one line has to split it, splitting
-- needs quoting rules, and the quoting rules differ between systems. A
-- script that wants the system's own rules asks for them, and that is what
-- the shell flag is.
value ProgramToStart {
    command: List<String>

    -- Whether the shell reads the command rather than the host starting the
    -- program itself. The shell does the splitting, the globbing and the
    -- redirecting.
    --
    -- The first entry is the command line the shell reads, and any entries
    -- after it become the shell's positional parameters: the second is $0,
    -- the third is $1, and so on. So a block command with the shell is not a
    -- list of arguments to the program, which is what it is without the
    -- shell, and reading it as one gives a command line that ignores
    -- everything after the first entry.
    --
    -- The single-entry case is the string command, where there was never
    -- more than one thing to send.
    read_by_the_shell: Boolean

    -- Whether the child is put on the host's own console. Asked for
    -- separately from inheriting the streams, because a host may have
    -- streams and no console to attach to.
    attached_to_the_hosts_console: Boolean

    -- Whether the interpreter waits for the child to exit before carrying
    -- on. It has to when anything is being captured, because there is
    -- nothing to hand back until the child has finished writing.
    waited_for: Boolean

    standard_input: ProgramInput
    input_bytes: List<Integer>?     -- when the input is supplied_bytes
    input_file: String?             -- when the input is a_files_contents

    standard_output: ProgramOutput
    output_file: String?            -- when the output goes into_a_file

    standard_error: ProgramOutput
    error_file: String?             -- when the error stream goes into_a_file
}

-- What the host tells the interpreter about a program it started.
--
-- The last field is the one to get right. A system that would not start the
-- program at all is a different outcome from a program that started and
-- failed, and the two are easy to conflate because both end with a script
-- that did not get what it wanted. An exit code says the program ran.
value ProgramResult {
    process_number: Integer
    exit_code: Integer?             -- only when the child was waited for
    captured_output: List<Integer>?
    captured_error: List<Integer>?
    refusal_message: String?        -- what the system said, when it refused
}

-- What a script asks for when it asks the operator to choose a file.
--
-- All five are optional and the dialog is usable with none of them, which is
-- why they are fields on a request rather than five separate ways of asking.
value FileChoiceRequest {
    for_saving: Boolean         -- choosing a name to write, not one to read
    several_at_once: Boolean    -- the operator may pick more than one
    starting_at: String?        -- the name or directory to open on
    window_title: String?       -- what the window's bar says

    -- What the chooser will show, flat: a name, then the pattern it stands
    -- for, then the next name, and so on. Empty when the script named none.
    --
    -- The two entries of a pair do different jobs. The name is what the
    -- operator reads in the chooser's menu and the pattern is what it selects
    -- by, so "Rebol scripts" then "*.r3" reads as a menu entry a person can
    -- pick, and a chooser offering "*.r3" as the name is one nobody can use.
    --
    -- Flat rather than already paired, because flat is what the script hands
    -- over and the pairing is a reading of it rather than a property of it. A
    -- list of an odd length has no pairing at all and is refused; a model that
    -- had paired them already could not say what was wrong with a list that
    -- would not pair.
    --
    -- Every entry is text by the time it crosses, whatever the script wrote.
    filters: List<String>
}

-- What a script may ask the operator for through a window on a screen.
--
-- Five things, and they are one service rather than five because a host that
-- will put one dialog on the screen will put any of them there. A grant per
-- dialog would let a host say which verb and not which screen, and the verb
-- was never the interesting half.
--
-- Every one of them answers none when the operator declines. That is not a
-- refusal and must not be reported as one: a person who closes a file
-- chooser has answered the question, and a script that cannot tell "no file"
-- from "no permission" will retry the wrong one.
enum WindowRequest {
    a_browser_at         -- open a URL or a local file in a web browser
    | a_file             -- choose a file, to read or to save, from a
                         -- FileChoiceRequest saying which files to offer
    | a_directory        -- choose a directory
    | a_colour           -- choose a colour
    | a_password         -- type a secret, without it appearing on screen
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

-- One interpreter, owned by one thread, holding everything reachable from
-- it. A host running many scripts at once runs many of these; it does not
-- share one, because series share mutable storage and confining that to a
-- single thread is what makes it need no synchronisation.
--
-- The host hands over every port the interpreter will ever have when it
-- builds it, and there is no way to change them afterwards: a port supplied
-- after a script had already run would let a run begin under one host's
-- rules and finish under another's, and a setter for one models a change
-- that never happens. A port the host does not supply is that port's
-- refusing default, so an interpreter built with none reaches nothing, and
-- the refusal a script meets names the kind of thing that was not supplied.
entity Interpreter {
    bounds: Bounds
    machine: HostMachine
    user_context: values/Context
    network: NetworkPort

    -- Who judges a server's certificates. Every interpreter has one: a host
    -- that supplies none gets the authority that trusts nothing, so a grant
    -- of certificates on its own never lets an unchecked server through.
    certificate_authority: CertificateAuthority

    -- Where a script's HTTP goes on a host that fetches for it. Absent on
    -- a host that leaves HTTP to Rebol's own protocol, which is every JVM
    -- host until one says otherwise.
    http: HttpPort?

    runs: ScriptRun with interpreter = this
    active_runs: runs where status = running

    invariant OneScriptAtATime {
        active_runs.count <= 1
    }
}

entity ScriptRun {
    interpreter: Interpreter
    source_text: String
    started_at: Timestamp

    status: running | finished

    conclusion: Conclusion when status = finished
    result: values/Value when status = finished
    elapsed: Duration when status = finished

    deadline: started_at + interpreter.bounds.time_limit
    overdue: now >= deadline

    -- Which host service the script asked for and did not get, and why.
    -- Kept on the run and not only in the error value because a host that
    -- granted too little wants to see that from the outside, without
    -- reading the error the script saw.
    refused_service: HostService when conclusion = raised
    refusal_reason: ServiceRefusal when conclusion = raised

    -- Set when the host asked for the run to stop. The evaluator notices at
    -- its own convenience rather than being interrupted where it stands,
    -- because a thread stopped mid-mutation leaves values half-changed.
    cancellation_requested: Boolean

    -- Set when the script itself asked to stop, by calling QUIT. Kept
    -- apart from cancellation because the two are not the same event: one
    -- is the host overruling the script, the other is the script finishing
    -- early on purpose, and a host wants to tell them apart.
    quit_requested: Boolean
    quit_value: values/Value when quit_requested

    transitions status {
        running -> finished
        terminal: finished
    }
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    -- Long enough that ordinary work finishes, short enough that a runaway
    -- script does not hold a request open until something else times out.
    default_time_limit: Duration = 5.seconds
    default_maximum_nesting: Integer = 10_000
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- A script that asks for a host service it has not been granted gets an
-- error, and the error says which of the three reasons applies. Silence
-- is the failure this prevents: a READ that quietly answers none reads as
-- an empty file, and a script cannot tell the two apart.
--
-- Which of the two reasons it is turns on whether the host has the
-- service at all. A grant the host did not give can be asked for again; a
-- service it was never able to offer cannot, and a script that reads
-- "not present" knows to stop asking.
rule RefusedServiceRaises {
    when: script_asks_for(run, service)
    requires: service not in run.interpreter.bounds.granted_services
    ensures:
        run.status = finished
        run.conclusion = raised
        run.refused_service = service
        run.refusal_reason = if service in run.interpreter.bounds.unavailable_services:
            not_present
        else:
            not_granted
}

-- And the sentence says what was asked and who said no, so a script can
-- report "a browser does not allow processes" rather than a bare refusal.
-- The host names itself; JEBOL never guesses what kind of host it is in.
rule ARefusalNamesTheServiceAndTheHost {
    when: script_asks_for(run, service)
    requires: service not in run.interpreter.bounds.granted_services
    ensures: CallFails(error: no_service, about: service)
    ensures: the_error_says_which_host_refused(run) =
        run.interpreter.bounds.host_name
}


-- The current directory belongs to the interpreter and not to the process
-- that holds it. A host runs many interpreters at once and each one must
-- be able to sit in a different directory, thus changing one must not
-- move another. Every relative path is made absolute against the
-- interpreter's own directory before it reaches the host.
rule WorkingDirectoryIsPerInterpreter {
    when: script_changes_directory(run, path)
    requires: working_directory in run.interpreter.bounds.granted_services
    ensures:
        run.interpreter.working_directory = path
        for other in interpreters where other != run.interpreter:
            other.working_directory unchanged
}

-- A script asking about a file it cannot see gets none rather than a
-- refusal, because "there is nothing there" is an answer and a script has
-- to be able to act on it. The refusal is for the service: a script not
-- granted `files` cannot ask at all, and that raises.
rule AskingAboutAMissingFileAnswersNone {
    when: script_queries_file(run, path)
    requires: files in run.interpreter.bounds.granted_services
    requires: not host_has_anything_at(path)
    ensures: QueryResult(value: none)
}

-- A fact the host cannot supply is none for that field alone, and the rest
-- of the answer stands. A host that knows a file's size and not when it was
-- last read is an ordinary host, not a broken one.
rule AFactTheHostHasNotGotIsNoneOnItsOwn {
    when: script_queries_file(run, path, field)
    requires: files in run.interpreter.bounds.granted_services
    requires: host_has_anything_at(path)
    requires: information_of(path).field_named(field) = null
    ensures: QueryResult(value: none)
}

-- Starting another program hands the host a command already separated and a
-- decision about each of the child's three streams. Nothing about the shape
-- of the call is left for the host to work out.
--
-- Each stream is decided independently, which is what lets a script capture
-- what a program printed while letting its complaints go to the console the
-- operator is watching.
rule StartingAProgramCrossesAsACommandAndThreeStreams {
    when: script_starts_a_program(run, program)
    requires: processes in run.interpreter.bounds.granted_services

    ensures:
        program.command.count >= 1
        program.standard_input in ProgramInput
        program.standard_output in ProgramOutput
        program.standard_error in ProgramOutput
}

-- === What the host says about its machine ===================

-- What a script reads about the machine is what the host said about it, and
-- nothing the interpreter looked up for itself. The platform word, the home and
-- current directories, the separator TO-LOCAL-FILE writes, and the process
-- number ACCESS-OS answers all come from the one place, so a host that
-- describes a machine gets a script that sees that machine throughout.
rule ScriptSeesHostMachine {
    when: interpreter: Interpreter.created

    ensures: system_platform(interpreter) = interpreter.machine.operating_system
    ensures: system_options_home(interpreter) =
        directory_at(interpreter.machine.home_directory)
    ensures: system_options_path(interpreter) =
        directory_at(interpreter.machine.current_directory)
    ensures: system_options_data(interpreter) =
        directory_at(interpreter.machine.home_directory + "/.jebol")
    ensures: to_local_file_separator(interpreter) =
        interpreter.machine.file_separator
    ensures: access_os_process_number(interpreter) =
        interpreter.machine.process_number
}

-- `system/options/boot` is the launcher the machine makes, and only where a
-- script may start a program at all. A script that cannot start one has no use
-- for a way to start itself, and writing a launcher is writing a file the host
-- never asked for.
--
-- A machine that cannot make one leaves boot none. A script that tests for it
-- learns there is no second interpreter to start, which is true; a launcher
-- that had been written for an earlier root and stayed put would start one
-- that is not confined the way this one is.
rule MachineMakesLauncher {
    when: launcher_settled(interpreter, root, data_directory)
    requires: processes in interpreter.bounds.granted_services

    ensures: system_options_boot(interpreter) =
        if interpreter.machine.makes_launchers:
            file_at(machine_launcher(interpreter.machine, root, data_directory))
        else: none
}

rule NoProcessesNoLauncher {
    when: interpreter: Interpreter.created
    requires: processes not in interpreter.bounds.granted_services

    ensures: system_options_boot(interpreter) = none
    ensures: not machine_asked_for_launcher(interpreter)
}

-- === Where the root is, from inside ========================

-- A confined script sees the root it was given as `/`, and every path it names
-- is resolved beneath that. Which settles what `..` does at the top: **it stays
-- where it is.** `/..` is `/` on a real filesystem -- `change-dir %../` at the
-- root of a machine answers `%/` and moves nothing -- and a root that behaved
-- differently would be telling the script it is somewhere other than the top.
--
-- So the dots are worked out as they are anywhere else, and a `..` with nothing
-- above it is dropped rather than refused. `%../../../etc/passwd` from inside
-- names `/etc/passwd` *within the root*, which is the same thing
-- `%/etc/passwd` names and reaches nothing for the same reason.
--
-- This is confinement, not a warning: a path that climbs cannot reach outside,
-- because there is no outside to reach. Refusing it instead would say the same
-- thing about safety and a different thing about where the script is standing,
-- and the second is what a script acts on.
rule TheDotsAreWorkedOutAndClampAtTheRoot {
    when: a_confined_script_names(path)

    ensures: the_file_reached(path) =
        beneath_the_root(the_segments_of_with_dots_dropped(path))
    ensures: not is_outside(the_root, the_file_reached(path))
}

-- Symbolic links are followed, and a link that leads out of the root is
-- refused.
--
-- The dots alone are not the whole of confinement. A link inside the root
-- pointing at `/etc` is a door the dots never see, and a filesystem that
-- followed it would hand a confined script the machine. Refusing to follow
-- links at all would be safe and wrong: an app that keeps a folder of
-- shared assets linked into each user's space is an ordinary app.
--
-- So every access is judged by where the path really lands, each link along
-- it followed as the operating system would follow it, and anywhere outside
-- the root is refused with `security`, naming the path as the script wrote
-- it -- the real location is the host's to know, and naming it would tell
-- the script where its root sits. Inside the root, a link is followed like
-- any other path.
--
-- A link that dangles is judged by where its target would be, because that
-- is where a write through it lands. A chain of more than forty links is
-- refused the same way rather than followed for ever: forty is the limit a
-- POSIX kernel gives up at.
rule ALinkLeavingTheRootIsRefused {
    when: a_confined_script_names(path)
    requires: is_outside(the_root, the_real_location_of(path))
        or more_than_forty_links_lie_along(path)

    ensures: CallFails(error: security, arg1: path)
    ensures: nothing_outside_the_root_is_read_or_written()
}

rule ALinkLandingInsideTheRootIsFollowed {
    when: a_confined_script_names(path)
    requires: not is_outside(the_root, the_real_location_of(path))

    ensures: the_file_reached(path) = the_real_location_of(path)
}

-- Deleting, renaming and making a directory act on the entry the path names,
-- not on what it points to. Deleting a link removes the link and leaves its
-- target alone, as `rm` does; only the folders above the entry are followed,
-- and those must still land inside the root.
rule RemovingALinkRemovesTheLinkItself {
    when: script_changes_the_entry(path, action)
    requires: action in {delete, rename, make_directory}
    requires: not is_outside(the_root, the_real_location_of(the_folder_holding(path)))

    ensures: the_entry_acted_on(path) =
        the_real_location_of(the_folder_holding(path)) + the_last_name_in(path)
}

-- A host may hand a script a root it can read and not change. Every change is
-- refused the same way, with Rebol's own `read-only`, naming nothing -- writing,
-- appending, deleting, renaming and making a directory alike. One refusal for
-- all five keeps a script from learning which of them the host meant to allow.
-- `make-dir` on a directory already there changes nothing and is not refused:
-- Rebol's own `make-dir` answers it before it asks the host for anything.
-- And `make-dir/deep` reports the refusal as `cannot-open` naming the first
-- folder it could not make, because Rebol's own `make-dir/deep` reports every
-- failure of the folders it makes that way.
rule ReadOnlyRootRefusesEveryChange {
    when: script_changes_the_entry(path, action)
    requires: action in {write, append, delete, rename, make_directory}
    requires: root_is_read_only()

    ensures: CallFails(error: read-only)
    ensures: root_unchanged()
}

-- And the check and the access are the same path. What is opened is the
-- location the check resolved, never the path resolved a second time, so a
-- link swapped between the two cannot redirect the access.
rule TheLocationCheckedIsTheLocationOpened {
    when: a_confined_script_names(path)
    ensures: the_file_reached(path) = the_location_checked_for(path)
}

-- And the directory the program starts in, which is the one the script is
-- standing in rather than the one the host process happens to be in.
--
-- A script that changes directory and then starts a program means the two to
-- agree: `cd sub  call "touch a"` makes `sub/a`, because that is what the same
-- two lines do in a shell. Leaving it to the host makes the program start
-- wherever the embedding application was launched from, and a script confined
-- to a directory of its own then writes outside it through the one door
-- confinement cannot close.
--
-- Which is the honest limit of the arrangement rather than a hole in it. A
-- host that grants the process service has granted the running of arbitrary
-- programs, and no interpreter can confine those; what it can do is start
-- them where the script thinks it is, so a script that never names an
-- absolute path never reaches outside by accident.
rule AStartedProgramBeginsWhereTheScriptIsStanding {
    when: script_starts_a_program(run, program)
    requires: processes in run.interpreter.bounds.granted_services

    ensures: program.working_directory =
        the_host_path_of(the_directory_relative_paths_count_from(run))
}

-- And where a script can start another interpreter, that one is confined the
-- way this one is.
--
-- `system/options/boot` is a launcher this interpreter writes for itself, so a
-- script that was given a directory and nothing above it could start a copy of
-- itself that had the whole machine -- and then write anywhere through it.
-- Confinement that a script can step out of by running its own name is not
-- confinement.
--
-- Which also makes a path mean the same thing on both sides. A script confined
-- to a directory sees `%/units/files/x.r3`, and handing that to a child that
-- was rooted somewhere else names nothing; handing it to a child rooted the
-- same way names the same file.
rule ASecondInterpreterIsConfinedAsThisOneIs {
    when: run: ScriptRun.created
    requires: files in run.interpreter.bounds.granted_services

    ensures: the_launcher_at(system_options_boot()) =
        a_command_that_roots_its_filesystem_at(
            the_host_path_of(the_root_this_script_sees()))
}

-- And it is told where the application data is, for the same reason and with
-- the same consequence if it is not.
--
-- A real Rebol needs no such arrangement: parent and child each work the data
-- directory out from the operating system and each get the same answer. Here
-- the host is entitled to move it, and a confined host must, so the child
-- working it out for itself gets a different answer from its parent. The
-- child then looks for modules where its parent did not put them, and IMPORT
-- of a module the parent installed a moment earlier fails with "module not
-- found".
--
-- Which is the same fact as the root, one level down. Confinement is not only
-- what a script may reach; it is what the paths mean, and
-- `system/options/data` is a path with a meaning the host decided. A child
-- rooted the same way and told a different data directory agrees about every
-- path except the one the two of them are most likely to share.
--
-- The modules directory follows the data directory in the child exactly as it
-- does in the parent, so nothing has to be said about it separately: this is
-- TheModulesDirectorySitsBesideTheData in spec/natives.allium, running in the
-- child.
rule ASecondInterpreterFindsTheSameApplicationData {
    when: run: ScriptRun.created
    requires: files in run.interpreter.bounds.granted_services
    requires: the_host_moved_the_data_directory()

    ensures: the_launcher_at(system_options_boot()) =
        a_command_that_puts_its_application_data_at(
            the_data_directory_this_script_sees())
}

-- A capture waits, and the host is told so rather than working it out. A
-- child still running has not finished writing, so there is nothing to give
-- back yet, and a host that answered early would answer with part of the
-- output and no way of saying it was part.
rule CapturingAStreamMeansWaitingForTheChild {
    when: script_starts_a_program(run, program)
    requires: processes in run.interpreter.bounds.granted_services
    requires: program.standard_output = captured
        or program.standard_error = captured
        or program.standard_input = supplied_bytes

    ensures: program.waited_for = true
}

-- What comes back is the process number, and the exit code as well when the
-- child was waited for. A number that is not there is absent rather than
-- zero: a program that has not finished has no exit code, and zero is the
-- code for a program that finished perfectly.
rule AnUnwaitedProgramHasNoExitCodeYet {
    when: host_reports_a_started_program(run, result)
    requires: not result.was_waited_for

    ensures: result.exit_code = null
}

-- A file chooser's filters are pairs, and a list with an odd number of items
-- is refused before the dialog opens.
--
-- Before it opens is the whole point. A malformed list is the script's
-- mistake and nothing about it improves by asking a person first: an
-- operator shown a chooser, who picks a file, and is then told the call was
-- invalid has done work for nothing and cannot tell what went wrong.
rule AFilterListOfOddLengthIsRefusedBeforeTheDialogOpens {
    when: script_asks_the_operator_to_choose_a_file(run, request)
    requires: windows in run.interpreter.bounds.granted_services
    requires: not the_filter_items_pair_up(run)

    ensures:
        run.conclusion = raised
        no_window_was_shown(request)
}

-- Each item of the filter list is formed to text, so an item that is not a
-- string is not a mistake. A word, a file or a number becomes its own
-- spelling and goes to the chooser as that.
--
-- Formed rather than molded, so a file contributes its path and not a path
-- with a percent sign in front of it. Only the count is checked, which is
-- why the odd-length refusal is the only way a filter list can be wrong.
rule EachFilterItemIsFormedToText {
    when: script_asks_the_operator_to_choose_a_file(run, request)
    requires: windows in run.interpreter.bounds.granted_services

    ensures:
        for item in the_filter_items_written_by(run):
            request.filters.holds(formed(item))
}

-- A filter pattern the host cannot honour is applied as far as the host can
-- and otherwise ignored. The chooser still opens.
--
-- A decision, and it is about which of two disappointments to prefer. A
-- desktop chooser typically filters by extension and no further, so "*.r3"
-- works and "r3-*" does not. Refusing the call would stop a script for a
-- request the operator would not have minded, and would make a script's
-- portability depend on which patterns each host's chooser happens to
-- support. Showing everything is the lesser loss: the operator sees more
-- files than the script suggested and can still pick the right one.
--
-- What is not acceptable is silently choosing a different file. The filter
-- narrows what is offered and never what is answered, so whatever the
-- operator picks is what the script gets.
rule AFilterTheHostCannotHonourIsAppliedAsFarAsItGoes {
    when: script_asks_the_operator_to_choose_a_file(run, request)
    requires: windows in run.interpreter.bounds.granted_services
    requires: some_pattern_the_host_cannot_honour(request)

    ensures: the_chooser_is_shown(request)
}

-- A dialog the operator declined answers none. The three refusal reasons are
-- about the service and never about the answer, so a script can tell a
-- cancelled file chooser from a filesystem it was not granted.
rule ADeclinedDialogAnswersNone {
    when: script_asks_the_operator(run, request)
    requires: windows in run.interpreter.bounds.granted_services
    requires: operator_declined(request)
    ensures: WindowResult(value: none)
}

-- A file chooser asked for several files and cancelled is none too, not an
-- empty block: the C answers R_NONE whenever the chooser came back with
-- nothing, whatever the refinements.
rule ACancelledChooserForSeveralFilesIsNone {
    when: script_asks_the_operator_to_choose_a_file(run, request)
    requires: windows in run.interpreter.bounds.granted_services
    requires: request.several_at_once
    requires: operator_declined(request)
    ensures: WindowResult(value: none)
}

-- A browser that opened is unset, as the C answers: BROWSE returns R_UNSET
-- both for `browse none` and after OS_Browse succeeds.
rule ABrowseThatOpenedAnswersUnset {
    when: script_asks_the_operator(run, request)
    requires: windows in run.interpreter.bounds.granted_services
    requires: request = a_browser_at
    requires: not operator_declined(request)
    ensures: WindowResult(value: unset)
}

-- A host that granted the windows service and supplied nothing to put a
-- window on gets not_present rather than not_granted. The two are different
-- facts about the host and a script may act on either: the first can be
-- fixed by granting, the second cannot.
rule GrantedWithNoScreenIsNotPresent {
    when: script_asks_the_operator(run, request)
    requires: windows in run.interpreter.bounds.granted_services
    requires: run.interpreter.window_port = null
    ensures:
        run.conclusion = raised
        run.refusal_reason = not_present
        run.refused_service = windows
}

rule ScriptRunBegins {
    when: Run(interpreter, source_text)
    requires: interpreter.active_runs.count = 0
    ensures: ScriptRun.created(
        interpreter: interpreter,
        source_text: source_text,
        started_at: now,
        status: running,
        cancellation_requested: false
    )
}

-- The single place a run's outcome is decided, in precedence order.
-- Stopping beats finishing: a script that produced a value after its
-- deadline produced it too late to be wanted.
rule ScriptRunConcludes {
    when: run: ScriptRun.evaluation_settled
    requires: run.status = running

    ensures:
        if run.overdue:
            run.status = finished
            run.conclusion = timed_out
            run.result = timeout_error()
        else if run.cancellation_requested:
            run.status = finished
            run.conclusion = cancelled
            run.result = cancelled_error()
        else if evaluation_raised(run):
            run.status = finished
            run.conclusion = raised
            run.result = raised_error_of(run)
        else:
            run.status = finished
            run.conclusion = produced_a_value
            run.result = evaluation_result_of(run)
}

-- QUIT ends the run and nothing else. In a real REBOL it ends the process
-- too, because there the script IS the process; here a script is a guest
-- and the host is the one entitled to decide whether anything exits. A
-- guest that could take the host down with it is not embeddable, and a
-- host that had to guard against it could not run untrusted code at all.
--
-- It carries a value because REBOL's QUIT/RETURN does, and because a host
-- running a script to get an answer wants the answer rather than a bare
-- "it stopped".
rule QuitEndsTheRunWithoutEndingTheHost {
    when: run: ScriptRun.quit_requested

    requires: run.status = running

    ensures:
        run.status = finished
        run.conclusion = quit_early
        run.result = quit_value_of(run)

    @guidance
        -- Without /RETURN, or with /RETURN NONE, the value is unset, as
        -- Halt_Code makes it (AQuitCarryingNoneCarriesUnset in
        -- natives.allium). The refinement chooses the value; it does not
        -- choose whether there is one.
}

-- === Extensions: what a library adds ========================

-- One way in. A host function used to be a nameless native set in the
-- script's context by `defineFunction`: it shadowed built-ins silently, had
-- no spec, converted every value to a Java type, reported every failure as
-- host-error, was gated by one switch, was recorded nowhere, reached one
-- interpreter, and could not call back. All nine are what an extension is
-- built to answer, and `defineFunction` is gone.

-- The library is sealed once it is complete, and that is when an
-- interpreter has been built: Rebol's own REBOL files have replaced the
-- natives they replace, and start, which runs later on the command line,
-- adds no word to `lib` (775 words before it and after, measured on
-- 2026-10-15). Every word `lib` holds at that moment is sealed -- the
-- natives and actions, and Rebol's own REBOL functions like `split`,
-- `exists?` and `secure` too, because a library replacing `secure` would be
-- as bad as one replacing `add`.
--
-- The seal is on registration, never on assignment. A script may still
-- write `lib/add: func [a b] ["mine"]`, as it may in r3.
rule TheLibraryIsSealedOnceBuilt {
    when: interpreter: Interpreter.built
    ensures: the_sealed_names(interpreter) = every_word_lib_holds(interpreter)
    ensures: a_script_may_still_assign_into_lib(interpreter)
}

-- Then each extension the bounds carry is installed, in the order added.
-- Installing is all or nothing: an extension refused at any step leaves no
-- word in `lib`, no entry in `system/modules`, and no handle kind behind.
rule ExtensionsAreInstalledInOrderAfterTheSeal {
    when: interpreter: Interpreter.built
    ensures: for extension in interpreter.bounds.extensions:
        InstallExtension(interpreter, extension)
}

-- A name the library already holds is refused with `already-used`, naming
-- the word. Between two extensions the first to install wins, because its
-- words are in `lib` when the second arrives.
--
-- r3 keeps existing names over a REBOL module's exports silently. This is
-- louder because it is the host's call, made before any script runs: no
-- script can see the difference, and a host that named a word twice needs
-- telling.
rule AnExtensionMayNotTakeANameTheLibraryHolds {
    when: InstallExtension(interpreter, extension)
    requires: some_command_name_is_held_by_lib(extension, interpreter)
    ensures: ExtensionRefused(interpreter, extension, error: already_used)
}

-- Its source must read as a REBOL module, and every command's spec as a
-- function spec. Either failing is `bad-extension` naming the extension, as
-- R3 names the library that gave it a bad definition.
rule AnExtensionThatDoesNotReadIsABadExtension {
    when: InstallExtension(interpreter, extension)
    requires: not the_source_reads_as_a_module(extension)
        or some_command_spec_does_not_read(extension)
    ensures: ExtensionRefused(interpreter, extension, error: bad_extension)
}

-- A kind of handle names the Java class it carries. A kind already known
-- holding a different class is refused with `handle-exists`, as R3 refuses a
-- handle registered again with a different size; the same kind holding the
-- same class is shared.
rule AHandleKindIsOneClass {
    when: InstallExtension(interpreter, extension)
    requires: some_handle_kind_is_known_with_another_class(extension, interpreter)
    ensures: ExtensionRefused(interpreter, extension, error: handle_exists)
}

-- An extension may need starting, and starting may fail: no camera on this
-- machine, a library the platform lacks. A failed start is
-- `extension-init`, R3's error for a library whose initialisation did not
-- complete, and the extension is not installed.
rule AnExtensionThatCannotStartIsNotInstalled {
    when: InstallExtension(interpreter, extension)
    requires: the_start_step_fails(extension)
    ensures: ExtensionRefused(interpreter, extension, error: extension_init)
}

-- Installed, an extension is what R3's `load-boot-exts` makes of a hosted
-- extension: `load-extension/dispatch` with its source and its dispatcher,
-- `load-ext-module` and `make module!` on the result, an entry in
-- `system/modules` under its name, and its commands exported into `lib`.
rule AnInstalledExtensionIsAModuleInLib {
    when: InstallExtension(interpreter, extension)
    requires: not ExtensionRefused(interpreter, extension)
    ensures: system_modules_entry(interpreter, extension.name) = the_module_made(extension)
    ensures: for command in extension.commands:
        lib_word(interpreter, command.name) = a_command_value(command)
}

-- The host can ask what was installed and what was refused, and why.
rule TheHostCanListItsExtensions {
    when: AskForExtensions(host, interpreter)
    ensures: ExtensionsListed(reports: a_report_for_each_extension_in_order(interpreter))
}

-- A command is called as any function is: arguments gathered and checked
-- against its spec, so a wrong datatype is `expect-arg` naming the word, the
-- argument and the datatype, before the extension is reached.
--
-- The extension receives the values themselves, a file! as a file! and a
-- block as a block, and answers a value. It may raise any error the
-- catalogue holds, with its own id and arguments. A failure that is not a
-- REBOL error -- the Java behind it throwing -- is `command-fail` carrying
-- its message, as R3 reports a command that answered RXR_ERROR.
rule ACommandFailsInCatalogueTerms {
    when: CallCommand(command, arguments)
    requires: the_extension_fails_without_a_rebol_error(command, arguments)
    ensures: CallFails(error: command_fail, about: the_failure_message())
}

-- A command may reach the interpreter it runs in: evaluate a block it was
-- given, and hand a script a handle of a kind its extension declared.
rule ACommandCanReachItsInterpreter {
    when: CallCommand(command, arguments)
    ensures: the_command_may_evaluate_a_block_in(the_calling_interpreter())
}

-- And from any thread, at any time, an extension may post: an event to a
-- port, which the port's awake sees when the script next waits, or a
-- callback -- a function in an object called with arguments -- which
-- DO-CALLBACK runs on the script's own thread and whose answer goes back to
-- the extension. R3 carries a callback the same way, as an event of type
-- callback on the callback port.
rule AnExtensionPostsFromAnyThread {
    when: ExtensionPosts(extension, interpreter, event)
    ensures: the_event_waits_for_the_next_wait(interpreter, event)
}

-- A run that passes its deadline is stopped whether or not it was going to
-- finish. Without this the bound is advice.
rule OverdueRunIsStopped {
    when: run: ScriptRun.overdue
    requires: run.status = running
    ensures: run.cancellation_requested = true
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- Nothing a script does escapes as a host exception, including running out
-- of time. A host catching REBOL failures by catching Java exceptions would
-- be catching bugs in JEBOL as well, and could not tell them apart.
invariant EveryConclusionIsAValue {
    for run in ScriptRuns:
        run.status = finished implies run.result.datatype in {error}
            or run.conclusion in {produced_a_value, quit_early}
}

-- A finished run took no longer than its deadline allowed, give or take
-- however long the evaluator takes to notice. A bound that could be
-- exceeded without limit is not a bound.
invariant FinishedRunsRespectTheirDeadline {
    for run in ScriptRuns:
        run.conclusion = timed_out implies run.elapsed >= interpreter_limit_of(run)
}

-- An interpreter runs one script at a time. Concurrency comes from having
-- several interpreters, not from sharing one, because the value model has
-- no synchronisation in it and deliberately so.
invariant RunsDoNotOverlap {
    for run in ScriptRuns:
        run.status = running implies run.interpreter.active_runs.count = 1
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface Embedding {
    facing host: HostApplication

    provides:
        Run(host, interpreter, source_text)
        RunNext(host, interpreter, source_text)
        Cancel(host, interpreter)
        AskForExtensions(host, interpreter)
        CallCommand(command, arguments)
        ExtensionPosts(extension, interpreter, event)

    exposes:
        Conclusion
        Bounds
        HostService
        ServiceRefusal
        Extension
        ExtensionCommand
        HandleKind
        ExtensionReport
        FileInformation
        HostMachine
        WindowRequest
        ProgramInput
        ProgramOutput
        ProgramToStart
        ProgramResult
        FileChoiceRequest
        HttpPort
        HttpRequest
        HttpResponse

    @guarantee AStartedProgramArrivesSplitWithItsThreeStreamsDecided
        -- A command crosses the boundary already separated into the program
        -- and its arguments, so the host never splits a line and never
        -- applies quoting rules of its own. A script that wants the system's
        -- own rules asks for the shell, and then the single entry is a
        -- command line the shell reads.
        --
        -- Each of the child's three streams is decided separately. Its input
        -- comes from the host's own, from bytes the script supplied, from a
        -- file, or from nothing at all. Each of its two outputs goes to the
        -- host's own, back to the interpreter, into a file, or nowhere.
        --
        -- Two of those choices are quiet traps. Closing a child's input is
        -- not the same as leaving it on the host's, because the first reads
        -- end of input at once and the second waits for someone who may
        -- never type. And a system that refused to start the program at all
        -- is not a program that ran and failed, so what comes back
        -- distinguishes a message from the system from an exit code.

    @guarantee TheHostSaysWhatItKnowsAboutAFileAndNoMore
        -- Six facts cross the boundary about one file: its name, whether it
        -- is a directory, its size, and when it was created, last read and
        -- last changed. That is the whole of what QUERY can answer, so a
        -- port offering more would be offering something no script can ask
        -- for.
        --
        -- A fact the host has not got is none for that field alone and the
        -- rest of the answer stands. A host that knows a file's size and
        -- not when it was last read is an ordinary host.

    @guarantee AHostGrantsServicesOneAtATime
        -- A script can reach the file system, the environment, another
        -- program, the operator, the clock, the network and the screen.
        -- Each is a separate grant and none is given by default.
        --
        -- One kind at a time and not one function at a time, because a
        -- host that lets a script read a file almost always lets it read
        -- every file it can see. A grant per function reads as finer
        -- control and gives none: the host cannot say which file, only
        -- which verb, and the verb was never the interesting half.
        --
        -- A script that asks for a service it has not been granted gets
        -- an error that names the service and says which of three things
        -- happened: the host has it and did not grant it, the host has no
        -- such service, or nothing can offer it. The last covers the four
        -- that exist to call code written in C. A script cannot tell an
        -- empty answer from a refused one, thus none of them may answer
        -- with silence.
        --
        -- The working directory belongs to the interpreter. A host runs
        -- many interpreters at once and each must be able to sit in a
        -- different directory, so changing one must not move another.

    @guarantee RunNextStopsAfterOneExpression
        -- RunNext evaluates the first expression of the source and hands
        -- back both its conclusion and the source still unread, so a host
        -- can walk a script an expression at a time. Everything else about
        -- it is Run: the same bounds, the same conclusions, the same
        -- promise that nothing escapes as a host exception.
        --
        -- Needed because "the value of this source" and "the value of its
        -- first expression" are different questions, and only Run answered
        -- either. A console answers the first for a line; a test harness
        -- reading `--assert all [...] a: none` needs the second, because
        -- the assertion is the ALL and the rest is ordinary code that
        -- still has to run.
        --
        -- Three attempts to build this beside the interpreter rather than
        -- inside it each lost ground: REDUCE fails wholesale when a later
        -- expression does, and a hand-assembled evaluator did not carry
        -- the same bounds or fresh-word handling. The seam belongs here.

    @guarantee NoFailureEscapesAsAHostException
        -- Every way a script can stop arrives as a conclusion and a value,
        -- including timing out and nesting too deep. A host never has to
        -- catch a throwable to find out that a script misbehaved.

    @guarantee BoundsAreEnforcedNotAdvertised
        -- A script that passes its deadline is stopped. A script that nests
        -- past its limit is stopped. Neither depends on the script being
        -- willing to cooperate.

    @guarantee AnInterpreterIsOwnedByOneThread
        -- Handing one to two threads is a mistake JEBOL does not defend
        -- against and does not make safe. Run several instead.

    @guidance
        -- Cancellation is cooperative: the evaluator checks between steps
        -- rather than being interrupted where it stands. Stopping a thread
        -- mid-mutation would leave series half-changed, and series are
        -- shared, so the damage would outlive the script.
}

actor HostApplication {
    identified_by: Interpreter where active_runs.count >= 0
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "Does attaching a started program to the host's console differ observably from letting it inherit the host's streams, in a host that has no console? The C passes a flag and leaves the host to decide, so both readings are available: a console-less host could treat the request as ordinary inheritance, or it could refuse it and say the host has no console to attach to. The first keeps a script portable and gives the operator nothing; the second is honest and stops a script that would have worked. It matters for JEBOL because the common case is a server with no console at all, which is the opposite of the case the refinement was designed for."

open question "Does a file feeding a started program's input cross the boundary as a path for the host to open, or as bytes the interpreter read? The C passes the path and the host opens it, which is what this spec follows and why ProgramInput has four members rather than three. Reading it in the interpreter would leave the host with one way of being fed rather than two, at the cost of holding a whole file in memory and of the host losing the chance to stream it. Nothing a script can observe separates them, so this is a question about where the work sits rather than about behaviour."

open question "How often does the evaluator check whether it should stop? Every step is safest and slowest; every hundredth is cheaper and lets a tight loop overrun by a hundred steps. What is the right granularity, and should it be measured rather than guessed?"

open question "Is there a memory bound as well as a time bound? A script can allocate without nesting, so a depth limit does not stop it. Bounding heap per interpreter needs something the JVM does not offer directly."

open question "What does a host see of a script's progress while it runs? Nothing at all is simplest; a partial result or a progress callback would need the boundary to be crossed while the script is still running, which the one-thread rule forbids."

-- A host may let a script reach the network, and what that means is two
-- different things.
--
-- Naming and carrying. Asking what host a name stands for is a lookup and
-- costs one round trip; opening a connection and moving bytes over it is a
-- conversation that lasts. They are separated here because a host may
-- reasonably want the first without the second -- resolving a name leaks only
-- the name, while a connection can carry anything.
entity NetworkPort {
    resolves_names: boolean
    carries_connections: boolean
}

-- And a host may fetch for the script rather than carry the connection
-- itself.
--
-- The request crosses as the pieces a url and a port's spec already
-- carry: a method, headers, some content, and whether redirects are to be
-- followed. The answer comes back whole -- the status, the headers and
-- the body -- and the body is bytes, because what they mean is the
-- codec's business rather than the transport's. A host that fetches has
-- settled names, certificates and redirects by the time it answers; a
-- script cannot see those as separate steps and does not have to.
--
-- One service for both http and https, because a host that can fetch over
-- the secure transport fetches over both, and a script cannot tell the
-- transport from the answer.
entity HttpPort {
    answers_requests: boolean
    follows_redirects: boolean
}

-- What crosses the boundary when a script reads a url on a host that
-- fetches for it.
value HttpRequest {
    url: String
    method: String

    -- The headers, flat: a name, then its value, then the next name. Flat
    -- for the same reason a program's filters are: it is how a script
    -- writes them, and pairing them is a reading rather than a fact. Every
    -- entry is text by the time it crosses.
    header_names: List<String>
    header_values: List<String>

    content: List<Integer>?
    follows_redirects: Boolean
    timeout: Duration?
}

-- And what comes back. The body is bytes rather than text because the
-- decoding is the codec's business: a host that answered a string would
-- be choosing an encoding on behalf of a caller who may have asked for
-- binary.
value HttpResponse {
    status: Integer
    header_names: List<String>
    header_values: List<String>
    body: List<Integer>
}

-- === What a browser can offer ================================

-- A browser is a host worth naming, because the page it runs in can do
-- less than a machine and the difference is visible to scripts.
--
-- It has a console the page shows, files in a store of that site's own, the
-- clock, the screen it is drawn on, the clipboard, the instruments Web MIDI
-- reaches, HTTP through the browser's own fetching, and a working
-- directory, which is the interpreter's own and costs the page nothing,
-- since it lives inside the store the host already has. It has no raw connection, no way to start a
-- program and no environment it was launched with, because a page has none
-- of those. Nor does it have a list of authorities to judge a certificate
-- against: the browser judges every certificate itself, inside fetch, and a
-- page is never shown one.
--
-- So a browser's bounds mark those four unavailable and may grant any of the
-- others. Asking for an unavailable one is refused not_present with the browser named,
-- which is a different answer from the same script on a machine where the
-- operator simply did not grant it. The four are refused before anything is
-- attempted, so a script cannot learn whether a host exists by timing a name
-- lookup it was never allowed to make.
rule ABrowserOffersWhatItsPageCan {
    when: interpreter: Interpreter.created

    ensures: interpreter.bounds.unavailable_services =
        {network, processes, environment, certificates}
    ensures: interpreter.bounds.host_name = "a browser"
}

-- The page JEBOL ships grants everything a page has. The clock among them:
-- the boot reads the time to set up the system object whatever is granted,
-- so withholding it from the script protected nothing and made NOW refuse.
rule TheShippedPageGrantsEverythingAPageHas {
    when: interpreter: Interpreter.created
    requires: the_host_is_the_shipped_page(interpreter)

    ensures: interpreter.bounds.granted_services =
        {console, files, working_directory, clock, windows, clipboard, midi, web}
}

-- And what it does have it may still choose not to grant. The web service
-- is the one a page cannot do without: without it there is no HTTP at
-- all, because a page has no other way to fetch.
rule ABrowserWithTheWebServiceAnswersHttpItself {
    when: script_reads_an_http_url(run, url)
    requires: run.interpreter.http != null
    requires: web in run.interpreter.bounds.granted_services

    let request = an_http_request_for(url)
    let answer = the_answer_the_host_gave()

    ensures: the_request_crosses_as(request)
    ensures: the_answer_that_crossed_back_is(answer)
    ensures: if the_host_reached_it():
        CallResult(value: the_body_it_brought_back())
    ensures: if the_host_could_not_reach_it():
        CallFails(error: cannot_connect)
}

-- === Trusting a server ========================================

-- A real 3.22.5 trusts every server. It decodes the certificates a server
-- sends and never asks who signed them, whether they are still in date, or
-- whose name they carry, so an expired certificate, a self-signed one, one
-- for another host and one from an authority nobody trusts all read as
-- though nothing were wrong. A connection that anyone between the two ends
-- can read and rewrite is what that buys, and on a phone, where the app's
-- traffic is JEBOL's own TLS rather than a browser's, that is every
-- connection the app makes. This is the one place JEBOL deliberately
-- answers differently from the C.
--
-- Two questions decide trust, and they belong to different owners. Whether
-- the chain leads to an authority worth trusting is the host's, because the
-- list of authorities is the host's: a JVM's own store, a phone's, or one a
-- company issues. Whether the certificate names the server the script
-- asked for is the domain's, because the answer is the same on every host
-- and a host that got it wrong would be wrong silently.

-- Why a server is not trusted. The script sees which one, so an operator
-- can tell a clock that is wrong from a server that is.
enum CertificateMistrust {
    expired               -- a certificate in the chain is past its end
    | not_yet_valid       -- a certificate in the chain has not begun yet
    | unknown_authority   -- the chain leads to no authority the host trusts;
                          -- a self-signed certificate is the shortest case
    | broken_chain        -- a certificate does not sign the one before it,
                          -- or cannot be read as a certificate at all
    | no_certificate      -- the server sent none
    | wrong_host          -- the chain is trusted and names another server
}

-- What a host's authority knows about one chain: whether it is trusted,
-- and the names the first certificate in it vouches for. The names come
-- back with the verdict because reading them needs the same certificate
-- parsing the judgement does, and a host already has that.
--
-- Judged at the moment the handshake reaches it, by the host's own clock.
entity CertificateAuthority {
    judges: ChainVerdict
}

value ChainVerdict {
    trusted: Boolean
    mistrust: CertificateMistrust when not trusted
    -- The leaf's subject alternative names, as the certificate writes them.
    dns_names: Set<String> when trusted
    ip_addresses: Set<String> when trusted
}

-- Opening a secure connection asks for the service before a byte is sent,
-- so a script without the grant learns that from the open itself, as a
-- refusal naming the service. Asked any later and the refusal would arrive
-- inside the handshake, where HTTP reports every failure as one it could
-- not connect, and the reason would be lost.
--
-- Only a client asks. A server listening for connections is sent no
-- certificate to judge.
rule ASecureConnectionAsksForTheService {
    when: script_opens_a_secure_connection(run, host)
    requires: host != null
    ensures: script_asks_for(run, certificates)
}

-- Two owners decide trust. The chain is judged in the order the server sent
-- it, first certificate first. Each certificate must be issued by the one after
-- it, or the chain is broken before any authority is asked about it. Whether
-- the chain leads to an authority worth trusting is the host's, because the
-- list of authorities is the host's; whether the certificate names the server
-- the script asked for is the domain's.
--
-- The chain ends at the first certificate carrying the name and key of a
-- root the host trusts, whatever follows it and whoever signed that copy.
-- Servers still send an old copy of a trusted root signed by a root since
-- retired, and a browser stops at the root it trusts; judging past it would
-- blame the retired root for a certificate that is, say, merely expired.
--
-- A host that supplied no authority has one that trusts nothing, so every
-- chain is unknown_authority.
rule AuthorityAndNameDecideWhetherToTrust {
    when: server_sends_its_certificates(run, host, chain)
    requires: certificates in run.interpreter.bounds.granted_services
    requires: chain.count > 0
    let verdict = run.interpreter.certificate_authority.judge(chain)
    ensures: if not verdict.trusted:
        TheHandshakeEnds(run: run, mistrust: verdict.mistrust)
    ensures: if verdict.trusted and not names_cover(verdict, host):
        TheHandshakeEnds(run: run, mistrust: wrong_host)
}

-- Where the authorities come from is the host's to choose, and the command
-- line's host chooses the machine it runs on: the runtime's own store and the
-- store the operating system keeps. macOS keeps them in its keychain, Windows
-- in its own root store, and a Linux system in a bundle on disk. A company
-- that reads traffic installs its authority where the machine already looks,
-- so a browser and this interpreter trust the same servers.
--
-- The list widens and no verdict changes. A certificate that is expired, signs
-- itself, names another host, or leads to an authority the machine does not
-- trust still ends the handshake.
rule AServerTheMachineTrustsIsTrusted {
    when: server_sends_its_certificates(run, host, chain)
    requires: the_command_lines_host_is_running(run)
    requires: the_machines_authorities_vouch_for(chain)
    ensures: run.interpreter.certificate_authority.judge(chain).trusted
}

-- An authority supplied when the command line starts is trusted beside the
-- machine's, not instead of them. It is how a container or a build host with
-- no readable system store is given one, and how a test puts a local server on
-- the same footing as a public one.
rule ASuppliedAuthorityIsTrusted {
    when: server_sends_its_certificates(run, host, chain)
    requires: the_command_lines_host_is_running(run)
    requires: the_supplied_authorities_vouch_for(chain)
    ensures: run.interpreter.certificate_authority.judge(chain).trusted
}

rule NoCertificateIsNoTrust {
    when: server_sends_its_certificates(run, host, chain)
    requires: chain.count = 0
    ensures: TheHandshakeEnds(run: run, mistrust: no_certificate)
}

-- A handshake that ends this way sends nothing further; no request is
-- written, so nothing the script meant for the server reaches whoever
-- answered in its place. The TLS port's error is an access error, id
-- protocol, and says the reason in words and the host it was about. HTTP
-- reports it as it reports every handshake that fails -- could not connect,
-- with the url -- which is what a real 3.22.5 does for a failed handshake
-- too.
rule AMistrustedServerEndsTheHandshake {
    when: TheHandshakeEnds(run, mistrust)
    ensures: no_request_was_written(run)
    ensures: CallFails(error: protocol, about: mistrust)
}

-- Which names a certificate vouches for. Only the subject alternative
-- names count; the subject's common name is never read, as no browser has
-- read it since 2017, because two places to put a name is one more than a
-- check can be sure it looked in.
--
-- A name is compared without regard to letter case and with one trailing
-- dot ignored on either side, since `Example.COM.` and `example.com` are
-- the same server.
--
-- A wildcard stands only as the whole of the leftmost label, and stands
-- for exactly one label that is not empty: `*.example.com` covers
-- `www.example.com` and not `example.com` or `a.b.example.com`. Anything
-- else with a star in it -- `w*.example.com`, `*.*.example.com`,
-- `www.*.com` -- covers nothing. Nor does a wildcard with fewer than two
-- labels after it, `*.com` or a bare `*`, since that would vouch for a
-- whole top-level domain.
--
-- A host written as an address is matched only against the addresses the
-- certificate names, compared as addresses, and never against a name or a
-- wildcard.
rule TheNamesCoverTheHost {
    when: names_cover(verdict, host)
    ensures: if host.is_an_address:
        host in verdict.ip_addresses
    else:
        verdict.dns_names.any(name => name_covers(name, host))
}

-- The signature the server makes over the handshake proves it holds the
-- key its first certificate is for. Without that check the chain proves
-- nothing, because a chain is public: anyone can send a real server's
-- certificates. A real 3.22.5 checks the TLS 1.3 signature only for one RSA
-- scheme and logs a failure instead of stopping, and its TLS 1.2 elliptic
-- curve check never records its own answer, so every such server fails.
--
-- Every scheme the client can check is checked, and a signature that does
-- not verify ends the handshake. A scheme it cannot check ends it too --
-- one it never offered, or Ed25519, which it offers and has no native to
-- verify -- because a signature nobody checked proves nothing.
rule TheServerProvesItHoldsTheKey {
    when: server_signs_the_handshake(run, scheme, signature)
    ensures: if not scheme in the_schemes_the_client_can_check(run)
        or not signature_verifies(run, scheme, signature):
        CallFails(error: protocol, about: signature)
    ensures: if not scheme in the_schemes_the_client_can_check(run)
        or not signature_verifies(run, scheme, signature):
        no_request_was_written(run)
}

open question "Revocation is not checked. A browser asks an authority whether a certificate has been withdrawn, or reads a list it was stapled, and fails open when it cannot find out; JEBOL does neither. Is a withdrawn certificate worth a network round trip per handshake, and which way should it fail?"

open question "A server that sends its chain out of order is broken_chain here, and one that leaves out an intermediate authority a browser would fetch from the address the certificate names is unknown_authority. Browsers repair both. Is that repair JEBOL's to make?"

open question "A host name in Unicode is compared as written. A certificate names such a host in its ASCII form, so the two never match until the url is converted first. Where should that conversion live?"
