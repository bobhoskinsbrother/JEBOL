-- allium: 3
--
-- JEBOL: what an Android app does with the screen, the operator's hands and
-- the life Android gives it.
--
-- Scope: the app's one view, which is the screen every window is painted on;
-- one finger as the pointer; the soft keyboard; Back; and what Android does to
-- the app -- turning the device, sending it to the background, ending its
-- process -- as a script hears them. And printing, which on a phone reaches a
-- person only through the log. And the ports Android gives a script: its
-- files, its environment, pictures, the clipboard, the network and TLS, and
-- what it may not have (decision 77).
--
-- Excludes:
--   - Files the user chooses through Android's picker. They are goal 2c2's.
--   - Gestures with more than one finger. A second finger is ignored here;
--     goal 2d may give them a meaning, in the GUI's REBOL.
--   - What a window looks like. The paint list is screen.allium's and the
--     view executes it as the desktop and the page do (decision 35).
--
-- Dependencies: OneSurfaceScreen, ScreenWindow and the screen events in
-- screen.allium; the history, Back and the unsaved-work flag in nav.allium.
--
-- A phone is a page and not a desktop: one surface the platform owns, every
-- window painted on it, so the app's screen is the core's OneSurfaceScreen with
-- Android's viewer and Android's history behind it (decision 75).

------------------------------------------------------------
-- Entities
------------------------------------------------------------

-- The app's one view, filling its activity.
entity AppView {
    width_in_pixels: Integer
    height_in_pixels: Integer
    density: Decimal                 -- the display's pixels per dp, 1 at 160 dpi
    finger_down: Boolean             -- whether the finger that is the pointer is on the glass
    keyboard_raised: Boolean
    painting: Boolean                -- false while the app is in the background
}

-- A view in the background paints nothing, and a keyboard is never raised
-- over a view nobody can see.
invariant AViewInTheBackgroundShowsNothing {
    for view in AppView:
        not view.painting implies not view.keyboard_raised
}

-- What the app keeps so a process Android ended can come back where it was.
entity SavedPlace {
    address: String                  -- the current place's address when it was saved
}

------------------------------------------------------------
-- Sizes
------------------------------------------------------------

-- A size a script sees is in dp: the view's pixels divided by the display's
-- density, so a window is the same size to the eye on any phone. The
-- viewport is the view's size in dp, and the screen's dpi is 160 times the
-- density, which is what dp means.
rule TheViewportIsTheViewInDp {
    when: the_view_changes_size(view)

    ensures: the_viewport_is(view.width_in_pixels / view.density, view.height_in_pixels / view.density)
    ensures: screen_dpi = 160 * view.density
}

-- The view paints in pixels: every command is scaled by the density before
-- it is executed, and nothing else changes on the way.
rule TheViewScalesThePaintListByTheDensity {
    when: the_view_paints(view, painting)

    ensures: each_command_is_executed_scaled_by(painting, view.density)
}

------------------------------------------------------------
-- Touch
------------------------------------------------------------

-- One finger is the pointer. Its touching the glass is a press, its moving a
-- move, its lifting a release, each at its position in dp.
rule OneFingerIsThePointer {
    when: a_finger_touches(view, position_in_pixels)
    requires: not view.finger_down

    ensures: view.finger_down = true
    ensures: the_screen_hears(down, position_in_pixels / view.density)
}

rule TheFingerMovingIsAMove {
    when: the_pointer_finger_moves(view, position_in_pixels)
    requires: view.finger_down

    ensures: the_screen_hears(move, position_in_pixels / view.density)
}

rule TheFingerLiftingIsARelease {
    when: the_pointer_finger_lifts(view, position_in_pixels)
    requires: view.finger_down

    ensures: view.finger_down = false
    ensures: the_screen_hears(up, position_in_pixels / view.density)
}

-- A second finger is ignored until the first lifts.
rule ASecondFingerIsIgnored {
    when: another_finger_touches(view)
    requires: view.finger_down

    ensures: the_screen_hears_nothing()
}

------------------------------------------------------------
-- The keyboard
------------------------------------------------------------

-- A field taking the typing raises the soft keyboard, and its releasing the
-- typing lowers it.
rule TakingTheTypingRaisesTheKeyboard {
    when: the_screen_takes_typing(view)

    ensures: view.keyboard_raised = true
}

rule ReleasingTheTypingLowersTheKeyboard {
    when: the_screen_releases_typing(view)

    ensures: view.keyboard_raised = false
}

-- Text the keyboard commits is one key event per code point, in order. A
-- keyboard commits a word at a time, and a script reads keys one at a time.
rule CommittedTextIsOneKeyPerCodePoint {
    when: the_keyboard_commits(view, text)

    ensures: for code_point in text: the_screen_hears(key, code_point)
}

-- Delete is the key 8, backspace, and the keyboard's action key is 13,
-- return, as a desktop keyboard sends them.
rule DeleteIsBackspace {
    when: the_keyboard_deletes_before_the_cursor(view)

    ensures: the_screen_hears(key, 8)
}

rule TheActionKeyIsReturn {
    when: the_keyboard_sends_its_action(view)

    ensures: the_screen_hears(key, 13)
}

-- The arrow keys a keyboard sends are control events named as the desktop
-- names them.
rule AnArrowIsNamedAsTheDesktopNamesIt {
    when: the_keyboard_sends_an_arrow(view, arrow)

    ensures: the_screen_hears(control, the_desktops_name_for(arrow))
}

------------------------------------------------------------
-- Back
------------------------------------------------------------

-- Back is the history's Back (nav.allium). The app takes it -- Android does
-- not -- while the history has a place behind the current one, or while
-- unsaved work is flagged.
rule TheAppTakesBackWhileItHasSomewhereToGo {
    when: the_history_or_the_unsaved_work_flag_changes(history)

    ensures: the_app_takes_back = (history.has_a_place_behind or history.unsaved_work)
}

rule BackMovesTheHistory {
    when: the_operator_goes_back(history)
    requires: history.has_a_place_behind

    ensures: the_history_goes_back()
}

-- At the first place Back leaves the app. With unsaved work flagged it asks
-- first, with the app's own dialog, and staying is the answer to Cancel.
rule BackAtTheFirstPlaceLeaves {
    when: the_operator_goes_back(history)
    requires: not history.has_a_place_behind
    requires: not history.unsaved_work

    ensures: the_app_leaves()
}

rule BackWithUnsavedWorkAsksFirst {
    when: the_operator_goes_back(history)
    requires: not history.has_a_place_behind
    requires: history.unsaved_work

    ensures: the_app_asks_whether_to_leave()
}

rule CancelStays {
    when: the_operator_cancels_leaving()

    ensures: the_app_stays()
}

------------------------------------------------------------
-- How a script ends
------------------------------------------------------------

-- QUIT leaves the app, as it ends the command line's process. Nothing is
-- logged as an error for it, whatever it carries: the command line turns
-- what QUIT carries into its exit code, and an app has no exit code to give.
rule AQuitLeavesTheApp {
    when: the_script_ends(outcome)
    requires: outcome.conclusion = quit_early

    ensures: the_app_leaves()
    ensures: nothing_is_logged_as_an_error()
}

-- A script that runs to its end leaves its windows showing, as the command
-- line's window stays until it is closed. Only an error is logged as one.
rule AScriptThatEndsLeavesItsScreen {
    when: the_script_ends(outcome)
    requires: outcome.conclusion = produced_value

    ensures: the_app_stays()
    ensures: nothing_is_logged_as_an_error()
}

-- The app ending its own interpreter, as it does when it is closed, is not
-- the script's error either.
rule ACancelIsNotAnError {
    when: the_script_ends(outcome)
    requires: outcome.conclusion = cancelled

    ensures: nothing_is_logged_as_an_error()
}

------------------------------------------------------------
-- The life Android gives the app
------------------------------------------------------------

-- Turning the device is a resize: the activity is not made again, the
-- view's new size is measured into the screen, a maximised window refits as
-- a resized page's does, and the script hears resize.
rule ARotationIsAResize {
    when: the_device_turns(view)

    ensures: the_activity_is_kept()
    ensures: the_view_changes_size(view)
    ensures: for window in open_windows: the_script_hears(resize, window)
}

-- Going to the background is minimize on every open window, and the view
-- stops painting; coming back is restore on each, and a repaint. R3's own
-- hosts send the same two events (decision 72).
rule TheBackgroundIsMinimize {
    when: the_app_stops(view)

    ensures: view.painting = false
    ensures: view.keyboard_raised = false
    ensures: for window in open_windows: the_script_hears(minimize, window)
}

rule ComingBackIsRestore {
    when: the_app_starts_again(view)

    ensures: view.painting = true
    ensures: for window in open_windows: the_script_hears(restore, window)
    ensures: the_view_repaints(view)
}

-- Android may end the process with no warning, and the script hears nothing:
-- there is nothing left to hear it with. The current place's address is kept
-- whenever Android asks the app to save its state, and a relaunch after the
-- process was ended starts the app afresh at that place, as a reloaded page
-- starts at its address (nav.allium).
rule ThePlaceIsSavedWhenAndroidAsks {
    when: android_asks_the_app_to_save_its_state()

    ensures: SavedPlace.created(address: the_current_places_address())
}

rule ARelaunchResumesAtTheSavedPlace {
    when: the_app_is_launched_after_its_process_was_ended(saved)

    ensures: the_history_starts_at(saved.address)
}

------------------------------------------------------------
-- Printing
------------------------------------------------------------

-- What a script prints is one logcat line per finished line, under the tag
-- jebol: info, or error while error output is on. A part line is held until
-- it ends, which is the shape decision 64 gives a site's console.
rule AFinishedLineIsOneLogLine {
    when: the_script_prints_up_to_a_line_end(text)

    ensures: one_log_line(tag: "jebol", priority: the_priority_for_the_output_now(), text: held_text_and(text))
}

rule APartLineIsHeld {
    when: the_script_prints_without_a_line_end(text)

    ensures: the_text_is_held(text)
}

------------------------------------------------------------
-- A script given at launch
------------------------------------------------------------

-- A debug build runs a script given in its launch intent, under the extra
-- named script, instead of the app it carries, so a test can start the app on
-- a few lines of its own. A release build ignores the extra.
rule ADebugBuildRunsTheScriptItIsGiven {
    when: the_app_is_launched_with_a_script(script)
    requires: is_a_debug_build()

    ensures: the_app_runs(script)
}

-- A debug build restarts in place when it is sent an intent marked restart
-- while it is in front, so a test class pays for one launch and not one a
-- test. The process, ART's compiled classes and the view are kept; nothing a
-- script made is. The running interpreter is cancelled and its thread is
-- waited for; the screen is cleared of every window; the history is emptied,
-- Back given back to Android and the unsaved-work flag dropped; a dialog the
-- app shows is dismissed and the keyboard lowered. Then one line, restarted
-- and a count, is printed under jebol, and a fresh interpreter runs the
-- script the intent carries, or the app the build carries without one. A
-- test reads only what was printed after the latest such line.
rule ADebugBuildRestartsInPlace {
    when: the_app_is_sent_a_restart(script)
    requires: is_a_debug_build()

    ensures: the_running_interpreter_is_cancelled_and_has_ended()
    ensures: no_window_is_shown()
    ensures: the_history_is_empty()
    ensures: not the_app_takes_back
    ensures: not unsaved_work
    ensures: no_dialog_is_shown()
    ensures: for view in AppView: not view.keyboard_raised
    ensures: one_log_line(tag: "jebol", priority: info, text: "restarted " + restarts_so_far)
    ensures: the_app_runs(script)
}

-- A release build ignores both: a launch runs the app it carries, and an
-- intent marked restart, or carrying a script, changes nothing it is running.
rule AReleaseBuildRunsOnlyItsOwnApp {
    when: the_app_is_launched_with_a_script(script)
    requires: not is_a_debug_build()

    ensures: the_app_runs_the_app_it_carries()
}

rule AReleaseBuildIgnoresARestart {
    when: the_app_is_sent_a_restart(script)
    requires: not is_a_debug_build()

    ensures: the_app_keeps_running_what_it_runs()
}

------------------------------------------------------------
-- The ports (goal 2c, decision 77)
------------------------------------------------------------

-- The app's store is a folder in its own private storage, which no other app
-- reads and which outlives the process: a file a script writes is there when
-- Android has ended the app and it is launched again.
rule TheStoreIsPrivateAndOutlivesTheProcess {
    when: the_script_writes(path, contents)

    ensures: the_store_holds(path, contents)
    ensures: the_store_is_in(app_private_storage)
    ensures: after_the_process_ends_and_the_app_relaunches(the_store_holds(path, contents))
}

-- The store's root is the script's root, and home is that root, by decision
-- 69's rule: system/options/home is %/ and get-env "HOME" agrees with it.
rule HomeIsTheRoot {
    when: the_app_starts()

    ensures: system_options_home = "/"
    ensures: environment_value("HOME") = "/"
}

-- The APK's carried files read beneath the store: a read finds the store's
-- file first and the carried one after it; a write lands in the store, so a
-- script's own file shadows a carried one of the same name; a directory lists
-- both, each name once; and deleting or renaming a carried file is refused,
-- since the APK cannot be changed. Nothing is copied out of the APK.
rule TheStoreReadsBeforeTheCarriedFiles {
    when: the_script_reads(path)

    ensures: answer = store_file_or_else_carried_file(path)
}

rule AWriteLandsInTheStore {
    when: the_script_writes(path, contents)

    ensures: the_store_holds(path, contents)
    ensures: the_carried_file_is_unchanged(path)
}

rule ADirectoryListsBoth {
    when: the_script_lists(directory)

    ensures: answer = names_in_either_once(store_names(directory), carried_names(directory))
}

rule ACarriedFileCannotBeDeleted {
    when: the_script_deletes(path)
    requires: carried_has(path) and not store_has(path)

    ensures: refused_as(access, "read-only")
}

-- The environment is a standard desktop's, wrapped to the app's own places,
-- and none of the device's own variables ever reach a script.
-- HOME and PWD are the root; TMPDIR is /tmp, a folder in the store that the
-- app empties as it starts; LANG is the device's locale as en_GB.UTF-8; USER
-- and LOGNAME are the app's identifier; SHELL and PATH are absent, since
-- nothing can be started. A set-env is the script's own and lasts as long as
-- the process.
rule TheEnvironmentIsTheAppsOwn {
    when: the_app_starts()

    ensures: environment_names = {"HOME", "PWD", "TMPDIR", "LANG", "USER", "LOGNAME"}
    ensures: environment_value("USER") = application_id
    ensures: environment_value("LOGNAME") = application_id
    ensures: environment_value("TMPDIR") = "/tmp"
    ensures: environment_value("LANG") = device_locale_as_posix() + ".UTF-8"
}

-- A picture decodes from PNG, JPEG, GIF, BMP, WebP and HEIF, and encodes to
-- PNG, JPEG, WebP, BMP and GIF. Any other format is one the codec has not got,
-- and is refused as the desktop refuses one. GIF, both ways, is the core's own
-- codec, so a frame is the same picture on every platform: the frames before
-- it composed by their disposal methods (GIF89a), and a picture of more than
-- 256 colours quantised by median cut with Floyd-Steinberg dithering.
rule APictureDecodesInTheFormatsAndroidReads {
    when: the_script_loads_a_picture(bytes, format)
    requires: format in {png, jpeg, gif, bmp, webp, heif}

    ensures: answer = image_of(bytes)
}

rule APictureEncodesInTheFormatsAndroidWrites {
    when: the_script_saves_a_picture(image, format)
    requires: format in {png, jpeg, webp, bmp, gif}

    ensures: decoding(answer) = image_within_the_loss_of(format)
}

rule AnotherPictureFormatIsRefused {
    when: the_script_saves_a_picture(image, format)
    requires: format not in {png, jpeg, webp, bmp, gif}

    ensures: refused_as_a_format_the_codec_has_not_got(format)
}

-- Android gives the clipboard only to the app in front. Read from the
-- background, it answers none, as an empty clipboard does; a write from the
-- background changes nothing.
rule TheClipboardInTheBackgroundIsNone {
    when: the_script_reads_the_clipboard()
    requires: not the_app_is_in_front()

    ensures: answer = none
}

-- Nothing can be started: CALL and RUN refuse by the name a page's do, and
-- system/options/boot is none (embed.allium, RefusedServiceRaises).
rule CallRefusesAsAPagesDoes {
    when: the_script_calls_a_program(command)

    ensures: refused_as_unavailable(processes, "an Android app")
    ensures: system_options_boot = none
}

-- A tcp:// and a tls:// connection reach a server as on the desktop. A host
-- name in Unicode is turned to ASCII by Android's own IDNA, UTS #46 without
-- transitional processing.
rule ASocketReachesAServer {
    when: the_script_opens(scheme, host, port)
    requires: scheme in {tcp, tls}

    ensures: a_connection_to(ascii_host_name(host), port)
}

-- Plain http is refused where Android's network security policy refuses it,
-- before anything is sent: since API 28 that is every host, unless the
-- app's configuration names it. The debug build names 10.0.2.2 and localhost;
-- a release build names none. An https:// is not asked, and nor is a tcp://
-- a script opens itself, since Android restricts HTTP, not sockets.
rule PlainHttpIsRefusedWhereAndroidsPolicyRefusesIt {
    when: the_script_opens(http, host, port)
    requires: not cleartext_permitted(host)

    ensures: refused_as(access, "no-connect", host, "Android's network security policy refuses cleartext traffic")
}

-- The certificates trusted are the system's; a debug build adds those the
-- user installed, so a developer can watch the app's HTTPS through a proxy.
rule TheTrustIsTheSystems {
    when: the_script_opens(tls, host, port)

    ensures: the_chain_is_checked_against(the_roots_this_build_trusts())
}

-- An app's heap is far smaller than a desktop's, and a process that runs out
-- of it is ended by Android. So the app's bounds hold a ceiling below the
-- heap, from the device's memory class, and a script that grows past it gets
-- REBOL's own no-memory error while the app lives on.
rule AScriptPastTheCeilingGetsNoMemory {
    when: the_script_holds_more_than(memory_ceiling)

    ensures: raised(internal, "no-memory")
    ensures: the_app_is_still_running()
}
