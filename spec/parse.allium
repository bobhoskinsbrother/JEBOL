-- allium: 3
--
-- JEBOL: the PARSE dialect.
--
-- PARSE walks a series against a rule block and answers whether the whole
-- of the series matched. It is a second little language living inside the
-- first, with its own vocabulary, and almost nothing about the evaluator
-- carries over: a word in a rule is a rule, not a lookup, and an integer
-- is a count, not a value.
--
-- This module exists because it did not, and the cost was visible. The
-- parse corpus was written from REBOL/Core documentation, which describes
-- REBOL 2, and nine of its thirty entries were wrong in ways nothing
-- checked. Every claim below was run against a real R3 (3.22.1) rather
-- than read.

use "./values.allium" as values

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

-- The words PARSE reserves. A word in a rule block that is not one of
-- these is looked up, and what it holds is used as a rule.
enum ParseKeyword {
    any             -- the rule that follows, zero or more times
    | some          -- the rule that follows, one or more times
    | opt           -- the rule that follows, zero or one time
    | to            -- advance to just before the rule matches
    | thru          -- advance to just past where the rule matches
    | end           -- matches only at the tail
    | skip          -- consume one item without looking at it
    | into          -- descend into the block at this position
    | set           -- put what the next rule matched into a word
    | copy          -- put everything the next rule matched into a word
    | collect       -- gather what the rules below KEEP, and answer that
    | keep          -- add what the next rule matched to the collection
    | ahead         -- match the next rule without consuming it
    | not           -- succeed where the next rule fails, consuming nothing
    | reject        -- fail the current block at once, trying no alternative
    | return        -- end the parse at once and answer a value
    | then          -- match nothing and succeed, letting the next rule run
    | remove        -- take what the next rule matched out of the input
    | change        -- replace what the next rule matched with a value
    | insert        -- put a value in at the position, consuming nothing
    | case          -- mind case from here on
    | no_case       -- fold case from here on
    | fail          -- match nothing ever, sending the walk to the next branch
    | limit         -- reserved for future use, and raises until it exists
}

-- How a parse attempt finished.
enum ParseOutcome {
    matched         -- the rule matched and the input is used up
    | unmatched     -- the rule did not match, or input was left over
    | collected     -- COLLECT gathered what KEEP matched, and that is the answer
    | raised        -- the rule block is malformed
}

-- Why a rule block is malformed.
enum ParseFailure {
    parse_end       -- a repeat count with no rule after it to repeat
    | expect_arg    -- the input or rule argument is the wrong datatype
    | no_refine     -- a refinement PARSE no longer has
    | not_done      -- a reserved keyword that is not yet implemented (LIMIT)
    | parse_rule    -- a rule item that is no rule at all: a command word
                    -- after TO or THRU, an unset, or a function
    | no_value      -- a CHANGE or INSERT whose word replacement holds nothing
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

-- One call to PARSE.
entity ParseAttempt {
    input: values/Value
    rule: values/Value

    -- Where the walk has reached, as an index into the input.
    position: Integer

    -- True once no rule remains to apply.
    rule_exhausted: Boolean

    -- The count in front of the rule being applied, when one was written.
    active_count: RepeatCount?

    -- True when position has reached the tail of the input.
    input_exhausted: Boolean

    -- How many KEEP rules have run, whether or not the rule they sit in
    -- went on to match. Counted rather than derived, because what makes
    -- it interesting is exactly that it does not follow from the
    -- matching: see CollectingIsNotUndoneByBacktracking.
    keeps_attempted: Integer

    -- How many values the collection holds. Never less than the number
    -- of KEEPs that ran, because nothing is taken back out.
    collected_count: Integer

    status: ParseOutcome?
    failure: ParseFailure?

    invariant FailureAccompaniesRaised {
        status = raised implies failure != null
    }

    -- A count is always a count of something. Reaching the end of the
    -- rule block with one still outstanding is the parse_end failure.
    invariant ACountAlwaysHasARuleToApplyTo {
        active_count != null implies rule_exhausted = false
    }

    @guarantee TheDialectDoesNotDependOnTheInputType
        -- Every keyword means the same thing over a string as over a
        -- block. What changes is only what a rule matches against: a
        -- string rule matches a run of characters and a block rule
        -- matches one item. The counts, SET, COPY, COLLECT, KEEP, the
        -- alternatives and the backtracking are the same dialect either
        -- way.
        --
        -- Worth stating because it is the kind of thing an implementation
        -- quietly gets wrong. Matching a string and matching a block want
        -- different code, and once they are two walks nothing forces the
        -- second to keep up with the first. JEBOL's string walk had no
        -- counts, no SET, no COPY, no COLLECT and no KEEP, and nothing
        -- asked why `parse "ab" [2 skip]` was false while
        -- `parse [a b] [2 skip]` was true.
        --
        -- What a KEEP puts in the collection follows the input: one item
        -- of a block is that item, one character of a string is a
        -- character, and a run of characters is a slice keeping the
        -- input's own datatype. Collecting from a file gives file pieces,
        -- not string pieces.
}

-- A repeat count written in front of a rule. One integer means exactly
-- that many; two mean a range.
value RepeatCount {
    minimum: Integer
    maximum: Integer

    invariant RangeIsOrdered {
        minimum <= maximum
    }
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- === What counts as success ================================

-- The single thing most often got wrong about PARSE: matching the rule is
-- not enough. Input left over is a failure, which is why
-- `parse [1] []` is false while `parse [] []` is true. An empty rule
-- block matches nothing, and matching nothing only uses up an input that
-- was already empty.
rule ParseSucceedsOnlyWhenInputIsUsedUp {
    when: attempt: ParseAttempt.rule_exhausted
    requires: attempt.status = null

    ensures:
        if attempt.input_exhausted:
            attempt.status = matched
        else:
            attempt.status = unmatched
}

-- === An integer is a count, never a value ==================

-- In the evaluator an integer is a value. In a rule block it is the
-- number of times to apply whatever comes next, and there is no way to
-- write "match the integer 1" by writing 1. This is the difference that
-- made nine corpus entries wrong: `[any 1]` reads as "ANY, repeated once"
-- with no rule left to repeat, so it raises rather than matching a block
-- of ones.
--
-- One integer is an exact count. Two are a range, inclusive at both ends,
-- so `[2 3 integer!]` matches two or three of them. A count of zero
-- matches nothing at all, which succeeds, and then the leftover input
-- decides the parse.
rule RepeatCountNeedsARuleToRepeat {
    when: attempt: ParseAttempt.count_read
    requires: attempt.status = null

    ensures:
        if attempt.rule_exhausted:
            attempt.status = raised
            attempt.failure = parse_end
        else:
            attempt.status = null
}

-- === How many times ========================================

-- ANY, SOME and OPT are the three counts with names. ANY is zero or more,
-- so it matches against empty input. SOME is one or more, so it does not.
-- OPT is zero or one, and always matches.
rule NamedCountsDifferOnlyInTheirMinimum {
    when: attempt: ParseAttempt.keyword_read
    requires: attempt.status = null

    ensures:
        if attempt.rule_exhausted:
            attempt.status = raised
            attempt.failure = parse_end
        else:
            attempt.status = null
}

-- === What counts as getting somewhere ====================

-- ANY and SOME stop when a round gets nowhere, or they would never
-- finish. The question is what "nowhere" means, and consuming input is
-- not the whole of it: REMOVE takes what it matched out and leaves the
-- position where it was, so a round that removed something has advanced
-- through the input without the position moving at all.
--
-- `parse "aa" [some [remove "a"]]` is true and leaves the input empty.
-- Reading progress as "the position moved" makes that false after one
-- round, because the position is where it started and the walk decides
-- it is looping.
--
-- So a round gets somewhere when the position moved OR the input got
-- shorter. A round that does neither ends the repeat, which is what
-- keeps `parse "" [some [remove "a"]]` from running forever -- it is
-- false, because SOME needs one round and no round succeeded.
--
-- The guard belongs to the open-ended repeats alone. A counted rule is
-- bounded by the count, so it cannot loop for ever and does not need
-- protecting; applying the guard there stops it early instead.
-- Confirmed against a real R3: `parse [1 2] [collect 2 [collect []
-- (x: x + 1) keep (x)]]` runs both rounds and gives [[] 1 [] 2], even
-- though the first round consumes nothing at all. With the guard it
-- stops after one and gives [[] 1].
-- A round that matched but got nowhere is COUNTED before the repeat stops.
-- The guard ends the loop; it does not disown the round that triggered it.
--
-- The C's order is `count++` and then the no-progress break, and the order is
-- the whole of the difference. `parse "" [some [(a: true)]]` succeeds: the
-- round matched, so SOME has its one round, and only then does the walk
-- notice nothing moved and stop. Breaking first makes the same rule fail,
-- because SOME needs one round and would have counted none.
--
-- This does not weaken the loop guard. A round that FAILS still ends the
-- repeat without counting, so `parse "" [some [remove "a"]]` is still false:
-- the removal never matched, no round counted, and SOME went unsatisfied.
-- What changed is only the round that succeeded and stood still.
rule ARepeatStopsWhenARoundChangesNothing {
    when: attempt: ParseAttempt.round_finished
    requires: attempt.status = null

    ensures:
        attempt.status = null
}

-- === A bitset matches any of its characters ===============

-- A bitset in a rule matches one character that is in it, which is how a
-- rule says "any of these" without writing them as alternatives. It is
-- the difference between a rule that reads as a set and one that reads
-- as a list, and for a set of any size it is the only workable form.
--
-- Reached either as a value bound to a word or written out as a
-- construct, since a rule block is not evaluated and `make bitset! "ab"`
-- inside one is three values rather than a bitset.
rule ABitsetMatchesOneOfItsCharacters {
    when: attempt: ParseAttempt.bitset_read
    requires: attempt.status = null

    ensures:
        attempt.status = null
}

-- === Strings are matched exactly ===========================

-- Parsing a string never skips whitespace. `parse "a b c" ["a" "b" "c"]`
-- is false, because nothing consumed the spaces, and the rule that works
-- is `["a" " " "b" " " "c"]`. REBOL 2 skipped whitespace unless you asked
-- it not to with /all; R3 reversed the default and dropped the
-- refinement, so /all now raises no_refine rather than being redundant.
rule StringParsingNeverSkipsWhitespace {
    when: attempt: ParseAttempt.created
    requires: attempt.input.datatype = string

    ensures:
        attempt.position = 1
        attempt.status = null
}

-- === Changing the input while matching ====================

-- CHANGE matches the rule after it and puts a value where the match was,
-- so the input is different afterwards and may be a different length. It
-- is REMOVE and an insertion in one step, and like REMOVE it needs the
-- series rather than a copy of it.
--
-- Confirmed against a real R3: the replacement may be a paren, and then
-- it is evaluated at the moment the change happens rather than when the
-- rule was written. That is what makes CHANGE useful with SET:
-- `parse [1] [change set n integer! (n * 10)]` leaves [10], because the
-- paren runs after n has been set by the match it is replacing.
--
-- The replacement is one value, however many items the rule matched:
-- `parse [1 2 3] [change 2 skip 9]` leaves [9 3].

-- Confirmed against a real R3: a bitset folds case like everything else
-- in a parse, so `parse "A" reduce [charset "a"]` matches and
-- `parse/case "A" reduce [charset "a"]` does not. Asking the set only
-- about the character as written makes a charset the one rule in the
-- dialect that always minds case, which is not something a rule author
-- would expect or could switch off.

-- Confirmed against a real R3: TO and THRU take a whole rule, not only a
-- value. `parse "zx" [thru [x | y]]` walks forward until either
-- alternative matches, and `parse "abc" [to ["b" | "q"] "bc"]` stops
-- before whichever one did.
--
-- Reading the target as text instead makes every such rule fail, because
-- a block has no text form that appears in the input. It is the kind of
-- failure that looks like a rule that simply did not match.

-- Confirmed against a real R3: TO and THRU refuse a parse command word as
-- their target, raising parse-rule. Their target is a place -- an index -- or
-- something to look for -- a string, a char, a bitset, a block rule -- and a
-- command word is none of those. So `parse "abc" [thru thru]` raises
-- parse-rule rather than searching for the text "thru".
--
-- END is the one word they do take, meaning the tail, so `to end` and
-- `thru end` are the way to walk to the end of the input. Every other command
-- word -- to, thru, skip, some, not and the rest -- names a step in the
-- dialect rather than a value, and there is nothing in the input for it to
-- point at. The C passes command words through unresolved and then rejects
-- any target that is not a searchable value.

-- Confirmed against a real R3: LIMIT is a reserved parse command word that is
-- not yet implemented, so it raises not-done the moment it is read.
-- `parse "123" [limit ["123"]]` raises rather than doing anything with the
-- rule after it, and the error's id is not-done, in the Internal category:
-- "reserved for future use (or not yet implemented)".
--
-- Reserved rather than unknown is the distinction. An unknown word in a rule
-- would be looked up as a variable; LIMIT is known to the dialect and has a
-- place held for it, so it is refused at the door as unfinished rather than
-- read as a name. A script reaching it is told the feature is not here yet,
-- not that it wrote something meaningless.

-- Confirmed against a real R3: COLLECT may be told where to put what it
-- gathers. SET names a word to hold the collection; INTO names a series
-- the caller already has and puts them at its position, pushing what was
-- there along; AFTER puts them past what is there.
--
-- The target need not be a block. Collecting characters into a string
-- gives a string, because a string takes the text of what it is given
-- rather than the values: `a: "" parse "1" [collect into a [keep skip]]`
-- leaves a holding "1", where the same into a block leaves [#"1"].
--
-- Each of these three forms occupies two more items in the rule than a
-- plain COLLECT does, and a walk that measures them as a plain one
-- resumes on the word and matches it as a rule of its own. That is not a
-- small error: it collects nothing at all and reports a match.

-- Confirmed against a real R3: CASE and NO-CASE work on a block parse as
-- they do on a string one. `parse ["A"] ["a"]` matches, `[case ["a"]]`
-- does not, `[case ["A"]]` does, and `[case no-case ["a"]]` does -- so
-- the mode really is a mode and the later word wins.

-- Resolved: every keyword in the dialect works on both a block and a
-- string, and JEBOL implements the two in separate walkers, so a keyword
-- added to one and not the other makes the same rule behave differently
-- depending on what is being parsed -- the worst kind of divergence to
-- chase, because the rule is demonstrably correct somewhere.
--
-- Four had genuinely drifted apart: WHILE, CASE and NO-CASE were on the
-- string side only, and IF on the block side only. All four are now on
-- both, each checked against a real R3 on both.
--
-- Comparing the two keyword switches found six candidates, not four.
-- AFTER and BREAK were false positives: the block walker implements
-- them, AFTER inside COLLECT's own clause handling and BREAK through the
-- signal that ends a repeat, so neither appears in the switch the
-- comparison reads. A structural audit finds candidates, not defects,
-- and every one of them still has to be put to the binary.

-- Confirmed against a real R3: WHILE is ANY under another name. It
-- repeats the rule until it stops matching and succeeds either way, so
-- `parse "" [while [remove #"y" | #"x"]]` is true. The two spellings are
-- a matter of convention; nothing distinguishes them.

-- Confirmed against a real R3: INSERT puts a value in at the current
-- position and consumes nothing, so `parse [1] [insert 9]` leaves [9 1].
-- The position ends up after what was inserted, which is what stops an
-- INSERT inside a repeat from running forever.

-- INSERT and CHANGE look their value up before using it, so a word in that
-- place contributes what the word holds and not the word. `Get_Parse_Value`
-- in the C: a word that is not a parse command is fetched, a path is
-- evaluated, and everything else is taken as it stands.
--
-- This is the difference between a rule that builds something and a rule
-- that repeats one symbol. `v: 7  parse [a b] [some [word! insert v]]`
-- leaves [a 7 b 7], and taking the word as written leaves [a v b v] --
-- which looks like a working INSERT until something reads the result.
--
-- Rebol's own ENUM is built on it. Its rule is
-- `pos: word! insert enum-value (...)`, counting up as it goes, and with
-- the word taken as written every entry gets the same word instead of its
-- own number. The object then evaluates that word once, at construction,
-- so every name in the enumeration comes out holding the final count.
rule InsertAndChangeLookTheirValueUp {
    when: MatchRule(rule, input)
    requires: rule.keyword in {insert, change}
    requires: is_word(rule.value) and not is_parse_keyword(rule.value)
    ensures: RuleMatched(inserted: value_of(rule.value))
}

rule InsertAndChangeEvaluateAPath {
    when: MatchRule(rule, input)
    requires: rule.keyword in {insert, change}
    requires: is_path(rule.value)
    ensures: RuleMatched(inserted: result_of(rule.value))
}

-- A lit-word loses its tick on the way in, so `change word! 'x` leaves the
-- plain word x. The C does it by hand after the modify:
-- `if (IS_LIT_WORD(item)) SET_TYPE(BLK_SKIP(series, index-1), REB_WORD);`
--
-- Without that step there is no way to insert a plain word at all: an
-- unquoted one would be looked up by the rule above, and a quoted one would
-- stay quoted.
rule ALitWordInsertedBecomesAPlainWord {
    when: MatchRule(rule, input)
    requires: rule.keyword in {insert, change}
    requires: is_lit_word(rule.value)
    ensures: RuleMatched(inserted: as_plain_word(rule.value))
}

-- REMOVE and CHANGE take a MARKED POSITION where a rule would go, and then
-- the span they work on is everything between that mark and where the parse
-- has reached.
--
-- A set-word marks a position and the word then holds the input at that
-- place. Handing that word to REMOVE or CHANGE says "everything from there to
-- here", which is how a rule takes out or replaces a run it measured as it
-- went: `parse s [mark: some digit! remove mark]`.
--
-- Which of the two positions is earlier does not matter. The span runs
-- between them, so a mark behind the position and a mark ahead of it both
-- name the same run, and the parse ends up at the earlier of the two.
--
-- The word has to name a position in the SERIES BEING PARSED. A word holding
-- some other series names no span at all, and is read as an ordinary rule
-- instead. So is a parse command word, which can never be a mark -- otherwise
-- `remove skip` would be read as a span rather than as "remove what SKIP
-- matches", and the dialect would lose its most ordinary form.
rule RemoveAndChangeTakeAMarkedPositionAsASpan {
    when: MatchRule(rule, input)
    requires: rule.keyword in {remove, change}
    requires: names_a_position_in_the_input_being_parsed(rule.value)

    ensures: RuleMatched(
        span: the_input_between(rule.value, the_current_position),
        position: the_earlier_of(rule.value, the_current_position))
}

-- A CHANGE replacement written as a word is fetched from its binding, and a
-- word holding nothing raises no-value.
--
-- Fetching is InsertAndChangeLookTheirValueUp above; what is added here is
-- what happens when the fetch finds nothing. `do_modify` traps an unset
-- before it writes, so the rule fails loudly rather than putting an absent
-- value into the series.
--
-- Refusing is the right half of "look the value up". A rule that fetched and
-- then silently wrote nothing would leave a hole in the input that no later
-- rule could distinguish from a change that was never asked for.
rule ChangingToAWordThatHoldsNothingRaises {
    when: MatchRule(rule, input)
    requires: rule.keyword in {insert, change}
    requires: is_word(rule.value) and not is_parse_keyword(rule.value)
    requires: value_of(rule.value).datatype = unset

    ensures: ParseFails(failure: no_value, about: rule.value)
}

-- === Rules that are not rules ==============================

-- A rule item that is an UNSET or a FUNCTION is no rule at all, and raises
-- parse-rule naming the item as it was written.
--
-- `if (VAL_TYPE(item) <= REB_UNSET || VAL_TYPE(item) >= REB_NATIVE) goto
-- bad_rule;` -- the two ends of the datatype order, and everything between
-- them is something a rule can be. It applies both to an item written in the
-- rule block and to what a word in the rule block names, and the error names
-- the WORD in the second case rather than the value it found, because the
-- word is what the author wrote and can go and look at.
--
-- The unset half is the one that catches real mistakes: a rule holding a word
-- nobody assigned, or a word assigned from an expression that answered
-- nothing. Read as a value to match instead, it fails silently against
-- whatever is there and the rule looks like a grammar that does not fit.
--
-- The function half exists because a function in a rule looks plausible --
-- somewhere for a predicate to go -- and the dialect has no such place. Being
-- told so beats being told the input did not match.
rule AnUnsetOrAFunctionInARuleIsRefused {
    when: MatchRule(rule, input)
    requires: rule.item.datatype = unset or is_any_function(rule.item)

    ensures: ParseFails(failure: parse_rule, about: as_written(rule.item))
}

-- A PATH in a rule is evaluated, and what it answers is the rule.
--
-- So `a/b` naming a datatype matches by that datatype, and a path into an
-- object reaches a rule the object holds. It is the same treatment a word
-- gets -- looked up and the value used -- one segment deeper, and Rebol's own
-- Get_Parse_Value already does it for the value slot of INSERT and CHANGE.
--
-- Without it a path in a rule is compared as a value, so a rule held in
-- `rules/digit` fails against every input and looks like a grammar that does
-- not match.
rule APathInARuleIsEvaluatedAndItsValueIsTheRule {
    when: MatchRule(rule, input)
    requires: is_path(rule.item)

    ensures: RuleAppliedIs(result_of(rule.item))
}

-- TO and THRU refuse a get-word or a set-word as their target, raising
-- parse-rule.
--
-- They already refuse a command word, for the reason given above: their
-- target is a place or something to look for, and a command word is neither.
-- A marker word is neither for the same reason and one more -- a set-word
-- marks a position and a get-word returns to one, so both are instructions
-- about where the parse is, not things that appear in the input.
--
-- Allowed through, a get-word moved the position backwards and left the seek
-- reading a span running the wrong way, which surfaced as a host-language
-- failure rather than as a REBOL error. END remains the one word they take.
rule ToAndThruRefuseAMarkerWord {
    when: MatchRule(rule, input)
    requires: rule.keyword in {to, thru}
    requires: is_get_word(rule.value) or is_set_word(rule.value)

    ensures: ParseFails(failure: parse_rule, about: rule.value)
}

-- FAIL matches nothing, ever, so the walk goes to the current block's next
-- alternative.
--
-- It is the deliberate way to end a branch, where an ordinary failure is
-- something that happened to the rule. `[thing fail | other]` says "having
-- got this far, take the other branch", which a rule cannot otherwise say
-- without writing a condition that is guaranteed not to match.
--
-- FAIL and REJECT are the two ways to fail on purpose and they differ in
-- reach: FAIL fails the current rule and the alternatives are tried, REJECT
-- abandons the whole block and they are not.
rule FailNeverMatchesAndSendsTheWalkToTheNextAlternative {
    when: MatchRule(rule, input)
    requires: rule.keyword = fail

    ensures: RuleDidNotMatch(consuming: 0)
}

-- OPT resolves a word after it to the rule the word names, rather than
-- matching the word as a value.
--
-- `if (IS_WORD(item)) item = Get_Var(item);` -- the same resolution every
-- other keyword's following rule gets. Which matters most for a recursive
-- grammar: `opt tags` where TAGS is a rule that mentions itself is how an
-- optional repetition is written, and matching the literal word `tags`
-- against the input instead makes the whole grammar fail with nothing to
-- point at.
--
-- OPT with nothing after it raises parse-end, like every other keyword that
-- needs a rule.
rule OptResolvesTheRuleAWordNames {
    when: MatchRule(rule, input)
    requires: rule.keyword = opt

    ensures: RuleAppliedIs(the_rule_the_following_item_names(rule))
}

-- === Case, chosen part way through =========================

-- CASE and NO-CASE change how the rules after them compare, and they
-- last until the other one appears. A parse is case-folding by default,
-- so NO-CASE is only needed to undo a CASE earlier in the same rule.
-- Being a mode rather than a refinement is what lets one rule mind case
-- in one place and not in another.

-- === Looking without consuming ============================

-- AHEAD, spelled AND as well, matches the rule after it and then puts
-- the position back. It is how a rule asks what comes next without
-- taking it, so `[ahead #"a" skip]` matches an "a" twice over: once to
-- look and once to consume.
--
-- The rule after AHEAD is a whole rule, not a single value. So
-- `parse "abc" [ahead thru "c" 3 skip]` succeeds: AHEAD matches `thru "c"`,
-- a two-item rule, without moving, and then `3 skip` consumes "abc" from the
-- head. And `parse "abc" [and thru "z" 3 skip]` fails, because there is no
-- "z" ahead for the lookahead to reach. Reading the following rule as one
-- value made a compound lookahead like `thru "c"` fail, because it
-- text-matched only the first word.
--
-- AHEAD succeeds when the rule matches and fails when it does not, resetting
-- the position only on the success. So a failed lookahead leaves the parse
-- where a failed match leaves it, and a matched one leaves the position
-- exactly where AHEAD found it.
--
-- REMOVE is the opposite kind of thing: it matches the rule after it and
-- takes what matched out of the input, so the series is shorter
-- afterwards. Both leave the parse's answer alone; what they change is
-- the position and the input.
rule LookaheadPutsThePositionBack {
    when: attempt: ParseAttempt.ahead_read
    requires: attempt.status = null

    ensures:
        attempt.status = null
}

-- Confirmed against a real R3: NOT negates the rule after it and consumes no
-- input. It is the mirror of AHEAD: where AHEAD succeeds when the next rule
-- matches, NOT succeeds when the next rule fails, and neither moves the
-- position. So `parse "abc" [not "x" "abc"]` is true -- the "x" is not there,
-- so NOT succeeds and "abc" then matches from the head -- and
-- `parse "abc" [not "a" "abc"]` is false, because the "a" is there and NOT
-- fails on it.
--
-- Stacked, two NOTs cancel: NOT NOT is a no-op, a zero-width assertion that
-- succeeds where the inner rule matches and still consumes nothing, so
-- `parse "1" [not not "1" "1"]` is true -- the doubled NOT succeeds at the
-- head and the following "1" matches. The C carries a second flag toggled on
-- each NOT, so an even number of them leaves the negation off.
--
-- Consuming nothing is the property to hold on to. NOT is a test of what
-- comes next, not a step over it, so a rule after a NOT starts from the same
-- position the NOT looked at -- which is why `not "x" "abc"` matches "abc"
-- from the head rather than from one past it.

-- === One dialect, whichever series is being walked ========

-- Every keyword above means the same thing over a string as over a
-- block. What changes is only what a rule matches against: a string rule
-- matches a run of characters and a block rule matches one item.
-- Everything else -- the counts, SET, COPY, COLLECT, KEEP, the
-- alternatives, the backtracking -- is the same dialect.
--
-- This is worth stating because it is the kind of thing an
-- implementation quietly gets wrong. Matching a string and matching a
-- block want different code, and once they are two walks nothing forces
-- the second to keep up with the first. JEBOL's string walk had no
-- counts, no SET, no COPY, no COLLECT and no KEEP, and no test asked why
-- `parse "ab" [2 skip]` was false when `parse [a b] [2 skip]` was true.
--
-- What a KEEP puts in the collection follows the input: one item of a
-- block is that item, one character of a string is a character, and a
-- run of characters is a slice that keeps the input's own datatype. So
-- collecting from a file gives file pieces, not string pieces.
-- === Collecting while matching ============================

-- COLLECT changes what PARSE answers. Ordinarily a parse is a question
-- with a logic for an answer; with COLLECT at the top of the rule it is
-- an extraction, and the answer is the block of everything KEEP matched.
--
-- Two consequences follow and both are easy to miss. Leftover input does
-- not matter, because the question is no longer "did this account for
-- all of it"; `parse [1 2] [collect [keep integer!]]` answers `[1]` and
-- not false. And an empty collection is an empty block rather than none,
-- so a caller can append to what came back without testing it first.
rule CollectChangesWhatParseAnswers {
    when: attempt: ParseAttempt.collect_read
    requires: attempt.status = null

    ensures:
        attempt.status = collected
}

-- A collection is answered whether or not its rule matched, and what
-- KEEP put in it stays there.
--
-- This is the part of COLLECT that no amount of reasoning gets you to,
-- and it was asked of R3 rather than worked out. Matching in PARSE
-- backtracks: a rule that fails puts the position back and an
-- alternative tries from there. Collecting does not.
-- `parse [1 2] [collect [keep integer! keep string! | keep integer!]]`
-- answers `[1 1]`, because the first branch kept the 1, then failed on
-- the string, and the alternative kept the same 1 again. Both are in
-- the answer.
--
-- The same holds one level up. A nested COLLECT hands its block to the
-- collection around it as soon as it starts, not when it succeeds, so a
-- nested collect whose rule fails still leaves a block behind:
-- `parse [] [collect [collect [keep 2 skip]]]` answers `[[]]`.
--
-- What this means for anyone reading a rule: the collection is a record
-- of every KEEP that ran, not of the KEEPs on the path that finally
-- matched. A rule with alternatives collects from the branches it tried
-- and abandoned as well as from the one it kept.
rule CollectingIsNotUndoneByBacktracking {
    when: attempt: ParseAttempt.collect_read
    requires: attempt.status = null

    ensures:
        attempt.status = collected
        and attempt.collected_count >= attempt.keeps_attempted
}

-- COLLECT SET assigns the word its fresh collection BEFORE the rule below it
-- runs, and everything kept goes into that same block.
--
-- The C makes the block and sets the word in one breath -- `Make_Block` then
-- `Set_Var_Series` -- and only then applies the rule. Two things follow, and
-- neither is reachable if the word is assigned at the end instead.
--
-- A rule below can read what has been collected so far, because the word
-- already names the block being filled.
--
-- And nested COLLECT SETs of the SAME word settle the right way round. The
-- outer assigns first and the inner assigns second, so the word is left
-- holding the inner collection -- which is what a reader expects, the inner
-- one being the nearer. Assigning at the end reverses it: the inner finishes
-- first, the outer finishes last and overwrites it, and the word holds the
-- collection further away.
rule CollectSetAssignsItsWordBeforeTheRuleRuns {
    when: attempt: ParseAttempt.collect_read
    requires: the_collect_named_a_word_to_set(attempt)

    ensures:
        the_word_holds(attempt) = a_fresh_empty_block()
        and that_assignment_happens_before(the_rule_below_it_runs)
        and everything_kept_goes_into(the_block_already_assigned)
}

-- KEEP COPY keeps the SERIES the copy produced, not the single value a plain
-- KEEP would keep.
--
-- The difference shows on a match of exactly one item, which is where the two
-- would otherwise agree. `keep copy` of one character keeps a one-character
-- string of the input's own kind; plain `keep` of one character keeps a char.
-- Same match, two datatypes, and a caller appending the results finds out
-- which they got only when something downstream reads them.
--
-- It follows from COPY meaning "the whole span as a series" rather than from
-- anything about KEEP: KEEP of a COPY keeps what COPY made.
rule KeepCopyKeepsTheTypedSlice {
    when: MatchRule(rule, input)
    requires: rule.keyword = keep
    requires: the_next_item_is(rule, copy)

    ensures: RuleMatched(kept: the_matched_span_as_a_series_of(input.datatype))
}

-- KEEP PICK of a paren keeps the paren's value whole, exactly as a plain KEEP
-- of the same expression would.
--
-- PICK asks for the items of what was matched to be kept one by one rather
-- than as a series, and a paren matches nothing -- it is an expression, not a
-- span. So the flag has nothing to act on and the value goes in whole. The C
-- reaches the same place by setting the pick flag, then finding a paren, and
-- never consulting the flag again.
--
-- Worth stating because `keep pick (...)` reads as though it should spread a
-- block the paren answered, and it does not.
rule KeepPickOfAParenKeepsItsValueWhole {
    when: MatchRule(rule, input)
    requires: rule.keyword = keep
    requires: the_next_item_is(rule, pick)
    requires: is_paren(the_item_after_pick(rule))

    ensures: RuleMatched(kept: result_of(the_item_after_pick(rule)))
}

-- Parsing a BINARY, KEEP keeps each byte as its NUMBER, and a COLLECT INTO a
-- binary delivers those numbers back as bytes.
--
-- `SET_INTEGER(val, BIN_HEAD(series)[i])` -- one byte is a number where one
-- character of a string is a char. The span form keeps a binary, by the same
-- rule COPY follows, so `parse #{010203} [collect any [keep 1 2 skip]]` is
-- `[#{0102} 3]`: a binary and a number in one block.
--
-- Delivering into a binary target completes the pair. A collection made of
-- byte numbers and binary slices goes into a binary as bytes, so a caller can
-- collect from one binary into another. Without it the delivery quietly did
-- nothing, which is the same silence PARSE refuses elsewhere with
-- parse-into-type.
rule KeepingFromABinaryKeepsBytesAsNumbers {
    when: MatchRule(rule, input)
    requires: rule.keyword = keep
    requires: input.datatype = binary

    ensures: RuleMatched(kept:
        if the_match_is_one_item: the_byte_as_a_number
        else: the_matched_span_as_a_binary)
}

rule CollectingIntoABinaryDeliversBytes {
    when: attempt: ParseAttempt.collect_read
    let target = the_series_the_collect_delivers_into(attempt)
    requires: target.datatype = binary

    ensures:
        for kept in the_collection(attempt):
            the_bytes_added_to(target) =
                if is_integer(kept): the_one_byte(kept)
                else: the_bytes_of(kept)
}

-- Confirmed against a real R3: REJECT fails the current block at once and
-- tries none of that block's later alternatives. That is exactly where it
-- differs from an ordinary match failure: a plain failure lets the block go
-- on to its next `|` branch, and REJECT abandons the whole block.
--
-- So `parse "aabb" [[#"a" reject | "aabb"]]` is false: the inner block
-- matches "a", REJECT fails the block, and the `| "aabb"` branch it holds is
-- never tried -- which is what makes `not parse ...` of it true. The `|`
-- alternative would have matched, and an ordinary failure would have reached
-- it; REJECT is the difference.
--
-- A REJECT only fails the block it sits in, not the one around it. So
-- `parse "aabb" [[#"a" reject] | "aabb"]` is true: the inner block is
-- abandoned, but the outer block still has its own `| "aabb"` to try, and
-- that matches. The abandonment stops at the block boundary rather than
-- unwinding the whole parse.
--
-- REJECT and BREAK are the two ways a block ends itself early and they end
-- it opposite ways: BREAK (and ACCEPT) leave the block a success, REJECT
-- leaves it a failure. The C returns success from one and not-found from the
-- other, each unwinding the current rule loop immediately.

-- Confirmed against a real R3: RETURN ends the parse at once and answers a
-- value, rather than answering whether the whole input matched. It is the
-- other keyword that changes what PARSE gives back -- COLLECT answers the
-- gathered block, RETURN answers one value and stops.
--
-- It has two forms. RETURN of a paren evaluates the paren and answers its
-- value, so `parse [1 2 3] [return (42)]` answers 42, whatever is left
-- unmatched. RETURN of a rule matches that rule and answers the slice of
-- input the rule matched, so `parse [1 2 3] [return 2 skip]` answers [1 2] and
-- `parse [a b c] [return skip]` answers [a]. The rule after RETURN is a whole
-- rule, and the answer is exactly what it consumed.
--
-- A RETURN whose rule does not match does not end the parse. It fails like any
-- other rule, so `parse [1 2 3] [return "x"]` is false rather than answering
-- something: the "x" is not there, the RETURN rule fails, and the parse goes
-- on to fail as a whole. Only a RETURN that reaches its value ends the parse.
--
-- The C throws a paren's value the instant it reads the RETURN, and for a
-- rule sets a flag so that the matched slice is thrown on the rule's success;
-- the top level catches whatever was thrown and answers it. This is the block
-- parser -- the string parser could take the same for parity, and the suite
-- asserts on block parses.

-- Confirmed against a real R3: a get-word in a rule moves where the parse is
-- looking. It already seeks to a marked position when it names a place in the
-- series being parsed, and when it names a different series it switches the
-- input to that series and starts matching it from its head.
--
-- The seek is the familiar half: a set-word marks a position and a get-word
-- returns to it, so `parse "abc" [skip m: skip :m "bc"]` skips one, marks the
-- position, skips again, then seeks back to the mark and matches "bc" from
-- there. The switch is the same mechanism reaching a different series:
-- `b: "this"  parse "test" ["test" :b "this"]` is true, because "test" matches
-- the whole of "test", then `:b` adopts "this" as the input, and the "this"
-- rule matches the new input to its end.
--
-- One mechanism, not two, is the thing to hold on to. The C resets both the
-- series and the index whenever the get-word holds any series, so whether it
-- names the same series or another is only whether the series changed -- a
-- seek is a switch that happened to land on the series already being parsed.
-- A get-word holding something that is not a series raises parse-series.

-- Confirmed against a real R3: THEN matches nothing and succeeds, so the rule
-- after it runs straight on. `parse "ab" ["a" then "b"]` is true -- "a"
-- matches, THEN matches nothing and consumes nothing, and "b" matches from
-- where "a" left off. It sits inside a longer sequence without breaking it.

open question "THEN's fuller behaviour commits the current alternative when the rule after it fails, skipping the later bar branches so they are not tried -- the C does it by skipping to the next bar on the following rule's failure. JEBOL implements only the zero-width success half so far, which is what parse-test.r3 asserts; the commit-on-failure half is not built yet and no assertion presses on it. Recorded as an open edge: the built behaviour is correct as far as it goes, and the missing half changes only what happens down a failing branch."

-- REBOL 2 let the rule be a string, a character or NONE, meaning "split
-- the input on these delimiters" rather than "match this grammar", and
-- kept /all to hold whitespace out of the delimiter set. R3-Alpha still
-- had both. Rebol 3.22.1 removed them: a rule has to be a block, a string
-- where one belongs raises expect_arg, /all raises no_refine, and
-- splitting is SPLIT's job.
--
-- This entry has been written twice in both directions. The corpus said
-- "splits" from the REBOL/Core guide, was changed to "raises" against the
-- binary, changed back on reading R3-Alpha's Parse_String, and changed to
-- "raises" again when the target moved to the maintained fork. The
-- removal is a deliberate tidy-up rather than a regression: one name did
-- two unrelated jobs and now two names do one each.
rule ParseRequiresARuleBlock {
    when: attempt: ParseAttempt.created
    requires: attempt.rule.datatype != block

    ensures:
        attempt.status = raised
        attempt.failure = expect_arg
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface ParseDialect {
    exposes:
        ParseKeyword
        ParseOutcome
        ParseAttempt

    @guarantee AParenMayChangeTheInputAndTheWalkRereadsIt
        -- A paren in a rule runs arbitrary code, and that code may change the
        -- very series being parsed. So after every paren the walk re-reads
        -- the input and brings its position back to the tail if the series
        -- got shorter -- the C clamps `if (index > series->tail) index =
        -- series->tail;` after each one.
        --
        -- Without it a walk holds its own stale copy of the input, and a rule
        -- whose paren appended or removed goes on matching against what was
        -- there before. Nothing raises; the rule simply matches the wrong
        -- text, and the mismatch between the parse's answer and the series
        -- the caller ends up holding is the only evidence.
        --
        -- Both walkers do it, the block one and the string one, because a
        -- paren can shorten either.

    @guarantee ParenEffectsSurviveBacktracking
        -- A paren in a rule runs the moment the walk reaches it, and
        -- nothing undoes it if the rule it sits in goes on to fail. So
        -- `[[integer! (n: n + 1) word!] | integer!]` against `[1]` takes
        -- the second alternative and still leaves n incremented. A paren
        -- that the walk never reaches never runs, which is the only sense
        -- in which a failing rule's paren is skipped.

    @guarantee AWordInARuleIsARule
        -- A word that is not a keyword is looked up and what it holds is
        -- used as a rule, so a rule can be held in a word and reused. A
        -- lit-word is the way to match a word as a value: 'x matches the
        -- word x. A datatype word matches any value of that datatype.

    @guarantee SetAndCopyOutliveTheParse
        -- SET puts the single value its rule matched into a word, and
        -- COPY puts the whole span into a word as a series. Both survive
        -- the call, so the word still holds the value afterwards.
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

-- Resolved against a real R3: the whole of the input must be consumed for
-- PARSE to answer true. It is not "did the rule match" but "did the rule
-- account for everything".

-- Resolved against a real R3: a repeat count of zero followed by a rule
-- matches nothing and succeeds. `parse [] [0 integer!]` is true and
-- `parse [1 1 1] [0 integer!]` is false, the second because the three
-- integers are still sitting there unaccounted for.

-- Resolved: the target is Rebol 3.22.1, the maintained fork, and not
-- R3-Alpha. R3-Alpha's last commit was in July 2015. Where the two
-- disagree the fork decides, which so far means only the splitting form
-- above. See docs/decisions.md item 10.

open question "Backtracking is specified here only by what survives it. Nothing says how far PARSE backs up when an alternative fails, or whether a partially applied repeat count is retried at a lower count. The corpus reaches the common cases and the implementation makes a choice; the choice is not written down."

-- Resolved against a real R3: two mistakes PARSE refuses that JEBOL used
-- to let past in silence.
--
-- A KEEP with no COLLECT around it raises parse-no-collect. Left alone it
-- dropped what it kept and carried on matching, so a rule with the
-- COLLECT left off looked like it worked and the values simply went
-- missing. The same failure covers a COLLECT whose next rule is not a
-- block, because nothing ever opens a collection for the KEEPs below it.
--
-- A COLLECT INTO target that cannot hold what the parse yields raises
-- parse-into-type. A block, a paren or a hash takes anything; a string
-- target needs a string being parsed and a binary target needs a binary;
-- anything that is not a series at all is refused whatever is being
-- parsed. Left unchecked the delivery quietly did nothing, which is the
-- same silence in a different place.

-- Resolved against a real R3: PARSE walks a binary one byte at a time,
-- with every rule word meaning what it means for a string.
--
-- SKIP steps one byte, a rule written as a binary matches those bytes,
-- and TO and THRU seek over them. A count still has to match the length,
-- so `parse #{0102} [3 skip]` is false.
--
-- What differs from a string is only what comes back out. COPY answers a
-- binary however many bytes it took, so one byte is still `#{01}` and not
-- a number. SET of one byte answers the number, 1 rather than `#{01}`,
-- and that difference between COPY and SET is the whole of it. KEEP
-- follows SET's rule for one byte and COPY's for a span, which is why
-- `parse #{010203} [collect any [keep 1 2 skip]]` is `[#{0102} 3]` -- a
-- binary and a number in the same block.
--
-- A zero byte and a byte of 255 are both ordinary. Nothing about them
-- ends anything, which is worth pinning because the obvious way to build
-- this -- letting each byte stand in for a character -- puts the null
-- character in the middle of the input.

-- Resolved against a real R3: TO and THRU take three kinds of target and
-- treat them quite differently.
--
-- Something to look for is searched forward from where the parse has
-- reached. TO stops before it and THRU stops after it, which is the whole
-- difference between the two words.
--
-- A whole number is a place rather than a thing to find, counted from the
-- head. `to 3` goes to the third item and `thru 3` goes past it, so
-- `thru 1` lands exactly where `to 2` does. Because it is counted from
-- the head it can move the parse backwards: `parse "abcd" ["ab" to 1
-- "abcd"]` succeeds, which nothing searched forward could do. A place
-- outside the input is no match rather than an error.
--
-- A rule that repeats is neither, and raises parse-rule: `thru some "0"`
-- and `thru any "0"` are both refused. So is a fraction, which is not a
-- place and not something to look for.
--
-- A tag stands for its brackets and all. FORM of a tag gives the letter
-- alone, so matching on that finds the letter without its brackets and
-- stops a character early -- or finds a letter that was never part of a
-- tag at all.

-- Resolved against a real R3: CHANGE spreads a block replacement and puts
-- it in whole only when ONLY says so.
--
-- `change some word! [z p]` leaves two words where the match was, not one
-- block holding them. `change ['a 'b] only [z p]` leaves the block. An
-- empty block takes the match out and puts nothing back, which is how a
-- CHANGE deletes and is not something a CHANGE that always nested could
-- do at all.
--
-- ONLY says how to put the replacement in, so it goes before the
-- replacement. Before the rule it reads as a rule called only, which is
-- no rule, and R3 raises parse-rule.
--
-- A paren replacement is evaluated, so the value put in is what the paren
-- answered rather than the paren itself.

-- Resolved against a real R3: a set-word in a block rule marks where the
-- parse has reached and consumes nothing; a get-word goes back to what
-- one recorded. The two together are how a rule measures a span.
--
-- The mark holds the series at that position, so `parse [1 2 3] [skip
-- mark: to end]` leaves mark as [2 3]. A mark at the head holds the whole
-- series and one at the tail holds an empty one; both are places.
--
-- A get-word naming no place, or a place in a different series, does not
-- match. That is better than moving: a position the walker cannot read is
-- worse than a rule that simply fails.
--
-- Missing entirely, a set-word is taken as a value to match and fails
-- against whatever is there, and everything after it in the rule fails
-- with it. That makes the mark look as though it broke the rule.
